{
  "name": "web-erp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../backend/api/openapi.bundle.yaml -o src/lib/api/schema.gen.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^11.7.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
