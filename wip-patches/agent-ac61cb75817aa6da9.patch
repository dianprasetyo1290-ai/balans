+-+		f.PartyType = domain.PartyType(*req.Params.PartyType)
+-+	}
+-+	list, err := h.svc.ListSpecialPrices(ctx, f)
+-+	if err != nil {
+-+		return nil, err
+-+	}
+-+	out := make([]SpecialPrice, len(list))
