+-+// productInfos mengubah ProductRef menjadi data validasi domain.
+-+func productInfos(refs map[uuid.UUID]ProductRef) map[uuid.UUID]domain.ProductInfo {
+-+	out := make(map[uuid.UUID]domain.ProductInfo, len(refs))
+-+	for id, p := range refs {
