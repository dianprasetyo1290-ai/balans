+const updateFixedAsset = `-- name: UpdateFixedAsset :execrows
+UPDATE fixed_assets
+SET name = $1, class_id = $2, location_id = $3,
+    location_label = $4, division_id = $5,
+    acquisition_source = $6, acquisition_date = $7,
+    acquisition_cost_amount = $8, salvage_amount = $9,
