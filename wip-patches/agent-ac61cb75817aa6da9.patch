-		}
-		in.Lines = append(in.Lines, domain.LineInput{ProductID: prod.ID, Qty: it.Qty, UnitPrice: it.UnitPrice})
-	}
-	if err := p.Err(); err != nil {
-		return err
-	}
-	if _, err := s.recordMarketplaceOrder(ctx, a, in, rowKey); err != nil {
-		return remapImportError(err)
-	}
-	return nil
-}
