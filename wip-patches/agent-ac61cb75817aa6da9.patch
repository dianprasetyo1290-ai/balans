+-func idLookup(id uuid.UUID, err error, what string) (uuid.UUID, bool, error) {
+-	if errors.Is(err, pgx.ErrNoRows) {
+-		return uuid.Nil, false, nil
+-	}
+-	if err != nil {
+-		return uuid.Nil, false, fmt.Errorf("%s: %w", what, err)
+-	}
+-	return id, true, nil
+-}
