+-+
+-+// GetOrder membaca PO beserta baris dan bahan maklon; forUpdate mengunci baris PO.
+-+func (s *Store) GetOrder(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.PurchaseOrder, error) {
+-+	var (
+-+		r   sqlcgen.PurchaseOrder
+-+		err error
+-+	)
+-+	if forUpdate {
+-+		r, err = s.q(ctx).GetPurchaseOrderForUpdate(ctx, id)
+-+	} else {
+-+		r, err = s.q(ctx).GetPurchaseOrder(ctx, id)
+-+	}
+-+	if err != nil {
+-+		return domain.PurchaseOrder{}, notFound(err, "get purchase order")
+-+	}
+-+	o := toOrder(r)
+-+	lines, err := s.q(ctx).ListPurchaseOrderLines(ctx, []uuid.UUID{id})
+-+	if err != nil {
+-+		return domain.PurchaseOrder{}, fmt.Errorf("list purchase order lines: %w", err)
+-+	}
+-+	o.Lines = make([]domain.OrderLine, len(lines))
+-+	for i, l := range lines {
+-+		o.Lines[i] = domain.OrderLine{
+-+			ID: l.ID, LineNo: int(l.LineNo), ProductID: uuidPtr(l.ProductID), Description: l.Description,
+-+			OrderedQty: l.OrderedQty, UnitPrice: amount(l.UnitPriceAmount), Amount: amount(l.LineAmount),
+-+			ReceivedQty: l.ReceivedQty, BilledQty: l.BilledQty, PurchaseRequestLineID: uuidPtr(l.PurchaseRequestLineID),
+-+			Note: l.Note,
+-+		}
+-+	}
+-+	materials, err := s.q(ctx).ListPurchaseOrderMaterials(ctx, []uuid.UUID{id})
+-+	if err != nil {
+-+		return domain.PurchaseOrder{}, fmt.Errorf("list purchase order materials: %w", err)
+-+	}
+-+	o.Materials = make([]domain.OrderMaterial, len(materials))
+-+	for i, m := range materials {
+-+		o.Materials[i] = domain.OrderMaterial{
+-+			ID: m.ID, LineNo: int(m.LineNo), ProductID: m.MaterialProductID, PlannedQty: m.PlannedQty, Note: m.Note,
+-+		}
+-+	}
+-+	return o, nil
+-+}
+-+
+-+func (s *Store) insertOrderItems(ctx context.Context, o domain.PurchaseOrder) error {
+-+	for _, l := range o.Lines {
+-+		if err := s.q(ctx).InsertPurchaseOrderLine(ctx, sqlcgen.InsertPurchaseOrderLineParams{
+-+			PurchaseOrderID: o.ID, LineNo: int32Of(l.LineNo), ProductID: nullUUID(l.ProductID), Description: l.Description,
+-+			OrderedQty: l.OrderedQty, UnitPriceAmount: l.UnitPrice.Decimal(), LineAmount: l.Amount.Decimal(),
+-+			ReceivedQty: l.ReceivedQty, BilledQty: l.BilledQty, PurchaseRequestLineID: nullUUID(l.PurchaseRequestLineID),
+-+			Note: l.Note,
+-+		}); err != nil {
+-+			return fmt.Errorf("insert purchase order line: %w", err)
+-+		}
+-+	}
+-+	for _, m := range o.Materials {
+-+		if err := s.q(ctx).InsertPurchaseOrderMaterial(ctx, sqlcgen.InsertPurchaseOrderMaterialParams{
+-+			PurchaseOrderID: o.ID, LineNo: int32Of(m.LineNo), MaterialProductID: m.ProductID, PlannedQty: m.PlannedQty, Note: m.Note,
+-+		}); err != nil {
+-+			return fmt.Errorf("insert purchase order material: %w", err)
+-+		}
+-+	}
+-+	return nil
+-+}
+-+
+-+// InsertOrder menyimpan draft PO baru beserta baris dan bahannya.
+-+func (s *Store) InsertOrder(ctx context.Context, o domain.PurchaseOrder, actorID uuid.UUID) (domain.PurchaseOrder, error) {
+-+	row, err := s.q(ctx).InsertPurchaseOrder(ctx, sqlcgen.InsertPurchaseOrderParams{
+-+		OrderType: string(o.Type), SupplierID: o.SupplierID, SupplierCode: o.SupplierCode, SupplierName: o.SupplierName,
+-+		DivisionID: o.DivisionID, BusinessDate: o.BusinessDate, ExpectedDate: o.ExpectedDate,
+-+		PaymentTermDays: int32Of(o.PaymentTermDays), Note: o.Note, TollLocationID: nullUUID(o.TollLocationID),
+-+		MaterialSourceLocationID: nullUUID(o.MaterialSourceLocationID), SubtotalAmount: o.Subtotal.Decimal(),
+-+		TotalAmount: o.Total.Decimal(), ActorID: actorID,
+-+	})
+-+	if err != nil {
+-+		return domain.PurchaseOrder{}, fmt.Errorf("insert purchase order: %w", err)
+-+	}
+-+	o.ID = row.ID
+-+	if err := s.insertOrderItems(ctx, o); err != nil {
+-+		return domain.PurchaseOrder{}, err
+-+	}
+-+	return s.GetOrder(ctx, o.ID, false)
+-+}
+-+
+-+// SaveOrder menyimpan header PO dengan optimistic locking. replaceLines mengganti baris dan bahan (draft).
+-+func (s *Store) SaveOrder(ctx context.Context, o domain.PurchaseOrder, version int, actorID uuid.UUID, replaceLines bool) error {
+-+	_, err := s.q(ctx).UpdatePurchaseOrder(ctx, sqlcgen.UpdatePurchaseOrderParams{
+-+		Number: text(o.Number), SupplierID: o.SupplierID, SupplierCode: o.SupplierCode, SupplierName: o.SupplierName,
+-+		DivisionID: o.DivisionID, BusinessDate: o.BusinessDate, ExpectedDate: o.ExpectedDate,
+-+		PaymentTermDays: int32Of(o.PaymentTermDays), Note: o.Note, TollLocationID: nullUUID(o.TollLocationID),
+-+		MaterialSourceLocationID: nullUUID(o.MaterialSourceLocationID), SubtotalAmount: o.Subtotal.Decimal(),
+-+		TotalAmount: o.Total.Decimal(), Status: string(o.Status), CloseReason: o.CloseReason, CancelReason: o.CancelReason,
+-+		SubmittedAt: o.SubmittedAt, ApprovedAt: o.ApprovedAt, EtaNotifiedAt: o.ETANotifiedAt, ActorID: actorID,
+-+		ID: o.ID, Version: int32Of(version),
+-+	})
+-+	if err != nil {
+-+		return versionConflict(err, "update purchase order")
+-+	}
+-+	if !replaceLines {
+-+		return nil
+-+	}
+-+	if err := s.q(ctx).DeletePurchaseOrderLines(ctx, o.ID); err != nil {
+-+		return fmt.Errorf("delete purchase order lines: %w", err)
+-+	}
+-+	if err := s.q(ctx).DeletePurchaseOrderMaterials(ctx, o.ID); err != nil {
+-+		return fmt.Errorf("delete purchase order materials: %w", err)
+-+	}
+-+	return s.insertOrderItems(ctx, o)
+-+}
+-+
+-+// SaveOrderLineQty menyimpan qty diterima dan ditagih per baris.
+-+func (s *Store) SaveOrderLineQty(ctx context.Context, lines []domain.OrderLine) error {
+-+	for _, l := range lines {
+-+		if err := s.q(ctx).SetPurchaseOrderLineQty(ctx, sqlcgen.SetPurchaseOrderLineQtyParams{
+-+			ReceivedQty: l.ReceivedQty, BilledQty: l.BilledQty, ID: l.ID,
+-+		}); err != nil {
+-+			return fmt.Errorf("set purchase order line qty: %w", err)
+-+		}
+-+	}
+-+	return nil
+-+}
+-+
+-+// OrdersDueForETA mengembalikan PO disetujui yang tiba pada tanggal tertentu dan belum diberi notifikasi ETA.
+-+func (s *Store) OrdersDueForETA(ctx context.Context, expected clock.BusinessDate) ([]uuid.UUID, error) {
+-+	ids, err := s.q(ctx).OrdersDueForETA(ctx, expected)
+-+	if err != nil {
+-+		return nil, fmt.Errorf("orders due for eta: %w", err)
+-+	}
+-+	return ids, nil
+-+}
+-+
+-+// MarkETANotified menandai PO sudah diberi notifikasi ETA; false jika sudah ditandai proses lain.
+-+func (s *Store) MarkETANotified(ctx context.Context, id uuid.UUID, at time.Time) (bool, error) {
+-+	n, err := s.q(ctx).MarkPurchaseOrderETANotified(ctx, sqlcgen.MarkPurchaseOrderETANotifiedParams{At: &at, ID: id})
+-+	if err != nil {
+-+		return false, fmt.Errorf("mark purchase order eta notified: %w", err)
+-+	}
+-+	return n == 1, nil
+-+}
+-+
+-+// --- Uang muka ----------------------------------------------------------------------------------
+-+
+-+// AdvanceFilter adalah kriteria daftar uang muka.
+-+type AdvanceFilter struct {
+-+	Status          domain.Status
+-+	PurchaseOrderID *uuid.UUID
+-+	SupplierID      *uuid.UUID
+-+	DateFrom        *clock.BusinessDate
+-+	DateTo          *clock.BusinessDate
+-+	Search          string
+-+}
+-+
+-+func toAdvance(r sqlcgen.ListPurchaseAdvancesRow) domain.Advance {
+-+	return domain.Advance{
+-+		ID: r.ID, Number: r.Number.String, PurchaseOrderID: r.PurchaseOrderID, OrderNumber: r.OrderNumber.String,
+-+		SupplierID: r.SupplierID, SupplierName: r.SupplierName, DivisionID: r.DivisionID, Amount: amount(r.Amount),
+-+		PaymentDate: r.PaymentDate, BankAccountCode: r.BankAccountCode, Note: r.Note, Applied: amount(r.AppliedAmount),
+-+		Status: domain.Status(r.Status), JournalEntryID: uuidPtr(r.JournalEntryID),
+-+		ReversalJournalEntryID: uuidPtr(r.ReversalJournalEntryID), CancelReason: r.CancelReason, PostedAt: r.PostedAt,
+-+		CreatedBy: r.CreatedBy, CreatedAt: r.CreatedAt, UpdatedAt: r.UpdatedAt, Version: int(r.Version),
+-+	}
+-+}
+-+
+-+// ListAdvances mengembalikan satu halaman uang muka.
+-+func (s *Store) ListAdvances(ctx context.Context, f AdvanceFilter, page paging.Page) (paging.Result[domain.Advance], error) {
+-+	status, search := text(string(f.Status)), text(f.Search)
+-+	rows, err := s.q(ctx).ListPurchaseAdvances(ctx, sqlcgen.ListPurchaseAdvancesParams{
+-+		Status: status, PurchaseOrderID: nullUUID(f.PurchaseOrderID), SupplierID: nullUUID(f.SupplierID),
+-+		DateFrom: pgDate(f.DateFrom), DateTo: pgDate(f.DateTo), Search: search, RowLimit: page.Limit(), RowOffset: page.Offset(),
+-+	})
+-+	if err != nil {
+-+		return paging.Result[domain.Advance]{}, fmt.Errorf("list purchase advances: %w", err)
+-+	}
+-+	total, err := s.q(ctx).CountPurchaseAdvances(ctx, sqlcgen.CountPurchaseAdvancesParams{
+-+		Status: status, PurchaseOrderID: nullUUID(f.PurchaseOrderID), SupplierID: nullUUID(f.SupplierID),
+-+		DateFrom: pgDate(f.DateFrom), DateTo: pgDate(f.DateTo), Search: search,
+-+	})
+-+	if err != nil {
+-+		return paging.Result[domain.Advance]{}, fmt.Errorf("count purchase advances: %w", err)
+-+	}
+-+	items := make([]domain.Advance, len(rows))
+-+	for i, r := range rows {
+-+		items[i] = toAdvance(r)
+-+	}
+-+	return paging.Result[domain.Advance]{Items: items, Page: page, Total: total}, nil
+-+}
+-+
+-+// GetAdvance membaca uang muka; forUpdate mengunci barisnya lebih dulu.
+-+func (s *Store) GetAdvance(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.Advance, error) {
+-+	if forUpdate {
+-+		if _, err := s.q(ctx).LockPurchaseAdvance(ctx, id); err != nil {
+-+			return domain.Advance{}, notFound(err, "lock purchase advance")
+-+		}
+-+	}
+-+	r, err := s.q(ctx).GetPurchaseAdvance(ctx, id)
+-+	if err != nil {
+-+		return domain.Advance{}, notFound(err, "get purchase advance")
+-+	}
+-+	return toAdvance(sqlcgen.ListPurchaseAdvancesRow(r)), nil
+-+}
+-+
+-+// AdvancesByOrder mengembalikan semua uang muka satu PO, urut tanggal bayar.
+-+func (s *Store) AdvancesByOrder(ctx context.Context, orderID uuid.UUID) ([]domain.Advance, error) {
+-+	rows, err := s.q(ctx).ListAdvancesByOrder(ctx, orderID)
+-+	if err != nil {
+-+		return nil, fmt.Errorf("list advances by order: %w", err)
+-+	}
+-+	out := make([]domain.Advance, len(rows))
+-+	for i, r := range rows {
+-+		out[i] = toAdvance(sqlcgen.ListPurchaseAdvancesRow(r))
+-+	}
+-+	return out, nil
+-+}
+-+
+-+// InsertAdvance menyimpan draft uang muka baru.
+-+func (s *Store) InsertAdvance(ctx context.Context, a domain.Advance, actorID uuid.UUID) (uuid.UUID, error) {
+-+	id, err := s.q(ctx).InsertPurchaseAdvance(ctx, sqlcgen.InsertPurchaseAdvanceParams{
+-+		PurchaseOrderID: a.PurchaseOrderID, SupplierID: a.SupplierID, DivisionID: a.DivisionID, Amount: a.Amount.Decimal(),
+-+		PaymentDate: a.PaymentDate, BankAccountCode: a.BankAccountCode, Note: a.Note, ActorID: actorID,
+-+	})
+-+	if err != nil {
+-+		return uuid.Nil, fmt.Errorf("insert purchase advance: %w", err)
+-+	}
+-+	return id, nil
+-+}
+-+
+-+// SaveAdvance menyimpan uang muka dengan optimistic locking.
+-+func (s *Store) SaveAdvance(ctx context.Context, a domain.Advance, version int, actorID uuid.UUID) error {
+-+	n, err := s.q(ctx).UpdatePurchaseAdvance(ctx, sqlcgen.UpdatePurchaseAdvanceParams{
+-+		Number: text(a.Number), Amount: a.Amount.Decimal(), PaymentDate: a.PaymentDate, BankAccountCode: a.BankAccountCode,
+-+		Note: a.Note, AppliedAmount: a.Applied.Decimal(), Status: string(a.Status), JournalEntryID: nullUUID(a.JournalEntryID),
+-+		ReversalJournalEntryID: nullUUID(a.ReversalJournalEntryID), CancelReason: a.CancelReason, PostedAt: a.PostedAt,
+-+		ActorID: actorID, ID: a.ID, Version: int32Of(version),
+-+	})
+-+	if err != nil {
+-+		return fmt.Errorf("update purchase advance: %w", err)
+-+	}
+-+	if n == 0 {
+-+		return apperr.New(apperr.CodeVersionConflict)
+-+	}
+-+	return nil
+-+}
+-diff --git a/backend/internal/procurement/procurement.go b/backend/internal/procurement/procurement.go
+-new file mode 100644
+-index 0000000..67f1a6c
+---- /dev/null
+-+++ b/backend/internal/procurement/procurement.go
+-@@ -0,0 +1,237 @@
+-+// Package procurement adalah API publik modul pengadaan R1.2: Purchase Request, Purchase Order (barang/packaging,
+-+// jasa maklon per batch, reprocess) dengan approval berjenjang, notifikasi ETA H-1, dan uang muka pembelian A-19
+-+// (BRD 5.2, 5.3; PRD F1-201 – F1-203). Fungsi untuk Penerimaan Barang dan Tagihan Pemasok berjalan di transaksi
+-+// pemanggil dan tidak memeriksa permission (pemanggil memeriksa aksi user-nya).
+-+package procurement
+-+
+-+import (
+-+	"context"
+-+	"log/slog"
+-+
+-+	"github.com/go-chi/chi/v5"
+-+	"github.com/google/uuid"
+-+	"github.com/jackc/pgx/v5/pgxpool"
+-+	"github.com/riverqueue/river"
+-+
+-+	"balans/internal/approval"
+-+	"balans/internal/audit"
+-+	"balans/internal/platform/clock"
+-+	"balans/internal/platform/db"
+-+	"balans/internal/platform/httpx"
+-+	"balans/internal/platform/jobqueue"
+-+	"balans/internal/platform/money"
+-+	"balans/internal/procurement/domain"
+-+	procurementhttp "balans/internal/procurement/http"
+-+	"balans/internal/procurement/postgres"
+-+	"balans/internal/procurement/service"
+-+)
+-+
+-+// Name adalah nama modul di ENABLED_MODULES.
+-+const Name = "procurement"
+-+
+-+type (
+-+	// PurchaseOrder adalah PO beserta baris (qty dipesan/diterima/ditagih) dan bahan maklon.
+-+	PurchaseOrder = domain.PurchaseOrder
+-+	// OrderLine adalah baris PO.
+-+	OrderLine = domain.OrderLine
+-+	// OrderMaterial adalah packaging/material GM yang direncanakan dipakai maklon.
+-+	OrderMaterial = domain.OrderMaterial
+-+	// OrderType adalah jenis PO.
+-+	OrderType = domain.OrderType
+-+	// Status adalah status dokumen pengadaan.
+-+	Status = domain.Status
+-+	// QtyDelta adalah perubahan qty per baris PO (negatif untuk pembatalan dokumen).
+-+	QtyDelta = domain.QtyDelta
+-+	// Advance adalah uang muka pembelian.
+-+	Advance = domain.Advance
+-+	// AdvanceApplication adalah potongan satu uang muka oleh tagihan pemasok.
+-+	AdvanceApplication = service.AdvanceApplication
+-+
+-+	// Catalog, Suppliers, Locations, Ledger, Approvals, Numberer, Users, Notifier diisi adapter saat wiring.
+-+	Catalog   = service.Catalog
+-+	Suppliers = service.Suppliers
+-+	Locations = service.Locations
+-+	Ledger    = service.Ledger
+-+	Approvals = service.Approvals
+-+	Numberer  = service.Numberer
+-+	Users     = service.Users
+-+	Notifier  = service.Notifier
+-+	// ProductRef, SupplierRef, LocationRef, UserRef, Option adalah data rujukan dari modul lain.
+-+	ProductRef   = service.ProductRef
+-+	SupplierRef  = service.SupplierRef
+-+	LocationRef  = service.LocationRef
+-+	UserRef      = service.UserRef
+-+	Option       = service.Option
+-+	DocumentType = service.DocumentType
+-+)
+-+
+-+// Jenis PO, status, jenis nomor dokumen, dan permission.
+-+const (
+-+	OrderGoods             = domain.OrderGoods
+-+	OrderPackaging         = domain.OrderPackaging
+-+	OrderTollManufacturing = domain.OrderTollManufacturing
+-+	OrderReprocess         = domain.OrderReprocess
+-+	OrderOther             = domain.OrderOther
+-+
+-+	StatusApproved          = domain.StatusApproved
+-+	StatusPartiallyReceived = domain.StatusPartiallyReceived
+-+	StatusReceived          = domain.StatusReceived
+-+	StatusCompleted         = domain.StatusCompleted
+-+	StatusClosed            = domain.StatusClosed
+-+
+-+	DocPurchaseRequest = service.DocPurchaseRequest
+-+	DocPurchaseOrder   = service.DocPurchaseOrder
+-+	DocPayment         = service.DocPayment
+-+
+-+	PermRequestRead = service.PermRequestRead
+-+	PermOrderRead   = service.PermOrderRead
+-+	PermAdvanceRead = service.PermAdvanceRead
+-+
+-+	// SourcePurchaseAdvance adalah source_type jurnal A-19 uang muka.
+-+	SourcePurchaseAdvance = service.SourcePurchaseAdvance
+-+)
+-+
+-+// Deps adalah dependensi modul.
+-+type Deps struct {
+-+	Pool      *pgxpool.Pool
+-+	Tx        *db.TxManager
+-+	Clock     clock.Clock
+-+	Log       *slog.Logger
+-+	Responder *httpx.Responder
+-+	Audit     audit.Recorder
+-+	Catalog   Catalog
+-+	Suppliers Suppliers
+-+	Locations Locations
+-+	Ledger    Ledger
+-+	Approvals Approvals
+-+	Numberer  Numberer
+-+	Users     Users
+-+	Notifier  Notifier
+-+	BaseURL   string
+-+}
+-+
+-+// Module adalah modul procurement.
+-+type Module struct {
+-+	svc *service.Service
+-+	rs  *httpx.Responder
+-+	h   *procurementhttp.ProcurementHandler
+-+}
+-+
+-+// New menyusun modul.
+-+func New(d Deps) *Module {
+-+	svc := service.New(service.Deps{
+-+		Store: postgres.NewStore(d.Pool), Tx: d.Tx, Audit: d.Audit, Clock: d.Clock, Log: d.Log, Catalog: d.Catalog,
+-+		Suppliers: d.Suppliers, Locations: d.Locations, Ledger: d.Ledger, Approvals: d.Approvals, Numberer: d.Numberer,
+-+		Users: d.Users, Notifier: d.Notifier, BaseURL: d.BaseURL,
+-+	})
+-+	return &Module{svc: svc, rs: d.Responder, h: procurementhttp.NewHandler(svc)}
+-+}
+-+
+-+// Name mengembalikan nama modul.
+-+func (m *Module) Name() string { return Name }
+-+
+-+// RegisterRoutes mendaftarkan route PR, PO, dan uang muka.
+-+func (m *Module) RegisterRoutes(r chi.Router) { procurementhttp.Register(r, m.h, m.rs) }
+-+
+-+// RegisterWorkers mendaftarkan worker notifikasi ETA.
+-+func (m *Module) RegisterWorkers(w *river.Workers) {
+-+	river.AddWorker(w, service.NewNotifyETAWorker(m.svc))
+-+}
+-+
+-+// PeriodicJobs menjadwalkan procurement.notify_eta harian 07.00 WIB: PO yang tiba besok diberitahukan ke
+-+// Logistik Leader (S-202, Desain Alur Lintas Modul 1).
+-+func (m *Module) PeriodicJobs() []*river.PeriodicJob {
+-+	return []*river.PeriodicJob{
+-+		river.NewPeriodicJob(jobqueue.DailyAt{Hour: 7},
+-+			func() (river.JobArgs, *river.InsertOpts) { return service.NotifyETAArgs{}, nil },
+-+			&river.PeriodicJobOpts{ID: service.NotifyETAArgs{}.Kind()}),
+-+	}
+-+}
+-+
+-+// AuditEntities memetakan jenis entitas audit trail ke permission baca untuk tab Riwayat (audit.RegisterEntity).
+-+func AuditEntities() map[string]string {
+-+	return map[string]string{
+-+		service.EntityPurchaseRequest: service.PermRequestRead,
+-+		service.EntityPurchaseOrder:   service.PermOrderRead,
+-+		service.EntityPurchaseAdvance: service.PermAdvanceRead,
+-+	}
+-+}
+-+
+-+// ApprovalRegistrar adalah bagian modul approval yang dipakai saat wiring.
+-+type ApprovalRegistrar interface {
+-+	RegisterHandler(t approval.SubjectType, readPermission string, h approval.Handler)
+-+}
+-+
+-+// RegisterApprovalHandlers mendaftarkan handler keputusan approval `purchase_request` dan `purchase_order`.
+-+// Dipanggil SETELAH handler dev agar menggantikannya.
+-+func (m *Module) RegisterApprovalHandlers(r ApprovalRegistrar) {
+-+	r.RegisterHandler(approval.SubjectPurchaseRequest, service.PermRequestRead, approval.Handler{
+-+		OnApproved: m.svc.OnRequestApproved, OnRejected: m.svc.OnRequestRejected,
+-+	})
+-+	r.RegisterHandler(approval.SubjectPurchaseOrder, service.PermOrderRead, approval.Handler{
+-+		OnApproved: m.svc.OnOrderApproved, OnRejected: m.svc.OnOrderRejected,
+-+	})
+-+}
+-+
+-+// NotifyETA menjalankan notifikasi ETA H-1 satu kali (dipakai worker dan test).
+-+func (m *Module) NotifyETA(ctx context.Context) (int, error) { return m.svc.NotifyETA(ctx) }
+-+
+-+// --- API untuk Penerimaan Barang (S-206, S-207) -----------------------------------------------
+-+
+-+// ReceivableOrder mengembalikan PO yang bisa diterima (Disetujui/Diterima Sebagian) beserta baris (OutstandingQty
+-+// per baris), bahan maklon (Materials), lokasi maklon (TollLocationID), dan lokasi asal bahan. Ditolak
+-+// INVALID_STATE_TRANSITION bila PO belum disetujui, sudah diterima penuh, ditutup, atau dibatalkan.
+-+func (m *Module) ReceivableOrder(ctx context.Context, orderID uuid.UUID) (PurchaseOrder, error) {
+-+	return m.svc.ReceivableOrder(ctx, orderID)
+-+}
+-+
+-+// RecordReceipt mencatat qty diterima per baris PO di transaksi aktif (qty negatif saat Penerimaan Barang
+-+// dibatalkan) dan mengubah status PO menjadi Diterima Sebagian/Diterima. Toleransi qty 0%: qty diterima melebihi
+-+// qty PO ditolak VALIDATION_FAILED. receiptLabel (nomor GR) dicatat di audit trail PO.
+-+func (m *Module) RecordReceipt(ctx context.Context, orderID uuid.UUID, receiptLabel string, lines []QtyDelta) (PurchaseOrder, error) {
+-+	return m.svc.RecordReceipt(ctx, orderID, receiptLabel, lines)
+-+}
+-+
+-+// --- API untuk Tagihan Pemasok (S-208) --------------------------------------------------------
+-+
+-+// Order membaca PO beserta baris tanpa memeriksa permission (3-way match tagihan).
+-+func (m *Module) Order(ctx context.Context, orderID uuid.UUID) (PurchaseOrder, error) {
+-+	return m.svc.Order(ctx, orderID)
+-+}
+-+
+-+// RecordBilling mencatat qty yang ditagih per baris PO di transaksi aktif (negatif saat tagihan dibatalkan);
+-+// PO Diterima yang tertagih penuh menjadi Selesai. Qty ditagih tidak boleh melebihi qty diterima.
+-+func (m *Module) RecordBilling(ctx context.Context, orderID uuid.UUID, billLabel string, lines []QtyDelta) (PurchaseOrder, error) {
+-+	return m.svc.RecordBilling(ctx, orderID, billLabel, lines)
+-+}
+-+
+-+// OutstandingAdvances mengembalikan uang muka Diposting PO yang masih punya sisa (Advance.Outstanding), urut
+-+// tanggal bayar.
+-+func (m *Module) OutstandingAdvances(ctx context.Context, orderID uuid.UUID) ([]Advance, error) {
+-+	return m.svc.OutstandingAdvances(ctx, orderID)
+-+}
+-+
+-+// OutstandingAdvanceAmount menjumlah sisa uang muka PO yang akan dipotong otomatis dari tagihan.
+-+func (m *Module) OutstandingAdvanceAmount(ctx context.Context, orderID uuid.UUID) (money.Amount, error) {
+-+	list, err := m.svc.OutstandingAdvances(ctx, orderID)
+-+	if err != nil {
+-+		return money.Zero, err
+-+	}
+-+	total := money.Zero
+-+	for _, a := range list {
+-+		total = total.Add(a.Outstanding())
+-+	}
+-+	return total, nil
+-+}
+-+
+-+// ApplyAdvances memotong sisa uang muka PO sebesar maksimal amount (FIFO tanggal bayar) di transaksi aktif dan
+-+// mengembalikan rinciannya. Tagihan pemasok memposting A-19 `advance_applied` (Dr 2101 / Cr 1401) sebesar total
+-+// potongan dan menyimpan rincian untuk ReleaseAdvances.
+-+func (m *Module) ApplyAdvances(ctx context.Context, orderID uuid.UUID, amount money.Amount) ([]AdvanceApplication, error) {
+-+	return m.svc.ApplyAdvances(ctx, orderID, amount)
+-+}
+-+
+-+// ReleaseAdvances mengembalikan potongan uang muka saat tagihan pemasok dibatalkan.
+-+func (m *Module) ReleaseAdvances(ctx context.Context, applications []AdvanceApplication) error {
+-+	return m.svc.ReleaseAdvances(ctx, applications)
+-+}
