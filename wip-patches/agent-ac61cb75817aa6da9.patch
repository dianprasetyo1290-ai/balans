+    disposal_proceeds_amount = $19, disposal_account_id = $20,
+    disposal_reason = $21, disposal_journal_id = $22,
+    note = $23, updated_at = now(), updated_by = $24, version = version + 1
+WHERE id = $25 AND version = $26 AND deleted_at IS NULL
+`
