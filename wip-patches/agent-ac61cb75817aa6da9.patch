+func (s *Store) RefreshDepreciationRunTotals(ctx context.Context, id uuid.UUID) error {
+	if err := s.q(ctx).RefreshDepreciationRunTotals(ctx, id); err != nil {
+		return fmt.Errorf("refresh depreciation run: %w", err)
+	}
+	return nil
