+func lineAmounts(e domain.Entry) map[string]string {
+	out := map[string]string{}
+	for _, l := range e.Lines {
+		if l.Debit.IsPositive() {
+			out["D"+l.AccountCode] = l.Debit.String()
+		} else {
+			out["C"+l.AccountCode] = l.Credit.String()
+		}
+	}
+	return out
+}
