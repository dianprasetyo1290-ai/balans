+-+import {
+-+  Dialog,
+-+  DialogContent,
+-+  DialogDescription,
+-+  DialogFooter,
+-+  DialogHeader,
+-+  DialogTitle,
+-+} from "@/components/ui/dialog"
+-+import {
+-+  Field,
+-+  FieldDescription,
+-+  FieldError,
+-+  FieldGroup,
+-+  FieldLabel,
+-+} from "@/components/ui/field"
+-+import { Input } from "@/components/ui/input"
+-+import {
+-+  Select,
+-+  SelectContent,
+-+  SelectItem,
+-+  SelectTrigger,
+-+  SelectValue,
+-+} from "@/components/ui/select"
+-+import { Textarea } from "@/components/ui/textarea"
+-+import { Checkbox } from "@/features/accounting/components/account-form-dialog"
+-+import { partnerOptionsQuery } from "@/features/party/api/party-api"
+-+import {
+-+  ChoiceField,
+-+  fieldError,
+-+  handleFormProblem,
+-+  type FieldErrors,
+-+} from "@/features/party/components/form-parts"
+-+import { parseProblem } from "@/lib/api/problem"
+-+import { useIdempotentMutation } from "@/lib/api/use-idempotent-mutation"
+-+
+-+import {
+-+  BASIS_LABELS,
+-+  CREATABLE_PRICE_LIST_TYPES,
+-+  PRICE_LIST_TYPE_LABELS,
+-+  createPriceList,
+-+  priceListOptionsQuery,
+-+  updatePriceList,
+-+  type PriceListBasis,
+-+  type PriceListDetail,
+-+  type PriceListInput,
+-+  type PriceListType,
+-+} from "../api/pricing-api"
