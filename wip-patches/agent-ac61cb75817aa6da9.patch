+-+}
+-+
+-+func (s *Store) insertItems(ctx context.Context, versionID uuid.UUID, items []domain.PriceListItem, actorID uuid.UUID) error {
+-+	if len(items) == 0 {
+-+		return nil
+-+	}
+-+	ids := make([]uuid.UUID, len(items))
+-+	prices := make([]string, len(items))
+-+	het := make([]string, len(items))
+-+	for i, it := range items {
+-+		ids[i], prices[i], het[i] = it.ProductID, it.Price.String(), amountText(it.MaxRetailPrice)
+-+	}
+-+	err := s.q(ctx).InsertVersionItems(ctx, sqlcgen.InsertVersionItemsParams{
+-+		VersionID: versionID, ActorID: actorID, ProductIds: ids, Prices: prices, MaxRetailPrices: het,
+-+	})
+-+	if err != nil {
+-+		return mapWriteError(err, "insert version items")
+-+	}
+-+	return nil
+-+}
+-+
+-+// InsertVersion menyimpan versi baru beserta itemnya.
+-+func (s *Store) InsertVersion(ctx context.Context, v domain.PriceListVersion, actorID uuid.UUID) (domain.PriceListVersion, error) {
+-+	r, err := s.q(ctx).InsertVersion(ctx, sqlcgen.InsertVersionParams{
+-+		PriceListID: v.PriceListID, VersionNo: int32(v.No), ValidFrom: v.ValidFrom, ValidTo: toPgDate(v.ValidTo), //nolint:gosec // nomor versi kecil
+-+		Status: string(v.Status), Percent: nullDecimal(v.Percent), Notes: v.Notes, ActorID: actorID,
+-+	})
+-+	if err != nil {
+-+		return domain.PriceListVersion{}, mapWriteError(err, "insert price list version")
+-+	}
+-+	if err := s.insertItems(ctx, r.ID, v.Items, actorID); err != nil {
+-+		return domain.PriceListVersion{}, err
+-+	}
+-+	out := toVersion(r, len(v.Items))
+-+	out.Items = v.Items
+-+	return out, nil
+-+}
+-+
+-+// UpdateVersion menyimpan perubahan versi dengan optimistic locking; replaceItems mengganti seluruh item.
+-+func (s *Store) UpdateVersion(ctx context.Context, v domain.PriceListVersion, version int, actorID uuid.UUID, replaceItems bool) (domain.PriceListVersion, error) {
+-+	r, err := s.q(ctx).UpdateVersion(ctx, sqlcgen.UpdateVersionParams{
+-+		ValidFrom: v.ValidFrom, ValidTo: toPgDate(v.ValidTo), Status: string(v.Status), Percent: nullDecimal(v.Percent),
+-+		Notes: v.Notes, SubmittedAt: v.SubmittedAt, SubmittedBy: nullUUID(v.SubmittedBy), DecidedAt: v.DecidedAt,
+-+		DecidedBy: nullUUID(v.DecidedBy), ActorID: actorID, ID: v.ID, Version: version32(version),
+-+	})
+-+	if err != nil {
+-+		return domain.PriceListVersion{}, versionConflict(err, "update price list version")
+-+	}
+-+	if replaceItems {
+-+		if err := s.q(ctx).DeleteVersionItems(ctx, v.ID); err != nil {
+-+			return domain.PriceListVersion{}, fmt.Errorf("delete version items: %w", err)
+-+		}
+-+		if err := s.insertItems(ctx, v.ID, v.Items, actorID); err != nil {
+-+			return domain.PriceListVersion{}, err
+-+		}
+-+	}
+-+	out := toVersion(r, len(v.Items))
+-+	out.Items = v.Items
+-+	return out, nil
+-+}
+-+
+-+// VersionPrice adalah harga produk dari versi aktif satu daftar harga pada satu tanggal.
+-+type VersionPrice struct {
+-+	VersionID uuid.UUID
+-+	// Percent terisi untuk daftar basis percent.
+-+	Percent *decimal.Decimal
+-+	// Price nil bila produk tidak ada di versi.
+-+	Price          *money.Amount
+-+	MaxRetailPrice *money.Amount
+-+}
+-+
+-+// ListPriceOn membaca harga produk dari versi aktif daftar harga pada tanggal; ok=false bila tidak ada versi aktif.
+-+func (s *Store) ListPriceOn(ctx context.Context, priceListID, productID uuid.UUID, on clock.BusinessDate) (VersionPrice, bool, error) {
+-+	r, err := s.q(ctx).ListPriceOn(ctx, sqlcgen.ListPriceOnParams{ProductID: productID, PriceListID: priceListID, OnDate: on})
+-+	if errors.Is(err, pgx.ErrNoRows) {
+-+		return VersionPrice{}, false, nil
+-+	}
+-+	if err != nil {
+-+		return VersionPrice{}, false, fmt.Errorf("list price on: %w", err)
+-+	}
+-+	return VersionPrice{
+-+		VersionID: r.VersionID, Percent: decimalPtr(r.Percent), Price: amountPtr(r.PriceAmount),
+-+		MaxRetailPrice: amountPtr(r.MaxRetailPriceAmount),
+-+	}, true, nil
+-+}
+-diff --git a/backend/internal/pricing/postgres/queries/price_lists.sql b/backend/internal/pricing/postgres/queries/price_lists.sql
+-new file mode 100644
+-index 0000000..4748547
+---- /dev/null
+-+++ b/backend/internal/pricing/postgres/queries/price_lists.sql
+-@@ -0,0 +1,121 @@
+-+-- name: ListPriceLists :many
+-+SELECT * FROM price_lists
+-+WHERE (deleted_at IS NOT NULL) = sqlc.arg('deleted')::boolean
+-+  AND (sqlc.arg('include_inactive')::boolean OR is_active)
+-+  AND (sqlc.narg('price_list_type')::text IS NULL OR price_list_type = sqlc.narg('price_list_type'))
+-+  AND (sqlc.narg('q')::text IS NULL OR code ILIKE '%' || sqlc.narg('q') || '%' OR name ILIKE '%' || sqlc.narg('q') || '%')
+-+ORDER BY (price_list_type <> 'base'), code;
+-+
+-+-- name: GetPriceList :one
+-+SELECT * FROM price_lists WHERE id = $1;
+-+
+-+-- name: GetPriceListForUpdate :one
+-+SELECT * FROM price_lists WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: GetPriceListsByIDs :many
+-+SELECT * FROM price_lists WHERE id = ANY(sqlc.arg('ids')::uuid[]);
+-+
+-+-- name: GetBasePriceList :one
+-+SELECT * FROM price_lists WHERE price_list_type = 'base' AND deleted_at IS NULL;
+-+
+-+-- name: InsertPriceList :one
+-+INSERT INTO price_lists (
+-+    code, name, price_list_type, channel_id, sub_channel_id, partner_id, reseller_level, basis,
+-+    reference_price_list_id, description, is_active, created_by, updated_by)
+-+VALUES (
+-+    sqlc.arg('code'), sqlc.arg('name'), sqlc.arg('price_list_type'), sqlc.narg('channel_id'), sqlc.narg('sub_channel_id'),
+-+    sqlc.narg('partner_id'), sqlc.arg('reseller_level'), sqlc.arg('basis'), sqlc.narg('reference_price_list_id'),
+-+    sqlc.arg('description'), sqlc.arg('is_active'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdatePriceList :one
+-+UPDATE price_lists
+-+SET name = sqlc.arg('name'), channel_id = sqlc.narg('channel_id'), sub_channel_id = sqlc.narg('sub_channel_id'),
+-+    partner_id = sqlc.narg('partner_id'), reseller_level = sqlc.arg('reseller_level'), basis = sqlc.arg('basis'),
+-+    reference_price_list_id = sqlc.narg('reference_price_list_id'), description = sqlc.arg('description'),
+-+    is_active = sqlc.arg('is_active'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: SetPriceListDeleted :one
+-+UPDATE price_lists
+-+SET deleted_at = sqlc.narg('deleted_at'), deleted_by = sqlc.narg('deleted_by'), updated_at = now(),
+-+    updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: CountPriceListReferences :one
+-+SELECT count(*)::int FROM price_lists
+-+WHERE reference_price_list_id = sqlc.arg('id') AND deleted_at IS NULL;
+-+
+-+-- name: FindScopePriceLists :many
+-+-- Daftar harga aktif yang mungkin berlaku untuk transaksi: karyawan, mitra, dan channel/sub-channel.
+-+SELECT * FROM price_lists
+-+WHERE deleted_at IS NULL AND is_active AND (
+-+    price_list_type = 'employee'
+-+    OR (price_list_type = 'partner' AND partner_id = sqlc.narg('partner_id'))
+-+    OR (price_list_type IN ('channel', 'vending') AND channel_id = sqlc.narg('channel_id')
+-+        AND (sub_channel_id IS NULL OR sub_channel_id = sqlc.narg('sub_channel_id'))));
+-+
+-+-- name: ListVersions :many
+-+SELECT v.*, (SELECT count(*) FROM price_list_items i WHERE i.price_list_version_id = v.id)::int AS item_count
+-+FROM price_list_versions v
+-+WHERE v.price_list_id = $1
+-+ORDER BY v.version_no DESC;
+-+
+-+-- name: ListCurrentVersions :many
+-+-- Versi aktif dan versi yang sedang disiapkan/diajukan untuk beberapa daftar harga (ringkasan list).
+-+SELECT v.*, (SELECT count(*) FROM price_list_items i WHERE i.price_list_version_id = v.id)::int AS item_count
+-+FROM price_list_versions v
+-+WHERE v.price_list_id = ANY(sqlc.arg('ids')::uuid[]) AND v.status IN ('active', 'draft', 'pending_approval')
+-+ORDER BY v.price_list_id, v.version_no DESC;
+-+
+-+-- name: GetVersion :one
+-+SELECT * FROM price_list_versions WHERE id = $1;
+-+
+-+-- name: GetVersionForUpdate :one
+-+SELECT * FROM price_list_versions WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: NextVersionNo :one
+-+SELECT (coalesce(max(version_no), 0) + 1)::int FROM price_list_versions WHERE price_list_id = $1;
+-+
+-+-- name: ActiveVersionsForUpdate :many
+-+SELECT * FROM price_list_versions WHERE price_list_id = $1 AND status = 'active' ORDER BY valid_from FOR UPDATE;
+-+
+-+-- name: InsertVersion :one
+-+INSERT INTO price_list_versions (price_list_id, version_no, valid_from, valid_to, status, percent, notes, created_by, updated_by)
+-+VALUES (
+-+    sqlc.arg('price_list_id'), sqlc.arg('version_no'), sqlc.arg('valid_from'), sqlc.narg('valid_to'), sqlc.arg('status'),
+-+    sqlc.narg('percent'), sqlc.arg('notes'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdateVersion :one
+-+UPDATE price_list_versions
+-+SET valid_from = sqlc.arg('valid_from'), valid_to = sqlc.narg('valid_to'), status = sqlc.arg('status'),
+-+    percent = sqlc.narg('percent'), notes = sqlc.arg('notes'), submitted_at = sqlc.narg('submitted_at'),
+-+    submitted_by = sqlc.narg('submitted_by'), decided_at = sqlc.narg('decided_at'), decided_by = sqlc.narg('decided_by'),
+-+    updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: ListVersionItems :many
+-+SELECT * FROM price_list_items WHERE price_list_version_id = $1 ORDER BY created_at, id;
+-+
+-+-- name: DeleteVersionItems :exec
+-+DELETE FROM price_list_items WHERE price_list_version_id = $1;
+-+
+-+-- name: InsertVersionItems :exec
+-+INSERT INTO price_list_items (price_list_version_id, product_id, price_amount, max_retail_price_amount, created_by)
+-+SELECT sqlc.arg('version_id')::uuid, t.product_id, t.price_amount::numeric, NULLIF(t.max_retail, '')::numeric,
+-+    sqlc.arg('actor_id')::uuid
+-+FROM (
+-+    SELECT unnest(sqlc.arg('product_ids')::uuid[]) AS product_id, unnest(sqlc.arg('prices')::text[]) AS price_amount,
+-+        unnest(sqlc.arg('max_retail_prices')::text[]) AS max_retail) AS t;
+-+
+-+-- name: ListPriceOn :one
+-+-- Harga produk dari versi aktif daftar harga pada tanggal; price_amount kosong bila produk tidak ada di versi.
+-+SELECT v.id AS version_id, v.percent, i.price_amount, i.max_retail_price_amount
+-+FROM price_list_versions v
+-+LEFT JOIN price_list_items i ON i.price_list_version_id = v.id AND i.product_id = sqlc.arg('product_id')
+-+WHERE v.price_list_id = sqlc.arg('price_list_id') AND v.status = 'active'
+-+  AND v.valid_from <= sqlc.arg('on_date')::date AND (v.valid_to IS NULL OR v.valid_to >= sqlc.arg('on_date')::date);
+-diff --git a/backend/internal/pricing/postgres/queries/rules.sql b/backend/internal/pricing/postgres/queries/rules.sql
+-new file mode 100644
+-index 0000000..50fc02f
+---- /dev/null
+-+++ b/backend/internal/pricing/postgres/queries/rules.sql
+-@@ -0,0 +1,207 @@
+-+-- Harga khusus ----------------------------------------------------------------------------------
+-+
+-+-- name: ListSpecialPrices :many
+-+SELECT * FROM special_prices
+-+WHERE deleted_at IS NULL
+-+  AND (sqlc.narg('party_type')::text IS NULL OR party_type = sqlc.narg('party_type'))
+-+  AND (sqlc.narg('party_id')::uuid IS NULL OR party_id = sqlc.narg('party_id'))
+-+  AND (sqlc.narg('product_id')::uuid IS NULL OR product_id = sqlc.narg('product_id'))
+-+  AND (sqlc.arg('include_ended')::boolean OR valid_to IS NULL OR valid_to >= sqlc.arg('today')::date)
+-+ORDER BY party_type, party_id, product_id, valid_from DESC;
+-+
+-+-- name: GetSpecialPrice :one
+-+SELECT * FROM special_prices WHERE id = $1;
+-+
+-+-- name: GetSpecialPriceForUpdate :one
+-+SELECT * FROM special_prices WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: OverlappingSpecialPrices :many
+-+SELECT * FROM special_prices
+-+WHERE deleted_at IS NULL AND party_type = sqlc.arg('party_type') AND party_id = sqlc.arg('party_id')
+-+  AND product_id = sqlc.arg('product_id')
+-+  AND daterange(valid_from, valid_to, '[]') && daterange(sqlc.arg('valid_from')::date, sqlc.narg('valid_to')::date, '[]')
+-+FOR UPDATE;
+-+
+-+-- name: InsertSpecialPrice :one
+-+INSERT INTO special_prices (party_type, party_id, product_id, price_amount, valid_from, valid_to, notes, created_by, updated_by)
+-+VALUES (
+-+    sqlc.arg('party_type'), sqlc.arg('party_id'), sqlc.arg('product_id'), sqlc.arg('price_amount'), sqlc.arg('valid_from'),
+-+    sqlc.narg('valid_to'), sqlc.arg('notes'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdateSpecialPriceEnd :one
+-+UPDATE special_prices
+-+SET valid_to = sqlc.narg('valid_to'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: DeleteSpecialPrice :execrows
+-+UPDATE special_prices
+-+SET deleted_at = now(), deleted_by = sqlc.arg('actor_id')::uuid, updated_at = now(), updated_by = sqlc.arg('actor_id'),
+-+    version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version') AND deleted_at IS NULL;
+-+
+-+-- name: SpecialPriceOn :one
+-+SELECT * FROM special_prices
+-+WHERE deleted_at IS NULL AND party_type = sqlc.arg('party_type') AND party_id = sqlc.arg('party_id')
+-+  AND product_id = sqlc.arg('product_id')
+-+  AND valid_from <= sqlc.arg('on_date')::date AND (valid_to IS NULL OR valid_to >= sqlc.arg('on_date')::date);
+-+
+-+-- Promo ------------------------------------------------------------------------------------------
+-+
+-+-- name: ListPromotions :many
+-+SELECT * FROM promotions
+-+WHERE (deleted_at IS NOT NULL) = sqlc.arg('deleted')::boolean
+-+  AND (sqlc.arg('include_ended')::boolean OR valid_to >= sqlc.arg('today')::date)
+-+  AND (sqlc.narg('channel_id')::uuid IS NULL OR channel_id = sqlc.narg('channel_id'))
+-+  AND (sqlc.narg('q')::text IS NULL OR code ILIKE '%' || sqlc.narg('q') || '%' OR name ILIKE '%' || sqlc.narg('q') || '%')
+-+ORDER BY valid_from DESC, code;
+-+
+-+-- name: CountPromotionItems :many
+-+SELECT promotion_id, count(*)::int AS item_count FROM promotion_items
+-+WHERE promotion_id = ANY(sqlc.arg('ids')::uuid[])
+-+GROUP BY promotion_id;
+-+
+-+-- name: GetPromotion :one
+-+SELECT * FROM promotions WHERE id = $1;
+-+
+-+-- name: GetPromotionForUpdate :one
+-+SELECT * FROM promotions WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: InsertPromotion :one
+-+INSERT INTO promotions (code, name, channel_id, sub_channel_id, valid_from, valid_to, is_active, description, created_by, updated_by)
+-+VALUES (
+-+    sqlc.arg('code'), sqlc.arg('name'), sqlc.narg('channel_id'), sqlc.narg('sub_channel_id'), sqlc.arg('valid_from'),
+-+    sqlc.arg('valid_to'), sqlc.arg('is_active'), sqlc.arg('description'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdatePromotion :one
+-+UPDATE promotions
+-+SET name = sqlc.arg('name'), channel_id = sqlc.narg('channel_id'), sub_channel_id = sqlc.narg('sub_channel_id'),
+-+    valid_from = sqlc.arg('valid_from'), valid_to = sqlc.arg('valid_to'), is_active = sqlc.arg('is_active'),
+-+    description = sqlc.arg('description'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: DeletePromotion :execrows
+-+UPDATE promotions
+-+SET deleted_at = now(), deleted_by = sqlc.arg('actor_id')::uuid, updated_at = now(), updated_by = sqlc.arg('actor_id'),
+-+    version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version') AND deleted_at IS NULL;
+-+
+-+-- name: ListPromotionItems :many
+-+SELECT * FROM promotion_items WHERE promotion_id = $1 ORDER BY created_at, id;
+-+
+-+-- name: DeletePromotionItems :exec
+-+DELETE FROM promotion_items WHERE promotion_id = $1;
+-+
+-+-- name: InsertPromotionItems :exec
+-+INSERT INTO promotion_items (promotion_id, product_id, price_amount, discount_percent, created_by)
+-+SELECT sqlc.arg('promotion_id')::uuid, t.product_id, NULLIF(t.price_amount, '')::numeric, NULLIF(t.discount_percent, '')::numeric,
+-+    sqlc.arg('actor_id')::uuid
+-+FROM (
+-+    SELECT unnest(sqlc.arg('product_ids')::uuid[]) AS product_id, unnest(sqlc.arg('prices')::text[]) AS price_amount,
+-+        unnest(sqlc.arg('discount_percents')::text[]) AS discount_percent) AS t;
+-+
+-+-- name: PromotionOffersOn :many
+-+-- Item promo aktif untuk produk pada tanggal dan channel transaksi (promo tanpa channel berlaku semua channel).
+-+SELECT p.id AS promotion_id, p.code, p.name, i.price_amount, i.discount_percent
+-+FROM promotions p
+-+JOIN promotion_items i ON i.promotion_id = p.id
+-+WHERE p.deleted_at IS NULL AND p.is_active AND i.product_id = sqlc.arg('product_id')
+-+  AND p.valid_from <= sqlc.arg('on_date')::date AND p.valid_to >= sqlc.arg('on_date')::date
+-+  AND (p.channel_id IS NULL OR p.channel_id = sqlc.narg('channel_id'))
+-+  AND (p.sub_channel_id IS NULL OR p.sub_channel_id = sqlc.narg('sub_channel_id'))
+-+ORDER BY p.valid_from DESC, p.code;
+-+
+-+-- Harga bertingkat -------------------------------------------------------------------------------
+-+
+-+-- name: ListTieredPrices :many
+-+SELECT * FROM tiered_prices
+-+WHERE deleted_at IS NULL
+-+  AND (sqlc.narg('product_id')::uuid IS NULL OR product_id = sqlc.narg('product_id'))
+-+  AND (sqlc.narg('price_list_id')::uuid IS NULL OR price_list_id = sqlc.narg('price_list_id'))
+-+  AND (sqlc.arg('include_ended')::boolean OR valid_to IS NULL OR valid_to >= sqlc.arg('today')::date)
+-+ORDER BY product_id, price_list_id NULLS FIRST, min_qty, valid_from DESC;
+-+
+-+-- name: GetTieredPrice :one
+-+SELECT * FROM tiered_prices WHERE id = $1;
+-+
+-+-- name: GetTieredPriceForUpdate :one
+-+SELECT * FROM tiered_prices WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: OverlappingTieredPrices :many
+-+SELECT * FROM tiered_prices
+-+WHERE deleted_at IS NULL AND price_list_id IS NOT DISTINCT FROM sqlc.narg('price_list_id')::uuid
+-+  AND product_id = sqlc.arg('product_id') AND min_qty = sqlc.arg('min_qty')
+-+  AND daterange(valid_from, valid_to, '[]') && daterange(sqlc.arg('valid_from')::date, sqlc.narg('valid_to')::date, '[]')
+-+FOR UPDATE;
+-+
+-+-- name: InsertTieredPrice :one
+-+INSERT INTO tiered_prices (price_list_id, product_id, min_qty, price_amount, valid_from, valid_to, notes, created_by, updated_by)
+-+VALUES (
+-+    sqlc.narg('price_list_id'), sqlc.arg('product_id'), sqlc.arg('min_qty'), sqlc.arg('price_amount'), sqlc.arg('valid_from'),
+-+    sqlc.narg('valid_to'), sqlc.arg('notes'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdateTieredPriceEnd :one
+-+UPDATE tiered_prices
+-+SET valid_to = sqlc.narg('valid_to'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: DeleteTieredPrice :execrows
+-+UPDATE tiered_prices
+-+SET deleted_at = now(), deleted_by = sqlc.arg('actor_id')::uuid, updated_at = now(), updated_by = sqlc.arg('actor_id'),
+-+    version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version') AND deleted_at IS NULL;
+-+
+-+-- name: TieredPricesOn :many
+-+-- Harga bertingkat yang berlaku untuk qty dan tanggal: khusus daftar harga kandidat atau berlaku umum.
+-+SELECT * FROM tiered_prices
+-+WHERE deleted_at IS NULL AND product_id = sqlc.arg('product_id') AND min_qty <= sqlc.arg('qty')::numeric
+-+  AND (price_list_id IS NULL OR price_list_id = ANY(sqlc.arg('price_list_ids')::uuid[]))
+-+  AND valid_from <= sqlc.arg('on_date')::date AND (valid_to IS NULL OR valid_to >= sqlc.arg('on_date')::date)
+-+ORDER BY min_qty DESC;
+-+
+-+-- Batas diskon -----------------------------------------------------------------------------------
+-+
+-+-- name: ListDiscountLimits :many
+-+SELECT * FROM discount_limits
+-+WHERE deleted_at IS NULL
+-+  AND (sqlc.arg('include_ended')::boolean OR valid_to IS NULL OR valid_to >= sqlc.arg('today')::date)
+-+ORDER BY role_code, valid_from DESC;
+-+
+-+-- name: GetDiscountLimitForUpdate :one
+-+SELECT * FROM discount_limits WHERE id = $1 FOR UPDATE;
+-+
+-+-- name: OverlappingDiscountLimits :many
+-+SELECT * FROM discount_limits
+-+WHERE deleted_at IS NULL AND role_code = sqlc.arg('role_code')
+-+  AND daterange(valid_from, valid_to, '[]') && daterange(sqlc.arg('valid_from')::date, sqlc.narg('valid_to')::date, '[]')
+-+FOR UPDATE;
+-+
+-+-- name: InsertDiscountLimit :one
+-+INSERT INTO discount_limits (
+-+    role_code, max_line_discount_percent, max_document_discount_percent, valid_from, valid_to, notes, created_by, updated_by)
+-+VALUES (
+-+    sqlc.arg('role_code'), sqlc.arg('max_line_discount_percent'), sqlc.arg('max_document_discount_percent'),
+-+    sqlc.arg('valid_from'), sqlc.narg('valid_to'), sqlc.arg('notes'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+-+RETURNING *;
+-+
+-+-- name: UpdateDiscountLimitEnd :one
+-+UPDATE discount_limits
+-+SET valid_to = sqlc.narg('valid_to'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+-+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+-+RETURNING *;
+-+
+-+-- name: DeleteDiscountLimit :execrows
