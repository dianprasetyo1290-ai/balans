+-+			return nil, err
+-+		}
+-+		items = append(items, purchase_request_id)
+-+	}
+-+	if err := rows.Err(); err != nil {
+-+		return nil, err
+-+	}
+-+	return items, nil
+-+}
+-+
+-+const purchaseRequestLineOrders = `-- name: PurchaseRequestLineOrders :many
+-+SELECT l.purchase_request_line_id, l.ordered_qty, l.received_qty, o.status, o.id AS purchase_order_id, o.number
+-+FROM purchase_order_lines l
+-+JOIN purchase_orders o ON o.id = l.purchase_order_id
+-+JOIN purchase_request_lines r ON r.id = l.purchase_request_line_id
+-+WHERE r.purchase_request_id = $1
+-+`
+-+
+-+type PurchaseRequestLineOrdersRow struct {
+-+	PurchaseRequestLineID uuid.NullUUID
+-+	OrderedQty            decimal.Decimal
+-+	ReceivedQty           decimal.Decimal
+-+	Status                string
+-+	PurchaseOrderID       uuid.UUID
+-+	Number                pgtype.Text
+-+}
+-+
+-+// Baris PO yang menautkan baris PR beserta status PO, untuk menghitung qty yang sudah dijadikan PO.
+-+func (q *Queries) PurchaseRequestLineOrders(ctx context.Context, purchaseRequestID uuid.UUID) ([]PurchaseRequestLineOrdersRow, error) {
+-+	rows, err := q.db.Query(ctx, purchaseRequestLineOrders, purchaseRequestID)
+-+	if err != nil {
+-+		return nil, err
+-+	}
+-+	defer rows.Close()
+-+	var items []PurchaseRequestLineOrdersRow
+-+	for rows.Next() {
+-+		var i PurchaseRequestLineOrdersRow
+-+		if err := rows.Scan(
+-+			&i.PurchaseRequestLineID,
+-+			&i.OrderedQty,
+-+			&i.ReceivedQty,
+-+			&i.Status,
+-+			&i.PurchaseOrderID,
+-+			&i.Number,
+-+		); err != nil {
+-+			return nil, err
+-+		}
+-+		items = append(items, i)
+-+	}
+-+	if err := rows.Err(); err != nil {
+-+		return nil, err
+-+	}
+-+	return items, nil
+-+}
+-+
+-+const setPurchaseRequestLineFulfilled = `-- name: SetPurchaseRequestLineFulfilled :exec
+-+UPDATE purchase_request_lines SET fulfilled_qty = $1 WHERE id = $2
+-+`
+-+
+-+type SetPurchaseRequestLineFulfilledParams struct {
+-+	FulfilledQty decimal.Decimal
+-+	ID           uuid.UUID
+-+}
+-+
+-+func (q *Queries) SetPurchaseRequestLineFulfilled(ctx context.Context, arg SetPurchaseRequestLineFulfilledParams) error {
+-+	_, err := q.db.Exec(ctx, setPurchaseRequestLineFulfilled, arg.FulfilledQty, arg.ID)
+-+	return err
+-+}
+-+
+-+const updatePurchaseRequest = `-- name: UpdatePurchaseRequest :one
+-+UPDATE purchase_requests
+-+SET number = $1, division_id = $2, business_date = $3,
+-+    needed_date = $4, note = $5,
+-+    estimated_total_amount = $6, status = $7,
+-+    close_reason = $8, submitted_at = $9,
+-+    decided_at = $10, updated_at = now(), updated_by = $11, version = version + 1
+-+WHERE id = $12 AND version = $13
+-+RETURNING id, number, division_id, requested_by, business_date, needed_date, note, estimated_total_amount, status, close_reason, submitted_at, decided_at, created_at, created_by, updated_at, updated_by, version, deleted_at, deleted_by
+-+`
+-+
+-+type UpdatePurchaseRequestParams struct {
+-+	Number               pgtype.Text
+-+	DivisionID           uuid.UUID
+-+	BusinessDate         clock.BusinessDate
+-+	NeededDate           pgtype.Date
+-+	Note                 string
+-+	EstimatedTotalAmount decimal.Decimal
+-+	Status               string
+-+	CloseReason          string
+-+	SubmittedAt          *time.Time
+-+	DecidedAt            *time.Time
+-+	ActorID              uuid.UUID
+-+	ID                   uuid.UUID
+-+	Version              int32
+-+}
+-+
+-+func (q *Queries) UpdatePurchaseRequest(ctx context.Context, arg UpdatePurchaseRequestParams) (PurchaseRequest, error) {
+-+	row := q.db.QueryRow(ctx, updatePurchaseRequest,
+-+		arg.Number,
+-+		arg.DivisionID,
+-+		arg.BusinessDate,
+-+		arg.NeededDate,
+-+		arg.Note,
+-+		arg.EstimatedTotalAmount,
+-+		arg.Status,
+-+		arg.CloseReason,
+-+		arg.SubmittedAt,
+-+		arg.DecidedAt,
+-+		arg.ActorID,
+-+		arg.ID,
+-+		arg.Version,
+-+	)
+-+	var i PurchaseRequest
+-+	err := row.Scan(
+-+		&i.ID,
+-+		&i.Number,
+-+		&i.DivisionID,
+-+		&i.RequestedBy,
+-+		&i.BusinessDate,
+-+		&i.NeededDate,
+-+		&i.Note,
+-+		&i.EstimatedTotalAmount,
+-+		&i.Status,
+-+		&i.CloseReason,
+-+		&i.SubmittedAt,
+-+		&i.DecidedAt,
+-+		&i.CreatedAt,
+-+		&i.CreatedBy,
+-+		&i.UpdatedAt,
+-+		&i.UpdatedBy,
+-+		&i.Version,
+-+		&i.DeletedAt,
+-+		&i.DeletedBy,
+-+	)
+-+	return i, err
+-+}
+-diff --git a/backend/internal/procurement/postgres/store.go b/backend/internal/procurement/postgres/store.go
