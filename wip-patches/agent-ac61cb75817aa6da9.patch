+-		return remapFields(err, customerField)
+-	}
+-	if cur == nil {
+-		_, err = s.CreateCustomer(ctx, in)
+-	} else {
+-		_, err = s.UpdateCustomer(ctx, cur.ID, cur.Version, in)
+-	}
+-	if err != nil {
+-		return remapFields(err, customerField)
+-	}
+-	return nil
+-}
