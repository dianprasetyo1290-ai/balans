+-+	return actor.With(context.Background(), actor.Actor{UserID: h.actorID, FullName: "Penguji", Permissions: set})
+-+}
+-+
+-+func (h *harness) adminCtx() context.Context {
+-+	set := map[string]struct{}{}
+-+	for _, p := range allPerms {
+-+		set[p] = struct{}{}
