+-+
+-+/** Cakupan daftar harga: channel/sub-channel, mitra, atau acuan persentase. */
+-+export function scopeLabel(
+-+  l: Pick<
+-+    PriceList,
+-+    | "priceListType"
+-+    | "channelId"
+-+    | "subChannelId"
+-+    | "partnerName"
+-+    | "resellerLevel"
