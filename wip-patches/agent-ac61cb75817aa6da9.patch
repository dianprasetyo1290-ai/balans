+-+
+-+const updateTieredPriceEnd = `-- name: UpdateTieredPriceEnd :one
+-+UPDATE tiered_prices
+-+SET valid_to = $1, updated_at = now(), updated_by = $2, version = version + 1
+-+WHERE id = $3 AND version = $4
+-+RETURNING id, price_list_id, product_id, min_qty, price_amount, valid_from, valid_to, notes, created_at, created_by, updated_at, updated_by, version, deleted_at, deleted_by
+-+`
+-+
+-+type UpdateTieredPriceEndParams struct {
