-    .map((l) => {
-      const r = receipt?.lines.find((x) => x.purchaseOrderLineId === l.id)
-      return {
-        orderLineId: l.id,
-        goodQty: r?.goodQty ?? "",
-        rejectQty: r && Number(r.rejectQty) > 0 ? r.rejectQty : "",
