+-+		&i.Version,
+-+		&i.DeletedAt,
+-+		&i.DeletedBy,
+-+	)
+-+	return i, err
+-+}
+-+
+-+const updatePromotion = `-- name: UpdatePromotion :one
+-+UPDATE promotions
+-+SET name = $1, channel_id = $2, sub_channel_id = $3,
+-+    valid_from = $4, valid_to = $5, is_active = $6,
+-+    description = $7, updated_at = now(), updated_by = $8, version = version + 1
+-+WHERE id = $9 AND version = $10
+-+RETURNING id, code, name, channel_id, sub_channel_id, valid_from, valid_to, is_active, description, created_at, created_by, updated_at, updated_by, version, deleted_at, deleted_by
+-+`
+-+
+-+type UpdatePromotionParams struct {
