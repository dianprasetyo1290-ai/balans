+-+// DeleteTieredPrice operation middleware
+-+func (sh *strictHandler) DeleteTieredPrice(w http.ResponseWriter, r *http.Request, id Id, params DeleteTieredPriceParams) {
+-+	var request DeleteTieredPriceRequestObject
+-+
+-+	request.Id = id
+-+	request.Params = params
+-+
+-+	handler := func(ctx context.Context, w http.ResponseWriter, r *http.Request, request interface{}) (interface{}, error) {
+-+		return sh.ssi.DeleteTieredPrice(ctx, request.(DeleteTieredPriceRequestObject))
+-+	}
+-+	for _, middleware := range sh.middlewares {
+-+		handler = middleware(handler, "DeleteTieredPrice")
+-+	}
+-+
+-+	response, err := handler(r.Context(), w, r, request)
+-+
+-+	if err != nil {
+-+		sh.options.ResponseErrorHandlerFunc(w, r, err)
+-+	} else if validResponse, ok := response.(DeleteTieredPriceResponseObject); ok {
+-+		if err := validResponse.VisitDeleteTieredPriceResponse(w); err != nil {
+-+			sh.options.ResponseErrorHandlerFunc(w, r, err)
+-+		}
+-+	} else if response != nil {
+-+		sh.options.ResponseErrorHandlerFunc(w, r, fmt.Errorf("unexpected response type: %T", response))
+-+	}
+-+}
+-+
+-+// EndTieredPrice operation middleware
+-+func (sh *strictHandler) EndTieredPrice(w http.ResponseWriter, r *http.Request, id Id, params EndTieredPriceParams) {
+-+	var request EndTieredPriceRequestObject
+-+
+-+	request.Id = id
+-+	request.Params = params
+-+
+-+	var body EndTieredPriceJSONRequestBody
+-+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+-+		sh.options.RequestErrorHandlerFunc(w, r, fmt.Errorf("can't decode JSON body: %w", err))
+-+		return
+-+	}
+-+	request.Body = &body
+-+
+-+	handler := func(ctx context.Context, w http.ResponseWriter, r *http.Request, request interface{}) (interface{}, error) {
+-+		return sh.ssi.EndTieredPrice(ctx, request.(EndTieredPriceRequestObject))
+-+	}
