+-+    enabled: !!fromRequestId,
+-+  })
+-+  if (fromRequestId && request.isPending) {
+-+    return <LoadingArea loading>{null}</LoadingArea>
+-+  }
+-+  return <OrderForm initial={fromRequest(orderType, request.data)} />
+-+}
