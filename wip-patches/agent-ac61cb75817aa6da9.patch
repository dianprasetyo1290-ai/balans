+-+	ID           uuid.UUID
+-+	Version      int32
+-+}
+-+
+-+func (q *Queries) UpdatePromotion(ctx context.Context, arg UpdatePromotionParams) (Promotion, error) {
+-+	row := q.db.QueryRow(ctx, updatePromotion,
+-+		arg.Name,
+-+		arg.ChannelID,
+-+		arg.SubChannelID,
+-+		arg.ValidFrom,
+-+		arg.ValidTo,
+-+		arg.IsActive,
+-+		arg.Description,
+-+		arg.ActorID,
+-+		arg.ID,
+-+		arg.Version,
+-+	)
+-+	var i Promotion
+-+	err := row.Scan(
+-+		&i.ID,
+-+		&i.Code,
+-+		&i.Name,
+-+		&i.ChannelID,
+-+		&i.SubChannelID,
+-+		&i.ValidFrom,
+-+		&i.ValidTo,
