+-+		out.Advances[i] = toAdvance(ctx, a)
+-+	}
+-+	for _, a := range service.OrderActions(ctx, v.PurchaseOrder) {
+-+		out.AllowedActions = append(out.AllowedActions, PurchaseOrderAllowedActions(a))
+-+	}
+-+	return out
+-+}
