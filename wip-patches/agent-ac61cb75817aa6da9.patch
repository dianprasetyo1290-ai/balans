+	if err != nil {
+		return domain.FixedAsset{}, notFound(err, "get fixed asset by code")
+	}
+	return toFixedAsset(r.FixedAsset, r.ClassName), nil
+}
+
+// InsertFixedAsset menyimpan aset baru.
