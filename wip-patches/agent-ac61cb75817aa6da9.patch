+-+    case "employee":
+-+      return "Pelanggan berstatus karyawan aktif"
+-+    case "partner":
+-+      return l.partnerName ?? "—"
+-+    case "reseller":
+-+      return `Level ${l.resellerLevel}`
+-+    default:
+-+      return [channelName(l.channelId), channelName(l.subChannelId)]
+-+        .filter(Boolean)
+-+        .join(" › ")
