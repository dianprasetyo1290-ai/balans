-				Note: "Pembatalan pemakaian maklon " + r.Number,
-			})
-		}
-	}
-	if len(back) == 0 {
-		return nil
-	}
-	_, err := s.Stock.Post(ctx, inventory.Posting{
-		Source: inventory.Source{Type: SourceGoodsReceipt, ID: r.ID, Action: stockActionUnconsume, Label: r.Number, BusinessDate: date},
-		Lines:  back,
-	})
