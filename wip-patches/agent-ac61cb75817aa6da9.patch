+package domain
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+// Permission aset tetap (Desain Role & Approval 3.4): Finance RWP, Head F&A R + A.
+const (
+	PermFixedAssetRead  = "accounting.fixed_asset.read"
+	PermFixedAssetWrite = "accounting.fixed_asset.write"
+	PermFixedAssetPost  = "accounting.fixed_asset.post"
+)
+
+// Source type jurnal A-31 (Desain Finance & Accounting 2.1).
+const (
+	SourceFixedAsset             = "fixed_asset"
+	SourceFixedAssetDepreciation = "fixed_asset_depreciation"
+	SourceFixedAssetDisposal     = "fixed_asset_disposal"
+	RuleFixedAsset               = "A-31"
+)
+
+// Nilai bernama A-31 (posting_rule_accounts).
+const (
+	AmountAcquisition         = "acquisition_value"
+	AmountDepreciation        = "depreciation_value"
+	AmountDisposalAccumulated = "disposal_accumulated"
+	AmountDisposalProceeds    = "disposal_proceeds"
+	AmountDisposalLoss        = "disposal_loss"
+	AmountDisposalCost        = "disposal_cost"
+	AmountDisposalGain        = "disposal_gain"
+)
+
+// MaxUsefulLifeMonths membatasi umur manfaat (50 tahun).
+const MaxUsefulLifeMonths = 600
+
+var (
+	assetClassCodePattern = regexp.MustCompile(`^[a-z][a-z0-9_]{1,49}$`)
+	assetCodePattern      = regexp.MustCompile(`^[A-Z0-9][A-Z0-9._/-]{0,39}$`)
+)
+
+// AssetClass adalah kelas aset tetap: umur manfaat default dan akun aset/akumulasi (A-31).
+type AssetClass struct {
+	ID                     uuid.UUID
+	Code                   string
+	Name                   string
+	UsefulLifeMonths       int
+	AssetAccountID         uuid.UUID
+	AssetAccountCode       string
+	AccumulatedAccountID   uuid.UUID
+	AccumulatedAccountCode string
+	IsActive               bool
+	UpdatedAt              time.Time
+	Version                int
+}
+
+// AssetClassInput adalah isian kelas aset.
+type AssetClassInput struct {
+	Code                 string
+	Name                 string
+	UsefulLifeMonths     int
+	AssetAccountID       uuid.UUID
+	AccumulatedAccountID uuid.UUID
+	IsActive             bool
+}
+
+func validLife(months int) bool { return months >= 1 && months <= MaxUsefulLifeMonths }
+
+// NewAssetClass memvalidasi isian kelas aset. Akun diperiksa service (harus akun aset yang bisa diposting).
+func NewAssetClass(in AssetClassInput) (AssetClass, error) {
+	c := AssetClass{Code: strings.TrimSpace(in.Code)}
+	fields := map[string]string{}
+	if !assetClassCodePattern.MatchString(c.Code) {
+		fields["code"] = "Kode huruf kecil, angka, atau garis bawah (2–50 karakter), diawali huruf"
+	}
+	if err := c.Apply(in); err != nil {
+		for k, v := range apperr.As(err).Fields {
+			fields[k] = v
+		}
+	}
+	if len(fields) > 0 {
+		return AssetClass{}, apperr.Validation(fields)
+	}
+	return c, nil
+}
+
+// Apply mengubah isian kelas aset (kode tidak bisa diubah).
+func (c *AssetClass) Apply(in AssetClassInput) error {
+	fields := map[string]string{}
+	name := strings.TrimSpace(in.Name)
+	if name == "" || len(name) > 120 {
+		fields["name"] = "Nama kelas wajib diisi (maks. 120 karakter)"
+	}
+	if !validLife(in.UsefulLifeMonths) {
+		fields["usefulLifeMonths"] = fmt.Sprintf("Umur manfaat 1–%d bulan", MaxUsefulLifeMonths)
+	}
+	if in.AssetAccountID == uuid.Nil {
+		fields["assetAccountId"] = "Akun aset wajib dipilih"
+	}
+	switch in.AccumulatedAccountID {
+	case uuid.Nil:
+		fields["accumulatedAccountId"] = "Akun akumulasi penyusutan wajib dipilih"
+	case in.AssetAccountID:
+		fields["accumulatedAccountId"] = "Akun akumulasi harus berbeda dengan akun aset"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	c.Name, c.UsefulLifeMonths, c.IsActive = name, in.UsefulLifeMonths, in.IsActive
+	c.AssetAccountID, c.AccumulatedAccountID = in.AssetAccountID, in.AccumulatedAccountID
+	return nil
+}
+
+// AssetStatus adalah status aset tetap (UI: Draft, Aktif, Dilepas).
+type AssetStatus string
+
+const (
+	AssetDraft    AssetStatus = "draft"
+	AssetActive   AssetStatus = "active"
+	AssetDisposed AssetStatus = "disposed"
+)
+
+// AssetSource adalah asal aset: pembelian setelah go-live atau saldo awal migrasi.
+type AssetSource string
+
+const (
+	AssetPurchase AssetSource = "purchase"
+	AssetOpening  AssetSource = "opening"
+)
+
+// FixedAsset adalah satu aset tetap (ACC-21).
+type FixedAsset struct {
+	ID            uuid.UUID
+	Code          string
+	Name          string
+	ClassID       uuid.UUID
+	ClassName     string
+	LocationID    *uuid.UUID
+	LocationLabel string
+	DivisionID    uuid.UUID
+	Source        AssetSource
+	// AcquisitionDate adalah tanggal perolehan; untuk aset pembelian juga tanggal jurnal perolehan.
+	AcquisitionDate clock.BusinessDate
+	Cost            money.Amount
+	Salvage         money.Amount
+	UsefulLife      int
+	// DepreciationStart adalah tanggal 1 bulan pertama yang disusutkan sistem.
+	DepreciationStart clock.BusinessDate
+	// OpeningAccumulated dan OpeningMonths adalah akumulasi & bulan yang sudah disusutkan sebelum cut-over.
+	OpeningAccumulated money.Amount
+	OpeningMonths      int
+	Accumulated        money.Amount
+	PaymentAccountID   *uuid.UUID
+	Status             AssetStatus
+	AcquisitionJournal *uuid.UUID
+	DisposalDate       *clock.BusinessDate
+	DisposalProceeds   *money.Amount
+	DisposalAccountID  *uuid.UUID
+	DisposalReason     string
+	DisposalJournal    *uuid.UUID
+	Note               string
+	DeletedAt          *time.Time
+	CreatedAt          time.Time
+	UpdatedAt          time.Time
+	Version            int
+}
+
+// FixedAssetInput adalah isian Tambah/Ubah Aset Tetap.
+type FixedAssetInput struct {
+	Code               string
+	Name               string
+	ClassID            uuid.UUID
+	LocationID         *uuid.UUID
+	LocationLabel      string
+	DivisionID         uuid.UUID
+	Source             AssetSource
+	AcquisitionDate    clock.BusinessDate
+	Cost               money.Amount
+	Salvage            money.Amount
+	UsefulLife         int
+	OpeningAccumulated money.Amount
+	PaymentAccountID   *uuid.UUID
+	Note               string
+}
+
+func firstOfMonth(d clock.BusinessDate) clock.BusinessDate {
+	return clock.NewBusinessDate(d.Year(), d.Month(), 1)
+}
+
+// MonthsBetween menghitung selisih bulan from → to (to − from), mis. Jan → Mar = 2.
+func MonthsBetween(from, to PeriodKey) int { return to.Index() - from.Index() }
+
+// NewFixedAsset menyusun aset draft. cutover wajib untuk aset saldo awal: penyusutan sistem mulai bulan
+// setelah cut-over dan bulan yang sudah lewat (perolehan s.d. cut-over) dianggap sudah disusutkan.
+// Aset pembelian mulai disusutkan pada bulan perolehan.
+func NewFixedAsset(in FixedAssetInput, class AssetClass, cutover *clock.BusinessDate) (FixedAsset, error) {
+	a := FixedAsset{Code: strings.ToUpper(strings.TrimSpace(in.Code)), Status: AssetDraft}
+	fields := map[string]string{}
+	if !assetCodePattern.MatchString(a.Code) {
+		fields["code"] = "Kode aset huruf besar/angka (maks. 40 karakter), boleh . _ / -"
+	}
+	if err := a.apply(in, class, cutover); err != nil {
+		for k, v := range apperr.As(err).Fields {
+			fields[k] = v
+		}
+	}
+	if len(fields) > 0 {
+		return FixedAsset{}, apperr.Validation(fields)
+	}
+	return a, nil
+}
+
+// Update mengubah aset draft (kode tidak bisa diubah).
+func (a *FixedAsset) Update(in FixedAssetInput, class AssetClass, cutover *clock.BusinessDate) error {
+	if a.Status != AssetDraft || a.DeletedAt != nil {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Hanya aset Draft yang bisa diubah.")
+	}
+	return a.apply(in, class, cutover)
+}
+
+func (a *FixedAsset) apply(in FixedAssetInput, class AssetClass, cutover *clock.BusinessDate) error {
+	fields := map[string]string{}
+	name := strings.TrimSpace(in.Name)
+	if name == "" || len(name) > 200 {
+		fields["name"] = "Nama aset wajib diisi (maks. 200 karakter)"
+	}
+	if in.ClassID == uuid.Nil || class.ID != in.ClassID {
+		fields["classId"] = "Kelas aset wajib dipilih"
+	} else if !class.IsActive && a.ClassID != class.ID {
+		fields["classId"] = "Kelas aset tidak aktif"
+	}
+	if in.DivisionID == uuid.Nil {
+		fields["divisionId"] = "Divisi wajib dipilih (dimensi jurnal A-31)"
+	}
+	if in.AcquisitionDate.IsZero() {
+		fields["acquisitionDate"] = "Tanggal perolehan wajib diisi"
+	}
+	if !in.Cost.IsPositive() || !isWholeCents(in.Cost) {
+		fields["cost"] = "Harga perolehan harus lebih dari 0 (maks. 2 desimal)"
+	}
+	if in.Salvage.IsNegative() || !isWholeCents(in.Salvage) || (in.Cost.IsPositive() && in.Salvage.Cmp(in.Cost) >= 0) {
+		fields["salvage"] = "Nilai sisa 0 atau lebih dan lebih kecil dari harga perolehan"
+	}
+	life := in.UsefulLife
+	if life == 0 {
+		life = class.UsefulLifeMonths
+	}
+	if !validLife(life) {
+		fields["usefulLife"] = fmt.Sprintf("Umur manfaat 1–%d bulan", MaxUsefulLifeMonths)
+	}
+	if len(in.LocationLabel) > 120 {
+		fields["locationLabel"] = "Lokasi paling panjang 120 karakter"
+	}
+	if len(in.Note) > 1000 {
+		fields["note"] = "Catatan paling panjang 1000 karakter"
+	}
+	var start clock.BusinessDate
+	openingMonths := 0
+	switch in.Source {
+	case AssetPurchase:
+		if !in.OpeningAccumulated.IsZero() {
+			fields["openingAccumulated"] = "Akumulasi saldo awal hanya untuk aset saldo awal"
+		}
+		if in.PaymentAccountID == nil {
+			fields["paymentAccountId"] = "Akun pembayaran (Kas/Bank atau Utang Usaha) wajib dipilih"
+		}
+		if !in.AcquisitionDate.IsZero() {
+			start = firstOfMonth(in.AcquisitionDate)
+		}
+	case AssetOpening:
+		if cutover == nil || cutover.IsZero() {
+			fields["source"] = "Tanggal cut-over saldo awal belum diisi di Saldo Awal"
+			break
+		}
+		if !in.AcquisitionDate.IsZero() && in.AcquisitionDate.After(*cutover) {
+			fields["acquisitionDate"] = "Tanggal perolehan aset saldo awal tidak boleh setelah tanggal cut-over " + cutover.String()
+		}
+		depreciable := in.Cost.Sub(in.Salvage)
+		if in.OpeningAccumulated.IsNegative() || !isWholeCents(in.OpeningAccumulated) ||
+			(depreciable.IsPositive() && in.OpeningAccumulated.Cmp(depreciable) > 0) {
+			fields["openingAccumulated"] = "Akumulasi penyusutan 0 s.d. harga perolehan dikurangi nilai sisa"
+		}
+		next := PeriodOf(*cutover).Next()
+		start = clock.NewBusinessDate(next.Year, next.Month, 1)
+		if !in.AcquisitionDate.IsZero() {
+			openingMonths = min(max(MonthsBetween(PeriodOf(in.AcquisitionDate), PeriodOf(*cutover))+1, 0), life)
+		}
+	default:
+		fields["source"] = "Asal aset tidak dikenal"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	a.Name, a.ClassID, a.ClassName, a.LocationID, a.LocationLabel = name, class.ID, class.Name, in.LocationID, strings.TrimSpace(in.LocationLabel)
+	a.DivisionID, a.Source, a.AcquisitionDate, a.Cost, a.Salvage = in.DivisionID, in.Source, in.AcquisitionDate, in.Cost, in.Salvage
+	a.UsefulLife, a.DepreciationStart, a.OpeningMonths = life, start, openingMonths
+	a.OpeningAccumulated, a.Accumulated, a.Note = in.OpeningAccumulated, in.OpeningAccumulated, strings.TrimSpace(in.Note)
+	a.PaymentAccountID = nil
+	if in.Source == AssetPurchase {
+		a.PaymentAccountID = in.PaymentAccountID
+	}
+	return nil
+}
+
+// Depreciable adalah nilai yang disusutkan: harga perolehan − nilai sisa.
+func (a FixedAsset) Depreciable() money.Amount { return a.Cost.Sub(a.Salvage) }
+
+// BookValue adalah nilai buku: harga perolehan − akumulasi.
+func (a FixedAsset) BookValue() money.Amount { return a.Cost.Sub(a.Accumulated) }
+
+// MonthlyDepreciation adalah penyusutan garis lurus per bulan dari nilai yang disusutkan (tampilan).
+func (a FixedAsset) MonthlyDepreciation() money.Amount {
+	if a.UsefulLife <= 0 {
+		return money.Zero
+	}
+	return a.Depreciable().Mul(decimal.NewFromInt(1).Div(decimal.NewFromInt(int64(a.UsefulLife)))).Round()
+}
+
+// DepreciationFor menghitung penyusutan garis lurus periode k (A-31): sisa nilai yang belum disusutkan dibagi
+// sisa umur bulan, dibulatkan ke sen; bulan terakhir mengambil seluruh sisa agar akumulasi tepat sama dengan
+// nilai yang disusutkan. Aset yang belum aktif, dilepas, belum mulai disusutkan, atau sudah habis = 0.
+func (a FixedAsset) DepreciationFor(k PeriodKey) money.Amount {
+	if a.Status != AssetActive || a.DepreciationStart.IsZero() {
+		return money.Zero
+	}
+	start := PeriodOf(a.DepreciationStart)
+	if k.Index() < start.Index() {
+		return money.Zero
+	}
+	remaining := a.Depreciable().Sub(a.Accumulated)
+	if !remaining.IsPositive() {
+		return money.Zero
+	}
+	used := a.OpeningMonths + MonthsBetween(start, k)
+	left := a.UsefulLife - used
+	if left <= 1 {
+		return remaining
+	}
+	amount := money.FromDecimal(remaining.Decimal().Div(decimal.NewFromInt(int64(left)))).Round()
+	if amount.Cmp(remaining) > 0 {
+		return remaining
+	}
+	return amount
+}
+
+// RecordDepreciation menambah akumulasi setelah jurnal penyusutan diposting.
+func (a *FixedAsset) RecordDepreciation(amount money.Amount) {
+	a.Accumulated = a.Accumulated.Add(amount)
+}
+
+// Activate mengaktifkan aset draft. Aset pembelian dijurnal A-31 perolehan oleh service.
+func (a *FixedAsset) Activate() error {
+	if a.DeletedAt != nil || a.Status != AssetDraft {
+		return apperr.InvalidStateTransition("fixed_asset", string(a.Status), string(AssetActive))
+	}
+	a.Status = AssetActive
+	return nil
+}
+
+// Disposal adalah hasil perhitungan pelepasan aset (A-31): akumulasi + hasil + rugi = perolehan + laba.
+type Disposal struct {
+	Accumulated money.Amount
+	Cost        money.Amount
+	Proceeds    money.Amount
+	Loss        money.Amount
+	Gain        money.Amount
+}
+
+// Amounts adalah nilai bernama untuk PostingRequest A-31.
+func (d Disposal) Amounts() map[string]money.Amount {
+	return map[string]money.Amount{
+		AmountDisposalAccumulated: d.Accumulated, AmountDisposalCost: d.Cost, AmountDisposalProceeds: d.Proceeds,
+		AmountDisposalLoss: d.Loss, AmountDisposalGain: d.Gain,
+	}
+}
+
+// Dispose melepas aset aktif (dijual/dihapusbukukan) pada tanggal tertentu. Hasil penjualan 0 = dihapusbukukan.
+func (a *FixedAsset) Dispose(date clock.BusinessDate, proceeds money.Amount, accountID *uuid.UUID, reason string) (Disposal, error) {
+	if a.Status != AssetActive {
+		return Disposal{}, apperr.InvalidStateTransition("fixed_asset", string(a.Status), string(AssetDisposed))
+	}
+	fields := map[string]string{}
+	reason = strings.TrimSpace(reason)
+	if date.IsZero() {
+		fields["disposalDate"] = "Tanggal pelepasan wajib diisi"
+	} else if date.Before(a.AcquisitionDate) {
+		fields["disposalDate"] = "Tanggal pelepasan tidak boleh sebelum tanggal perolehan"
+	}
+	if proceeds.IsNegative() || !isWholeCents(proceeds) {
+		fields["proceeds"] = "Hasil pelepasan 0 atau lebih (maks. 2 desimal)"
+	}
+	if proceeds.IsPositive() && accountID == nil {
+		fields["disposalAccountId"] = "Akun penerimaan wajib dipilih bila ada hasil pelepasan"
+	}
+	if reason == "" || len(reason) > 500 {
+		fields["reason"] = "Alasan pelepasan wajib diisi (maks. 500 karakter)"
+	}
+	if len(fields) > 0 {
+		return Disposal{}, apperr.Validation(fields)
+	}
+	d := Disposal{Accumulated: a.Accumulated, Cost: a.Cost, Proceeds: proceeds, Loss: money.Zero, Gain: money.Zero}
+	diff := a.BookValue().Sub(proceeds)
+	if diff.IsPositive() {
+		d.Loss = diff
+	} else {
+		d.Gain = diff.Neg()
+	}
+	a.Status, a.DisposalDate, a.DisposalProceeds, a.DisposalReason = AssetDisposed, &date, &proceeds, reason
+	a.DisposalAccountID = nil
+	if proceeds.IsPositive() {
+		a.DisposalAccountID = accountID
+	}
+	return d, nil
+}
+
+// AssetAction adalah aksi yang boleh dilakukan user pada aset.
+type AssetAction string
+
+const (
+	AssetActionEdit     AssetAction = "edit"
+	AssetActionDelete   AssetAction = "delete"
+	AssetActionActivate AssetAction = "activate"
+	AssetActionDispose  AssetAction = "dispose"
+)
+
+// AllowedActions untuk tombol di ERP.
+func (a FixedAsset) AllowedActions(has func(string) bool) []AssetAction {
+	out := []AssetAction{}
+	if a.DeletedAt != nil {
+		return out
+	}
+	switch a.Status {
+	case AssetDraft:
+		if has(PermFixedAssetWrite) {
+			out = append(out, AssetActionEdit, AssetActionDelete)
+		}
+		if has(PermFixedAssetPost) {
+			out = append(out, AssetActionActivate)
+		}
+	case AssetActive:
+		if has(PermFixedAssetPost) {
+			out = append(out, AssetActionDispose)
+		}
+	}
+	return out
+}
+
+// DepreciationLine adalah penyusutan satu aset pada satu periode.
+type DepreciationLine struct {
+	ID             uuid.UUID
+	RunID          uuid.UUID
+	AssetID        uuid.UUID
+	AssetCode      string
+	AssetName      string
+	PeriodID       uuid.UUID
+	Period         PeriodKey
+	Amount         money.Amount
+	Accumulated    money.Amount
+	BookValue      money.Amount
+	JournalEntryID uuid.UUID
+	JournalNumber  string
+	CreatedAt      time.Time
+}
+
+// DepreciationRun adalah ringkasan penyusutan satu periode.
+type DepreciationRun struct {
+	ID         uuid.UUID
+	PeriodID   uuid.UUID
+	Period     PeriodKey
+	AssetCount int
+	Total      money.Amount
+	RunCount   int
+	LastRunAt  time.Time
+	CreatedAt  time.Time
+	Version    int
+}
diff --git a/backend/internal/accounting/domain/fixed_asset_test.go b/backend/internal/accounting/domain/fixed_asset_test.go
new file mode 100644
index 0000000..4b3a224
--- /dev/null
+++ b/backend/internal/accounting/domain/fixed_asset_test.go
@@ -0,0 +1,190 @@
+package domain
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+func testClass() AssetClass {
+	return AssetClass{ID: uuid.New(), Code: "office_equipment", Name: "Peralatan Kantor & Komputer", UsefulLifeMonths: 48, IsActive: true}
+}
+
+func fieldsOf(err error) map[string]string { return apperr.As(err).Fields }
+
+func TestNewAssetClass(t *testing.T) {
+	asset, accum := uuid.New(), uuid.New()
+	c, err := NewAssetClass(AssetClassInput{Code: "vehicle", Name: " Kendaraan ", UsefulLifeMonths: 96, AssetAccountID: asset, AccumulatedAccountID: accum, IsActive: true})
+	require.NoError(t, err)
+	assert.Equal(t, "Kendaraan", c.Name)
+
+	_, err = NewAssetClass(AssetClassInput{Code: "X", Name: "", UsefulLifeMonths: 0, AssetAccountID: asset, AccumulatedAccountID: asset})
+	f := fieldsOf(err)
+	for _, k := range []string{"code", "name", "usefulLifeMonths", "accumulatedAccountId"} {
+		assert.Contains(t, f, k)
+	}
+	_, err = NewAssetClass(AssetClassInput{Code: "ok_code", Name: "A", UsefulLifeMonths: 12})
+	assert.Contains(t, fieldsOf(err), "assetAccountId")
+}
+
+func purchaseInput(class AssetClass) FixedAssetInput {
+	bank := uuid.New()
+	return FixedAssetInput{
+		Code: "ast-lp-001", Name: "Laptop", ClassID: class.ID, DivisionID: uuid.New(), Source: AssetPurchase,
+		AcquisitionDate: clock.NewBusinessDate(2027, time.January, 20), Cost: money.FromInt(12_000_000), Salvage: money.Zero,
+		PaymentAccountID: &bank,
+	}
+}
+
+func TestNewFixedAssetPurchase(t *testing.T) {
+	class := testClass()
+	a, err := NewFixedAsset(purchaseInput(class), class, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "AST-LP-001", a.Code)
+	assert.Equal(t, AssetDraft, a.Status)
+	assert.Equal(t, 48, a.UsefulLife, "umur kelas dipakai bila kosong")
+	assert.Equal(t, clock.NewBusinessDate(2027, time.January, 1), a.DepreciationStart, "mulai bulan perolehan")
+	assert.Equal(t, "250000.00", a.MonthlyDepreciation().String())
+
+	in := purchaseInput(class)
+	in.PaymentAccountID, in.OpeningAccumulated = nil, money.FromInt(1)
+	in.Salvage = money.FromInt(13_000_000)
+	_, err = NewFixedAsset(in, class, nil)
+	f := fieldsOf(err)
+	assert.Contains(t, f, "paymentAccountId")
+	assert.Contains(t, f, "openingAccumulated")
+	assert.Contains(t, f, "salvage")
+
+	bad := FixedAssetInput{Code: "!", Source: "x", UsefulLife: 700}
+	_, err = NewFixedAsset(bad, AssetClass{}, nil)
+	for _, k := range []string{"code", "name", "classId", "divisionId", "acquisitionDate", "cost", "usefulLife", "source"} {
+		assert.Contains(t, fieldsOf(err), k)
+	}
+	inactive := class
+	inactive.IsActive = false
+	_, err = NewFixedAsset(purchaseInput(inactive), inactive, nil)
+	assert.Contains(t, fieldsOf(err), "classId")
+}
+
+func TestNewFixedAssetOpening(t *testing.T) {
+	class := testClass()
+	cutover := clock.NewBusinessDate(2026, time.December, 31)
+	in := FixedAssetInput{
+		Code: "AST-VM-001", Name: "Mesin Vending A", ClassID: class.ID, DivisionID: uuid.New(), Source: AssetOpening,
+		AcquisitionDate: clock.NewBusinessDate(2025, time.July, 1), Cost: money.FromInt(45_000_000), UsefulLife: 48,
+		OpeningAccumulated: money.FromInt(16_875_000),
+	}
+	_, err := NewFixedAsset(in, class, nil)
+	assert.Contains(t, fieldsOf(err), "source", "aset saldo awal butuh tanggal cut-over")
+
+	a, err := NewFixedAsset(in, class, &cutover)
+	require.NoError(t, err)
+	assert.Equal(t, clock.NewBusinessDate(2027, time.January, 1), a.DepreciationStart)
+	assert.Equal(t, 18, a.OpeningMonths, "Jul 2025 s.d. Des 2026")
+	assert.Equal(t, "16875000.00", a.Accumulated.String())
+	assert.Nil(t, a.PaymentAccountID)
+
+	in.AcquisitionDate = clock.NewBusinessDate(2027, time.February, 1)
+	in.OpeningAccumulated = money.FromInt(50_000_000)
+	_, err = NewFixedAsset(in, class, &cutover)
+	assert.Contains(t, fieldsOf(err), "acquisitionDate")
+	assert.Contains(t, fieldsOf(err), "openingAccumulated")
+}
+
+func TestDepreciationStraightLine(t *testing.T) {
+	class := testClass()
+	in := purchaseInput(class)
+	in.Cost, in.UsefulLife = money.MustParse("1000.00"), 3
+	a, err := NewFixedAsset(in, class, nil)
+	require.NoError(t, err)
+	jan := PeriodKey{Year: 2027, Month: time.January}
+	assert.True(t, a.DepreciationFor(jan).IsZero(), "draft belum disusutkan")
+	require.NoError(t, a.Activate())
+	assert.Error(t, a.Activate())
+
+	assert.True(t, a.DepreciationFor(PeriodKey{Year: 2026, Month: time.December}).IsZero(), "sebelum mulai")
+	var total money.Amount
+	for i, want := range []string{"333.33", "333.34", "333.33"} {
+		k := PeriodKey{Year: 2027, Month: time.Month(i + 1)}
+		got := a.DepreciationFor(k)
+		assert.Equal(t, want, got.String(), k.Label())
+		a.RecordDepreciation(got)
+		total = total.Add(got)
+	}
+	assert.Equal(t, "1000.00", total.String(), "akumulasi tepat sama dengan nilai yang disusutkan")
+	assert.True(t, a.DepreciationFor(PeriodKey{Year: 2027, Month: time.April}).IsZero(), "habis")
+	assert.Equal(t, "0.00", a.BookValue().String())
+
+	// Job terlambat: sisa umur habis → seluruh sisa disusutkan.
+	b, err := NewFixedAsset(in, class, nil)
+	require.NoError(t, err)
+	require.NoError(t, b.Activate())
+	assert.Equal(t, "1000.00", b.DepreciationFor(PeriodKey{Year: 2027, Month: time.June}).String())
+}
+
+func TestDepreciationOpeningAsset(t *testing.T) {
+	class := testClass()
+	cutover := clock.NewBusinessDate(2026, time.December, 31)
+	a, err := NewFixedAsset(FixedAssetInput{
+		Code: "AST-VM-002", Name: "Mesin", ClassID: class.ID, DivisionID: uuid.New(), Source: AssetOpening,
+		AcquisitionDate: clock.NewBusinessDate(2025, time.July, 1), Cost: money.FromInt(48_000), UsefulLife: 48,
+		OpeningAccumulated: money.FromInt(18_000),
+	}, class, &cutover)
+	require.NoError(t, err)
+	require.NoError(t, a.Activate())
+	// Sisa 30.000 dibagi sisa umur 30 bulan.
+	assert.Equal(t, "1000.00", a.DepreciationFor(PeriodKey{Year: 2027, Month: time.January}).String())
+}
+
+func TestDisposeAndActions(t *testing.T) {
+	class := testClass()
+	a, err := NewFixedAsset(purchaseInput(class), class, nil)
+	require.NoError(t, err)
+	has := func(string) bool { return true }
+	assert.ElementsMatch(t, []AssetAction{AssetActionEdit, AssetActionDelete, AssetActionActivate}, a.AllowedActions(has))
+	_, err = a.Dispose(clock.NewBusinessDate(2027, time.June, 1), money.Zero, nil, "rusak")
+	assert.Error(t, err, "draft tidak bisa dilepas")
+
+	require.NoError(t, a.Activate())
+	assert.Equal(t, []AssetAction{AssetActionDispose}, a.AllowedActions(has))
+	a.RecordDepreciation(money.FromInt(1_250_000))
+	assert.Error(t, a.Update(purchaseInput(class), class, nil), "aset aktif tidak bisa diubah")
+
+	_, err = a.Dispose(clock.BusinessDate{}, money.FromInt(-1), nil, "")
+	f := fieldsOf(err)
+	for _, k := range []string{"disposalDate", "proceeds", "reason"} {
+		assert.Contains(t, f, k)
+	}
+	_, err = a.Dispose(clock.NewBusinessDate(2027, time.June, 1), money.FromInt(1), nil, "dijual")
+	assert.Contains(t, fieldsOf(err), "disposalAccountId")
+
+	bank := uuid.New()
+	b := a
+	d, err := b.Dispose(clock.NewBusinessDate(2027, time.June, 1), money.FromInt(11_000_000), &bank, "Dijual")
+	require.NoError(t, err)
+	assert.Equal(t, "0.00", d.Loss.String())
+	assert.Equal(t, "250000.00", d.Gain.String(), "hasil 11 jt − nilai buku 10,75 jt")
+	assert.Equal(t, AssetDisposed, b.Status)
+	assert.Empty(t, b.AllowedActions(has))
+
+	c := a
+	d, err = c.Dispose(clock.NewBusinessDate(2027, time.June, 1), money.Zero, &bank, "Hilang")
+	require.NoError(t, err)
+	assert.Equal(t, "10750000.00", d.Loss.String())
+	assert.Nil(t, c.DisposalAccountID, "tanpa hasil tidak perlu akun penerimaan")
+	amounts := d.Amounts()
+	assert.Equal(t, "1250000.00", amounts[AmountDisposalAccumulated].String())
+	assert.Equal(t, "12000000.00", amounts[AmountDisposalCost].String())
+
+	deleted := a
+	now := time.Now()
+	deleted.DeletedAt = &now
+	assert.Empty(t, deleted.AllowedActions(has))
+}
diff --git a/backend/internal/accounting/domain/opening.go b/backend/internal/accounting/domain/opening.go
new file mode 100644
index 0000000..9c3edb8
--- /dev/null
+++ b/backend/internal/accounting/domain/opening.go
@@ -0,0 +1,338 @@
+package domain
+
+import (
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+// Saldo awal migrasi (ACC-14, A-36, U-10).
+const (
+	SourceOpeningBalance    = "opening_balance"
+	RuleOpeningBalance      = "A-36"
+	AmountOpeningDebit      = "opening_debit"
+	AmountOpeningCredit     = "opening_credit"
+	AmountOpeningDifference = "opening_difference"
+)
+
+// OpeningStatus adalah status saldo awal (UI: Draft, Diposting).
+type OpeningStatus string
+
+const (
+	OpeningDraft  OpeningStatus = "draft"
+	OpeningPosted OpeningStatus = "posted"
+)
+
+// OpeningSet adalah saldo awal per tanggal cut-over. Hanya satu per sistem.
+type OpeningSet struct {
+	ID             uuid.UUID
+	CutoverDate    clock.BusinessDate
+	Status         OpeningStatus
+	JournalEntryID *uuid.UUID
+	JournalNumber  string
+	PostedAt       *time.Time
+	PostedBy       *uuid.UUID
+	UpdatedAt      time.Time
+	Version        int
+}
+
+// CheckEditable menolak perubahan saldo awal yang sudah diposting.
+func (s OpeningSet) CheckEditable() error {
+	if s.Status != OpeningDraft {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+			"Saldo awal sudah diposting dan tidak bisa diubah. Koreksi lewat Jurnal Umum.")
+	}
+	return nil
+}
+
+// ValidateCutoverDate memastikan tanggal cut-over adalah akhir bulan (akhir periode akuntansi, U-10).
+func ValidateCutoverDate(d clock.BusinessDate) error {
+	if d.IsZero() {
+		return apperr.Validation(map[string]string{"cutoverDate": "Tanggal cut-over wajib diisi"})
+	}
+	if d.AddDays(1).Day() != 1 {
+		return apperr.Validation(map[string]string{"cutoverDate": "Tanggal cut-over harus tanggal terakhir bulan (akhir periode akuntansi)"})
+	}
+	return nil
+}
+
+// OpeningLine adalah saldo awal satu akun neraca.
+type OpeningLine struct {
+	ID          uuid.UUID
+	SetID       uuid.UUID
+	AccountID   uuid.UUID
+	AccountCode string
+	AccountName string
+	Debit       money.Amount
+	Credit      money.Amount
+	Note        string
+	UpdatedAt   time.Time
+	Version     int
+}
+
+// OpeningLineInput adalah isian satu baris Neraca Saldo Awal.
+type OpeningLineInput struct {
+	AccountID uuid.UUID
+	Debit     money.Amount
+	Credit    money.Amount
+	Note      string
+}
+
+// NewOpeningLine memvalidasi baris: akun neraca (kelompok 1–3) yang bisa diposting, debit XOR kredit.
+func NewOpeningLine(in OpeningLineInput, acc Account) (OpeningLine, error) {
+	fields := map[string]string{}
+	switch {
+	case acc.ID == uuid.Nil:
+		fields["accountId"] = "Akun tidak ditemukan"
+	case acc.Group.IsProfitLoss():
+		fields["accountId"] = "Saldo awal hanya untuk akun neraca (1xxx–3xxx)"
+	case acc.AutoPostingError() != "":
+		fields["accountId"] = acc.AutoPostingError()
+	}
+	switch {
+	case in.Debit.IsNegative() || in.Credit.IsNegative():
+		fields["debit"] = "Nominal tidak boleh negatif"
+	case in.Debit.IsPositive() && in.Credit.IsPositive():
+		fields["debit"] = "Isi salah satu Debit atau Kredit"
+	case in.Debit.IsZero() && in.Credit.IsZero():
+		fields["debit"] = "Isi nominal Debit atau Kredit"
+	case !isWholeCents(in.Debit) || !isWholeCents(in.Credit):
+		fields["debit"] = "Nominal paling banyak 2 angka di belakang koma"
+	}
+	note := strings.TrimSpace(in.Note)
+	if len(note) > 500 {
+		fields["note"] = "Keterangan paling panjang 500 karakter"
+	}
+	if len(fields) > 0 {
+		return OpeningLine{}, apperr.Validation(fields)
+	}
+	return OpeningLine{
+		AccountID: acc.ID, AccountCode: acc.Code, AccountName: acc.Name, Debit: in.Debit, Credit: in.Credit, Note: note,
+	}, nil
+}
+
+// OpeningTotals adalah total Neraca Saldo Awal; Difference = debit − kredit (dibukukan ke 3901 saat posting).
+type OpeningTotals struct {
+	Debit      money.Amount
+	Credit     money.Amount
+	Difference money.Amount
+}
+
+// TotalsOf menjumlahkan baris saldo awal.
+func TotalsOf(lines []OpeningLine) OpeningTotals {
+	t := OpeningTotals{Debit: money.Zero, Credit: money.Zero}
+	for _, l := range lines {
+		t.Debit, t.Credit = t.Debit.Add(l.Debit), t.Credit.Add(l.Credit)
+	}
+	t.Difference = t.Debit.Sub(t.Credit)
+	return t
+}
+
+// OpeningPosting menyusun PostingRequest A-36: tiap akun lewat split opening_debit/opening_credit, selisih
+// debit − kredit ke 3901 (opening_difference di sisi kredit; negatif dibalik ke debit oleh Plan).
+func OpeningPosting(set OpeningSet, lines []OpeningLine) (PostingRequest, error) {
+	if len(lines) == 0 {
+		return PostingRequest{}, apperr.WithMessage(apperr.CodeValidationFailed, "Neraca Saldo Awal masih kosong.")
+	}
+	req := PostingRequest{
+		RuleCode: RuleOpeningBalance, SourceType: SourceOpeningBalance, SourceID: set.ID,
+		SourceLabel: "Saldo Awal " + set.CutoverDate.String(), BusinessDate: set.CutoverDate,
+		Description: "Saldo awal migrasi per " + set.CutoverDate.String(), Amounts: map[string]money.Amount{},
+	}
+	for _, l := range lines {
+		key, amount := AmountOpeningDebit, l.Debit
+		if l.Credit.IsPositive() {
+			key, amount = AmountOpeningCredit, l.Credit
+		}
+		req.Splits = append(req.Splits, PostingSplit{AmountKey: key, AccountCode: l.AccountCode, Amount: amount, Memo: l.Note})
+	}
+	if diff := TotalsOf(lines).Difference; !diff.IsZero() {
+		req.Amounts[AmountOpeningDifference] = diff
+	}
+	return req, nil
+}
+
+// OpeningItemType adalah jenis saldo terbuka: piutang atau utang.
+type OpeningItemType string
+
+const (
+	OpeningReceivable OpeningItemType = "receivable"
+	OpeningPayable    OpeningItemType = "payable"
+)
+
+// Jenis pihak saldo terbuka (modul party).
+const (
+	PartyCustomer = "customer"
+	PartyPartner  = "partner"
+	PartySupplier = "supplier"
+)
+
+// OpeningItem adalah piutang/utang terbuka per dokumen lama per tanggal cut-over. OpenAmount adalah sisa per
+// cut-over; Settled adalah pelunasan oleh dokumen pembayaran setelah go-live. Outstanding = OpenAmount − Settled.
+type OpeningItem struct {
+	ID             uuid.UUID
+	SetID          uuid.UUID
+	Type           OpeningItemType
+	PartyType      string
+	PartyID        uuid.UUID
+	PartyCode      string
+	DocumentNumber string
+	DocumentDate   clock.BusinessDate
+	DueDate        clock.BusinessDate
+	Amount         money.Amount
+	OpenAmount     money.Amount
+	Settled        money.Amount
+	AccountID      uuid.UUID
+	AccountCode    string
+	ChannelID      *uuid.UUID
+	Note           string
+	UpdatedAt      time.Time
+	Version        int
+}
+
+// Outstanding adalah sisa yang belum dilunasi saat ini.
+func (i OpeningItem) Outstanding() money.Amount { return i.OpenAmount.Sub(i.Settled) }
+
+// OpeningItemInput adalah isian satu baris Piutang/Utang Terbuka.
+type OpeningItemInput struct {
+	Type           OpeningItemType
+	PartyType      string
+	PartyID        uuid.UUID
+	PartyCode      string
+	DocumentNumber string
+	DocumentDate   clock.BusinessDate
+	DueDate        clock.BusinessDate
+	Amount         money.Amount
+	OpenAmount     money.Amount
+	ChannelID      *uuid.UUID
+	Note           string
+}
+
+// NewOpeningItem memvalidasi baris saldo terbuka. acc adalah akun kontrol (piutang 12xx / utang 2101).
+func NewOpeningItem(in OpeningItemInput, acc Account, cutover clock.BusinessDate) (OpeningItem, error) {
+	fields := map[string]string{}
+	switch in.Type {
+	case OpeningReceivable:
+		if in.PartyType != PartyCustomer && in.PartyType != PartyPartner {
+			fields["partyCode"] = "Pihak piutang harus pelanggan atau mitra"
+		}
+		if acc.ID != uuid.Nil && !strings.HasPrefix(acc.Code, "12") {
+			fields["accountCode"] = "Akun piutang harus akun 12xx"
+		}
+	case OpeningPayable:
+		if in.PartyType != PartySupplier {
+			fields["partyCode"] = "Pihak utang harus pemasok/maklon"
+		}
+		if acc.ID != uuid.Nil && acc.Group != GroupLiability {
+			fields["accountCode"] = "Akun utang harus akun liabilitas"
+		}
+	default:
+		fields["type"] = "Jenis saldo tidak dikenal"
+	}
+	if in.PartyID == uuid.Nil && fields["partyCode"] == "" {
+		fields["partyCode"] = "Pihak tidak ditemukan"
+	}
+	if acc.ID == uuid.Nil {
+		fields["accountCode"] = "Akun tidak ditemukan"
+	} else if msg := acc.AutoPostingError(); msg != "" {
+		fields["accountCode"] = msg
+	}
+	doc := strings.TrimSpace(in.DocumentNumber)
+	if doc == "" || len(doc) > 60 {
+		fields["documentNumber"] = "Nomor dokumen wajib diisi (maks. 60 karakter)"
+	}
+	if in.DocumentDate.IsZero() {
+		fields["documentDate"] = "Tanggal dokumen wajib diisi"
+	} else if !cutover.IsZero() && in.DocumentDate.After(cutover) {
+		fields["documentDate"] = "Tanggal dokumen tidak boleh setelah tanggal cut-over " + cutover.String()
+	}
+	if in.DueDate.IsZero() {
+		fields["dueDate"] = "Jatuh tempo wajib diisi"
+	} else if !in.DocumentDate.IsZero() && in.DueDate.Before(in.DocumentDate) {
+		fields["dueDate"] = "Jatuh tempo tidak boleh sebelum tanggal dokumen"
+	}
+	if !in.Amount.IsPositive() || !isWholeCents(in.Amount) {
+		fields["amount"] = "Nilai dokumen harus lebih dari 0 (maks. 2 desimal)"
+	}
+	if !in.OpenAmount.IsPositive() || !isWholeCents(in.OpenAmount) {
+		fields["openAmount"] = "Sisa belum dibayar harus lebih dari 0 (maks. 2 desimal)"
+	} else if in.Amount.IsPositive() && in.OpenAmount.Cmp(in.Amount) > 0 {
+		fields["openAmount"] = "Sisa belum dibayar tidak boleh melebihi nilai dokumen"
+	}
+	if len(in.Note) > 500 {
+		fields["note"] = "Keterangan paling panjang 500 karakter"
+	}
+	if len(fields) > 0 {
+		return OpeningItem{}, apperr.Validation(fields)
+	}
+	return OpeningItem{
+		Type: in.Type, PartyType: in.PartyType, PartyID: in.PartyID, PartyCode: strings.TrimSpace(in.PartyCode),
+		DocumentNumber: doc, DocumentDate: in.DocumentDate, DueDate: in.DueDate, Amount: in.Amount,
+		OpenAmount: in.OpenAmount, Settled: money.Zero, AccountID: acc.ID, AccountCode: acc.Code, ChannelID: in.ChannelID,
+		Note: strings.TrimSpace(in.Note),
+	}, nil
+}
+
+// Settle mencatat pelunasan (positif) atau pembatalan pelunasan (negatif) dari dokumen pembayaran.
+func (i *OpeningItem) Settle(amount money.Amount) error {
+	next := i.Settled.Add(amount)
+	if amount.IsZero() || !isWholeCents(amount) {
+		return apperr.Validation(map[string]string{"amount": "Nilai pelunasan tidak valid"})
+	}
+	if next.IsNegative() || next.Cmp(i.OpenAmount) > 0 {
+		return apperr.Validation(map[string]string{
+			"amount": "Pelunasan melebihi sisa saldo awal " + i.DocumentNumber + " (" + i.Outstanding().String() + ")",
+		})
+	}
+	i.Settled = next
+	return nil
+}
+
+// ReconciliationStatus adalah hasil satu cek rekonsiliasi cut-over.
+type ReconciliationStatus string
+
+const (
+	ReconOK      ReconciliationStatus = "ok"
+	ReconFailed  ReconciliationStatus = "failed"
+	ReconSkipped ReconciliationStatus = "skipped"
+)
+
+// ReconciliationCheck adalah satu baris pengecekan rekonsiliasi cut-over (Panduan Migrasi Data bagian 4):
+// nilai sub-ledger dibanding saldo GL akun terkait, toleransi 0.
+type ReconciliationCheck struct {
+	Code        string
+	Label       string
+	AccountCode string
+	Subledger   money.Amount
+	Ledger      money.Amount
+	Difference  money.Amount
+	Status      ReconciliationStatus
+	Note        string
+}
+
+// Compare membuat cek dengan selisih sub-ledger − GL.
+func Compare(code, label, account string, subledger, ledger money.Amount) ReconciliationCheck {
+	c := ReconciliationCheck{
+		Code: code, Label: label, AccountCode: account, Subledger: subledger, Ledger: ledger,
+		Difference: subledger.Sub(ledger), Status: ReconOK,
+	}
+	if !c.Difference.IsZero() {
+		c.Status = ReconFailed
+	}
+	return c
+}
+
+// ReconciliationPassed: semua cek lolos (cek yang dilewati tidak menggagalkan).
+func ReconciliationPassed(checks []ReconciliationCheck) bool {
+	for _, c := range checks {
+		if c.Status == ReconFailed {
+			return false
+		}
+	}
+	return true
+}
