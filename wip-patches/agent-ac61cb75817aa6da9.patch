+-diff --git a/backend/internal/pricing/postgres/store.go b/backend/internal/pricing/postgres/store.go
+-new file mode 100644
+-index 0000000..f8f77f0
+---- /dev/null
+-+++ b/backend/internal/pricing/postgres/store.go
+-@@ -0,0 +1,161 @@
+-+// Package postgres adalah repository modul pricing.
+-+package postgres
+-+
+-+import (
+-+	"context"
+-+	"errors"
+-+	"fmt"
+-+	"time"
+-+
+-+	"github.com/google/uuid"
+-+	"github.com/jackc/pgx/v5"
+-+	"github.com/jackc/pgx/v5/pgconn"
+-+	"github.com/jackc/pgx/v5/pgtype"
+-+	"github.com/jackc/pgx/v5/pgxpool"
+-+	"github.com/shopspring/decimal"
+-+
+-+	"balans/internal/platform/apperr"
+-+	"balans/internal/platform/clock"
+-+	"balans/internal/platform/db"
+-+	"balans/internal/platform/money"
+-+	"balans/internal/platform/softdelete"
+-+	"balans/internal/pricing/postgres/sqlcgen"
+-+)
+-+
+-+// Store menyimpan daftar harga dan aturan harga.
+-+type Store struct {
+-+	pool *pgxpool.Pool
+-+}
+-+
+-+// NewStore membuat Store.
+-+func NewStore(pool *pgxpool.Pool) *Store { return &Store{pool: pool} }
+-+
+-+func (s *Store) q(ctx context.Context) *sqlcgen.Queries {
+-+	return sqlcgen.New(db.Conn(ctx, s.pool))
+-+}
+-+
+-+func text(s string) pgtype.Text { return pgtype.Text{String: s, Valid: s != ""} }
+-+
+-+func nullUUID(id *uuid.UUID) uuid.NullUUID {
+-+	if id == nil {
+-+		return uuid.NullUUID{}
+-+	}
+-+	return uuid.NullUUID{UUID: *id, Valid: true}
+-+}
+-+
+-+func uuidPtr(id uuid.NullUUID) *uuid.UUID {
+-+	if !id.Valid {
+-+		return nil
+-+	}
+-+	v := id.UUID
+-+	return &v
+-+}
+-+
+-+func toPgDate(d *clock.BusinessDate) pgtype.Date {
+-+	if d == nil {
+-+		return pgtype.Date{}
+-+	}
+-+	return pgtype.Date{Time: d.Time(), Valid: true}
+-+}
+-+
+-+func fromPgDate(d pgtype.Date) *clock.BusinessDate {
+-+	if !d.Valid {
+-+		return nil
+-+	}
+-+	b := clock.NewBusinessDate(d.Time.Year(), d.Time.Month(), d.Time.Day())
+-+	return &b
+-+}
+-+
+-+func nullDecimal(d *decimal.Decimal) decimal.NullDecimal {
+-+	if d == nil {
+-+		return decimal.NullDecimal{}
+-+	}
+-+	return decimal.NullDecimal{Decimal: *d, Valid: true}
+-+}
+-+
+-+func decimalPtr(d decimal.NullDecimal) *decimal.Decimal {
+-+	if !d.Valid {
+-+		return nil
+-+	}
+-+	v := d.Decimal
+-+	return &v
+-+}
+-+
+-+func amountPtr(d decimal.NullDecimal) *money.Amount {
+-+	if !d.Valid {
+-+		return nil
+-+	}
+-+	a := money.FromDecimal(d.Decimal)
+-+	return &a
+-+}
+-+
+-+func amountText(a *money.Amount) string {
+-+	if a == nil {
+-+		return ""
+-+	}
+-+	return a.String()
+-+}
+-+
+-+func mark(at *time.Time, by uuid.NullUUID) softdelete.Mark {
+-+	return softdelete.Mark{DeletedAt: at, DeletedBy: uuidPtr(by)}
+-+}
+-+
+-+func version32(v int) int32 { return int32(v) } //nolint:gosec // versi optimistic locking kecil
+-+
+-+func notFound(err error, what string) error {
+-+	if errors.Is(err, pgx.ErrNoRows) {
+-+		return apperr.Wrap(apperr.CodeNotFound, fmt.Errorf("%s: %w", what, err))
+-+	}
+-+	return fmt.Errorf("%s: %w", what, err)
+-+}
+-+
+-+// constraintMessages memetakan pelanggaran constraint ke field dan pesan untuk user.
+-+var constraintMessages = map[string][2]string{
+-+	"uq_price_lists_code":             {"code", "Kode sudah dipakai (termasuk daftar harga yang sudah dihapus)"},
+-+	"uq_price_lists_scope":            {"priceListType", "Sudah ada daftar harga untuk cakupan ini"},
+-+	"uq_price_list_versions_open":     {"validFrom", "Masih ada versi draft atau yang sedang diajukan untuk daftar harga ini"},
+-+	"ex_price_list_versions_period":   {"validFrom", "Periode beririsan dengan versi aktif lain"},
+-+	"uq_promotions_code":              {"code", "Kode promo sudah dipakai (termasuk promo yang sudah dihapus)"},
+-+	"ex_special_prices_period":        {"validFrom", "Periode beririsan dengan harga khusus lain untuk pihak dan produk ini"},
+-+	"ex_tiered_prices_period":         {"validFrom", "Periode beririsan dengan harga bertingkat lain untuk produk dan qty ini"},
+-+	"ex_discount_limits_period":       {"validFrom", "Periode beririsan dengan batas diskon lain untuk role ini"},
+-+	"uq_price_list_items_product":     {"items", "Produk tidak boleh ganda dalam satu versi"},
+-+	"uq_promotion_items_product":      {"items", "Produk tidak boleh ganda dalam satu promo"},
+-+	"ck_price_list_items_max_retail":  {"items", "HET tidak boleh di bawah harga dasar"},
+-+	"ck_price_lists_basis_reference":  {"referencePriceListId", "Pilih daftar harga acuan"},
+-+	"fk_price_lists_reference":        {"referencePriceListId", "Daftar harga acuan tidak ditemukan"},
+-+	"fk_tiered_prices_price_list":     {"priceListId", "Daftar harga tidak ditemukan"},
+-+	"ck_price_list_versions_validity": {"validTo", "Tanggal berakhir tidak boleh sebelum tanggal mulai"},
+-+}
+-+
+-+// mapWriteError mengubah pelanggaran unik/EXCLUDE/check yang dikenal menjadi VALIDATION_FAILED/DUPLICATE_CODE.
+-+func mapWriteError(err error, what string) error {
+-+	var pe *pgconn.PgError
+-+	if errors.As(err, &pe) {
+-+		if m, ok := constraintMessages[pe.ConstraintName]; ok {
+-+			code := apperr.CodeValidationFailed
+-+			if pe.Code == "23505" && m[0] == "code" {
+-+				code = apperr.CodeDuplicateCode
+-+			}
+-+			return &apperr.Error{Code: code, Message: code.DefaultMessage(), Fields: map[string]string{m[0]: m[1]}, Err: err}
+-+		}
+-+	}
+-+	return fmt.Errorf("%s: %w", what, err)
+-+}
+-+
+-+func versionConflict(err error, what string) error {
+-+	if errors.Is(err, pgx.ErrNoRows) {
+-+		return apperr.New(apperr.CodeVersionConflict)
+-+	}
+-+	return mapWriteError(err, what)
+-+}
+-+
+-+func rowsConflict(n int64, err error, what string) error {
+-+	if err != nil {
+-+		return fmt.Errorf("%s: %w", what, err)
+-+	}
+-+	if n == 0 {
+-+		return apperr.New(apperr.CodeVersionConflict)
+-+	}
+-+	return nil
+-+}
+-diff --git a/backend/internal/pricing/pricing.go b/backend/internal/pricing/pricing.go
+-new file mode 100644
+-index 0000000..8dea45c
+---- /dev/null
+-+++ b/backend/internal/pricing/pricing.go
+-@@ -0,0 +1,202 @@
+-+// Package pricing adalah API publik modul harga (BRD 5.18; MD-04, MD-05, MD-11, MD-12): daftar harga per
+-+// channel/mitra/karyawan/vending dengan versi berlaku yang disetujui, harga khusus, promo, harga bertingkat,
+-+// resolver harga 5 aturan (Technical Guideline 5.6), dan batas diskon manual per role. Modul dokumen penjualan
+-+// memanggil Resolve untuk setiap baris dan menyimpan PriceQuote.Rule serta PriceQuote.SourceID/versi di barisnya;
+-+// CheckDiscount menentukan apakah dokumen butuh approval sales_order_discount.
+-+package pricing
+-+
+-+import (
+-+	"context"
+-+
+-+	"github.com/go-chi/chi/v5"
+-+	"github.com/jackc/pgx/v5/pgxpool"
+-+	"github.com/riverqueue/river"
+-+
+-+	"balans/internal/approval"
+-+	"balans/internal/audit"
+-+	"balans/internal/platform/actor"
+-+	"balans/internal/platform/clock"
+-+	"balans/internal/platform/db"
+-+	"balans/internal/platform/httpx"
+-+	"balans/internal/platform/money"
+-+	"balans/internal/pricing/domain"
+-+	pricinghttp "balans/internal/pricing/http"
+-+	"balans/internal/pricing/postgres"
+-+	"balans/internal/pricing/service"
+-+)
+-+
+-+// Name adalah nama modul di ENABLED_MODULES.
+-+const Name = "pricing"
+-+
+-+type (
+-+	// PriceRequest adalah permintaan harga satu baris transaksi (tanggal = business_date transaksi).
+-+	PriceRequest = domain.PriceRequest
+-+	// PriceQuote adalah harga hasil resolver beserta aturan dan versi yang dipakai.
+-+	PriceQuote = domain.PriceQuote
+-+	// Rule adalah aturan harga yang disimpan sebagai `price_rule`.
+-+	Rule = domain.Rule
+-+	// Discount adalah diskon manual persen atau nominal.
+-+	Discount = domain.Discount
+-+	// DiscountKind adalah bentuk diskon manual.
+-+	DiscountKind = domain.DiscountKind
+-+	// LineDiscount adalah diskon manual satu baris (Gross = qty × harga satuan).
+-+	LineDiscount = domain.LineDiscount
+-+	// DocumentDiscount adalah diskon manual per dokumen (Subtotal = total baris setelah diskon baris).
+-+	DocumentDiscount = domain.DocumentDiscount
+-+	// DiscountCheck adalah hasil pemeriksaan diskon terhadap batas role.
+-+	DiscountCheck = domain.DiscountCheck
+-+	// DiscountLimit adalah batas diskon efektif (terbesar dari role-role user).
+-+	DiscountLimit = domain.Limit
+-+
+-+	// ProductRef adalah ringkasan produk dari modul catalog.
+-+	ProductRef = service.ProductRef
+-+	// Products membaca produk dari modul catalog.
+-+	Products = service.Products
+-+	// PartyRef adalah ringkasan pelanggan/mitra dari modul party.
+-+	PartyRef = service.PartyRef
+-+	// Parties membaca pelanggan dan mitra dari modul party.
+-+	Parties = service.Parties
+-+	// Roles membaca nama role dari modul identity.
+-+	Roles = service.Roles
+-+	// Approvals mengajukan dan membatalkan approval (modul approval).
+-+	Approvals = service.Approvals
+-+)
+-+
+-+// Aturan harga, urut prioritas BRD 5.18.
+-+const (
+-+	RuleSpecialPrice = domain.RuleSpecialPrice
+-+	RulePromotion    = domain.RulePromotion
+-+	RuleTieredPrice  = domain.RuleTieredPrice
+-+	RulePriceList    = domain.RulePriceList
+-+	RuleBasePrice    = domain.RuleBasePrice
+-+
+-+	DiscountPercent = domain.DiscountPercent
+-+	DiscountAmount  = domain.DiscountAmount
+-+)
+-+
+-+// Permission modul.
+-+const (
+-+	PermPriceListRead     = service.PermPriceListRead
+-+	PermPromotionRead     = service.PermPromotionRead
+-+	PermSpecialPriceRead  = service.PermSpecialPriceRead
+-+	PermDiscountLimitRead = service.PermDiscountLimitRead
+-+)
+-+
+-+// Deps adalah dependensi modul. Products, Parties, Roles, dan Eligibility opsional (nil = tanpa validasi/nama
+-+// dan tanpa harga karyawan/PKS); Approvals wajib untuk mengajukan versi daftar harga.
+-+type Deps struct {
+-+	Pool        *pgxpool.Pool
+-+	Tx          *db.TxManager
+-+	Clock       clock.Clock
+-+	Responder   *httpx.Responder
+-+	Audit       audit.Recorder
+-+	Products    Products
+-+	Parties     Parties
+-+	Roles       Roles
+-+	Eligibility Eligibility
+-+	Approvals   Approvals
+-+}
+-+
+-+// Module adalah modul pricing.
+-+type Module struct {
+-+	svc      *service.Service
+-+	resolver *Resolver
+-+	rs       *httpx.Responder
+-+	h        *pricinghttp.PricingHandler
+-+}
+-+
+-+// New menyusun modul.
+-+func New(d Deps) *Module {
+-+	svc := service.New(service.Deps{
+-+		Store: postgres.NewStore(d.Pool), Tx: d.Tx, Audit: d.Audit, Clock: d.Clock, Products: d.Products,
+-+		Parties: d.Parties, Roles: d.Roles, Approvals: d.Approvals,
+-+	})
+-+	return newModule(svc, d.Eligibility, d.Responder)
+-+}
+-+
+-+func newModule(svc *service.Service, eligibility Eligibility, rs *httpx.Responder) *Module {
+-+	m := &Module{svc: svc, resolver: NewResolver(svc, eligibility, DefaultRules(svc)...), rs: rs}
+-+	m.h = pricinghttp.NewHandler(svc, simulator{m: m})
+-+	return m
+-+}
+-+
+-+// Name mengembalikan nama modul.
+-+func (m *Module) Name() string { return Name }
+-+
+-+// RegisterRoutes mendaftarkan route daftar harga, aturan harga, batas diskon, dan simulasi.
+-+func (m *Module) RegisterRoutes(r chi.Router) { pricinghttp.Register(r, m.h, m.rs) }
+-+
+-+// RegisterWorkers tidak ada.
+-+func (m *Module) RegisterWorkers(*river.Workers) {}
+-+
+-+// PeriodicJobs tidak ada.
+-+func (m *Module) PeriodicJobs() []*river.PeriodicJob { return nil }
+-+
+-+// AuditEntities memetakan jenis entitas audit trail ke permission baca untuk tab Riwayat.
+-+func AuditEntities() map[string]string {
+-+	return map[string]string{
+-+		service.EntityPriceList: PermPriceListRead, service.EntityPriceListVersion: PermPriceListRead,
+-+		service.EntitySpecialPrice: PermSpecialPriceRead, service.EntityPromotion: PermPromotionRead,
+-+		service.EntityTieredPrice: PermPromotionRead, service.EntityDiscountLimit: PermDiscountLimitRead,
+-+	}
+-+}
+-+
+-+// ApprovalHandler adalah handler approval price_list_version: versi diberlakukan saat disetujui level terakhir
+-+// dan ditandai ditolak saat ditolak. Didaftarkan saat wiring dengan approval.Module.RegisterHandler.
+-+func (m *Module) ApprovalHandler() approval.Handler {
+-+	return approval.Handler{OnApproved: m.svc.OnVersionApproved, OnRejected: m.svc.OnVersionRejected}
+-+}
+-+
+-+// Resolve menentukan harga satu baris transaksi dengan rantai aturan BRD 5.18 (harga khusus → promo → harga
+-+// bertingkat → daftar harga channel/mitra/karyawan → Harga Dasar & HET) pada req.Date. Tidak memeriksa
+-+// permission; NOT_FOUND bila produk belum punya harga.
+-+func (m *Module) Resolve(ctx context.Context, req PriceRequest) (PriceQuote, error) {
+-+	return m.resolver.Resolve(ctx, req)
+-+}
+-+
+-+// EffectiveDiscountLimit mengembalikan batas diskon hari ini untuk role-role user (nilai terbesar antar role).
+-+func (m *Module) EffectiveDiscountLimit(ctx context.Context, roleCodes []string) (DiscountLimit, error) {
+-+	return m.svc.EffectiveLimit(ctx, roleCodes)
+-+}
+-+
+-+// CheckDiscount memeriksa diskon manual per baris dan per dokumen terhadap batas diskon role-role pembuat yang
+-+// berlaku hari ini (MD-12). DiscountCheck.RequiresApproval = true berarti dokumen harus diajukan dengan approval
+-+// sales_order_discount (Head Sales); nominalnya DiscountCheck.TotalDiscountAmount. Tidak memeriksa permission.
+-+func (m *Module) CheckDiscount(ctx context.Context, roleCodes []string, lines []LineDiscount, doc DocumentDiscount) (DiscountCheck, error) {
+-+	limit, err := m.svc.EffectiveLimit(ctx, roleCodes)
+-+	if err != nil {
+-+		return DiscountCheck{}, err
+-+	}
+-+	return domain.CheckDiscount(limit, lines, doc)
+-+}
+-+
+-+// ApprovalSubjectDiscount adalah jenis approval untuk diskon di atas batas role.
+-+const ApprovalSubjectDiscount = approval.SubjectSalesOrderDiscount
+-+
+-+// simulator melayani halaman Penjualan › Harga & Diskon.
+-+type simulator struct{ m *Module }
+-+
+-+func (s simulator) QuotePrice(ctx context.Context, req PriceRequest) (PriceQuote, error) {
+-+	if _, err := actor.RequireAny(ctx, service.PermPriceListRead, service.PermPromotionRead, service.PermSpecialPriceRead); err != nil {
+-+		return PriceQuote{}, err
+-+	}
+-+	return s.m.Resolve(ctx, req)
+-+}
+-+
+-+// CheckDiscountForActor memeriksa diskon terhadap role user yang login; subtotal dokumen = bruto − diskon baris.
+-+func (s simulator) CheckDiscountForActor(ctx context.Context, lines []LineDiscount, doc Discount) (DiscountCheck, money.Amount, error) {
+-+	a, err := actor.RequireAny(ctx, service.PermDiscountLimitRead, service.PermPriceListRead)
+-+	if err != nil {
+-+		return DiscountCheck{}, money.Zero, err
+-+	}
+-+	subtotal := money.Zero
+-+	for _, l := range lines {
+-+		amount, _, err := l.Discount.Apply(l.Gross)
+-+		if err != nil {
+-+			amount = money.Zero
+-+		}
+-+		subtotal = subtotal.Add(l.Gross.Sub(amount))
+-+	}
+-+	check, err := s.m.CheckDiscount(ctx, a.Roles, lines, DocumentDiscount{Subtotal: subtotal, Discount: doc})
+-+	return check, subtotal, err
+-+}
+-diff --git a/backend/internal/pricing/resolver.go b/backend/internal/pricing/resolver.go
+-new file mode 100644
+-index 0000000..e94b779
+---- /dev/null
+-+++ b/backend/internal/pricing/resolver.go
+-@@ -0,0 +1,382 @@
+-+package pricing
+-+
+-+import (
+-+	"context"
+-+	"fmt"
+-+
+-+	"github.com/google/uuid"
+-+	"github.com/shopspring/decimal"
+-+
+-+	"balans/internal/platform/apperr"
+-+	"balans/internal/platform/clock"
+-+	"balans/internal/pricing/domain"
+-+)
+-+
+-+// Source membaca data harga yang berlaku pada tanggal transaksi (dipenuhi service modul).
+-+type Source interface {
+-+	SpecialPriceOn(ctx context.Context, t domain.PartyType, partyID, productID uuid.UUID, on clock.BusinessDate) (domain.SpecialPrice, bool, error)
+-+	PromotionOffersOn(ctx context.Context, productID uuid.UUID, channelID, subChannelID *uuid.UUID, on clock.BusinessDate) ([]domain.PromotionOffer, error)
+-+	TieredPricesOn(ctx context.Context, productID uuid.UUID, priceListIDs []uuid.UUID, qty decimal.Decimal, on clock.BusinessDate) ([]domain.TieredPrice, error)
+-+	ScopePriceLists(ctx context.Context, partnerID, channelID, subChannelID *uuid.UUID) ([]domain.PriceList, error)
+-+	PriceListByID(ctx context.Context, id uuid.UUID) (domain.PriceList, error)
+-+	BasePriceList(ctx context.Context) (domain.PriceList, error)
+-+	ListPriceOn(ctx context.Context, l domain.PriceList, productID uuid.UUID, on clock.BusinessDate) (domain.ListPrice, bool, error)
+-+}
+-+
+-+// Eligibility membaca hak harga dari modul party: harga karyawan (pelanggan tertaut karyawan aktif, HR-03) dan
+-+// daftar harga di PKS mitra yang berlaku.
+-+type Eligibility interface {
+-+	EmployeePriceEligible(ctx context.Context, customerID uuid.UUID, on clock.BusinessDate) (bool, error)
+-+	PartnerAgreementPriceList(ctx context.Context, partnerID uuid.UUID, on clock.BusinessDate) (*uuid.UUID, error)
+-+}
+-+
+-+// PriceQuery adalah permintaan harga beserta daftar harga kandidat (urut prioritas) yang dihitung sekali oleh
+-+// Resolver. Next menghitung harga dari aturan berikutnya di rantai (dipakai promo potongan persen).
+-+type PriceQuery struct {
+-+	domain.PriceRequest
+-+	// Lists adalah daftar harga yang berlaku untuk transaksi, urut prioritas: karyawan, PKS mitra, mitra,
+-+	// sub-channel, channel.
+-+	Lists []domain.PriceList
+-+	next  func(ctx context.Context) (domain.PriceQuote, bool, error)
+-+}
+-+
+-+// Next menghitung harga dari aturan dengan prioritas lebih rendah (harga tanpa aturan saat ini).
+-+func (q PriceQuery) Next(ctx context.Context) (domain.PriceQuote, bool, error) {
+-+	if q.next == nil {
+-+		return domain.PriceQuote{}, false, nil
+-+	}
+-+	return q.next(ctx)
+-+}
+-+
+-+// ListIDs mengembalikan ID daftar harga kandidat.
+-+func (q PriceQuery) ListIDs() []uuid.UUID {
+-+	ids := make([]uuid.UUID, len(q.Lists))
+-+	for i, l := range q.Lists {
+-+		ids[i] = l.ID
+-+	}
+-+	return ids
+-+}
+-+
+-+// PriceRule adalah satu mata rantai penentuan harga (Technical Guideline 5.6). ok=false meneruskan ke aturan
+-+// berikutnya.
+-+type PriceRule interface {
+-+	Name() domain.Rule
+-+	Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error)
+-+}
+-+
+-+// Resolver menjalankan rantai aturan harga berurutan dan mengembalikan hasil aturan pertama yang cocok.
+-+type Resolver struct {
+-+	rules       []PriceRule
+-+	source      Source
+-+	eligibility Eligibility
+-+}
+-+
+-+// NewResolver menyusun rantai aturan. Urutan WAJIB sama dengan BRD 5.18 (lihat DefaultRules).
+-+func NewResolver(source Source, eligibility Eligibility, rules ...PriceRule) *Resolver {
+-+	return &Resolver{rules: rules, source: source, eligibility: eligibility}
+-+}
+-+
+-+// DefaultRules adalah rantai 5 aturan BRD 5.18: harga khusus → promo → bertingkat → daftar harga channel →
+-+// harga dasar.
+-+func DefaultRules(s Source) []PriceRule {
+-+	return []PriceRule{
+-+		SpecialPriceRule{Source: s},
+-+		PromotionRule{Source: s},
+-+		TieredPriceRule{Source: s},
+-+		ChannelPriceListRule{Source: s},
+-+		BasePriceRule{Source: s},
+-+	}
+-+}
+-+
+-+// errNoPrice: tidak ada aturan yang menghasilkan harga.
+-+func errNoPrice() error {
+-+	return apperr.WithMessage(apperr.CodeNotFound,
+-+		"Harga produk belum diatur: tidak ada harga khusus, promo, daftar harga, atau Harga Dasar & HET yang berlaku.")
+-+}
+-+
+-+// Resolve menentukan harga satu baris transaksi.
+-+func (r *Resolver) Resolve(ctx context.Context, req domain.PriceRequest) (domain.PriceQuote, error) {
+-+	if err := req.Validate(); err != nil {
+-+		return domain.PriceQuote{}, err
+-+	}
+-+	lists, err := r.candidateLists(ctx, req)
+-+	if err != nil {
+-+		return domain.PriceQuote{}, err
+-+	}
+-+	q := PriceQuery{PriceRequest: req, Lists: lists}
+-+	quote, ok, err := r.run(ctx, q, 0)
+-+	if err != nil {
+-+		return domain.PriceQuote{}, err
+-+	}
+-+	if !ok {
+-+		return domain.PriceQuote{}, errNoPrice()
+-+	}
+-+	return quote, nil
+-+}
+-+
+-+func (r *Resolver) run(ctx context.Context, q PriceQuery, from int) (domain.PriceQuote, bool, error) {
+-+	for i := from; i < len(r.rules); i++ {
+-+		next := i + 1
+-+		q.next = func(ctx context.Context) (domain.PriceQuote, bool, error) { return r.run(ctx, q, next) }
+-+		quote, ok, err := r.rules[i].Resolve(ctx, q)
+-+		if err != nil {
+-+			return domain.PriceQuote{}, false, fmt.Errorf("aturan harga %s: %w", r.rules[i].Name(), err)
+-+		}
+-+		if ok {
+-+			quote.Rule = r.rules[i].Name()
+-+			return quote, true, nil
+-+		}
+-+	}
+-+	return domain.PriceQuote{}, false, nil
+-+}
+-+
+-+// candidateLists menentukan daftar harga yang berlaku untuk transaksi, urut prioritas: daftar karyawan (pelanggan
+-+// tertaut karyawan aktif), daftar harga di PKS mitra yang berlaku, daftar per mitra, daftar sub-channel, lalu
+-+// daftar channel. Daftar nonaktif atau terhapus dilewati.
+-+func (r *Resolver) candidateLists(ctx context.Context, req domain.PriceRequest) ([]domain.PriceList, error) {
+-+	scope, err := r.source.ScopePriceLists(ctx, req.PartnerID, req.ChannelID, req.SubChannelID)
+-+	if err != nil {
+-+		return nil, err
+-+	}
+-+	var out []domain.PriceList
+-+	seen := map[uuid.UUID]bool{}
+-+	add := func(l domain.PriceList) {
+-+		if !seen[l.ID] && l.Usable() {
+-+			seen[l.ID] = true
+-+			out = append(out, l)
+-+		}
+-+	}
+-+	pick := func(match func(domain.PriceList) bool) {
+-+		for _, l := range scope {
+-+			if match(l) {
+-+				add(l)
+-+			}
+-+		}
+-+	}
+-+	if req.CustomerID != nil && r.eligibility != nil {
+-+		ok, err := r.eligibility.EmployeePriceEligible(ctx, *req.CustomerID, req.Date)
+-+		if err != nil {
+-+			return nil, err
+-+		}
+-+		if ok {
+-+			pick(func(l domain.PriceList) bool { return l.Type == domain.TypeEmployee })
+-+		}
+-+	}
+-+	if req.PartnerID != nil {
+-+		if r.eligibility != nil {
+-+			id, err := r.eligibility.PartnerAgreementPriceList(ctx, *req.PartnerID, req.Date)
+-+			if err != nil {
+-+				return nil, err
+-+			}
+-+			if id != nil {
+-+				l, err := r.source.PriceListByID(ctx, *id)
+-+				switch {
+-+				case apperr.HasCode(err, apperr.CodeNotFound):
+-+				case err != nil:
+-+					return nil, err
+-+				default:
+-+					add(l)
+-+				}
+-+			}
+-+		}
+-+		pick(func(l domain.PriceList) bool {
+-+			return l.Type == domain.TypePartner && l.PartnerID != nil && *l.PartnerID == *req.PartnerID
+-+		})
+-+	}
+-+	if req.ChannelID != nil {
+-+		isChannel := func(l domain.PriceList) bool {
+-+			return (l.Type == domain.TypeChannel || l.Type == domain.TypeVending) && l.ChannelID != nil && *l.ChannelID == *req.ChannelID
+-+		}
+-+		if req.SubChannelID != nil {
+-+			pick(func(l domain.PriceList) bool {
+-+				return isChannel(l) && l.SubChannelID != nil && *l.SubChannelID == *req.SubChannelID
+-+			})
+-+		}
+-+		pick(func(l domain.PriceList) bool { return isChannel(l) && l.SubChannelID == nil })
+-+	}
+-+	return out, nil
+-+}
+-+
+-+func ptr[T any](v T) *T { return &v }
+-+
+-+// SpecialPriceRule (prioritas 1): harga khusus pelanggan, lalu harga khusus mitra.
+-+type SpecialPriceRule struct{ Source Source }
+-+
+-+// Name mengembalikan nama aturan.
+-+func (SpecialPriceRule) Name() domain.Rule { return domain.RuleSpecialPrice }
+-+
+-+// Resolve mencari harga khusus yang berlaku.
+-+func (r SpecialPriceRule) Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error) {
+-+	parties := []struct {
+-+		t  domain.PartyType
+-+		id *uuid.UUID
+-+	}{{domain.PartyCustomer, q.CustomerID}, {domain.PartyPartner, q.PartnerID}}
+-+	for _, p := range parties {
+-+		if p.id == nil {
+-+			continue
+-+		}
+-+		sp, ok, err := r.Source.SpecialPriceOn(ctx, p.t, *p.id, q.ProductID, q.Date)
+-+		if err != nil || !ok {
+-+			if err != nil {
+-+				return domain.PriceQuote{}, false, err
+-+			}
+-+			continue
+-+		}
+-+		who := "pelanggan"
+-+		if p.t == domain.PartyPartner {
+-+			who = "mitra"
+-+		}
+-+		return domain.PriceQuote{
+-+			UnitPrice: sp.Price, SourceID: sp.ID, SpecialPriceID: ptr(sp.ID), Description: "Harga khusus " + who,
+-+		}, true, nil
+-+	}
+-+	return domain.PriceQuote{}, false, nil
+-+}
+-+
+-+// PromotionRule (prioritas 2): promo periode aktif untuk channel transaksi. Bila beberapa promo berlaku,
+-+// dipilih harga terendah. Potongan persen dihitung dari harga aturan berikutnya (harga tanpa promo).
+-+type PromotionRule struct{ Source Source }
+-+
+-+// Name mengembalikan nama aturan.
+-+func (PromotionRule) Name() domain.Rule { return domain.RulePromotion }
+-+
+-+// Resolve mencari promo yang berlaku.
+-+func (r PromotionRule) Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error) {
+-+	offers, err := r.Source.PromotionOffersOn(ctx, q.ProductID, q.ChannelID, q.SubChannelID, q.Date)
+-+	if err != nil || len(offers) == 0 {
+-+		return domain.PriceQuote{}, false, err
+-+	}
+-+	var (
+-+		regular    domain.PriceQuote
+-+		hasRegular bool
+-+		loaded     bool
+-+		best       *domain.PriceQuote
+-+	)
+-+	for _, o := range offers {
+-+		var price = o.Item.Price
+-+		desc := "Promo " + o.Code
+-+		var base *domain.PriceQuote
+-+		if o.Item.NeedsRegular() {
+-+			if !loaded {
+-+				if regular, hasRegular, err = q.Next(ctx); err != nil {
+-+					return domain.PriceQuote{}, false, err
+-+				}
+-+				loaded = true
+-+			}
+-+			if !hasRegular {
+-+				continue
+-+			}
+-+			p := o.Item.Offer(regular.UnitPrice)
+-+			price, base = &p, &regular
+-+			desc = fmt.Sprintf("Promo %s (potongan %s%%)", o.Code, o.Item.DiscountPercent.String())
+-+		}
+-+		if best != nil && price.Cmp(best.UnitPrice) >= 0 {
+-+			continue
+-+		}
+-+		quote := domain.PriceQuote{UnitPrice: *price, SourceID: o.PromotionID, PromotionID: ptr(o.PromotionID), Description: desc}
+-+		if base != nil {
+-+			quote.RegularPrice = ptr(base.UnitPrice)
+-+			quote.PriceListID, quote.PriceListVersionID = base.PriceListID, base.PriceListVersionID
+-+		}
+-+		best = &quote
+-+	}
+-+	if best == nil {
+-+		return domain.PriceQuote{}, false, nil
+-+	}
+-+	return *best, true, nil
+-+}
+-+
+-+// TieredPriceRule (prioritas 3): harga bertingkat qty minimum. Harga bertingkat milik daftar harga kandidat
+-+// pertama didahulukan, lalu harga bertingkat umum; dalam satu daftar dipilih qty minimum terbesar yang terpenuhi.
+-+type TieredPriceRule struct{ Source Source }
+-+
+-+// Name mengembalikan nama aturan.
+-+func (TieredPriceRule) Name() domain.Rule { return domain.RuleTieredPrice }
+-+
+-+// Resolve mencari harga bertingkat yang berlaku.
+-+func (r TieredPriceRule) Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error) {
+-+	tiers, err := r.Source.TieredPricesOn(ctx, q.ProductID, q.ListIDs(), q.Qty, q.Date)
+-+	if err != nil || len(tiers) == 0 {
+-+		return domain.PriceQuote{}, false, err
+-+	}
+-+	rank := func(t domain.TieredPrice) int {
+-+		if t.PriceListID == nil {
+-+			return len(q.Lists)
+-+		}
+-+		for i, l := range q.Lists {
+-+			if l.ID == *t.PriceListID {
+-+				return i
+-+			}
+-+		}
+-+		return -1
+-+	}
+-+	var best *domain.TieredPrice
+-+	bestRank := 0
+-+	for _, t := range tiers {
+-+		rk := rank(t)
+-+		if rk < 0 || t.MinQty.GreaterThan(q.Qty) || !t.Contains(q.Date) || t.Deleted() {
+-+			continue
+-+		}
+-+		if best == nil || rk < bestRank || (rk == bestRank && t.MinQty.GreaterThan(best.MinQty)) {
+-+			best, bestRank = &t, rk
+-+		}
+-+	}
+-+	if best == nil {
+-+		return domain.PriceQuote{}, false, nil
+-+	}
+-+	quote := domain.PriceQuote{
+-+		UnitPrice: best.Price, SourceID: best.ID, TieredPriceID: ptr(best.ID), PriceListID: best.PriceListID,
+-+		Description: fmt.Sprintf("Harga bertingkat qty ≥ %s", best.MinQty.String()),
+-+	}
+-+	return quote, true, nil
+-+}
+-+
+-+// ChannelPriceListRule (prioritas 4): daftar harga kandidat pertama yang memuat produk (karyawan, PKS mitra, mitra,
+-+// sub-channel, channel).
+-+type ChannelPriceListRule struct{ Source Source }
+-+
+-+// Name mengembalikan nama aturan.
+-+func (ChannelPriceListRule) Name() domain.Rule { return domain.RulePriceList }
+-+
+-+// Resolve mencari harga di daftar harga kandidat.
+-+func (r ChannelPriceListRule) Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error) {
+-+	for _, l := range q.Lists {
+-+		lp, ok, err := r.Source.ListPriceOn(ctx, l, q.ProductID, q.Date)
+-+		if err != nil {
+-+			return domain.PriceQuote{}, false, err
+-+		}
+-+		if ok {
+-+			return listQuote(lp, "Daftar harga "+lp.Name), true, nil
+-+		}
+-+	}
+-+	return domain.PriceQuote{}, false, nil
+-+}
+-+
+-+func listQuote(lp domain.ListPrice, desc string) domain.PriceQuote {
+-+	return domain.PriceQuote{
+-+		UnitPrice: lp.Price, SourceID: lp.VersionID, PriceListID: ptr(lp.PriceListID), PriceListVersionID: ptr(lp.VersionID),
+-+		MaxRetailPrice: lp.MaxRetailPrice, Description: desc,
+-+	}
+-+}
+-+
+-+// BasePriceRule (prioritas 5): Harga Dasar & HET.
+-+type BasePriceRule struct{ Source Source }
+-+
+-+// Name mengembalikan nama aturan.
+-+func (BasePriceRule) Name() domain.Rule { return domain.RuleBasePrice }
+-+
+-+// Resolve membaca harga dasar produk.
+-+func (r BasePriceRule) Resolve(ctx context.Context, q PriceQuery) (domain.PriceQuote, bool, error) {
+-+	base, err := r.Source.BasePriceList(ctx)
+-+	if apperr.HasCode(err, apperr.CodeNotFound) {
+-+		return domain.PriceQuote{}, false, nil
+-+	}
+-+	if err != nil {
+-+		return domain.PriceQuote{}, false, err
+-+	}
+-+	lp, ok, err := r.Source.ListPriceOn(ctx, base, q.ProductID, q.Date)
+-+	if err != nil || !ok {
+-+		return domain.PriceQuote{}, false, err
+-+	}
+-+	return listQuote(lp, "Harga dasar"), true, nil
+-+}
