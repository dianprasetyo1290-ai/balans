-	in.DeliveryNote, in.Note = strings.TrimSpace(in.DeliveryNote), strings.TrimSpace(in.Note)
-	if len([]rune(in.DeliveryNote)) > 100 {
-		fields["deliveryNote"] = "Nomor surat jalan maksimal 100 karakter"
