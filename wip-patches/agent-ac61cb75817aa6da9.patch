+		ID: r.ID, PeriodID: r.FiscalPeriodID, Period: domain.PeriodKey{Year: int(year), Month: time.Month(month)},
+		AssetCount: int(r.AssetCount), Total: money.FromDecimal(r.TotalAmount), RunCount: int(r.RunCount),
