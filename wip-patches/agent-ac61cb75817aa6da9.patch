index 54b5147..1505e20 100644
--- a/backend/internal/platform/jobqueue/jobqueue_test.go
+++ b/backend/internal/platform/jobqueue/jobqueue_test.go
@@ -80,3 +80,13 @@ func TestDailyAtUsesJakartaTime(t *testing.T) {
 	}
 	assert.Len(t, jobqueue.QueueConfig(), 3)
 }
+
+func TestMonthlyAtUsesJakartaTime(t *testing.T) {
+	sched := jobqueue.MonthlyAt{Day: 1, Hour: 1, Minute: 0}
+	// 1 Nov 2026 01.00 WIB = 31 Okt 2026 18.00 UTC.
+	first := time.Date(2026, 10, 31, 18, 0, 0, 0, time.UTC)
+	assert.Equal(t, first, sched.Next(time.Date(2026, 10, 17, 3, 0, 0, 0, time.UTC)))
+	assert.Equal(t, time.Date(2026, 11, 30, 18, 0, 0, 0, time.UTC), sched.Next(first), "tepat jadwal pindah ke bulan berikutnya")
+	// 1 Jan 2027 01.00 WIB = 31 Des 2026 18.00 UTC.
+	assert.Equal(t, time.Date(2026, 12, 31, 18, 0, 0, 0, time.UTC), sched.Next(time.Date(2026, 12, 15, 0, 0, 0, 0, time.UTC)))
+}
diff --git a/backend/internal/platform/jobqueue/schedule.go b/backend/internal/platform/jobqueue/schedule.go
index 6c58df5..5bcf6c4 100644
--- a/backend/internal/platform/jobqueue/schedule.go
+++ b/backend/internal/platform/jobqueue/schedule.go
@@ -21,3 +21,21 @@ func (d DailyAt) Next(t time.Time) time.Time {
 	}
 	return next.UTC()
 }
+
+// MonthlyAt adalah jadwal bulanan pada tanggal dan jam WIB tertentu (mis. penyusutan tanggal 1 pukul 01.00).
+// Day 1–28 agar selalu ada di setiap bulan.
+type MonthlyAt struct {
+	Day    int
+	Hour   int
+	Minute int
+}
+
+// Next mengembalikan waktu jalan berikutnya setelah t.
+func (m MonthlyAt) Next(t time.Time) time.Time {
+	local := t.In(clock.Jakarta)
+	next := time.Date(local.Year(), local.Month(), m.Day, m.Hour, m.Minute, 0, 0, clock.Jakarta)
+	if !next.After(local) {
+		next = time.Date(local.Year(), local.Month()+1, m.Day, m.Hour, m.Minute, 0, 0, clock.Jakarta)
+	}
+	return next.UTC()
+}
