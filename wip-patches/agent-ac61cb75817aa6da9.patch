+
+	"github.com/google/uuid"
+	"github.com/riverqueue/river"
+
+	"balans/internal/accounting/domain"
+	"balans/internal/accounting/postgres"
+	"balans/internal/accounting/service"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/jobqueue"
+	"balans/internal/platform/money"
+	"balans/internal/platform/paging"
+	"balans/internal/platform/tabular"
+)
+
+// API publik R1.4: aset tetap & penyusutan (S-408), Neraca Saldo (S-410), tutup buku (S-411), saldo awal &
+// cut-over (S-412), dan impor/ekspor transaksi (S-413).
+
+type (
+	// ApprovalSubject adalah dokumen yang diajukan accounting ke engine approval (buka kembali periode).
+	ApprovalSubject = service.ApprovalSubject
+	// ApprovalRequester dipasang saat wiring dengan adapter modul approval.
+	ApprovalRequester = service.ApprovalRequester
+	// PartyLookup mencari pelanggan/mitra/pemasok berdasarkan kode untuk impor piutang/utang terbuka.
+	PartyLookup = service.PartyLookup
+	// UserDirectory membaca nama user untuk halaman Tutup Buku.
+	UserDirectory = service.UserDirectory
+	// StockValuer menghitung nilai persediaan per akun untuk rekonsiliasi cut-over.
+	StockValuer = service.StockValuer
+	// CloseCheckFunc adalah hook pemeriksaan otomatis satu langkah checklist tutup buku.
+	CloseCheckFunc = service.CloseCheckFunc
+	// CloseCheck adalah hasil satu pemeriksaan otomatis.
+	CloseCheck = domain.CloseCheck
+	// CloseStepCode adalah kode langkah checklist tutup buku (BRD 5.15).
+	CloseStepCode = domain.CloseStepCode
+	// OpeningItem adalah piutang/utang terbuka saldo awal per dokumen lama.
+	OpeningItem = domain.OpeningItem
+	// OpeningItemType adalah jenis saldo terbuka (receivable/payable).
+	OpeningItemType = domain.OpeningItemType
+	// OpeningItemQuery adalah filter saldo terbuka.
+	OpeningItemQuery = postgres.OpeningItemFilter
+	// OpeningItemList adalah satu halaman saldo terbuka beserta total sisa.
+	OpeningItemList = service.OpeningItemList
+	// OpeningSettlement adalah pelunasan saldo terbuka oleh dokumen pembayaran.
+	OpeningSettlement = service.OpeningSettlement
+	// Reconciliation adalah hasil pengecekan rekonsiliasi cut-over.
+	Reconciliation = service.Reconciliation
+	// ReconciliationCheck adalah satu baris pengecekan rekonsiliasi.
+	ReconciliationCheck = domain.ReconciliationCheck
+)
+
+// Langkah checklist tutup buku untuk RegisterCloseCheck.
+const (
+	StepOperationalDocuments        = domain.StepOperationalDocuments
+	StepConsignmentVendingRecon     = domain.StepConsignmentVendingRecon
+	StepSettlementReconciliation    = domain.StepSettlementReconciliation
+	StepBankPettyCashReconciliation = domain.StepBankPettyCashReconciliation
+	StepPayroll                     = domain.StepPayroll
+	StepDepreciation                = domain.StepDepreciation
+	StepTaxRecap                    = domain.StepTaxRecap
+	StepInventoryReview             = domain.StepInventoryReview
+	StepFinancialReview             = domain.StepFinancialReview
+)
+
+// Jenis saldo terbuka, jenis pihak, dan jenis dokumen approval buka kembali periode.
+const (
+	OpeningReceivable = domain.OpeningReceivable
+	OpeningPayable    = domain.OpeningPayable
+	PartyCustomer     = domain.PartyCustomer
+	PartyPartner      = domain.PartyPartner
+	PartySupplier     = domain.PartySupplier
+
+	ApprovalSubjectFiscalPeriodReopen = domain.ApprovalSubjectFiscalPeriodReopen
+	// PermFiscalPeriodRead memberi hak melihat riwayat persetujuan buka kembali periode.
+	PermFiscalPeriodRead = service.PermFiscalPeriodRead
+	// SourceOpeningBalance adalah source type stok & jurnal saldo awal migrasi.
+	SourceOpeningBalance = domain.SourceOpeningBalance
+)
+
+// SetApprovals memasang pengaju approval buka kembali periode (dipanggil saat wiring).
+func (m *Module) SetApprovals(a ApprovalRequester) { m.svc.SetApprovals(a) }
+
+// SetUserDirectory memasang pembaca nama user (PIC checklist).
+func (m *Module) SetUserDirectory(u UserDirectory) { m.svc.SetUserDirectory(u) }
+
+// SetParties memasang pencari pihak untuk impor piutang/utang terbuka.
+func (m *Module) SetParties(p PartyLookup) { m.svc.SetParties(p) }
+
+// SetStockValuer memasang penghitung nilai persediaan rekonsiliasi cut-over.
+func (m *Module) SetStockValuer(v StockValuer) { m.svc.SetStockValuer(v) }
+
+// RegisterCloseCheck menambah pemeriksaan otomatis ke langkah checklist tutup buku; hasil yang tidak OK
+// menahan langkah ditandai Selesai dan menahan Tutup Periode. Modul dokumen (pengadaan, penjualan, gudang)
+// mendaftarkan cek "dokumen operasional belum diposting" pada StepOperationalDocuments.
+func (m *Module) RegisterCloseCheck(step CloseStepCode, fn CloseCheckFunc) {
+	m.svc.RegisterCloseCheck(step, fn)
+}
+
+// DecideReopen dipanggil handler approval `fiscal_period_reopen` di transaksi keputusan.
+func (m *Module) DecideReopen(ctx context.Context, requestID uuid.UUID, approved bool, decidedBy uuid.UUID, note string) error {
+	return m.svc.DecideReopen(ctx, requestID, approved, decidedBy, note)
+}
+
+// OpeningItems mengembalikan piutang/utang terbuka saldo awal (tanpa cek permission) agar umur piutang/utang
+// dan pelunasan di modul penjualan/pengadaan mencakup saldo migrasi.
+func (m *Module) OpeningItems(ctx context.Context, q OpeningItemQuery, page paging.Page) (OpeningItemList, error) {
+	return m.svc.OpeningItems(ctx, q, page)
+}
+
+// SettleOpeningItem mencatat pelunasan saldo terbuka oleh dokumen pembayaran di transaksi aktif (idempotent per
+// dokumen sumber). Jurnal pembayaran tetap diposting modul pembayar lewat Post (A-PB).
+func (m *Module) SettleOpeningItem(ctx context.Context, s OpeningSettlement) (OpeningItem, error) {
+	return m.svc.SettleOpeningItem(ctx, s)
+}
+
+// CutoverReconciliation menjalankan pengecekan rekonsiliasi cut-over (sub-ledger vs GL).
+func (m *Module) CutoverReconciliation(ctx context.Context) (Reconciliation, error) {
+	return m.svc.CutoverReconciliation(ctx)
+}
+
+// EnsureCutoverDate membuat saldo awal dengan tanggal cut-over bila belum ada (cmd/cutover).
+func (m *Module) EnsureCutoverDate(ctx context.Context, cutover clock.BusinessDate) error {
+	return m.svc.EnsureCutoverDate(ctx, cutover)
+}
+
+// CutoverDate mengembalikan tanggal cut-over saldo awal dan apakah sudah diposting; ok false bila belum diisi.
+// Tidak memeriksa permission.
+func (m *Module) CutoverDate(ctx context.Context) (date clock.BusinessDate, posted bool, ok bool, err error) {
+	set, ok, err := m.svc.CurrentOpeningSet(ctx)
+	if err != nil || !ok {
+		return clock.BusinessDate{}, false, false, err
+	}
+	return set.CutoverDate, set.Status == domain.OpeningPosted, true, nil
+}
+
+// PostOpeningBalances memposting Neraca Saldo Awal (A-36) versi terkini (cmd/cutover -post).
+func (m *Module) PostOpeningBalances(ctx context.Context) (journalNumber string, err error) {
+	v, err := m.svc.GetOpening(ctx)
+	if err != nil {
+		return "", err
+	}
+	if v.Set == nil {
+		return "", apperr.WithMessage(apperr.CodeValidationFailed, "Tanggal cut-over saldo awal belum diisi.")
+	}
+	if v.Set.Status == domain.OpeningPosted {
+		return v.Set.JournalNumber, nil
+	}
+	if v, err = m.svc.PostOpening(ctx, v.Set.Version); err != nil {
+		return "", err
+	}
+	return v.Set.JournalNumber, nil
+}
+
+// Depreciate menjalankan penyusutan periode (job, seed, test).
+func (m *Module) Depreciate(ctx context.Context, year int, month int) (assets int, total money.Amount, err error) {
+	r, err := m.svc.Depreciate(ctx, domain.PeriodKey{Year: year, Month: time.Month(month)})
+	return r.Run.AssetCount, r.Run.Total, err
+}
+
+// depreciationPeriodicJob menjadwalkan accounting.depreciate tanggal 1 pukul 01.00 WIB untuk bulan sebelumnya.
+func depreciationPeriodicJob() *river.PeriodicJob {
+	return river.NewPeriodicJob(jobqueue.MonthlyAt{Day: 1, Hour: 1, Minute: 0},
+		func() (river.JobArgs, *river.InsertOpts) { return service.DepreciateArgs{}, nil },
+		&river.PeriodicJobOpts{ID: service.DepreciateArgs{}.Kind()})
+}
+
+// --- Impor/ekspor Excel (S-412, S-413) ---------------------------------------------------------------
+
+// Kolom template impor/ekspor transaksi akuntansi.
+func OpeningBalanceColumns() []tabular.Column    { return service.OpeningBalanceColumns }
+func OpeningReceivableColumns() []tabular.Column { return service.OpeningReceivableColumns }
+func OpeningPayableColumns() []tabular.Column    { return service.OpeningPayableColumns }
+func OpeningAssetColumns() []tabular.Column      { return service.OpeningAssetColumns }
+func JournalImportColumns() []tabular.Column     { return service.JournalImportColumns }
+func TrialBalanceColumns() []tabular.Column      { return service.TrialBalanceColumns }
+func LedgerColumns() []tabular.Column            { return service.LedgerColumns }
+
+// ImportOpeningBalanceRow menyimpan satu baris Neraca Saldo Awal.
+func (m *Module) ImportOpeningBalanceRow(ctx context.Context, row tabular.Row) error {
+	return m.svc.ImportOpeningBalanceRow(ctx, row)
+}
+
+// ExportOpeningBalances mengalirkan Neraca Saldo Awal.
+func (m *Module) ExportOpeningBalances(ctx context.Context, emit func(tabular.Row) error) error {
+	return m.svc.ExportOpeningBalances(ctx, emit)
+}
+
+// ImportOpeningReceivableRow menyimpan satu piutang terbuka.
+func (m *Module) ImportOpeningReceivableRow(ctx context.Context, row tabular.Row) error {
+	return m.svc.ImportOpeningReceivableRow(ctx, row)
+}
+
+// ImportOpeningPayableRow menyimpan satu utang terbuka.
+func (m *Module) ImportOpeningPayableRow(ctx context.Context, row tabular.Row) error {
+	return m.svc.ImportOpeningPayableRow(ctx, row)
+}
+
+// ImportOpeningAssetRow membuat aset tetap saldo awal.
+func (m *Module) ImportOpeningAssetRow(ctx context.Context, row tabular.Row) error {
+	return m.svc.ImportOpeningAssetRow(ctx, row)
+}
+
+// ImportJournalRow menambah satu baris ke draft Jurnal Umum hasil impor; rowKey = dataexchange.RowKey.
+func (m *Module) ImportJournalRow(ctx context.Context, rowKey string, row tabular.Row) error {
+	return m.svc.ImportJournalRow(ctx, rowKey, row)
+}
+
+// ExportTrialBalance mengalirkan Neraca Saldo sesuai parameter ekspor (year+month atau dateFrom+dateTo, dimensi).
+func (m *Module) ExportTrialBalance(ctx context.Context, params map[string]string, emit func(tabular.Row) error) error {
+	return m.svc.ExportTrialBalance(ctx, params, emit)
+}
+
+// ExportLedger mengalirkan Buku Besar detail sesuai parameter ekspor (rentang, accountId opsional, dimensi).
+func (m *Module) ExportLedger(ctx context.Context, params map[string]string, emit func(tabular.Row) error) error {
+	return m.svc.ExportLedger(ctx, params, emit)
+}
diff --git a/backend/internal/accounting/domain/closing.go b/backend/internal/accounting/domain/closing.go
new file mode 100644
index 0000000..ddb6770
--- /dev/null
+++ b/backend/internal/accounting/domain/closing.go
@@ -0,0 +1,289 @@
+package domain
+
+import (
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"balans/internal/platform/apperr"
+)
+
+// PeriodPendingApproval: permintaan buka kembali menunggu approval; periode tetap terkunci.
+const PeriodPendingApproval PeriodStatus = "pending_approval"
+
+// Permission tutup buku (Desain Role & Approval 3.4): Finance RW (checklist), Head F&A P (tutup) + reopen ★.
+const (
+	PermFiscalPeriodPost   = "accounting.fiscal_period.post"
+	PermFiscalPeriodReopen = "accounting.fiscal_period.reopen"
+)
+
+// ApprovalSubjectFiscalPeriodReopen adalah jenis dokumen approval buka kembali periode (Head F&A → Direksi).
+// Nilainya sama dengan approval.SubjectFiscalPeriodReopen; accounting tidak mengimpor approval.
+const ApprovalSubjectFiscalPeriodReopen = "fiscal_period_reopen"
+
+// CloseStepCode adalah kode langkah checklist tutup buku (BRD 5.15).
+type CloseStepCode string
+
+const (
+	StepOperationalDocuments        CloseStepCode = "operational_documents"
+	StepConsignmentVendingRecon     CloseStepCode = "consignment_vending_reconciliation"
+	StepSettlementReconciliation    CloseStepCode = "settlement_reconciliation"
+	StepBankPettyCashReconciliation CloseStepCode = "bank_petty_cash_reconciliation"
+	StepPayroll                     CloseStepCode = "payroll"
+	StepDepreciation                CloseStepCode = "depreciation"
+	StepTaxRecap                    CloseStepCode = "tax_recap"
+	StepInventoryReview             CloseStepCode = "inventory_review"
+	StepFinancialReview             CloseStepCode = "financial_review"
+)
+
+// CloseStep adalah definisi satu langkah: urutan, aktivitas, dan PIC default BRD 5.15.
+type CloseStep struct {
+	Code     CloseStepCode
+	Order    int
+	Title    string
+	PICLabel string
+	// Automatic: diselesaikan sistem (penyusutan), user tetap bisa melihat statusnya.
+	Automatic bool
+}
+
+// CloseSteps adalah 9 langkah tutup buku bulanan berurutan (BRD 5.15).
+var CloseSteps = []CloseStep{
+	{StepOperationalDocuments, 1, "Semua dokumen operasional bulan berjalan sudah diposting (GR, DO, invoice, retur, pemakaian internal)", "Semua divisi", false},
+	{StepConsignmentVendingRecon, 2, "Rekonsiliasi konsinyasi & vending (stock count + Berita Acara)", "Sales MT, Admin Vending", false},
+	{StepSettlementReconciliation, 3, "Rekonsiliasi settlement Midtrans & marketplace", "Finance & Accounting", false},
+	{StepBankPettyCashReconciliation, 4, "Rekonsiliasi bank & kas kecil", "Finance & Accounting", false},
+	{StepPayroll, 5, "Payroll & jurnal payroll", "HRGA, Finance & Accounting", false},
+	{StepDepreciation, 6, "Penyusutan aset tetap (otomatis)", "Sistem", true},
+	{StepTaxRecap, 7, "Rekap PPh yang dipotong dan PPh Final (bila berlaku)", "Finance & Accounting", false},
+	{StepInventoryReview, 8, "Review selisih persediaan, stok kedaluwarsa, dan Barang Diterima Belum Ditagih", "Finance & Accounting, Head Logistik", false},
+	{StepFinancialReview, 9, "Review laporan keuangan, lalu tutup periode", "Head Finance & Accounting", false},
+}
+
+// StepByCode mencari definisi langkah.
+func StepByCode(code CloseStepCode) (CloseStep, bool) {
+	for _, s := range CloseSteps {
+		if s.Code == code {
+			return s, true
+		}
+	}
+	return CloseStep{}, false
+}
+
+// CloseStepStatus adalah status langkah (UI: Belum, Selesai, Tidak Berlaku).
+type CloseStepStatus string
+
+const (
+	StepPending CloseStepStatus = "pending"
+	StepDone    CloseStepStatus = "done"
+	StepSkipped CloseStepStatus = "skipped"
+)
+
+// Finished: langkah tidak lagi menahan tutup periode.
+func (s CloseStepStatus) Finished() bool { return s == StepDone || s == StepSkipped }
+
+// CloseCheck adalah hasil pemeriksaan otomatis satu langkah (hook modul lain atau accounting sendiri).
+type CloseCheck struct {
+	// Source adalah nama pemeriksa, mis. "Jurnal Umum draft".
+	Source  string
+	OK      bool
+	Message string
+	// Link adalah path ERP untuk menindaklanjuti, mis. /finance/journals?status=draft.
+	Link string
+}
+
+// ChecklistItem adalah status satu langkah checklist suatu periode.
+type ChecklistItem struct {
+	ID          uuid.UUID
+	PeriodID    uuid.UUID
+	Step        CloseStep
+	Status      CloseStepStatus
+	PICUserID   *uuid.UUID
+	CompletedBy *uuid.UUID
+	CompletedAt *time.Time
+	Note        string
+	Checks      []CloseCheck
+	UpdatedAt   time.Time
+	Version     int
+}
+
+// ChecksPassed: semua pemeriksaan otomatis lolos.
+func (c ChecklistItem) ChecksPassed() bool {
+	for _, chk := range c.Checks {
+		if !chk.OK {
+			return false
+		}
+	}
+	return true
+}
+
+// ChecklistUpdate adalah perubahan status/PIC/catatan satu langkah.
+type ChecklistUpdate struct {
+	Status    CloseStepStatus
+	PICUserID *uuid.UUID
+	Note      string
+}
+
+// Apply mengubah langkah. Langkah selesai butuh semua pemeriksaan otomatis lolos; Tidak Berlaku wajib catatan;
+// langkah 9 diselesaikan saat Tutup Periode.
+func (c *ChecklistItem) Apply(u ChecklistUpdate, by uuid.UUID, at time.Time) error {
+	note := strings.TrimSpace(u.Note)
+	fields := map[string]string{}
+	switch u.Status {
+	case StepPending, StepDone, StepSkipped:
+	default:
+		fields["status"] = "Status langkah tidak dikenal"
+	}
+	if len(note) > 1000 {
+		fields["note"] = "Catatan paling panjang 1000 karakter"
+	}
+	if u.Status == StepSkipped && note == "" {
+		fields["note"] = "Isi alasan langkah tidak berlaku"
+	}
+	if c.Step.Code == StepFinancialReview && u.Status != StepPending && u.Status != c.Status {
+		fields["status"] = "Langkah 9 selesai otomatis saat Tutup Periode"
+	}
+	if u.Status == StepDone && u.Status != c.Status && !c.ChecksPassed() {
+		for _, chk := range c.Checks {
+			if !chk.OK {
+				fields["status"] = chk.Message
+				break
+			}
+		}
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	if u.Status != c.Status {
+		if u.Status == StepPending {
+			c.CompletedBy, c.CompletedAt = nil, nil
+		} else {
+			c.CompletedBy, c.CompletedAt = &by, &at
+		}
+	}
+	c.Status, c.PICUserID, c.Note = u.Status, u.PICUserID, note
+	return nil
+}
+
+// CloseBlockers mengembalikan alasan periode belum bisa ditutup dari checklist: langkah 1–8 harus Selesai atau
+// Tidak Berlaku dan pemeriksaan otomatis lolos.
+func CloseBlockers(items []ChecklistItem) []string {
+	var out []string
+	for _, it := range items {
+		if it.Step.Code == StepFinancialReview {
+			continue
+		}
+		if !it.Status.Finished() {
+			out = append(out, "Langkah "+strconv.Itoa(it.Step.Order)+" belum selesai: "+it.Step.Title)
+			continue
+		}
+		if it.Status == StepDone {
+			for _, chk := range it.Checks {
+				if !chk.OK {
+					out = append(out, "Langkah "+strconv.Itoa(it.Step.Order)+": "+chk.Message)
+				}
+			}
+		}
+	}
+	return out
+}
+
+// Close menutup periode terbuka (Desain Status Dokumen 6.4).
+func (p *Period) Close(at time.Time, by uuid.UUID) error {
+	if p.Status != PeriodOpen {
+		return apperr.InvalidStateTransition("fiscal_period", string(p.Status), string(PeriodClosed))
+	}
+	p.Status, p.ClosedAt, p.ClosedBy = PeriodClosed, &at, &by
+	return nil
+}
+
+// RequestReopen memindahkan periode tertutup ke menunggu persetujuan buka kembali.
+func (p *Period) RequestReopen() error {
+	if p.Status != PeriodClosed {
+		return apperr.InvalidStateTransition("fiscal_period", string(p.Status), string(PeriodPendingApproval))
+	}
+	p.Status = PeriodPendingApproval
+	return nil
+}
+
+// ApproveReopen membuka kembali periode setelah approval terakhir.
+func (p *Period) ApproveReopen() error {
+	if p.Status != PeriodPendingApproval {
+		return apperr.InvalidStateTransition("fiscal_period", string(p.Status), string(PeriodOpen))
+	}
+	p.Status, p.ClosedAt, p.ClosedBy = PeriodOpen, nil, nil
+	p.ReopenedCount++
+	return nil
+}
+
+// RejectReopen mengembalikan periode ke Ditutup.
+func (p *Period) RejectReopen() error {
+	if p.Status != PeriodPendingApproval {
+		return apperr.InvalidStateTransition("fiscal_period", string(p.Status), string(PeriodClosed))
+	}
+	p.Status = PeriodClosed
+	return nil
+}
+
+// ValidateReopenReason memeriksa alasan buka kembali.
+func ValidateReopenReason(reason string) (string, error) {
+	reason = strings.TrimSpace(reason)
+	if reason == "" || len(reason) > 1000 {
+		return "", apperr.Validation(map[string]string{"reason": "Alasan buka kembali wajib diisi (maks. 1000 karakter)"})
+	}
+	return reason, nil
+}
+
+// ReopenStatus adalah status permintaan buka kembali.
+type ReopenStatus string
+
+const (
+	ReopenPending  ReopenStatus = "pending_approval"
+	ReopenApproved ReopenStatus = "approved"
+	ReopenRejected ReopenStatus = "rejected"
+)
+
+// ReopenRequest adalah permintaan buka kembali periode (ACC-14).
+type ReopenRequest struct {
+	ID           uuid.UUID
+	PeriodID     uuid.UUID
+	Reason       string
+	Status       ReopenStatus
+	RequestedBy  uuid.UUID
+	RequestedAt  time.Time
+	DecidedBy    *uuid.UUID
+	DecidedAt    *time.Time
+	DecisionNote string
+}
+
+// PeriodAction adalah aksi Tutup Buku yang boleh dilakukan user.
+type PeriodAction string
+
+const (
+	PeriodActionClose         PeriodAction = "close"
+	PeriodActionRequestReopen PeriodAction = "request_reopen"
+	PeriodActionEditChecklist PeriodAction = "edit_checklist"
+)
+
+// AllowedActions untuk tombol halaman Tutup Buku.
+func (p Period) AllowedActions(has func(string) bool) []PeriodAction {
+	out := []PeriodAction{}
+	switch p.Status {
+	case PeriodOpen:
+		if has(PermFiscalPeriodWrite) || has(PermFiscalPeriodPost) {
+			out = append(out, PeriodActionEditChecklist)
+		}
+		if has(PermFiscalPeriodPost) {
+			out = append(out, PeriodActionClose)
+		}
+	case PeriodClosed:
+		if has(PermFiscalPeriodReopen) {
+			out = append(out, PeriodActionRequestReopen)
+		}
+	}
+	return out
+}
+
+// PermFiscalPeriodWrite: Finance mengisi checklist (Desain Role & Approval 3.4).
+const PermFiscalPeriodWrite = "accounting.fiscal_period.write"
diff --git a/backend/internal/accounting/domain/closing_test.go b/backend/internal/accounting/domain/closing_test.go
new file mode 100644
index 0000000..cc0f984
--- /dev/null
+++ b/backend/internal/accounting/domain/closing_test.go
@@ -0,0 +1,126 @@
+package domain
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"balans/internal/platform/money"
+)
+
+func TestCloseStepsFollowBRD(t *testing.T) {
+	require.Len(t, CloseSteps, 9)
+	for i, s := range CloseSteps {
+		assert.Equal(t, i+1, s.Order)
+		got, ok := StepByCode(s.Code)
+		assert.True(t, ok)
+		assert.Equal(t, s, got)
+	}
+	_, ok := StepByCode("unknown")
+	assert.False(t, ok)
+	dep, _ := StepByCode(StepDepreciation)
+	assert.True(t, dep.Automatic)
+}
+
+func item(code CloseStepCode, status CloseStepStatus, checks ...CloseCheck) ChecklistItem {
+	st, _ := StepByCode(code)
+	return ChecklistItem{Step: st, Status: status, Checks: checks}
+}
+
+func TestChecklistApply(t *testing.T) {
+	by, at := uuid.New(), time.Now()
+	it := item(StepBankPettyCashReconciliation, StepPending)
+	require.NoError(t, it.Apply(ChecklistUpdate{Status: StepDone, Note: " ok "}, by, at))
+	assert.Equal(t, StepDone, it.Status)
+	assert.Equal(t, "ok", it.Note)
+	assert.Equal(t, &by, it.CompletedBy)
+	require.NoError(t, it.Apply(ChecklistUpdate{Status: StepPending}, by, at))
+	assert.Nil(t, it.CompletedAt)
+
+	assert.Contains(t, fieldsOf(it.Apply(ChecklistUpdate{Status: StepSkipped}, by, at)), "note", "Tidak Berlaku wajib alasan")
+	require.NoError(t, it.Apply(ChecklistUpdate{Status: StepSkipped, Note: "Belum ada payroll"}, by, at))
+	assert.Contains(t, fieldsOf(it.Apply(ChecklistUpdate{Status: "x"}, by, at)), "status")
+
+	blocked := item(StepOperationalDocuments, StepPending, CloseCheck{OK: false, Message: "Masih ada 2 Jurnal Umum draft"})
+	err := blocked.Apply(ChecklistUpdate{Status: StepDone}, by, at)
+	assert.Equal(t, "Masih ada 2 Jurnal Umum draft", fieldsOf(err)["status"])
+	assert.False(t, blocked.ChecksPassed())
+
+	last := item(StepFinancialReview, StepPending)
+	assert.Contains(t, fieldsOf(last.Apply(ChecklistUpdate{Status: StepDone}, by, at)), "status", "langkah 9 lewat Tutup Periode")
+	long := make([]byte, 1001)
+	assert.Contains(t, fieldsOf(it.Apply(ChecklistUpdate{Status: StepPending, Note: string(long)}, by, at)), "note")
+}
+
+func TestCloseBlockers(t *testing.T) {
+	var items []ChecklistItem
+	for _, s := range CloseSteps {
+		items = append(items, item(s.Code, StepDone))
+	}
+	items[8].Status = StepPending
+	assert.Empty(t, CloseBlockers(items), "langkah 9 tidak menahan")
+	items[2].Status = StepSkipped
+	assert.Empty(t, CloseBlockers(items))
+	items[0].Status = StepPending
+	items[5].Checks = []CloseCheck{{OK: false, Message: "2 aset tetap belum disusutkan"}}
+	b := CloseBlockers(items)
+	require.Len(t, b, 2)
+	assert.Contains(t, b[0], "Langkah 1")
+	assert.Contains(t, b[1], "Langkah 6: 2 aset tetap belum disusutkan")
+}
+
+func TestPeriodCloseReopenTransitions(t *testing.T) {
+	by := uuid.New()
+	p := Period{Status: PeriodOpen, Year: 2027, Month: time.January}
+	all := func(string) bool { return true }
+	assert.Equal(t, []PeriodAction{PeriodActionEditChecklist, PeriodActionClose}, p.AllowedActions(all))
+	assert.Error(t, p.RequestReopen())
+	require.NoError(t, p.Close(time.Now(), by))
+	assert.Error(t, p.CheckOpen(), "periode tertutup menolak transaksi")
+	assert.Error(t, p.Close(time.Now(), by))
+	assert.Equal(t, []PeriodAction{PeriodActionRequestReopen}, p.AllowedActions(all))
+	assert.Empty(t, p.AllowedActions(func(string) bool { return false }))
+
+	assert.Error(t, p.ApproveReopen())
+	require.NoError(t, p.RequestReopen())
+	assert.Equal(t, PeriodPendingApproval, p.Status)
+	assert.Error(t, p.CheckOpen(), "menunggu persetujuan tetap terkunci")
+	assert.Empty(t, p.AllowedActions(all))
+	require.NoError(t, p.RejectReopen())
+	assert.Equal(t, PeriodClosed, p.Status)
+	assert.Error(t, p.RejectReopen())
+
+	require.NoError(t, p.RequestReopen())
+	require.NoError(t, p.ApproveReopen())
+	assert.Equal(t, PeriodOpen, p.Status)
+	assert.Equal(t, 1, p.ReopenedCount)
+	assert.Nil(t, p.ClosedAt)
+
+	_, err := ValidateReopenReason("  ")
+	assert.Error(t, err)
+	r, err := ValidateReopenReason(" koreksi HPP ")
+	require.NoError(t, err)
+	assert.Equal(t, "koreksi HPP", r)
+}
+
+func TestTrialBalanceTotals(t *testing.T) {
+	rows := []TrialBalanceRow{
+		{AccountCode: "1111", OpeningNet: money.FromInt(1000), PeriodDebit: money.FromInt(500), PeriodCredit: money.FromInt(200)},
+		{AccountCode: "3101", OpeningNet: money.FromInt(-1000)},
+		{AccountCode: "4101", PeriodCredit: money.FromInt(500), PeriodDebit: money.Zero},
+		{AccountCode: "6301", PeriodDebit: money.FromInt(200), PeriodCredit: money.Zero},
+	}
+	assert.Equal(t, "1300.00", rows[0].ClosingNet().String())
+	d, c := SplitNet(money.FromInt(-5))
+	assert.Equal(t, "0.00", d.String())
+	assert.Equal(t, "5.00", c.String())
+	tot := TrialBalanceTotalsOf(rows)
+	assert.True(t, tot.Balanced())
+	assert.Equal(t, "1000.00", tot.OpeningDebit.String())
+	assert.Equal(t, "1500.00", tot.ClosingDebit.String())
+	rows[3].PeriodDebit = money.FromInt(201)
+	assert.False(t, TrialBalanceTotalsOf(rows).Balanced())
+}
