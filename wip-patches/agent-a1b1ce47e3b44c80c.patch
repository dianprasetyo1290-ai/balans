-+// maklon, reprocess), dan uang muka pembelian (BRD 5.2, 5.3; Desain Status Dokumen 2.1 – 2.2). Tanpa DB, HTTP,
-+// atau waktu sistem.
-+package domain
-+
-+import (
-+	"fmt"
-+	"slices"
-+	"strings"
-+
-+	"github.com/shopspring/decimal"
-+
-+	"balans/internal/platform/apperr"
