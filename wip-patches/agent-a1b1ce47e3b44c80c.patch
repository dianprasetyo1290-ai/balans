-+		f.add(field, fmt.Sprintf("%s harus %s sampai %s", label, low, high.String()))
-+		return nil
-+	case !d.Equal(d.Round(money.RateScale)):
-+		f.add(field, label+" paling banyak 4 angka desimal")
-+		return nil
-+	}
-+	return &d
-+}
-+
-+var hundred = decimal.NewFromInt(100)
