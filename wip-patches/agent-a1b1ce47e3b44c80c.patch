+func (s *Store) attachUsageLines(ctx context.Context, docs []domain.InternalUsage) error {
+	if len(docs) == 0 {
+		return nil
+	}
+	ids := make([]uuid.UUID, len(docs))
+	idx := map[uuid.UUID]int{}
+	for i, d := range docs {
