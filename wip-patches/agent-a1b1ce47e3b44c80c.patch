-			continue
-		}
-		parts := make([]string, len(identity))
-		empty := true
-		for i, c := range identity {
-			parts[i] = strings.ToUpper(r.Get(c.Key))
-			empty = empty && parts[i] == ""
-		}
-		if empty {
