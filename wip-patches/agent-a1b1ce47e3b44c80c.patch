+func dispositionRefIDs(docs ...domain.ReturnDisposition) refIDs {
+	var ids refIDs
+	for _, d := range docs {
+		ids.locations = append(ids.locations, d.LocationID)
+		for _, l := range d.Lines {
+			ids.products = append(ids.products, l.ProductID)
