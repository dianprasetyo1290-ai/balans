+	at   *time.Time
+}
+
+func fromStep(s *domain.Step) stepCols {
+	if s == nil {
+		return stepCols{}
+	}
+	at := s.At
+	return stepCols{by: uuid.NullUUID{UUID: s.By, Valid: true}, name: s.Name, at: &at}
