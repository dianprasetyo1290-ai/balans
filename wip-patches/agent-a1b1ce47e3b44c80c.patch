diff --git a/backend/internal/inventory/domain/disposal.go b/backend/internal/inventory/domain/disposal.go
new file mode 100644
index 0000000..6518a8a
--- /dev/null
+++ b/backend/internal/inventory/domain/disposal.go
@@ -0,0 +1,294 @@
+package domain
+
+import (
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// DisposalReason adalah alasan pemusnahan (Desain Data Model `disposals.reason`).
+type DisposalReason string
+
+const (
+	DisposalExpired DisposalReason = "expired"
+	DisposalDamaged DisposalReason = "damaged"
+	// DisposalReturn: barang dari Gudang Retur (disposisi retur), dijurnal A-26 (Dr 6403, Cr 1314).
+	DisposalReturn DisposalReason = "return"
+)
+
+var disposalReasonLabels = map[DisposalReason]string{
+	DisposalExpired: "Kedaluwarsa", DisposalDamaged: "Rusak", DisposalReturn: "Barang Retur",
+}
+
+// Valid memeriksa alasan.
+func (r DisposalReason) Valid() bool {
+	_, ok := disposalReasonLabels[r]
+	return ok
+}
+
+// Label adalah label alasan.
+func (r DisposalReason) Label() string { return disposalReasonLabels[r] }
+
+// PostingRule memilih jurnal: barang retur A-26 (musnah), kedaluwarsa/rusak di gudang A-27 (Desain Finance 2.1).
+func (r DisposalReason) PostingRule() string {
+	if r == DisposalReturn {
+		return "A-26"
+	}
+	return "A-27"
+}
+
+// Batas berita acara.
+const (
+	MaxWitnesses      = 10
+	MaxPhotos         = 10
+	MaxWitnessLength  = 120
+	MaxMethodLength   = 500
+	MinWitnessesForBA = 1
+	MinPhotosForBA    = 1
+)
+
+// Disposal adalah dokumen Pemusnahan dengan Berita Acara (INV-12): draft → pending_approval → approved → posted.
+type Disposal struct {
+	ID                  uuid.UUID
+	Number              string
+	Reason              DisposalReason
+	DisposalDate        clock.BusinessDate
+	Method              string
+	Witnesses           []string
+	PhotoFileIDs        []uuid.UUID
+	Note                string
+	Status              DocStatus
+	EstimatedCost       decimal.Decimal
+	CostAmount          decimal.Decimal
+	PostingRuleCode     string
+	JournalID           *uuid.UUID
+	ReturnDispositionID *uuid.UUID
+	CreatedBy           Actor
+	Submitted           *Step
+	Posted              *Step
+	Lines               []DisposalLine
+	CreatedAt           time.Time
+	UpdatedAt           time.Time
+	Version             int
+}
+
+// DisposalLine adalah barang yang dimusnahkan.
+type DisposalLine struct {
+	ID          uuid.UUID
+	LineNo      int
+	ProductID   uuid.UUID
+	BatchID     *uuid.UUID
+	LocationID  uuid.UUID
+	StockStatus StockStatus
+	Qty         decimal.Decimal
+	CostAmount  decimal.Decimal
+	Note        string
+}
+
+// DisposalLineInput adalah isian baris.
+type DisposalLineInput struct {
+	ProductID   uuid.UUID
+	BatchID     *uuid.UUID
+	LocationID  uuid.UUID
+	StockStatus StockStatus
+	Qty         decimal.Decimal
+	Note        string
+}
+
+// DisposalReport adalah isi berita acara: tanggal, metode, saksi, foto.
+type DisposalReport struct {
+	DisposalDate clock.BusinessDate
+	Method       string
+	Witnesses    []string
+	PhotoFileIDs []uuid.UUID
+}
+
+// DisposalInput adalah isian form Pemusnahan.
+type DisposalInput struct {
+	Reason DisposalReason
+	DisposalReport
+	Note  string
+	Lines []DisposalLineInput
+}
+
+// NewDisposal memvalidasi dan membuat draft.
+func NewDisposal(in DisposalInput, by Actor) (Disposal, error) {
+	d := Disposal{Status: DocDraft, CreatedBy: by, EstimatedCost: decimal.Zero, CostAmount: decimal.Zero}
+	if err := d.apply(in); err != nil {
+		return Disposal{}, err
+	}
+	return d, nil
+}
+
+// Update mengganti isian draft.
+func (d *Disposal) Update(in DisposalInput) error {
+	if d.Status != DocDraft {
+		return errTransition(ActionEdit, d.Status)
+	}
+	return d.apply(in)
+}
+
+func normalizeReport(fields map[string]string, r DisposalReport) DisposalReport {
+	if r.DisposalDate.IsZero() {
+		fields["disposalDate"] = "Tanggal pemusnahan wajib diisi"
+	}
+	r.Method = strings.TrimSpace(r.Method)
+	if len([]rune(r.Method)) > MaxMethodLength {
+		fields["method"] = "Metode maksimal 500 karakter"
+	}
+	var witnesses []string
+	for i, w := range r.Witnesses {
+		w = strings.TrimSpace(w)
+		if w == "" {
+			continue
+		}
+		if len([]rune(w)) > MaxWitnessLength {
+			fields[docLineField(i, "witness")] = "Nama saksi maksimal 120 karakter"
+		}
+		witnesses = append(witnesses, w)
+	}
+	if len(witnesses) > MaxWitnesses {
+		fields["witnesses"] = "Maksimal 10 saksi"
+	}
+	if len(r.PhotoFileIDs) > MaxPhotos {
+		fields["photoFileIds"] = "Maksimal 10 foto"
+	}
+	r.Witnesses = witnesses
+	if r.Witnesses == nil {
+		r.Witnesses = []string{}
+	}
+	if r.PhotoFileIDs == nil {
+		r.PhotoFileIDs = []uuid.UUID{}
+	}
+	return r
+}
+
+func (d *Disposal) apply(in DisposalInput) error {
+	fields := map[string]string{}
+	if !in.Reason.Valid() {
+		fields["reason"] = "Alasan pemusnahan tidak valid"
+	}
+	report := normalizeReport(fields, in.DisposalReport)
+	note := checkNote(fields, "note", in.Note)
+	checkLineCount(fields, len(in.Lines))
+	lines := make([]DisposalLine, len(in.Lines))
+	for i, l := range in.Lines {
+		if l.StockStatus == "" {
+			l.StockStatus = StatusAvailable
+		}
+		if l.ProductID == uuid.Nil {
+			fields[docLineField(i, "productId")] = "Produk wajib diisi"
+		}
+		if l.LocationID == uuid.Nil {
+			fields[docLineField(i, "locationId")] = "Lokasi wajib diisi"
+		}
+		if l.StockStatus != StatusAvailable && l.StockStatus != StatusQuarantine {
+			fields[docLineField(i, "stockStatus")] = "Status stok harus Tersedia atau Karantina"
+		}
+		checkQty(fields, docLineField(i, "qty"), l.Qty)
+		lines[i] = DisposalLine{
+			LineNo: i + 1, ProductID: l.ProductID, BatchID: l.BatchID, LocationID: l.LocationID, StockStatus: l.StockStatus,
+			Qty: l.Qty, CostAmount: decimal.Zero, Note: checkNote(fields, docLineField(i, "note"), l.Note),
+		}
+	}
+	if err := validationOrNil(fields); err != nil {
+		return err
+	}
+	d.Reason, d.DisposalDate, d.Method = in.Reason, report.DisposalDate, report.Method
+	d.Witnesses, d.PhotoFileIDs, d.Note, d.Lines = report.Witnesses, report.PhotoFileIDs, note, lines
+	return nil
+}
+
+// UpdateReport mengubah isi berita acara (draft atau sudah disetujui, sebelum posting).
+func (d *Disposal) UpdateReport(r DisposalReport) error {
+	if d.Status != DocDraft && d.Status != DocApproved {
+		return errTransition(ActionReport, d.Status)
+	}
+	fields := map[string]string{}
+	r = normalizeReport(fields, r)
+	if err := validationOrNil(fields); err != nil {
+		return err
+	}
+	d.DisposalDate, d.Method, d.Witnesses, d.PhotoFileIDs = r.DisposalDate, r.Method, r.Witnesses, r.PhotoFileIDs
+	return nil
+}
+
+// ReportComplete memeriksa kelengkapan berita acara sebelum posting (metode, saksi, foto).
+func (d Disposal) ReportComplete() error {
+	fields := map[string]string{}
+	if d.Method == "" {
+		fields["method"] = "Metode pemusnahan wajib diisi sebelum posting"
+	}
+	if len(d.Witnesses) < MinWitnessesForBA {
+		fields["witnesses"] = "Minimal satu saksi sebelum posting"
+	}
+	if len(d.PhotoFileIDs) < MinPhotosForBA {
+		fields["photoFileIds"] = "Minimal satu foto sebelum posting"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+var disposalTransitions = []transition{
+	{ActionSubmit, []DocStatus{DocDraft}, DocPendingApproval},
+	{ActionApprove, []DocStatus{DocPendingApproval}, DocApproved},
+	{ActionReject, []DocStatus{DocPendingApproval}, DocRejected},
+	{ActionRevise, []DocStatus{DocRejected}, DocDraft},
+	{ActionExecute, []DocStatus{DocApproved}, DocPosted},
+	{ActionCancel, []DocStatus{DocDraft, DocApproved}, DocCancelled},
+}
+
+// Transition menjalankan aksi pemusnahan; posting mewajibkan berita acara lengkap.
+func (d *Disposal) Transition(a DocAction) error {
+	to, ok := findTransition(disposalTransitions, a, d.Status)
+	if !ok {
+		return errTransition(a, d.Status)
+	}
+	if a == ActionExecute {
+		if err := d.ReportComplete(); err != nil {
+			return err
+		}
+	}
+	d.Status = to
+	return nil
+}
+
+// Permission Pemusnahan (Desain Role & Approval 3.2). Head Logistik mengajukan (S).
+const (
+	PermDisposalRead   = "inventory.disposal.read"
+	PermDisposalWrite  = "inventory.disposal.write"
+	PermDisposalSubmit = "inventory.disposal.submit"
+	PermDisposalPost   = "inventory.disposal.post"
+)
+
+// AllowedActions mengembalikan aksi yang bisa dilakukan pemegang permission.
+func (d Disposal) AllowedActions(has func(string) bool) []DocAction {
+	var out []DocAction
+	if d.Status == DocDraft && has(PermDisposalWrite) {
+		out = append(out, ActionEdit)
+	}
+	if (d.Status == DocDraft || d.Status == DocApproved) && has(PermDisposalWrite) {
+		out = append(out, ActionReport)
+	}
+	perms := map[DocAction]string{
+		ActionSubmit: PermDisposalSubmit, ActionRevise: PermDisposalWrite, ActionExecute: PermDisposalPost,
+		ActionCancel: PermDisposalWrite,
+	}
+	for _, a := range []DocAction{ActionSubmit, ActionRevise, ActionExecute, ActionCancel} {
+		if _, ok := findTransition(disposalTransitions, a, d.Status); ok && has(perms[a]) {
+			// Pemusnahan dari Disposisi Retur sudah disetujui lewat disposisi; batal lewat disposisi tidak ada.
+			if a == ActionCancel && d.ReturnDispositionID != nil {
+				continue
+			}
+			out = append(out, a)
+		}
+	}
+	return out
+}
diff --git a/backend/internal/inventory/domain/document.go b/backend/internal/inventory/domain/document.go
new file mode 100644
index 0000000..5d1d113
--- /dev/null
+++ b/backend/internal/inventory/domain/document.go
@@ -0,0 +1,153 @@
+package domain
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+)
+
+// DocStatus adalah status dokumen persediaan (Desain Status Dokumen bagian 1).
+type DocStatus string
+
+const (
+	DocDraft              DocStatus = "draft"
+	DocPendingApproval    DocStatus = "pending_approval"
+	DocApproved           DocStatus = "approved"
+	DocRejected           DocStatus = "rejected"
+	DocInProgress         DocStatus = "in_progress"
+	DocAwaitingSettlement DocStatus = "awaiting_settlement"
+	DocPosted             DocStatus = "posted"
+	DocCancelled          DocStatus = "cancelled"
+)
+
+var docStatusLabels = map[DocStatus]string{
+	DocDraft: "Draft", DocPendingApproval: "Menunggu Persetujuan", DocApproved: "Disetujui", DocRejected: "Ditolak",
+	DocInProgress: "Diproses", DocAwaitingSettlement: "Menunggu Penyelesaian", DocPosted: "Diposting",
+	DocCancelled: "Dibatalkan",
+}
+
+// Label adalah label status untuk tampilan.
+func (s DocStatus) Label() string { return docStatusLabels[s] }
+
+// Valid memeriksa status.
+func (s DocStatus) Valid() bool {
+	_, ok := docStatusLabels[s]
+	return ok
+}
+
+// DocAction adalah aksi bernama dokumen (allowedActions, Technical Guideline 5.4).
+type DocAction string
+
+const (
+	ActionEdit     DocAction = "edit"
+	ActionSubmit   DocAction = "submit"
+	ActionApprove  DocAction = "approve"
+	ActionReject   DocAction = "reject"
+	ActionRevise   DocAction = "revise"
+	ActionRelease  DocAction = "release"
+	ActionHandover DocAction = "handover"
+	ActionSettle   DocAction = "settle"
+	ActionStart    DocAction = "start"
+	ActionReport   DocAction = "report"
+	ActionExecute  DocAction = "post"
+	ActionCancel   DocAction = "cancel"
+)
+
+// transition adalah satu baris tabel transisi: aksi dari status asal ke status tujuan.
+type transition struct {
+	action DocAction
+	from   []DocStatus
+	to     DocStatus
+}
+
+func findTransition(table []transition, a DocAction, from DocStatus) (DocStatus, bool) {
+	for _, t := range table {
+		if t.action == a && slices.Contains(t.from, from) {
+			return t.to, true
+		}
+	}
+	return "", false
+}
+
+// errTransition menolak aksi yang tidak berlaku untuk status dokumen.
+func errTransition(a DocAction, s DocStatus) error {
+	return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+		fmt.Sprintf("Aksi %s tidak bisa dilakukan pada dokumen berstatus %s", a, s.Label()))
+}
+
+// CheckVersion menolak perubahan dengan versi lama (optimistic locking, TG 7.2).
+func CheckVersion(current, given int) error {
+	if current != given {
+		return apperr.New(apperr.CodeVersionConflict)
+	}
+	return nil
+}
+
+// Actor adalah pelaku sebuah langkah dokumen (ID + nama snapshot).
+type Actor struct {
+	ID   uuid.UUID
+	Name string
+}
+
+// Step adalah pelaku dan waktu satu langkah dokumen; nil = belum terjadi.
+type Step struct {
+	By   uuid.UUID
+	Name string
+	At   time.Time
+}
+
+// NewStep membuat langkah dari pelaku.
+func NewStep(a Actor, at time.Time) *Step { return &Step{By: a.ID, Name: a.Name, At: at} }
+
+// Batas dokumen.
+const (
+	MaxDocLines      = 100
+	MaxDocNoteLength = 500
+)
+
+func checkNote(fields map[string]string, key, note string) string {
+	note = strings.TrimSpace(note)
+	if len([]rune(note)) > MaxDocNoteLength {
+		fields[key] = "Maksimal 500 karakter"
+	}
+	return note
+}
+
+func checkLineCount(fields map[string]string, n int) {
+	switch {
+	case n == 0:
+		fields["lines"] = "Minimal satu baris"
+	case n > MaxDocLines:
+		fields["lines"] = fmt.Sprintf("Maksimal %d baris", MaxDocLines)
+	}
+}
+
+func checkQty(fields map[string]string, key string, q decimal.Decimal) {
+	if msg := ValidateQty(q); msg != "" {
+		fields[key] = msg
+	}
+}
+
+func docLineField(i int, f string) string { return fmt.Sprintf("lines[%d].%s", i, f) }
+
+func validationOrNil(fields map[string]string) error {
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+// SumDecimal menjumlahkan nilai.
+func SumDecimal(values ...decimal.Decimal) decimal.Decimal {
+	total := decimal.Zero
+	for _, v := range values {
+		total = total.Add(v)
+	}
+	return total
+}
diff --git a/backend/internal/inventory/domain/internal_usage.go b/backend/internal/inventory/domain/internal_usage.go
new file mode 100644
index 0000000..7665ed6
--- /dev/null
+++ b/backend/internal/inventory/domain/internal_usage.go
@@ -0,0 +1,308 @@
+package domain
+
+import (
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// UsagePurpose adalah tujuan Pemakaian Internal FG (INV-05, HR-02).
+type UsagePurpose string
+
+const (
+	PurposeMarketing      UsagePurpose = "marketing"
+	PurposeEvent          UsagePurpose = "event"
+	PurposeEmployeeSample UsagePurpose = "employee_sample"
+	PurposeSalesSampling  UsagePurpose = "sales_sampling"
+)
+
+var purposeLabels = map[UsagePurpose]string{
+	PurposeMarketing: "Marketing", PurposeEvent: "Event", PurposeEmployeeSample: "Sampel Karyawan",
+	PurposeSalesSampling: "Sampling Sales",
+}
+
+// Valid memeriksa tujuan.
+func (p UsagePurpose) Valid() bool {
+	_, ok := purposeLabels[p]
+	return ok
+}
+
+// Label adalah label tujuan.
+func (p UsagePurpose) Label() string { return purposeLabels[p] }
+
+// RequiresCampaign: semua tujuan kecuali sampel karyawan dibebankan ke Biaya Marketing (A-11) yang wajib kode
+// kampanye (Desain Finance & Accounting 3.3; sampling sales U-19).
+func (p UsagePurpose) RequiresCampaign() bool { return p != PurposeEmployeeSample }
+
+// PostingRule adalah rule jurnal pemakaian: A-12 sampel karyawan, selain itu A-11.
+func (p UsagePurpose) PostingRule() string {
+	if p == PurposeEmployeeSample {
+		return "A-12"
+	}
+	return "A-11"
+}
+
+// InternalUsage adalah dokumen Pemakaian Internal (Desain Status Dokumen 4.1).
+type InternalUsage struct {
+	ID               uuid.UUID
+	Number           string
+	Purpose          UsagePurpose
+	DivisionID       uuid.UUID
+	CampaignID       *uuid.UUID
+	SourceLocationID uuid.UUID
+	EventLocationID  *uuid.UUID
+	EventEndDate     *clock.BusinessDate
+	// SettleDueDate = tanggal selesai event + 1 (sisa wajib dicatat maks. H+1).
+	SettleDueDate *clock.BusinessDate
+	BusinessDate  clock.BusinessDate
+	Note          string
+	Status        DocStatus
+	EstimatedCost decimal.Decimal
+	CostAmount    decimal.Decimal
+	JournalID     *uuid.UUID
+	// ReturnDispositionID: dibuat dari Disposisi Retur (sampel) dan langsung berstatus Disetujui.
+	ReturnDispositionID *uuid.UUID
+	RequestedBy         Actor
+	Released            *Step
+	HandedOver          *Step
+	Settled             *Step
+	Posted              *Step
+	RemindedOn          *clock.BusinessDate
+	Lines               []UsageLine
+	CreatedAt           time.Time
+	UpdatedAt           time.Time
+	Version             int
+}
+
+// UsageLine adalah satu baris pemakaian. ConsumedQty = Qty − ReturnedQty; CostAmount atas ConsumedQty.
+type UsageLine struct {
+	ID          uuid.UUID
+	LineNo      int
+	ProductID   uuid.UUID
+	Qty         decimal.Decimal
+	ReturnedQty decimal.Decimal
+	ConsumedQty decimal.Decimal
+	CostAmount  decimal.Decimal
+	Note        string
+}
+
+// IsEvent memeriksa apakah pemakaian untuk event (stok dipindah ke lokasi Event dulu).
+func (u InternalUsage) IsEvent() bool { return u.Purpose == PurposeEvent }
+
+// UsageLineInput adalah isian baris.
+type UsageLineInput struct {
+	ProductID uuid.UUID
+	Qty       decimal.Decimal
+	Note      string
+}
+
+// InternalUsageInput adalah isian form Pemakaian Internal.
+type InternalUsageInput struct {
+	Purpose          UsagePurpose
+	DivisionID       uuid.UUID
+	CampaignID       *uuid.UUID
+	SourceLocationID uuid.UUID
+	EventLocationID  *uuid.UUID
+	EventEndDate     *clock.BusinessDate
+	BusinessDate     clock.BusinessDate
+	Note             string
+	Lines            []UsageLineInput
+}
+
+// NewInternalUsage memvalidasi isian dan membuat draft. Jenis lokasi, produk, dan dimensi diperiksa service.
+func NewInternalUsage(in InternalUsageInput, by Actor) (InternalUsage, error) {
+	u := InternalUsage{Status: DocDraft, RequestedBy: by, EstimatedCost: decimal.Zero, CostAmount: decimal.Zero}
+	if err := u.apply(in, false); err != nil {
+		return InternalUsage{}, err
+	}
+	return u, nil
+}
+
+// Update mengganti isian draft.
+func (u *InternalUsage) Update(in InternalUsageInput) error {
+	if u.Status != DocDraft {
+		return errTransition(ActionEdit, u.Status)
+	}
+	return u.apply(in, u.ReturnDispositionID != nil)
+}
+
+func (u *InternalUsage) apply(in InternalUsageInput, fromDisposition bool) error {
+	fields := map[string]string{}
+	if !in.Purpose.Valid() {
+		fields["purpose"] = "Tujuan pemakaian tidak valid"
+	}
+	if in.DivisionID == uuid.Nil {
+		fields["divisionId"] = "Divisi wajib diisi"
+	}
+	if in.Purpose.Valid() && in.Purpose.RequiresCampaign() && in.CampaignID == nil && !fromDisposition {
+		fields["campaignId"] = "Kode kampanye wajib diisi untuk pemakaian marketing, event, dan sampling sales"
+	}
+	if in.SourceLocationID == uuid.Nil {
+		fields["sourceLocationId"] = "Lokasi asal wajib diisi"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	var due *clock.BusinessDate
+	if in.Purpose == PurposeEvent {
+		if in.EventLocationID == nil || *in.EventLocationID == uuid.Nil {
+			fields["eventLocationId"] = "Lokasi Event wajib diisi"
+		}
+		switch {
+		case in.EventEndDate == nil:
+			fields["eventEndDate"] = "Tanggal selesai event wajib diisi"
+		case !in.BusinessDate.IsZero() && in.EventEndDate.Before(in.BusinessDate):
+			fields["eventEndDate"] = "Tanggal selesai event tidak boleh sebelum tanggal pemakaian"
+		default:
+			d := in.EventEndDate.AddDays(1)
+			due = &d
+		}
+	} else {
+		in.EventLocationID, in.EventEndDate = nil, nil
+	}
+	note := checkNote(fields, "note", in.Note)
+	checkLineCount(fields, len(in.Lines))
+	seen := map[uuid.UUID]bool{}
+	lines := make([]UsageLine, len(in.Lines))
+	for i, l := range in.Lines {
+		if l.ProductID == uuid.Nil {
+			fields[docLineField(i, "productId")] = "Produk wajib diisi"
+		} else if seen[l.ProductID] {
+			fields[docLineField(i, "productId")] = "Produk sudah ada di baris lain"
+		}
+		seen[l.ProductID] = true
+		checkQty(fields, docLineField(i, "qty"), l.Qty)
+		lines[i] = UsageLine{
+			LineNo: i + 1, ProductID: l.ProductID, Qty: l.Qty, ReturnedQty: decimal.Zero, ConsumedQty: decimal.Zero,
+			CostAmount: decimal.Zero, Note: checkNote(fields, docLineField(i, "note"), l.Note),
+		}
+	}
+	if err := validationOrNil(fields); err != nil {
+		return err
+	}
+	u.Purpose, u.DivisionID, u.CampaignID, u.SourceLocationID = in.Purpose, in.DivisionID, in.CampaignID, in.SourceLocationID
+	u.EventLocationID, u.EventEndDate, u.SettleDueDate = in.EventLocationID, in.EventEndDate, due
+	u.BusinessDate, u.Note, u.Lines = in.BusinessDate, note, lines
+	return nil
+}
+
+var usageTransitions = []transition{
+	{ActionSubmit, []DocStatus{DocDraft}, DocPendingApproval},
+	{ActionApprove, []DocStatus{DocPendingApproval}, DocApproved},
+	{ActionReject, []DocStatus{DocPendingApproval}, DocRejected},
+	{ActionRevise, []DocStatus{DocRejected}, DocDraft},
+	{ActionRelease, []DocStatus{DocApproved}, DocInProgress},
+	{ActionHandover, []DocStatus{DocInProgress}, DocPosted},
+	{ActionSettle, []DocStatus{DocAwaitingSettlement}, DocAwaitingSettlement},
+	{ActionExecute, []DocStatus{DocAwaitingSettlement}, DocPosted},
+	{ActionCancel, []DocStatus{DocDraft, DocApproved}, DocCancelled},
+}
+
+// Transition menjalankan aksi: event diserahkan ke lokasi Event (Menunggu Penyelesaian), sisa dicatat sekali
+// (settle), lalu diposting atas qty terpakai.
+func (u *InternalUsage) Transition(a DocAction) error {
+	to, ok := findTransition(usageTransitions, a, u.Status)
+	switch {
+	case !ok:
+		return errTransition(a, u.Status)
+	case a == ActionSettle && u.Settled != nil:
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Sisa barang event sudah dicatat")
+	case a == ActionExecute && u.Settled == nil:
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Catat sisa barang event terlebih dahulu")
+	case a == ActionHandover && u.IsEvent():
+		to = DocAwaitingSettlement
+	}
+	u.Status = to
+	return nil
+}
+
+// Permission Pemakaian Internal (Desain Role & Approval 3.2): peminta W/S, Logistik Leader/Staf Gudang P.
+const (
+	PermUsageRead   = "inventory.internal_usage.read"
+	PermUsageWrite  = "inventory.internal_usage.write"
+	PermUsageSubmit = "inventory.internal_usage.submit"
+	PermUsagePost   = "inventory.internal_usage.post"
+)
+
+// AllowedActions mengembalikan aksi yang bisa dilakukan pemegang permission.
+func (u InternalUsage) AllowedActions(has func(string) bool) []DocAction {
+	var out []DocAction
+	add := func(a DocAction, perm string) {
+		if _, ok := findTransition(usageTransitions, a, u.Status); ok && has(perm) {
+			out = append(out, a)
+		}
+	}
+	if u.Status == DocDraft && has(PermUsageWrite) {
+		out = append(out, ActionEdit)
+	}
+	add(ActionSubmit, PermUsageSubmit)
+	add(ActionRevise, PermUsageWrite)
+	add(ActionRelease, PermUsagePost)
+	add(ActionHandover, PermUsageWrite)
+	if u.Settled == nil {
+		add(ActionSettle, PermUsageWrite)
+	} else {
+		add(ActionExecute, PermUsagePost)
+	}
+	add(ActionCancel, PermUsageWrite)
+	return out
+}
+
+// SettleLine adalah qty sisa event satu baris.
+type SettleLine struct {
+	LineID      uuid.UUID
+	ReturnedQty decimal.Decimal
+}
+
+// ApplySettlement mencatat qty sisa per baris; baris yang tidak dikirim berarti tanpa sisa.
+func (u *InternalUsage) ApplySettlement(lines []SettleLine) error {
+	fields := map[string]string{}
+	byID := map[uuid.UUID]decimal.Decimal{}
+	for i, l := range lines {
+		if _, dup := byID[l.LineID]; dup {
+			fields[docLineField(i, "lineId")] = "Baris dikirim lebih dari sekali"
+		}
+		if l.ReturnedQty.IsNegative() || !l.ReturnedQty.Equal(l.ReturnedQty.Round(QtyScale)) {
+			fields[docLineField(i, "returnedQty")] = "Qty sisa tidak boleh negatif dan maksimal 3 angka di belakang koma"
+		}
+		byID[l.LineID] = l.ReturnedQty
+	}
+	known := map[uuid.UUID]bool{}
+	for i := range u.Lines {
+		known[u.Lines[i].ID] = true
+	}
+	for i, l := range lines {
+		if !known[l.LineID] {
+			fields[docLineField(i, "lineId")] = "Baris tidak ditemukan"
+		}
+	}
+	for i := range u.Lines {
+		l := &u.Lines[i]
+		ret := byID[l.ID]
+		if ret.GreaterThan(l.Qty) {
+			fields[docLineField(i, "returnedQty")] = "Qty sisa melebihi qty yang dikirim"
+		}
+		l.ReturnedQty = ret
+		l.ConsumedQty = l.Qty.Sub(ret)
+	}
+	return validationOrNil(fields)
+}
+
+// DistributeReturn membagi qty sisa ke batch yang dikirim: batch dengan kedaluwarsa paling akhir dianggap sisa
+// (barang dengan kedaluwarsa terdekat dipakai lebih dulu, FEFO). sent harus sudah urut FEFO.
+func DistributeReturn(sent []Candidate, returned decimal.Decimal) []Allocation {
+	var out []Allocation
+	remaining := returned
+	for i := len(sent) - 1; i >= 0 && remaining.IsPositive(); i-- {
+		take := decimal.Min(sent[i].Qty, remaining)
+		if take.IsPositive() {
+			out = append(out, Allocation{Candidate: sent[i], Qty: take})
+			remaining = remaining.Sub(take)
+		}
+	}
+	return out
+}
diff --git a/backend/internal/inventory/domain/recost.go b/backend/internal/inventory/domain/recost.go
new file mode 100644
index 0000000..1180996
--- /dev/null
+++ b/backend/internal/inventory/domain/recost.go
@@ -0,0 +1,96 @@
+package domain
+
+import (
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/clock"
+)
+
+// ReplayLayer adalah cost layer satu batch dalam urutan FIFO (tanggal bisnis penerimaan, lalu urutan dibuat).
+type ReplayLayer struct {
+	ID           uuid.UUID
+	BusinessDate clock.BusinessDate
+	ReceivedQty  decimal.Decimal
+	UnitCost     decimal.Decimal
+}
+
+// ReplayIssue adalah movement keluar (issue) satu batch dalam urutan tanggal bisnis, lalu urutan dibuat.
+// Qty positif. CurrentCost adalah HPP efektif saat ini (HPP posting + selisih recost sebelumnya).
+type ReplayIssue struct {
+	MovementID   uuid.UUID
+	BusinessDate clock.BusinessDate
+	Qty          decimal.Decimal
+	CurrentCost  decimal.Decimal
+}
+
+// ReplayResult adalah hasil hitung ulang FIFO satu batch.
+type ReplayResult struct {
+	// Costs: HPP hasil hitung ulang per movement (dibulatkan 2 desimal seperti posting).
+	Costs map[uuid.UUID]decimal.Decimal
+	// Remaining: sisa qty per cost layer setelah hitung ulang.
+	Remaining map[uuid.UUID]decimal.Decimal
+	// Short: true bila layer tidak cukup untuk semua issue (ledger tidak konsisten; recost dihentikan).
+	Short bool
+}
+
+// Replay menghitung ulang konsumsi FIFO seluruh issue satu batch terhadap seluruh cost layer-nya (S-224).
+// Setiap issue mengambil lebih dulu layer yang tanggal bisnisnya ≤ tanggal issue (FIFO), baru layer
+// sesudahnya bila belum cukup. Tanpa backdate hasilnya sama dengan konsumsi saat posting; dengan penerimaan
+// bertanggal mundur, issue sesudah tanggal itu mengonsumsi layer mundur tersebut lebih dulu.
+func Replay(layers []ReplayLayer, issues []ReplayIssue) ReplayResult {
+	res := ReplayResult{Costs: map[uuid.UUID]decimal.Decimal{}, Remaining: map[uuid.UUID]decimal.Decimal{}}
+	remaining := make([]decimal.Decimal, len(layers))
+	for i, l := range layers {
+		remaining[i] = l.ReceivedQty
+	}
+	for _, is := range issues {
+		need := is.Qty
+		var cons []Consumption
+		take := func(eligible func(ReplayLayer) bool) {
+			for i, l := range layers {
+				if !need.IsPositive() {
+					return
+				}
+				if !eligible(l) || !remaining[i].IsPositive() {
+					continue
+				}
+				q := decimal.Min(remaining[i], need)
+				cons = append(cons, Consumption{LayerID: l.ID, Qty: q, UnitCost: l.UnitCost})
+				remaining[i] = remaining[i].Sub(q)
+				need = need.Sub(q)
+			}
+		}
+		take(func(l ReplayLayer) bool { return !l.BusinessDate.After(is.BusinessDate) })
+		take(func(l ReplayLayer) bool { return l.BusinessDate.After(is.BusinessDate) })
+		if need.IsPositive() {
+			res.Short = true
+		}
+		res.Costs[is.MovementID] = CostAmount(cons)
+	}
+	for i, l := range layers {
+		res.Remaining[l.ID] = remaining[i]
+	}
+	return res
+}
+
+// RecostDiff adalah selisih HPP satu movement.
+type RecostDiff struct {
+	MovementID uuid.UUID
+	Previous   decimal.Decimal
+	Recomputed decimal.Decimal
+}
+
+// Difference = Recomputed − Previous (positif = HPP naik).
+func (d RecostDiff) Difference() decimal.Decimal { return d.Recomputed.Sub(d.Previous) }
+
+// Diffs mengembalikan movement yang HPP-nya berubah, sesuai urutan issue.
+func (r ReplayResult) Diffs(issues []ReplayIssue) []RecostDiff {
+	var out []RecostDiff
+	for _, is := range issues {
+		if c, ok := r.Costs[is.MovementID]; ok && !c.Equal(is.CurrentCost) {
+			out = append(out, RecostDiff{MovementID: is.MovementID, Previous: is.CurrentCost, Recomputed: c})
+		}
+	}
+	return out
+}
diff --git a/backend/internal/inventory/domain/repacking.go b/backend/internal/inventory/domain/repacking.go
new file mode 100644
index 0000000..5417e19
--- /dev/null
+++ b/backend/internal/inventory/domain/repacking.go
@@ -0,0 +1,227 @@
+package domain
+
+import (
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/clock"
+)
+
+// RepackDirection adalah arah baris repacking.
+type RepackDirection string
+
+const (
+	// RepackInput: barang retur (dari Gudang Retur) atau packaging baru (dari RM) yang dipakai.
+	RepackInput RepackDirection = "input"
+	// RepackOutput: FG hasil repacking dengan batch baru.
+	RepackOutput RepackDirection = "output"
+)
+
+// Repacking adalah dokumen Repacking (INV-06; Desain Status Dokumen 4.2): draft → in_progress → posted.
+type Repacking struct {
+	ID                  uuid.UUID
+	Number              string
+	BusinessDate        clock.BusinessDate
+	Note                string
+	Status              DocStatus
+	CostAmount          decimal.Decimal
+	JournalID           *uuid.UUID
+	ReturnDispositionID *uuid.UUID
+	CreatedBy           Actor
+	Started             *Step
+	Posted              *Step
+	Lines               []RepackLine
+	CreatedAt           time.Time
+	UpdatedAt           time.Time
+	Version             int
+}
+
+// RepackLine adalah satu baris input/output.
+type RepackLine struct {
+	ID          uuid.UUID
+	LineNo      int
+	Direction   RepackDirection
+	ProductID   uuid.UUID
+	LocationID  uuid.UUID
+	StockStatus StockStatus
+	// BatchID: input = batch yang diambil (nil = FEFO); output = batch baru setelah posting.
+	BatchID *uuid.UUID
+	// Batch baru output.
+	BatchNumber    string
+	ProductionDate *clock.BusinessDate
+	ExpiryDate     *clock.BusinessDate
+	Qty            decimal.Decimal
+	CostAmount     decimal.Decimal
+	Note           string
+}
+
+// RepackLineInput adalah isian baris.
+type RepackLineInput struct {
+	Direction      RepackDirection
+	ProductID      uuid.UUID
+	LocationID     uuid.UUID
+	StockStatus    StockStatus
+	BatchID        *uuid.UUID
+	BatchNumber    string
+	ProductionDate *clock.BusinessDate
+	ExpiryDate     *clock.BusinessDate
+	Qty            decimal.Decimal
+	Note           string
+}
+
+// RepackingInput adalah isian form Repacking.
+type RepackingInput struct {
+	BusinessDate clock.BusinessDate
+	Note         string
+	Lines        []RepackLineInput
+}
+
+// NewRepacking memvalidasi dan membuat draft repacking.
+func NewRepacking(in RepackingInput, by Actor) (Repacking, error) {
+	r := Repacking{Status: DocDraft, CreatedBy: by, CostAmount: decimal.Zero}
+	if err := r.apply(in); err != nil {
+		return Repacking{}, err
+	}
+	return r, nil
+}
+
+// Update mengganti isian draft.
+func (r *Repacking) Update(in RepackingInput) error {
+	if r.Status != DocDraft {
+		return errTransition(ActionEdit, r.Status)
+	}
+	return r.apply(in)
+}
+
+func (r *Repacking) apply(in RepackingInput) error {
+	fields := map[string]string{}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	note := checkNote(fields, "note", in.Note)
+	checkLineCount(fields, len(in.Lines))
+	inputs, outputs := 0, 0
+	lines := make([]RepackLine, len(in.Lines))
+	for i, l := range in.Lines {
+		if l.StockStatus == "" {
+			l.StockStatus = StatusAvailable
+		}
+		if l.ProductID == uuid.Nil {
+			fields[docLineField(i, "productId")] = "Produk wajib diisi"
+		}
+		if l.LocationID == uuid.Nil {
+			fields[docLineField(i, "locationId")] = "Lokasi wajib diisi"
+		}
+		if l.StockStatus != StatusAvailable && l.StockStatus != StatusQuarantine {
+			fields[docLineField(i, "stockStatus")] = "Status stok harus Tersedia atau Karantina"
+		}
+		checkQty(fields, docLineField(i, "qty"), l.Qty)
+		line := RepackLine{
+			LineNo: i + 1, Direction: l.Direction, ProductID: l.ProductID, LocationID: l.LocationID,
+			StockStatus: l.StockStatus, Qty: l.Qty, CostAmount: decimal.Zero, Note: checkNote(fields, docLineField(i, "note"), l.Note),
+		}
+		switch l.Direction {
+		case RepackInput:
+			inputs++
+			line.BatchID = l.BatchID
+		case RepackOutput:
+			outputs++
+			nb, msg := normalizeNewBatch(NewBatch{Number: l.BatchNumber, ProductionDate: l.ProductionDate, ExpiryDate: l.ExpiryDate})
+			if msg != "" {
+				fields[docLineField(i, "batchNumber")] = msg
+			}
+			if l.StockStatus != StatusAvailable {
+				fields[docLineField(i, "stockStatus")] = "Hasil repacking masuk sebagai stok Tersedia"
+			}
+			line.BatchNumber, line.ProductionDate, line.ExpiryDate = nb.Number, nb.ProductionDate, nb.ExpiryDate
+		default:
+			fields[docLineField(i, "direction")] = "Arah baris tidak valid"
+		}
+		lines[i] = line
+	}
+	if len(in.Lines) > 0 {
+		if inputs == 0 {
+			fields["lines"] = "Minimal satu baris bahan (barang retur atau packaging)"
+		}
+		if outputs != 1 {
+			fields["lines"] = "Repacking menghasilkan tepat satu baris FG hasil"
+		}
+	}
+	if err := validationOrNil(fields); err != nil {
+		return err
+	}
+	r.BusinessDate, r.Note, r.Lines = in.BusinessDate, note, lines
+	return nil
+}
+
+var repackTransitions = []transition{
+	{ActionStart, []DocStatus{DocDraft}, DocInProgress},
+	{ActionExecute, []DocStatus{DocInProgress}, DocPosted},
+	{ActionCancel, []DocStatus{DocDraft, DocInProgress}, DocCancelled},
+}
+
+// Transition menjalankan aksi repacking.
+func (r *Repacking) Transition(a DocAction) error {
+	to, ok := findTransition(repackTransitions, a, r.Status)
+	if !ok {
+		return errTransition(a, r.Status)
+	}
+	r.Status = to
+	return nil
+}
+
+// Permission Repacking (Desain Role & Approval 3.2).
+const (
+	PermRepackRead  = "inventory.repacking.read"
+	PermRepackWrite = "inventory.repacking.write"
+	PermRepackPost  = "inventory.repacking.post"
+)
+
+// AllowedActions mengembalikan aksi yang bisa dilakukan pemegang permission.
+func (r Repacking) AllowedActions(has func(string) bool) []DocAction {
+	var out []DocAction
+	if r.Status == DocDraft && has(PermRepackWrite) {
+		out = append(out, ActionEdit)
+	}
+	for _, a := range []DocAction{ActionStart, ActionExecute, ActionCancel} {
+		perm := PermRepackPost
+		if a == ActionCancel {
+			perm = PermRepackWrite
+		}
+		if _, ok := findTransition(repackTransitions, a, r.Status); ok && has(perm) {
+			out = append(out, a)
+		}
+	}
+	return out
+}
+
+// Inputs mengembalikan baris bahan.
+func (r Repacking) Inputs() []RepackLine {
+	var out []RepackLine
+	for _, l := range r.Lines {
+		if l.Direction == RepackInput {
+			out = append(out, l)
+		}
+	}
+	return out
+}
+
+// Output mengembalikan baris hasil (tepat satu setelah validasi).
+func (r Repacking) Output() *RepackLine {
+	for i := range r.Lines {
+		if r.Lines[i].Direction == RepackOutput {
+			return &r.Lines[i]
+		}
+	}
+	return nil
+}
+
+// OutputUnitCost = (HPP barang retur + packaging) ÷ qty hasil, 4 desimal (INV-06).
+func OutputUnitCost(inputCost, outputQty decimal.Decimal) decimal.Decimal {
+	if !outputQty.IsPositive() {
+		return decimal.Zero
+	}
+	return inputCost.Div(outputQty).Round(UnitCostScale)
+}
diff --git a/backend/internal/inventory/domain/return_disposition.go b/backend/internal/inventory/domain/return_disposition.go
new file mode 100644
index 0000000..9e17e94
--- /dev/null
+++ b/backend/internal/inventory/domain/return_disposition.go
@@ -0,0 +1,232 @@
+package domain
+
+import (
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/clock"
+)
+
+// Disposition adalah keputusan barang retur (BRD 5.11, U-09). Kode sama dengan usulan disposisi master
+// Alasan Retur (modul sales).
+type Disposition string
+
+const (
+	DispositionRestock   Disposition = "restock"
+	DispositionRepack    Disposition = "repack"
+	DispositionReprocess Disposition = "reprocess"
+	DispositionSample    Disposition = "marketing_sample"
+	DispositionDispose   Disposition = "dispose"
+)
+
+var dispositionLabels = map[Disposition]string{
+	DispositionRestock: "Kembali ke stok", DispositionRepack: "Repacking", DispositionReprocess: "Reprocess maklon",
+	DispositionSample: "Sampel/marketing", DispositionDispose: "Pemusnahan",
+}
+
+// Valid memeriksa disposisi.
+func (d Disposition) Valid() bool {
+	_, ok := dispositionLabels[d]
+	return ok
+}
+
+// Label adalah label disposisi.
+func (d Disposition) Label() string { return dispositionLabels[d] }
+
+// Jenis dokumen lanjutan eksekusi disposisi.
+const (
+	TargetRepacking     = "repacking"
+	TargetDisposal      = "disposal"
+	TargetInternalUsage = "internal_usage"
+)
+
+// ReturnDisposition adalah dokumen Disposisi Retur (Desain Status Dokumen 3.5).
+type ReturnDisposition struct {
+	ID            uuid.UUID
+	Number        string
+	LocationID    uuid.UUID
+	InboundID     *uuid.UUID
+	BusinessDate  clock.BusinessDate
+	Note          string
+	Status        DocStatus
+	DisposalValue decimal.Decimal
+	CostAmount    decimal.Decimal
+	JournalID     *uuid.UUID
+	CreatedBy     Actor
+	Submitted     *Step
+	Posted        *Step
+	Lines         []DispositionLine
+	CreatedAt     time.Time
+	UpdatedAt     time.Time
+	Version       int
+}
+
+// DispositionLine adalah satu barang retur beserta hasil QC dan disposisinya.
+type DispositionLine struct {
+	ID            uuid.UUID
+	LineNo        int
+	ProductID     uuid.UUID
+	BatchID       *uuid.UUID
+	StockStatus   StockStatus
+	Qty           decimal.Decimal
+	ReasonID      *uuid.UUID
+	Disposition   Disposition
+	QCNote        string
+	EstimatedCost decimal.Decimal
+	CostAmount    decimal.Decimal
+	TargetType    string
+	TargetID      *uuid.UUID
+}
+
+// DispositionLineInput adalah isian baris. Disposition kosong = usulan default alasan retur (diisi service).
+type DispositionLineInput struct {
+	ProductID   uuid.UUID
+	BatchID     *uuid.UUID
+	StockStatus StockStatus
+	Qty         decimal.Decimal
+	ReasonID    *uuid.UUID
+	Disposition Disposition
+	QCNote      string
+}
+
+// ReturnDispositionInput adalah isian form Disposisi Retur.
+type ReturnDispositionInput struct {
+	LocationID   uuid.UUID
+	InboundID    *uuid.UUID
+	BusinessDate clock.BusinessDate
+	Note         string
+	Lines        []DispositionLineInput
+}
+
+// NewReturnDisposition memvalidasi dan membuat draft.
+func NewReturnDisposition(in ReturnDispositionInput, by Actor) (ReturnDisposition, error) {
+	r := ReturnDisposition{Status: DocDraft, CreatedBy: by, DisposalValue: decimal.Zero, CostAmount: decimal.Zero}
+	if err := r.apply(in); err != nil {
+		return ReturnDisposition{}, err
+	}
+	return r, nil
+}
+
+// Update mengganti isian draft.
+func (r *ReturnDisposition) Update(in ReturnDispositionInput) error {
+	if r.Status != DocDraft {
+		return errTransition(ActionEdit, r.Status)
+	}
+	return r.apply(in)
+}
+
+func (r *ReturnDisposition) apply(in ReturnDispositionInput) error {
+	fields := map[string]string{}
+	if in.LocationID == uuid.Nil {
+		fields["locationId"] = "Lokasi Gudang Retur wajib diisi"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	note := checkNote(fields, "note", in.Note)
+	checkLineCount(fields, len(in.Lines))
+	lines := make([]DispositionLine, len(in.Lines))
+	for i, l := range in.Lines {
+		if l.StockStatus == "" {
+			l.StockStatus = StatusAvailable
+		}
+		if l.ProductID == uuid.Nil {
+			fields[docLineField(i, "productId")] = "Produk wajib diisi"
+		}
+		if l.StockStatus != StatusAvailable && l.StockStatus != StatusQuarantine {
+			fields[docLineField(i, "stockStatus")] = "Status stok harus Tersedia atau Karantina"
+		}
+		if !l.Disposition.Valid() {
+			fields[docLineField(i, "disposition")] = "Pilih disposisi atau alasan retur yang punya usulan disposisi"
+		}
+		checkQty(fields, docLineField(i, "qty"), l.Qty)
+		lines[i] = DispositionLine{
+			LineNo: i + 1, ProductID: l.ProductID, BatchID: l.BatchID, StockStatus: l.StockStatus, Qty: l.Qty,
+			ReasonID: l.ReasonID, Disposition: l.Disposition, QCNote: checkNote(fields, docLineField(i, "qcNote"), l.QCNote),
+			EstimatedCost: decimal.Zero, CostAmount: decimal.Zero,
+		}
+	}
+	if err := validationOrNil(fields); err != nil {
+		return err
+	}
+	r.LocationID, r.InboundID, r.BusinessDate, r.Note, r.Lines = in.LocationID, in.InboundID, in.BusinessDate, note, lines
+	return nil
+}
+
+// HasDisposal memeriksa baris pemusnahan (syarat level 2–3 approval `has_disposal`).
+func (r ReturnDisposition) HasDisposal() bool {
+	for _, l := range r.Lines {
+		if l.Disposition == DispositionDispose {
+			return true
+		}
+	}
+	return false
+}
+
+// ComputeDisposalValue menjumlahkan estimasi HPP baris pemusnahan (nominal approval).
+func (r *ReturnDisposition) ComputeDisposalValue() decimal.Decimal {
+	total := decimal.Zero
+	for _, l := range r.Lines {
+		if l.Disposition == DispositionDispose {
+			total = total.Add(l.EstimatedCost)
+		}
+	}
+	r.DisposalValue = total
+	return total
+}
+
+var dispositionTransitions = []transition{
+	{ActionSubmit, []DocStatus{DocDraft}, DocPendingApproval},
+	{ActionApprove, []DocStatus{DocPendingApproval}, DocApproved},
+	{ActionReject, []DocStatus{DocPendingApproval}, DocRejected},
+	{ActionRevise, []DocStatus{DocRejected}, DocDraft},
+	{ActionExecute, []DocStatus{DocApproved}, DocPosted},
+	{ActionCancel, []DocStatus{DocDraft}, DocCancelled},
+}
+
+// Transition menjalankan aksi disposisi.
+func (r *ReturnDisposition) Transition(a DocAction) error {
+	to, ok := findTransition(dispositionTransitions, a, r.Status)
+	if !ok {
+		return errTransition(a, r.Status)
+	}
+	r.Status = to
+	return nil
+}
+
+// Permission Disposisi Retur (Desain Role & Approval 3.2): Staf Gudang/Logistik Leader RWS; eksekusi memakai W
+// karena matriks tidak memberi P.
+const (
+	PermDispositionRead   = "warehouse.return_disposition.read"
+	PermDispositionWrite  = "warehouse.return_disposition.write"
+	PermDispositionSubmit = "warehouse.return_disposition.submit"
+)
+
+// AllowedActions mengembalikan aksi yang bisa dilakukan pemegang permission.
+func (r ReturnDisposition) AllowedActions(has func(string) bool) []DocAction {
+	var out []DocAction
+	if r.Status == DocDraft && has(PermDispositionWrite) {
+		out = append(out, ActionEdit)
+	}
+	perms := map[DocAction]string{
+		ActionSubmit: PermDispositionSubmit, ActionRevise: PermDispositionWrite, ActionExecute: PermDispositionWrite,
+		ActionCancel: PermDispositionWrite,
+	}
+	for _, a := range []DocAction{ActionSubmit, ActionRevise, ActionExecute, ActionCancel} {
+		if _, ok := findTransition(dispositionTransitions, a, r.Status); ok && has(perms[a]) {
+			out = append(out, a)
+		}
+	}
+	return out
+}
+
+// DispositionAmounts adalah nilai A-26 dari eksekusi restock/reprocess langsung di dokumen disposisi.
+type DispositionAmounts struct {
+	Restock   decimal.Decimal
+	Reprocess decimal.Decimal
+}
+
+// Returned adalah nilai kredit Persediaan Retur (1314).
+func (a DispositionAmounts) Returned() decimal.Decimal { return a.Restock.Add(a.Reprocess) }
diff --git a/backend/internal/inventory/postgres/queries/disposals.sql b/backend/internal/inventory/postgres/queries/disposals.sql
new file mode 100644
index 0000000..885c6f5
--- /dev/null
+++ b/backend/internal/inventory/postgres/queries/disposals.sql
@@ -0,0 +1,58 @@
+-- name: InsertDisposal :one
+INSERT INTO disposals (
+    reason, disposal_date, method, witnesses, photo_file_ids, note, status, return_disposition_id, created_by,
+    created_by_name, updated_by)
+VALUES (
+    sqlc.arg('reason'), sqlc.arg('disposal_date'), sqlc.arg('method'), sqlc.arg('witnesses'), sqlc.arg('photo_file_ids'),
+    sqlc.arg('note'), sqlc.arg('status'), sqlc.narg('return_disposition_id'), sqlc.arg('created_by'),
+    sqlc.arg('created_by_name'), sqlc.arg('created_by'))
+RETURNING id, created_at, updated_at, version;
+
+-- name: GetDisposal :one
+SELECT * FROM disposals WHERE id = $1;
+
+-- name: LockDisposal :one
+SELECT * FROM disposals WHERE id = $1 FOR UPDATE;
+
+-- name: UpdateDisposal :one
+UPDATE disposals SET
+    number = sqlc.narg('number'), reason = sqlc.arg('reason'), disposal_date = sqlc.arg('disposal_date'),
+    method = sqlc.arg('method'), witnesses = sqlc.arg('witnesses'), photo_file_ids = sqlc.arg('photo_file_ids'),
+    note = sqlc.arg('note'), status = sqlc.arg('status'), estimated_cost = sqlc.arg('estimated_cost'),
+    cost_amount = sqlc.arg('cost_amount'), posting_rule_code = sqlc.arg('posting_rule_code'),
+    journal_id = sqlc.narg('journal_id'),
+    submitted_by = sqlc.narg('submitted_by'), submitted_by_name = sqlc.arg('submitted_by_name'),
+    submitted_at = sqlc.narg('submitted_at'),
+    posted_by = sqlc.narg('posted_by'), posted_by_name = sqlc.arg('posted_by_name'), posted_at = sqlc.narg('posted_at'),
+    updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id')
+RETURNING updated_at, version;
+
