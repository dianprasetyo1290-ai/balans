+	CostAmount      decimal.Decimal
+	JournalID       uuid.NullUUID
+	SubmittedBy     uuid.NullUUID
+	SubmittedByName string
+	SubmittedAt     *time.Time
+	PostedBy        uuid.NullUUID
+	PostedByName    string
+	PostedAt        *time.Time
+	ActorID         uuid.UUID
+	ID              uuid.UUID
+}
+
+type UpdateReturnDispositionRow struct {
+	UpdatedAt time.Time
+	Version   int32
+}
+
+func (q *Queries) UpdateReturnDisposition(ctx context.Context, arg UpdateReturnDispositionParams) (UpdateReturnDispositionRow, error) {
+	row := q.db.QueryRow(ctx, updateReturnDisposition,
+		arg.Number,
+		arg.LocationID,
+		arg.InboundID,
+		arg.BusinessDate,
+		arg.Note,
+		arg.Status,
+		arg.DisposalValue,
+		arg.CostAmount,
+		arg.JournalID,
+		arg.SubmittedBy,
+		arg.SubmittedByName,
+		arg.SubmittedAt,
+		arg.PostedBy,
+		arg.PostedByName,
+		arg.PostedAt,
+		arg.ActorID,
+		arg.ID,
+	)
+	var i UpdateReturnDispositionRow
+	err := row.Scan(&i.UpdatedAt, &i.Version)
+	return i, err
+}
+
+const updateReturnDispositionLine = `-- name: UpdateReturnDispositionLine :exec
+UPDATE return_disposition_lines SET estimated_cost = $1, cost_amount = $2,
+    target_type = $3, target_id = $4
+WHERE id = $5
+`
+
+type UpdateReturnDispositionLineParams struct {
+	EstimatedCost decimal.Decimal
+	CostAmount    decimal.Decimal
+	TargetType    string
+	TargetID      uuid.NullUUID
+	ID            uuid.UUID
+}
+
+func (q *Queries) UpdateReturnDispositionLine(ctx context.Context, arg UpdateReturnDispositionLineParams) error {
+	_, err := q.db.Exec(ctx, updateReturnDispositionLine,
+		arg.EstimatedCost,
+		arg.CostAmount,
+		arg.TargetType,
+		arg.TargetID,
+		arg.ID,
+	)
+	return err
+}
