+          </div>
+          {err("lines") ? <p className="text-sm text-destructive">{err("lines")}</p> : null}
+          <div>
+            <Button type="button" variant="outline" onClick={() => setLines((ls) => [...ls, emptyLine()])}>
+              <PlusIcon /> Tambah Baris
+            </Button>
+          </div>
+        </section>
+        {toll ? (
+          <section className="flex flex-col gap-2">
+            <h2 className="text-sm font-semibold">
+              {orderType === "reprocess"
+                ? "Bahan GM yang Dikirim ke Maklon"
+                : "Packaging yang Akan Dipakai Maklon"}
+            </h2>
+            <div className="overflow-x-auto rounded-lg border">
+              <Table className="min-w-[44rem]">
+                <TableHeader>
+                  <TableRow>
+                    <TableHead className="w-80">
+                      {orderType === "reprocess" ? "Material (GM)" : "Packaging"}
+                    </TableHead>
+                    <TableHead className="w-40 text-right">Qty Rencana</TableHead>
+                    <TableHead>Catatan</TableHead>
+                    <TableHead className="w-12" />
+                  </TableRow>
+                </TableHeader>
+                <TableBody>
+                  {materials.map((m, i) => (
+                    <TableRow key={m.key} className="align-top">
+                      <TableCell>
+                        <ProductPicker
+                          value={m.product}
+                          types={orderType === "reprocess" ? ["reprocess_material"] : ["packaging"]}
+                          isBundle={false}
+                          excludeIds={materials
+                            .filter((x) => x.key !== m.key && x.product)
