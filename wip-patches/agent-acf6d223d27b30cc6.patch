-		}
-		if err := s.applyReservations(ctx, parts, m, actorID); err != nil {
-			return err
-		}
-		res, err = s.persist(ctx, postingID, p, parts, actorID)
-		return err
-	})
-	if err != nil {
-		return PostingResult{}, err
-	}
