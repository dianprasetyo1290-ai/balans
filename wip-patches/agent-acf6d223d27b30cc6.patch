+// TestPurchaseFlow: PR → approval Head divisi → PO dari PR → approval 3 level → uang muka A-19 → penerimaan →
+// potong uang muka, plus pemenuhan PR dan notifikasi ETA H-1.
+func TestPurchaseFlow(t *testing.T) {
+	h, m := setup(t)
+	tube := h.masters.product("PKG-TUBE30", "packaging")
+	pouch := h.masters.product("PKG-POUCH", "packaging")
+	supplier := h.masters.supplier("KEMAS", false)
+
+	// 1. Draft PR divisi peminta lalu ajukan.
+	var pr purchaseRequest
+	require.Equal(t, http.StatusCreated, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-requests", map[string]any{
+		"divisionId": h.division, "businessDate": today(), "note": "Stok packaging Q4",
+		"lines": []map[string]any{
+			{"productId": tube, "qty": "1000", "estimatedPrice": "50000"},
+			{"productId": pouch, "qty": "200", "estimatedPrice": "30000"},
+		},
+	}, &pr))
+	assert.Equal(t, "draft", pr.Status)
+	assert.Empty(t, pr.Number)
+	assert.Equal(t, "56000000.00", pr.EstimatedTotal)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-requests/"+pr.ID.String()+"/submit",
+		map[string]any{"version": pr.Version}, &pr))
+	assert.Equal(t, "pending_approval", pr.Status)
+	assert.Equal(t, "PR/2026/10/00001", pr.Number)
+
+	// 2. Head divisi peminta menyetujui (satu level) → PR Disetujui.
+	decided := h.approve(h.divHead, "purchase_request", pr.ID)
+	assert.Equal(t, "approved", decided.Status)
+	assert.Equal(t, "/procurement/purchase-requests/"+pr.ID.String(), decided.SubjectLink)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-requests/"+pr.ID.String(), nil, &pr))
+	assert.Equal(t, "approved", pr.Status)
+	assert.Contains(t, pr.AllowedActions, "create_order")
+
+	// 3. PO dari PR: tube penuh, pouch sebagian; qty melebihi sisa PR ditolak.
+	poBody := func(pouchQty string) map[string]any {
+		return map[string]any{
+			"orderType": "packaging", "supplierId": supplier, "divisionId": h.division, "businessDate": today(),
+			"expectedDate": plusDays(1),
+			"lines": []map[string]any{
+				{"productId": tube, "qty": "1000", "unitPrice": "50000", "purchaseRequestLineId": pr.Lines[0].ID},
+				{"productId": pouch, "qty": pouchQty, "unitPrice": "60000", "purchaseRequestLineId": pr.Lines[1].ID},
+			},
+		}
+	}
+	assert.Equal(t, http.StatusUnprocessableEntity, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders", poBody("201"), nil))
+	var po purchaseOrder
+	require.Equal(t, http.StatusCreated, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders", poBody("100"), &po))
+	assert.Equal(t, "56000000.00", po.TotalAmount, "NON-PKP: tanpa PPN")
+	assert.Equal(t, "PR/2026/10/00001", po.Lines[0].PurchaseRequestNumber)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-requests/"+pr.ID.String(), nil, &pr))
+	assert.Equal(t, "approved", pr.Status, "PR baru terpenuhi sebagian")
+	assert.Equal(t, "100.000", pr.Lines[1].RemainingQty)
+
+	// Uang muka sebelum PO disetujui ditolak.
+	assert.Equal(t, http.StatusConflict, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances", map[string]any{
+		"purchaseOrderId": po.ID, "amount": "1000", "paymentDate": today(), "bankAccountCode": "1111",
+	}, nil))
+
+	// 4. Ajukan PO > Rp50 jt → 3 level: Head F&A, Direksi, Direktur Utama.
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders/"+po.ID.String()+"/submit",
+		map[string]any{"version": po.Version}, &po))
+	assert.Equal(t, "PO/2026/10/00001", po.Number)
+	first := h.approve(h.hfa, "purchase_order", po.ID)
+	assert.Equal(t, 3, first.TotalLevels)
+	assert.Equal(t, "pending_approval", first.Status)
+	h.approve(h.director, "purchase_order", po.ID)
+	last := h.approve(h.presDir, "purchase_order", po.ID)
+	assert.Equal(t, "approved", last.Status)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-orders/"+po.ID.String(), nil, &po))
+	assert.Equal(t, "approved", po.Status)
+	assert.Contains(t, po.AllowedActions, "print")
+	assert.Contains(t, po.AllowedActions, "create_advance")
+
+	// 5. Uang muka 20 jt → posting A-19 balance (Dr 1401 / Cr 1111) dengan divisi PO dan pihak pemasok.
+	var adv purchaseAdvance
+	require.Equal(t, http.StatusCreated, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances", map[string]any{
+		"purchaseOrderId": po.ID, "amount": "20000000", "paymentDate": today(), "bankAccountCode": "1111", "note": "DP",
+	}, &adv))
+	assert.Equal(t, "draft", adv.Status)
+	assert.Equal(t, http.StatusUnprocessableEntity, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances", map[string]any{
+		"purchaseOrderId": po.ID, "amount": "36000000.01", "paymentDate": today(), "bankAccountCode": "1111",
+	}, nil), "total uang muka melebihi total PO")
+	require.Equal(t, http.StatusOK, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances/"+adv.ID.String()+"/post",
+		map[string]any{"version": adv.Version}, &adv))
+	assert.Equal(t, "posted", adv.Status)
+	assert.Equal(t, "BYR/2026/10/00001", adv.Number)
+	require.NotNil(t, adv.JournalEntryID)
+	lines := h.journalLines(*adv.JournalEntryID)
+	assert.Equal(t, map[string][2]string{"1401": {"20000000.00", "0.00"}, "1111": {"0.00", "20000000.00"}}, lines)
+
+	// PO dengan uang muka aktif tidak bisa dibatalkan.
+	assert.Equal(t, http.StatusConflict, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders/"+po.ID.String()+"/cancel",
+		map[string]any{"version": po.Version, "reason": "batal"}, nil))
+
+	// 6. API untuk Penerimaan Barang & Tagihan: terima sebagian, potong uang muka FIFO.
+	sys := h.as(h.purchasing)
+	ro, err := m.ReceivableOrder(sys, po.ID)
+	require.NoError(t, err)
+	require.Len(t, ro.Lines, 2)
+	received, err := m.RecordReceipt(sys, po.ID, "GR/2026/10/00001", []procurement.QtyDelta{
+		{LineID: ro.Lines[0].ID, Qty: decimal.NewFromInt(400)},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, procurement.StatusPartiallyReceived, received.Status)
+	_, err = m.RecordReceipt(sys, po.ID, "GR/2026/10/00002", []procurement.QtyDelta{
+		{LineID: ro.Lines[0].ID, Qty: decimal.NewFromInt(601)},
+	})
+	assert.True(t, apperr.HasCode(err, apperr.CodeValidationFailed), "toleransi qty 0%%")
+	outstanding, err := m.OutstandingAdvanceAmount(sys, po.ID)
+	require.NoError(t, err)
+	assert.Equal(t, "20000000.00", outstanding.String())
+	applied, err := m.ApplyAdvances(sys, po.ID, money.MustParse("5000000"))
+	require.NoError(t, err)
+	require.Len(t, applied, 1)
+	assert.Equal(t, "5000000.00", applied[0].Amount.String())
+	require.Equal(t, http.StatusOK, h.call(h.finance, http.MethodGet, "/api/v1/purchase-orders/"+po.ID.String(), nil, &po))
+	assert.Equal(t, "20000000.00", po.AdvancePaidAmount)
+	assert.Equal(t, "15000000.00", po.AdvanceOutstandingAmount)
+	assert.Contains(t, po.AllowedActions, "close")
+	// Uang muka yang sudah dipotong tagihan tidak bisa dibatalkan; setelah potongan dikembalikan bisa.
+	require.Equal(t, http.StatusOK, h.call(h.finance, http.MethodGet, "/api/v1/purchase-advances/"+adv.ID.String(), nil, &adv))
+	assert.Equal(t, http.StatusConflict, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances/"+adv.ID.String()+"/cancel",
+		map[string]any{"version": adv.Version, "reason": "salah"}, nil))
+	require.NoError(t, m.ReleaseAdvances(sys, applied))
+
+	// 7. PO kedua menyelesaikan PR; batalkan PO kedua → PR kembali Disetujui.
+	var po2 purchaseOrder
+	require.Equal(t, http.StatusCreated, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders", map[string]any{
+		"orderType": "packaging", "supplierId": supplier, "divisionId": h.division, "businessDate": today(),
+		"expectedDate": plusDays(3),
+		"lines":        []map[string]any{{"productId": pouch, "qty": "100", "unitPrice": "60000", "purchaseRequestLineId": pr.Lines[1].ID}},
+	}, &po2))
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-requests/"+pr.ID.String(), nil, &pr))
+	assert.Equal(t, "completed", pr.Status)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders/"+po2.ID.String()+"/cancel",
+		map[string]any{"version": po2.Version}, &po2))
+	assert.Equal(t, "cancelled", po2.Status)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-requests/"+pr.ID.String(), nil, &pr))
+	assert.Equal(t, "approved", pr.Status)
+	assert.Equal(t, "100.000", pr.Lines[1].RemainingQty)
+
+	// 8. Tutup PO diterima sebagian → qty PR yang terpenuhi = qty diterima.
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-orders/"+po.ID.String(), nil, &po))
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders/"+po.ID.String()+"/close",
+		map[string]any{"version": po.Version, "reason": "Sisa tidak dikirim pemasok"}, &po))
+	assert.Equal(t, "closed", po.Status)
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-requests/"+pr.ID.String(), nil, &pr))
+	assert.Equal(t, "400.000", pr.Lines[0].FulfilledQty)
+	assert.Equal(t, "200.000", pr.Lines[1].RemainingQty)
+
+	// 9. Batalkan uang muka yang belum dipotong → jurnal A-19 dibalik.
+	require.Equal(t, http.StatusOK, h.call(h.finance, http.MethodGet, "/api/v1/purchase-advances/"+adv.ID.String(), nil, &adv))
+	require.Equal(t, http.StatusOK, h.call(h.finance, http.MethodPost, "/api/v1/purchase-advances/"+adv.ID.String()+"/cancel",
+		map[string]any{"version": adv.Version, "reason": "Salah PO"}, &adv))
+	assert.Equal(t, "cancelled", adv.Status)
+	var reversals int
+	require.NoError(t, h.pool.QueryRow(context.Background(),
+		`SELECT count(*) FROM journal_entries WHERE reversal_of_id = $1`, *adv.JournalEntryID).Scan(&reversals))
+	assert.Equal(t, 1, reversals)
+}
+
+func TestTollManufacturingAndETA(t *testing.T) {
+	h, m := setup(t)
+	fg := h.masters.product("FG-WHEY1KG", "finished_good")
+	tube := h.masters.product("PKG-TUBE1KG", "packaging")
+	gm := h.masters.product("GM-WHEY-RET", "reprocess_material")
+	maklon := h.masters.supplier("NUTRI", true)
+	noLocation := h.masters.supplier("TANPALOKASI", true)
+	tollLoc := h.masters.location("MKL-NUTRI", "toll_manufacturer")
+	h.masters.toll[maklon] = tollLoc
+	gmLoc := h.masters.location("UTAMA-GM", "goods_material")
+	rmLoc := h.masters.location("UTAMA-RM", "raw_material")
+
+	body := func(orderType string, supplier uuid.UUID, material uuid.UUID, source *uuid.UUID) map[string]any {
+		return map[string]any{
+			"orderType": orderType, "supplierId": supplier, "divisionId": h.division, "businessDate": today(),
+			"expectedDate": plusDays(1), "materialSourceLocationId": source,
+			"lines":     []map[string]any{{"productId": fg, "qty": "5000", "unitPrice": "1500"}},
+			"materials": []map[string]any{{"productId": material, "plannedQty": "5100"}},
+		}
+	}
+	// Maklon tanpa lokasi eksternal ditolak; lokasi asal maklon harus RM.
+	assert.Equal(t, http.StatusUnprocessableEntity, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders",
+		body("toll_manufacturing", noLocation, tube, nil), nil))
+	assert.Equal(t, http.StatusUnprocessableEntity, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders",
+		body("toll_manufacturing", maklon, tube, &gmLoc), nil))
+	var toll purchaseOrder
+	require.Equal(t, http.StatusCreated, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders",
+		body("toll_manufacturing", maklon, tube, &rmLoc), &toll))
+	require.NotNil(t, toll.TollLocation)
+	assert.Equal(t, "MKL-NUTRI", toll.TollLocation.Code)
+	require.Len(t, toll.Materials, 1)
+	assert.Equal(t, "5100.000", toll.Materials[0].PlannedQty)
+
+	// Reprocess: bahan GM dari lokasi Gudang GM – GM.
+	assert.Equal(t, http.StatusUnprocessableEntity, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders",
+		body("reprocess", maklon, gm, &rmLoc), nil))
+	var reprocess purchaseOrder
+	require.Equal(t, http.StatusCreated, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders",
+		body("reprocess", maklon, gm, &gmLoc), &reprocess))
+
+	// PO maklon Rp7,5 jt → satu level Head F&A.
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodPost, "/api/v1/purchase-orders/"+toll.ID.String()+"/submit",
+		map[string]any{"version": toll.Version}, &toll))
+	decided := h.approve(h.hfa, "purchase_order", toll.ID)
+	assert.Equal(t, 1, decided.TotalLevels)
+	assert.Equal(t, "approved", decided.Status)
+
+	// ETA H-1: PO disetujui yang tiba besok diberitahukan sekali ke Logistik Leader (in-app + email).
+	n, err := m.NotifyETA(context.Background())
+	require.NoError(t, err)
+	assert.Equal(t, 1, n)
+	assert.Equal(t, 1, h.notificationCount(h.leader, "procurement.eta"))
+	var emails int
+	require.NoError(t, h.pool.QueryRow(context.Background(),
+		`SELECT count(*) FROM notification_emails WHERE recipient = $1 AND body_text LIKE '%FG-WHEY1KG%'`, h.leader.Email).Scan(&emails))
+	assert.Equal(t, 1, emails)
+	n, err = m.NotifyETA(context.Background())
+	require.NoError(t, err)
+	assert.Equal(t, 0, n, "idempotent")
+
+	// Pembuat tidak bisa mengubah jenis PO maupun draft yang sudah diajukan.
+	require.Equal(t, http.StatusOK, h.call(h.purchasing, http.MethodGet, "/api/v1/purchase-orders/"+toll.ID.String(), nil, &toll))
+	update := body("toll_manufacturing", maklon, tube, &rmLoc)
+	update["version"] = toll.Version
+	assert.Equal(t, http.StatusConflict, h.call(h.purchasing, http.MethodPut, "/api/v1/purchase-orders/"+toll.ID.String(), update, nil))
+	_, err = m.ReceivableOrder(h.as(h.purchasing), reprocess.ID)
+	assert.True(t, apperr.HasCode(err, apperr.CodeInvalidStateTransition))
+}
diff --git a/backend/internal/procurement/service/advances.go b/backend/internal/procurement/service/advances.go
new file mode 100644
index 0000000..06daa5d
--- /dev/null
+++ b/backend/internal/procurement/service/advances.go
@@ -0,0 +1,244 @@
+package service
+
+import (
+	"context"
+	"strings"
+
+	"github.com/google/uuid"
+
+	"balans/internal/accounting"
+	"balans/internal/audit"
+	"balans/internal/platform/actor"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/money"
+	"balans/internal/platform/paging"
+	"balans/internal/procurement/domain"
+	"balans/internal/procurement/postgres"
+)
+
+// AdvanceFilter adalah kriteria daftar uang muka.
+type AdvanceFilter = postgres.AdvanceFilter
+
+// Jenis dokumen sumber jurnal dan pihak sub-ledger.
+const (
+	SourcePurchaseAdvance = "purchase_advance"
+	PartySupplier         = "supplier"
+)
+
+var advanceActionPerms = map[domain.Action]string{
+	domain.ActionEdit: PermAdvanceWrite, domain.ActionPost: PermAdvancePost,
+}
+
+// AdvanceActions mengembalikan aksi uang muka yang boleh dilakukan actor. Batal draft cukup hak tulis;
+// batal uang muka Diposting (membalik jurnal) butuh hak posting.
+func AdvanceActions(ctx context.Context, a domain.Advance) []string {
+	perms := map[domain.Action]string{domain.ActionCancel: PermAdvanceWrite}
+	if a.Status == domain.StatusPosted {
+		perms[domain.ActionCancel] = PermAdvancePost
+	}
+	for k, v := range advanceActionPerms {
+		perms[k] = v
+	}
+	return filterActions(ctx, a.Actions(), perms)
+}
+
+func advanceSnapshot(a domain.Advance) map[string]any {
+	return map[string]any{
+		"purchaseOrderId": a.PurchaseOrderID, "amount": a.Amount.String(), "paymentDate": a.PaymentDate.String(),
+		"bankAccountCode": a.BankAccountCode, "note": a.Note, "status": string(a.Status),
+		"appliedAmount": a.Applied.String(), "cancelReason": a.CancelReason,
+	}
+}
+
+func advanceLabel(a domain.Advance) string {
+	if a.Number != "" {
+		return a.Number
+	}
+	return "Draft uang muka " + a.OrderNumber
+}
+
+// otherAdvancesTotal menjumlah uang muka aktif (draft + diposting) PO selain uang muka except.
+func otherAdvancesTotal(list []domain.Advance, except uuid.UUID) money.Amount {
+	total := money.Zero
+	for _, a := range list {
+		if a.ID != except && a.Counts() {
+			total = total.Add(a.Amount)
+		}
+	}
+	return total
+}
+
+// ListAdvances mengembalikan daftar uang muka.
+func (s *Service) ListAdvances(ctx context.Context, f AdvanceFilter, page paging.Page) (paging.Result[domain.Advance], error) {
+	if _, err := actor.Require(ctx, PermAdvanceRead); err != nil {
+		return paging.Result[domain.Advance]{}, err
+	}
+	f.Search = strings.TrimSpace(f.Search)
+	return s.Store.ListAdvances(ctx, f, page)
+}
+
+// GetAdvance mengembalikan detail uang muka.
+func (s *Service) GetAdvance(ctx context.Context, id uuid.UUID) (domain.Advance, error) {
+	if _, err := actor.Require(ctx, PermAdvanceRead); err != nil {
+		return domain.Advance{}, err
+	}
+	return s.Store.GetAdvance(ctx, id, false)
+}
+
+// CreateAdvance menyimpan draft uang muka untuk PO yang sudah disetujui. Total uang muka tidak boleh melebihi
+// total PO.
+func (s *Service) CreateAdvance(ctx context.Context, in domain.AdvanceInput) (domain.Advance, error) {
+	a, err := actor.Require(ctx, PermAdvanceWrite)
+	if err != nil {
+		return domain.Advance{}, err
+	}
+	var adv domain.Advance
+	err = s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		o, err := s.Store.GetOrder(ctx, in.PurchaseOrderID, true)
+		if apperr.HasCode(err, apperr.CodeNotFound) {
+			return apperr.Validation(map[string]string{"purchaseOrderId": "Purchase Order tidak ditemukan"})
+		}
+		if err != nil {
+			return err
+		}
+		existing, err := s.Store.AdvancesByOrder(ctx, o.ID)
+		if err != nil {
+			return err
+		}
+		if adv, err = domain.NewAdvance(in, o, otherAdvancesTotal(existing, uuid.Nil), a.UserID); err != nil {
+			return err
+		}
+		if adv.ID, err = s.Store.InsertAdvance(ctx, adv, a.UserID); err != nil {
+			return err
+		}
+		if adv, err = s.Store.GetAdvance(ctx, adv.ID, false); err != nil {
+			return err
+		}
+		return s.Audit.Record(ctx, audit.Entry{
+			Action: audit.ActionCreate, EntityType: EntityPurchaseAdvance, EntityID: adv.ID, EntityLabel: advanceLabel(adv),
+			After: advanceSnapshot(adv),
+		})
+	})
+	return adv, err
+}
+
+// mutateAdvance mengunci PO lalu uang muka (urutan kunci sama dengan CreateAdvance), memeriksa versi, menjalankan
+// fn, menyimpan, dan mencatat audit trail.
+func (s *Service) mutateAdvance(ctx context.Context, id uuid.UUID, version int, action audit.Action,
+	fn func(ctx context.Context, adv *domain.Advance, o domain.PurchaseOrder, others money.Amount) (string, error),
+) (domain.Advance, error) {
+	a, _ := actor.From(ctx)
+	var adv domain.Advance
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		cur, err := s.Store.GetAdvance(ctx, id, false)
+		if err != nil {
+			return err
+		}
+		o, err := s.Store.GetOrder(ctx, cur.PurchaseOrderID, true)
+		if err != nil {
+			return err
+		}
+		if adv, err = s.Store.GetAdvance(ctx, id, true); err != nil {
+			return err
+		}
+		if adv.Version != version {
+			return apperr.New(apperr.CodeVersionConflict)
+		}
+		list, err := s.Store.AdvancesByOrder(ctx, o.ID)
+		if err != nil {
+			return err
+		}
+		before := advanceSnapshot(adv)
+		note, err := fn(ctx, &adv, o, otherAdvancesTotal(list, adv.ID))
+		if err != nil {
+			return err
+		}
+		if err := s.Store.SaveAdvance(ctx, adv, version, a.UserID); err != nil {
+			return err
+		}
+		return s.Audit.Record(ctx, audit.Entry{
+			Action: action, EntityType: EntityPurchaseAdvance, EntityID: adv.ID, EntityLabel: advanceLabel(adv),
+			Before: before, After: advanceSnapshot(adv), Note: note,
+		})
+	})
+	if err != nil {
+		return domain.Advance{}, err
+	}
+	return s.Store.GetAdvance(ctx, id, false)
+}
+
+// UpdateAdvance mengubah draft uang muka.
+func (s *Service) UpdateAdvance(ctx context.Context, id uuid.UUID, version int, in domain.AdvanceInput) (domain.Advance, error) {
+	if _, err := actor.Require(ctx, PermAdvanceWrite); err != nil {
+		return domain.Advance{}, err
+	}
+	return s.mutateAdvance(ctx, id, version, audit.ActionUpdate, func(_ context.Context, adv *domain.Advance, o domain.PurchaseOrder, others money.Amount) (string, error) {
+		return "", adv.Update(in, o, others)
+	})
+}
+
+// PostAdvance memposting uang muka: nomor BYR dan jurnal A-19 (Dr 1401 Uang Muka Pembelian, Cr akun Kas & Bank)
+// dengan dimensi divisi PO dan pihak pemasok, di transaksi yang sama.
+func (s *Service) PostAdvance(ctx context.Context, id uuid.UUID, version int) (domain.Advance, error) {
+	if _, err := actor.Require(ctx, PermAdvancePost); err != nil {
+		return domain.Advance{}, err
+	}
+	return s.mutateAdvance(ctx, id, version, audit.ActionPost, func(ctx context.Context, adv *domain.Advance, o domain.PurchaseOrder, others money.Amount) (string, error) {
+		if err := adv.CanPost(o, others); err != nil {
+			return "", err
+		}
+		number, err := s.Numberer.Next(ctx, DocPayment, adv.PaymentDate)
+		if err != nil {
+			return "", err
+		}
+		division := adv.DivisionID
+		entry, err := s.Ledger.Post(ctx, accounting.PostingRequest{
+			RuleCode: RuleAdvance, SourceType: SourcePurchaseAdvance, SourceID: adv.ID, SourceLabel: number,
+			BusinessDate: adv.PaymentDate, Amounts: map[string]money.Amount{"advance_value": adv.Amount},
+			Accounts:    map[accounting.Resolver]string{accounting.ResolverBank: adv.BankAccountCode},
+			Dimensions:  accounting.Dimensions{DivisionID: &division},
+			Party:       &accounting.Party{Type: PartySupplier, ID: adv.SupplierID},
+			Description: "Uang muka pembelian " + o.Number + " · " + o.SupplierName,
+		})
+		if err != nil {
+			return "", err
+		}
+		if err := adv.Post(number, entry.ID, s.Clock.Now()); err != nil {
+			return "", err
+		}
+		return "Jurnal " + entry.Number, nil
+	})
+}
+
+// CancelAdvance membatalkan uang muka. Uang muka Diposting yang belum dipotong tagihan dibatalkan dengan jurnal
+// balik A-19 di transaksi yang sama.
+func (s *Service) CancelAdvance(ctx context.Context, id uuid.UUID, version int, reason string) (domain.Advance, error) {
+	if _, err := actor.RequireAny(ctx, PermAdvanceWrite, PermAdvancePost); err != nil {
+		return domain.Advance{}, err
+	}
+	return s.mutateAdvance(ctx, id, version, audit.ActionCancel, func(ctx context.Context, adv *domain.Advance, _ domain.PurchaseOrder, _ money.Amount) (string, error) {
+		posted := adv.Status == domain.StatusPosted
+		need := PermAdvanceWrite
+		if posted {
+			need = PermAdvancePost
+		}
+		if _, err := actor.Require(ctx, need); err != nil {
+			return "", err
+		}
+		if err := adv.Cancel(reason); err != nil {
+			return "", err
+		}
+		if !posted {
+			return adv.CancelReason, nil
+		}
+		entry, err := s.Ledger.Reverse(ctx, accounting.ReversalRequest{
+			SourceType: SourcePurchaseAdvance, SourceID: adv.ID, RuleCode: RuleAdvance, BusinessDate: s.today(),
+			Reason: "Pembatalan uang muka " + adv.Number + ": " + adv.CancelReason,
+		})
+		if err != nil {
+			return "", err
+		}
+		adv.ReversalJournalEntryID = &entry.ID
+		return adv.CancelReason + " (jurnal balik " + entry.Number + ")", nil
+	})
+}
diff --git a/backend/internal/procurement/service/integration.go b/backend/internal/procurement/service/integration.go
new file mode 100644
index 0000000..171fae4
--- /dev/null
+++ b/backend/internal/procurement/service/integration.go
@@ -0,0 +1,278 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/riverqueue/river"
+
+	"balans/internal/audit"
+	"balans/internal/platform/actor"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/jobqueue"
+	"balans/internal/platform/money"
+	"balans/internal/procurement/domain"
+)
+
+// API untuk Penerimaan Barang (S-206/S-207) dan Tagihan Pemasok (S-208). Dipanggil di dalam transaksi dokumen
+// pemanggil; tidak memeriksa permission karena pemanggil memeriksa aksi user-nya sendiri.
+
+// Order membaca PO beserta baris dan bahan maklon tanpa memeriksa permission.
+func (s *Service) Order(ctx context.Context, id uuid.UUID) (domain.PurchaseOrder, error) {
+	return s.Store.GetOrder(ctx, id, false)
+}
+
+// ReceivableOrder mengembalikan PO yang bisa diterima (Disetujui atau Diterima Sebagian) beserta baris, sisa qty,
+// bahan maklon, dan lokasi maklon. INVALID_STATE_TRANSITION bila PO belum disetujui atau sudah selesai.
+func (s *Service) ReceivableOrder(ctx context.Context, id uuid.UUID) (domain.PurchaseOrder, error) {
+	o, err := s.Store.GetOrder(ctx, id, false)
+	if err != nil {
+		return domain.PurchaseOrder{}, err
+	}
+	if !o.Receivable() {
+		return domain.PurchaseOrder{}, apperr.WithMessage(apperr.CodeInvalidStateTransition, fmt.Sprintf(
+			"Purchase Order %s berstatus %s; hanya PO Disetujui atau Diterima Sebagian yang bisa diterima.",
+			orderLabel(o), o.Status.Label()))
+	}
+	return o, nil
+}
+
+// applyLineQty mengunci PO, menerapkan perubahan qty, menyimpan, menghitung ulang PR, dan mencatat audit.
+func (s *Service) applyLineQty(ctx context.Context, id uuid.UUID, note string, fn func(o *domain.PurchaseOrder) error) (domain.PurchaseOrder, error) {
+	var o domain.PurchaseOrder
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		var err error
+		if o, err = s.Store.GetOrder(ctx, id, true); err != nil {
+			return err
+		}
+		version, before := o.Version, o.Status
+		if err := fn(&o); err != nil {
+			return err
+		}
+		if err := s.Store.SaveOrderLineQty(ctx, o.Lines); err != nil {
+			return err
+		}
+		if err := s.Store.SaveOrder(ctx, o, version, actor.UserID(ctx), false); err != nil {
+			return err
+		}
+		o.Version = version + 1
+		if o.Status == before {
+			return nil
+		}
+		return s.Audit.Record(ctx, audit.Entry{
+			Action: audit.ActionStatusChange, EntityType: EntityPurchaseOrder, EntityID: o.ID, EntityLabel: o.Number,
+			Before: map[string]any{"status": string(before)}, After: map[string]any{"status": string(o.Status)}, Note: note,
+		})
+	})
+	return o, err
+}
+
+// RecordReceipt menambah (atau, untuk pembatalan penerimaan, mengurangi dengan qty negatif) qty diterima per
+// baris PO dan menyesuaikan status Diterima Sebagian/Diterima. Toleransi qty 0%.
+func (s *Service) RecordReceipt(ctx context.Context, id uuid.UUID, receiptLabel string, deltas []domain.QtyDelta) (domain.PurchaseOrder, error) {
+	return s.applyLineQty(ctx, id, "Penerimaan "+receiptLabel, func(o *domain.PurchaseOrder) error {
+		return o.ApplyReceipt(deltas)
+	})
+}
+
+// RecordBilling menambah (atau mengurangi) qty yang ditagih per baris; PO Diterima yang tertagih penuh menjadi
+// Selesai.
+func (s *Service) RecordBilling(ctx context.Context, id uuid.UUID, billLabel string, deltas []domain.QtyDelta) (domain.PurchaseOrder, error) {
+	return s.applyLineQty(ctx, id, "Tagihan "+billLabel, func(o *domain.PurchaseOrder) error {
+		return o.ApplyBilling(deltas)
+	})
+}
+
+// OutstandingAdvances mengembalikan uang muka Diposting satu PO yang masih punya sisa, urut tanggal bayar.
+func (s *Service) OutstandingAdvances(ctx context.Context, orderID uuid.UUID) ([]domain.Advance, error) {
+	list, err := s.Store.AdvancesByOrder(ctx, orderID)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]domain.Advance, 0, len(list))
+	for _, a := range list {
+		if a.Outstanding().IsPositive() {
+			out = append(out, a)
+		}
+	}
+	return out, nil
+}
+
+// AdvanceApplication adalah potongan satu uang muka oleh tagihan.
+type AdvanceApplication struct {
+	AdvanceID     uuid.UUID
+	AdvanceNumber string
+	Amount        money.Amount
+}
+
+// ApplyAdvances memotong uang muka PO sebesar maksimal amount (FIFO tanggal bayar) dan mengembalikan rincian
+// potongannya. Tagihan pemasok memposting A-19 `advance_applied` (Dr 2101 / Cr 1401) sebesar total potongan.
+func (s *Service) ApplyAdvances(ctx context.Context, orderID uuid.UUID, amount money.Amount) ([]AdvanceApplication, error) {
+	if amount.IsNegative() {
+		return nil, apperr.Validation(map[string]string{"advanceAppliedAmount": "Potongan uang muka tidak boleh negatif"})
+	}
+	var out []AdvanceApplication
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		if _, err := s.Store.GetOrder(ctx, orderID, true); err != nil {
+			return err
+		}
+		list, err := s.Store.AdvancesByOrder(ctx, orderID)
+		if err != nil {
+			return err
+		}
+		alloc := domain.AllocateAdvances(list, amount)
+		for _, a := range list {
+			take, ok := alloc[a.ID]
+			if !ok {
+				continue
+			}
+			version := a.Version
+			if err := a.Apply(take); err != nil {
+				return err
+			}
+			if err := s.Store.SaveAdvance(ctx, a, version, actor.UserID(ctx)); err != nil {
+				return err
+			}
+			out = append(out, AdvanceApplication{AdvanceID: a.ID, AdvanceNumber: a.Number, Amount: take})
+		}
+		return nil
+	})
+	return out, err
+}
+
+// ReleaseAdvances mengembalikan potongan uang muka saat tagihan pemasok dibatalkan.
+func (s *Service) ReleaseAdvances(ctx context.Context, applications []AdvanceApplication) error {
+	return s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		for _, app := range applications {
+			a, err := s.Store.GetAdvance(ctx, app.AdvanceID, true)
+			if err != nil {
+				return err
+			}
+			version := a.Version
+			if err := a.Apply(app.Amount.Neg()); err != nil {
+				return err
+			}
+			if err := s.Store.SaveAdvance(ctx, a, version, actor.UserID(ctx)); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+// --- Notifikasi ETA H-1 -----------------------------------------------------------------------
+
+// kindETA adalah jenis notifikasi in-app ETA PO.
+const kindETA = "procurement.eta"
+
+// NotifyETAArgs adalah argumen job procurement.notify_eta (Technical Guideline Lampiran B).
+type NotifyETAArgs struct{}
+
+// Kind adalah nama job.
+func (NotifyETAArgs) Kind() string { return "procurement.notify_eta" }
+
+// InsertOpts: maks. 3 percobaan.
+func (NotifyETAArgs) InsertOpts() river.InsertOpts {
+	return river.InsertOpts{Queue: jobqueue.QueueDefault, MaxAttempts: 3}
+}
+
+// NotifyETA memberi tahu Logistik Leader (in-app + email) tentang PO yang dijadwalkan tiba besok beserta detail
+// barangnya, agar armada & manpower bisa diatur (S-202). Idempotent: setiap PO hanya sekali (eta_notified_at).
+func (s *Service) NotifyETA(ctx context.Context) (int, error) {
+	ctx = actor.System(ctx)
+	tomorrow := s.today().AddDays(1)
+	ids, err := s.Store.OrdersDueForETA(ctx, tomorrow)
+	if err != nil || len(ids) == 0 {
+		return 0, err
+	}
+	leaders, err := s.Users.UsersWithRole(ctx, RoleLogisticsLeader)
+	if err != nil {
+		return 0, err
+	}
+	if len(leaders) == 0 {
+		s.Log.WarnContext(ctx, "eta notification has no logistics leader", "orders", len(ids))
+	}
+	sent := 0
+	for _, id := range ids {
+		err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+			ok, err := s.Store.MarkETANotified(ctx, id, s.Clock.Now())
+			if err != nil || !ok || len(leaders) == 0 {
+				return err
+			}
+			o, err := s.Store.GetOrder(ctx, id, false)
+			if err != nil {
+				return err
+			}
+			v, err := s.orderView(ctx, o)
+			if err != nil {
+				return err
+			}
+			return s.sendETA(ctx, v, leaders)
+		})
+		if err != nil {
+			return sent, fmt.Errorf("notify eta purchase order %s: %w", id, err)
+		}
+		sent++
+	}
+	return sent, nil
+}
+
+// etaDetail menyusun detail barang PO untuk notifikasi ETA.
+func etaDetail(v OrderView) []string {
+	lines := make([]string, 0, len(v.Lines)+len(v.Materials))
+	for _, l := range v.Lines {
+		name, uom := l.Description, ""
+		if l.ProductID != nil {
+			if p, ok := v.Products[*l.ProductID]; ok {
+				name, uom = p.SKU+" "+p.Name, " "+p.UOM
+			}
+		}
+		lines = append(lines, fmt.Sprintf("- %s: %s%s (sisa %s)", name, l.OrderedQty.String(), uom, l.OutstandingQty().String()))
+	}
+	return lines
+}
+
+func (s *Service) sendETA(ctx context.Context, v OrderView, leaders []UserRef) error {
+	title := fmt.Sprintf("Barang tiba besok: %s", v.Number)
+	detail := etaDetail(v)
+	body := fmt.Sprintf("%s · %s · %d baris · tiba %s", v.Type.Label(), v.SupplierName, len(v.Lines), v.ExpectedDate.String())
+	ids := make([]uuid.UUID, len(leaders))
+	for i, u := range leaders {
+		ids[i] = u.ID
+	}
+	link := OrderPath(v.ID)
+	if err := s.Notifier.Notify(ctx, ids, kindETA, title, body, link); err != nil {
+		return err
+	}
+	text := fmt.Sprintf("%s\n\nPemasok: %s\nJenis PO: %s\nTanggal kirim diharapkan: %s\n\nDetail barang:\n%s\n\nBuka Purchase Order:\n%s%s\n",
+		title, v.SupplierName, v.Type.Label(), v.ExpectedDate.String(), strings.Join(detail, "\n"), s.BaseURL, link)
+	for _, u := range leaders {
+		if u.Email == "" {
+			continue
+		}
+		if _, err := s.Notifier.QueueEmail(ctx, u.Email, title, text); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// NotifyETAWorker menjalankan job procurement.notify_eta.
+type NotifyETAWorker struct {
+	river.WorkerDefaults[NotifyETAArgs]
+	service *Service
+}
+
+// NewNotifyETAWorker membuat worker.
+func NewNotifyETAWorker(s *Service) *NotifyETAWorker { return &NotifyETAWorker{service: s} }
+
+// Work mengirim notifikasi ETA.
+func (w *NotifyETAWorker) Work(ctx context.Context, _ *river.Job[NotifyETAArgs]) error {
+	n, err := w.service.NotifyETA(ctx)
+	if n > 0 {
+		w.service.Log.InfoContext(ctx, "purchase order eta notifications sent", "count", n)
+	}
+	return err
+}
