+
+	ListOrders(ctx context.Context, f postgres.OrderFilter, page paging.Page) (paging.Result[domain.PurchaseOrder], error)
+	GetOrder(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.PurchaseOrder, error)
