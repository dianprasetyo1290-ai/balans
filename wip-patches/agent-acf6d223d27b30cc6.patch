-		river.NewPeriodicJob(river.PeriodicInterval(time.Minute),
-			func() (river.JobArgs, *river.InsertOpts) { return service.ExpireReservationsArgs{}, nil },
-			&river.PeriodicJobOpts{ID: service.ExpireReservationsArgs{}.Kind()}),
-	}
-}
