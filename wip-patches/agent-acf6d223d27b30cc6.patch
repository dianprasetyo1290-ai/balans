+	pool     *pgxpool.Pool
+	clock    *clock.Fixed
+	dir      *directory
+	masters  *masters
+	approval *approval.Module
+	accounts *accounting.Module
+	srv      *httptest.Server
+	current  actor.Actor
+	mu       sync.Mutex
