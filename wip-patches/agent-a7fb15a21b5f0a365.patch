 	ID        uuid.UUID
 	ChannelID uuid.UUID
diff --git a/backend/internal/warehouse/domain/adjustment.go b/backend/internal/warehouse/domain/adjustment.go
new file mode 100644
index 0000000..b60df75
--- /dev/null
+++ b/backend/internal/warehouse/domain/adjustment.go
@@ -0,0 +1,81 @@
+package domain
+
+import (
+	"sort"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+)
+
+// Kode akun persediaan (Desain Finance & Accounting bagian 1) untuk resolver location_inventory_account.
+const (
+	AccountPackaging   = "1301"
+	AccountReprocess   = "1302"
+	AccountFGWarehouse = "1311"
+	AccountFGConsign   = "1312"
+	AccountFGVending   = "1313"
+	AccountReturns     = "1314"
+)
+
+// InventoryAccount memilih akun persediaan menurut jenis produk catalog dan jenis lokasi: Packaging → 1301,
+// bahan reprocess → 1302, Produk Jadi di konsinyasi → 1312, di buffer/mesin vending → 1313, di Gudang Retur
+// → 1314, Produk Jadi lain → 1311.
+func InventoryAccount(productType string, location LocationType) string {
+	if location == LocationReturns {
+		return AccountReturns
+	}
+	switch productType {
+	case "packaging":
+		return AccountPackaging
+	case "reprocess_material":
+		return AccountReprocess
+	}
+	switch location {
+	case LocationConsignment:
+		return AccountFGConsign
+	case LocationVendingBuffer, LocationVendingMachine:
+		return AccountFGVending
+	}
+	return AccountFGWarehouse
+}
+
+// AdjustmentLine adalah satu mutasi penyesuaian hasil stock count: Qty negatif = kurang (keluar dari stok
+// Tersedia), positif = lebih (masuk stok Tersedia dengan HPP snapshot).
+type AdjustmentLine struct {
+	LineID    uuid.UUID
+	ProductID uuid.UUID
+	BatchID   *uuid.UUID
+	Qty       decimal.Decimal
+	UnitCost  decimal.Decimal
+}
+
+// Adjustments mengembalikan baris yang perlu disesuaikan (selisih ≠ 0).
+func (c StockCount) Adjustments() []AdjustmentLine {
+	var out []AdjustmentLine
+	for _, l := range c.Lines {
+		if l.VarianceQty.IsZero() {
+			continue
+		}
+		out = append(out, AdjustmentLine{LineID: l.ID, ProductID: l.ProductID, BatchID: l.BatchID, Qty: l.VarianceQty, UnitCost: l.UnitCost})
+	}
+	return out
+}
+
+// AccountSplit adalah nilai selisih bersih per akun persediaan untuk A-14 (positif = kurang/beban).
+type AccountSplit struct {
+	Account string
+	Amount  decimal.Decimal
+}
+
+// ShortageSplits menjumlahkan nilai per akun dan membuang akun yang bersih nol; urut kode akun.
+func ShortageSplits(values map[string]decimal.Decimal) []AccountSplit {
+	out := make([]AccountSplit, 0, len(values))
+	for acc, v := range values {
+		if v.Round(2).IsZero() {
+			continue
+		}
+		out = append(out, AccountSplit{Account: acc, Amount: v.Round(2)})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Account < out[j].Account })
+	return out
+}
diff --git a/backend/internal/warehouse/domain/document.go b/backend/internal/warehouse/domain/document.go
new file mode 100644
index 0000000..4a4aa29
--- /dev/null
+++ b/backend/internal/warehouse/domain/document.go
@@ -0,0 +1,104 @@
+package domain
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+)
+
+// Status adalah status dokumen gudang (Desain Status Dokumen bagian 1 dan 3).
+type Status string
+
+const (
+	StatusDraft             Status = "draft"
+	StatusSubmitted         Status = "submitted"
+	StatusPendingApproval   Status = "pending_approval"
+	StatusRejected          Status = "rejected"
+	StatusInProgress        Status = "in_progress"
+	StatusInTransit         Status = "in_transit"
+	StatusPartiallyReceived Status = "partially_received"
+	StatusReceived          Status = "received"
+	StatusPosted            Status = "posted"
+	StatusCompleted         Status = "completed"
+	StatusCancelled         Status = "cancelled"
+)
+
+// Aksi dokumen gudang (allowedActions dan nama transisi).
+const (
+	ActionEdit     = "edit"
+	ActionSubmit   = "submit"
+	ActionRelease  = "release"
+	ActionPrepare  = "prepare"
+	ActionPost     = "post"
+	ActionShip     = "ship"
+	ActionReceive  = "receive"
+	ActionComplete = "complete"
+	ActionCancel   = "cancel"
+	ActionStart    = "start"
+	ActionCount    = "count"
+	ActionApprove  = "approve"
+	ActionReject   = "reject"
+	ActionRecount  = "recount"
+	ActionQC       = "qc"
+)
+
+// Batas dokumen.
+const (
+	MaxDocumentLines = 200
+	MaxNoteLength    = 500
+	// QtyScale adalah jumlah desimal qty (numeric(18,3)).
+	QtyScale = 3
+)
+
+// transition adalah satu baris tabel transisi status.
+type transition struct {
+	from   Status
+	action string
+	to     Status
+}
+
+// transitionTable mencari status tujuan aksi; aksi yang tidak terdaftar ditolak INVALID_STATE_TRANSITION.
+type transitionTable []transition
+
+func (t transitionTable) next(entity string, from Status, action string) (Status, error) {
+	for _, tr := range t {
+		if tr.from == from && tr.action == action {
+			return tr.to, nil
+		}
+	}
+	return "", apperr.InvalidStateTransition(entity, string(from), action)
+}
+
+func (t transitionTable) allows(from Status, action string) bool {
+	_, err := t.next("", from, action)
+	return err == nil
+}
+
+var sourceTypePattern = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)
+
+// ValidSourceType memeriksa jenis dokumen sumber snake_case (mis. goods_receipt).
+func ValidSourceType(s string) bool { return sourceTypePattern.MatchString(s) && len(s) <= 60 }
+
+func lineField(i int, f string) string { return fmt.Sprintf("lines[%d].%s", i, f) }
+
+// validQty memeriksa qty positif dengan maksimal 3 desimal.
+func validQty(q decimal.Decimal) bool {
+	return q.IsPositive() && q.Equal(q.Round(QtyScale))
+}
+
+// validQtyOrZero memeriksa qty ≥ 0 dengan maksimal 3 desimal.
+func validQtyOrZero(q decimal.Decimal) bool {
+	return !q.IsNegative() && q.Equal(q.Round(QtyScale))
+}
+
+func checkNote(note string, field string, fields map[string]string) string {
+	note = strings.TrimSpace(note)
+	if len([]rune(note)) > MaxNoteLength {
+		fields[field] = fmt.Sprintf("Maksimal %d karakter", MaxNoteLength)
+	}
+	return note
+}
diff --git a/backend/internal/warehouse/domain/inbound.go b/backend/internal/warehouse/domain/inbound.go
new file mode 100644
index 0000000..f09e154
--- /dev/null
+++ b/backend/internal/warehouse/domain/inbound.go
@@ -0,0 +1,357 @@
+package domain
+
+import (
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// Jenis dokumen asal Inbound yang dikenal (Desain Data Model 6.1). Modul lain boleh memakai jenis lain
+// selama snake_case; labelnya tampil apa adanya.
+const (
+	SourceGoodsReceipt        = "goods_receipt"
+	SourceSalesReturn         = "sales_return"
+	SourceConsignmentPullback = "consignment_pullback"
+	SourceStockTransfer       = "stock_transfer"
+	SourceInternalUsageReturn = "internal_usage_return"
+)
+
+var sourceLabels = map[string]string{
+	SourceGoodsReceipt: "Penerimaan Barang", SourceSalesReturn: "Retur Penjualan",
+	SourceConsignmentPullback: "Tarikan Konsinyasi", SourceStockTransfer: "Transfer Stok",
+	SourceInternalUsageReturn: "Sisa Pemakaian Internal",
+}
+
+// SourceTypeLabel adalah label jenis dokumen asal Inbound.
+func SourceTypeLabel(t string) string {
+	if l, ok := sourceLabels[t]; ok {
+		return l
+	}
+	return t
+}
+
+// RejectAction adalah perlakuan qty yang ditolak QC.
+type RejectAction string
+
+const (
+	// RejectHold: qty ditolak tetap Karantina di Inbound; modul asal memutuskan (reject penerimaan PRC-05,
+	// retur ke pemasok/maklon).
+	RejectHold RejectAction = "hold"
+	// RejectToReturns: qty ditolak pindah ke Gudang Retur (tetap Karantina) untuk disposisi (WMS-07).
+	RejectToReturns RejectAction = "returns"
+)
+
+// DefaultRejectAction: barang dari pemasok/maklon ditahan di Inbound, selain itu ke Gudang Retur.
+func DefaultRejectAction(sourceType string) RejectAction {
+	if sourceType == SourceGoodsReceipt {
+		return RejectHold
+	}
+	return RejectToReturns
+}
+
+// LineStatus adalah status baris Inbound.
+type LineStatus string
+
+const (
+	LineQuarantine LineStatus = "quarantine"
+	LinePosted     LineStatus = "posted"
+	LineQCRejected LineStatus = "qc_rejected"
+)
+
+// Inbound adalah antrian barang Karantina dari satu dokumen asal (WMS-02, WMS-09).
+type Inbound struct {
+	ID           uuid.UUID
+	Number       string
+	SourceType   string
+	SourceID     uuid.UUID
+	SourceLabel  string
+	WarehouseID  uuid.UUID
+	LocationID   uuid.UUID
+	BusinessDate clock.BusinessDate
+	RejectAction RejectAction
+	Status       Status
+	Note         string
+	CompletedAt  *time.Time
+	CreatedAt    time.Time
+	CreatedBy    uuid.UUID
+	UpdatedAt    time.Time
+	Version      int
+	Lines        []InboundLine
+}
+
+// InboundLine adalah satu baris barang Karantina.
+type InboundLine struct {
+	ID                    uuid.UUID
+	LineNo                int
+	SourceLineID          *uuid.UUID
+	ProductID             uuid.UUID
+	BatchID               *uuid.UUID
+	Qty                   decimal.Decimal
+	PassedQty             decimal.Decimal
+	RejectedQty           decimal.Decimal
+	DestinationLocationID uuid.UUID
+	Status                LineStatus
+	RejectReason          string
+	RejectLocationID      *uuid.UUID
+	CheckedBy             *uuid.UUID
+	CheckedByName         string
+	CheckedAt             *time.Time
+}
+
+// InboundLineInput adalah baris dari modul asal.
+type InboundLineInput struct {
+	SourceLineID *uuid.UUID
+	ProductID    uuid.UUID
+	BatchID      *uuid.UUID
+	Qty          decimal.Decimal
+	// DestinationLocationID opsional; kosong = lokasi standar sesuai jenis produk (diisi service).
+	DestinationLocationID *uuid.UUID
+}
+
+// InboundInput adalah permintaan pembuatan Inbound.
+type InboundInput struct {
+	SourceType   string
+	SourceID     uuid.UUID
+	SourceLabel  string
+	LocationID   uuid.UUID
+	BusinessDate clock.BusinessDate
+	RejectAction RejectAction
+	Note         string
+	Lines        []InboundLineInput
+}
+
+// NewInbound memvalidasi Inbound baru berstatus in_progress dengan semua baris Karantina. Lokasi tujuan
+// setiap baris harus sudah terisi (service mengisi default sebelum memanggil).
+func NewInbound(in InboundInput) (Inbound, error) {
+	fields := map[string]string{}
+	if !ValidSourceType(in.SourceType) {
+		fields["source.type"] = "Jenis dokumen asal tidak valid"
+	}
+	if in.SourceID == uuid.Nil {
+		fields["source.id"] = "Dokumen asal wajib diisi"
+	}
+	if len([]rune(in.SourceLabel)) > 120 {
+		fields["source.label"] = "Maksimal 120 karakter"
+	}
+	if in.LocationID == uuid.Nil {
+		fields["locationId"] = "Lokasi Inbound wajib diisi"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	if in.RejectAction == "" {
+		in.RejectAction = DefaultRejectAction(in.SourceType)
+	}
+	if in.RejectAction != RejectHold && in.RejectAction != RejectToReturns {
+		fields["rejectAction"] = "Perlakuan barang ditolak tidak dikenal"
+	}
+	note := checkNote(in.Note, "note", fields)
+	switch {
+	case len(in.Lines) == 0:
+		fields["lines"] = "Minimal satu baris"
+	case len(in.Lines) > MaxDocumentLines:
+		fields["lines"] = "Terlalu banyak baris"
+	}
+	ib := Inbound{
+		SourceType: in.SourceType, SourceID: in.SourceID, SourceLabel: in.SourceLabel, LocationID: in.LocationID,
+		BusinessDate: in.BusinessDate, RejectAction: in.RejectAction, Status: StatusInProgress, Note: note,
+	}
+	for i, l := range in.Lines {
+		if l.ProductID == uuid.Nil {
+			fields[lineField(i, "productId")] = "Produk wajib diisi"
+		}
+		if !validQty(l.Qty) {
+			fields[lineField(i, "qty")] = "Qty harus lebih dari 0 (maks. 3 desimal)"
+		}
+		if l.DestinationLocationID == nil || *l.DestinationLocationID == uuid.Nil {
+			fields[lineField(i, "destinationLocationId")] = "Lokasi tujuan wajib diisi"
+		}
+		line := InboundLine{
+			LineNo: i + 1, SourceLineID: l.SourceLineID, ProductID: l.ProductID, BatchID: l.BatchID, Qty: l.Qty,
+			Status: LineQuarantine, PassedQty: decimal.Zero, RejectedQty: decimal.Zero,
+		}
+		if l.DestinationLocationID != nil {
+			line.DestinationLocationID = *l.DestinationLocationID
+		}
+		ib.Lines = append(ib.Lines, line)
+	}
+	if len(fields) > 0 {
+		return Inbound{}, apperr.Validation(fields)
+	}
+	return ib, nil
+}
+
+// Line mengembalikan baris berdasarkan ID.
+func (ib *Inbound) Line(id uuid.UUID) (*InboundLine, bool) {
+	for i := range ib.Lines {
+		if ib.Lines[i].ID == id {
+			return &ib.Lines[i], true
+		}
+	}
+	return nil, false
+}
+
+// AllChecked memeriksa apakah semua baris sudah QC.
+func (ib Inbound) AllChecked() bool {
+	for _, l := range ib.Lines {
+		if l.Status == LineQuarantine {
+			return false
+		}
+	}
+	return true
+}
+
+// Checklist adalah butir QC per baris (Desain UI/UX 5: batch, expired, kondisi, segel). true = sesuai.
+type Checklist struct {
+	Batch     bool `json:"batch"`
+	Expiry    bool `json:"expiry"`
+	Condition bool `json:"condition"`
+	Seal      bool `json:"seal"`
+}
+
+// AllPassed memeriksa apakah semua butir sesuai.
+func (c Checklist) AllPassed() bool { return c.Batch && c.Expiry && c.Condition && c.Seal }
+
+// QCInput adalah hasil QC satu baris.
+type QCInput struct {
+	PassedQty   decimal.Decimal
+	RejectedQty decimal.Decimal
+	Checks      Checklist
+	// RejectReason wajib bila ada qty ditolak.
+	RejectReason string
+	// DestinationLocationID opsional: mengganti lokasi tujuan qty lulus.
+	DestinationLocationID *uuid.UUID
+	Note                  string
+	PhotoFileIDs          []uuid.UUID
+}
+
+// MaxQCPhotos membatasi jumlah foto QC per baris.
+const MaxQCPhotos = 5
+
+// ApplyQC memvalidasi dan mencatat hasil QC baris: qty lulus + ditolak = qty baris; ditolak wajib alasan; baris
+// yang seluruhnya lulus wajib semua butir checklist sesuai. Baris yang sudah QC ditolak INVALID_STATE_TRANSITION.
+func (l *InboundLine) ApplyQC(in QCInput, by uuid.UUID, byName string, at time.Time) (QCInput, error) {
+	if l.Status != LineQuarantine {
+		return in, apperr.InvalidStateTransition("inbound_line", string(l.Status), ActionQC)
+	}
+	fields := map[string]string{}
+	if !validQtyOrZero(in.PassedQty) {
+		fields["passedQty"] = "Qty lulus tidak valid"
+	}
+	if !validQtyOrZero(in.RejectedQty) {
+		fields["rejectedQty"] = "Qty ditolak tidak valid"
+	}
+	if len(fields) == 0 && !in.PassedQty.Add(in.RejectedQty).Equal(l.Qty) {
+		fields["passedQty"] = "Qty lulus + ditolak harus sama dengan qty baris (" + l.Qty.String() + ")"
+	}
+	in.RejectReason = checkNote(in.RejectReason, "rejectReason", fields)
+	in.Note = checkNote(in.Note, "note", fields)
+	if in.RejectedQty.IsPositive() && in.RejectReason == "" {
+		fields["rejectReason"] = "Alasan penolakan wajib diisi"
+	}
+	if in.RejectedQty.IsZero() && !in.Checks.AllPassed() {
+		fields["checks"] = "Semua butir QC harus sesuai untuk meluluskan seluruh qty; tolak qty yang tidak sesuai"
+	}
+	if len(in.PhotoFileIDs) > MaxQCPhotos {
+		fields["photoFileIds"] = "Maksimal 5 foto"
+	}
+	if in.DestinationLocationID != nil && *in.DestinationLocationID == uuid.Nil {
+		in.DestinationLocationID = nil
+	}
+	if len(fields) > 0 {
+		return in, apperr.Validation(fields)
+	}
+	l.PassedQty, l.RejectedQty, l.RejectReason = in.PassedQty, in.RejectedQty, in.RejectReason
+	if in.DestinationLocationID != nil {
+		l.DestinationLocationID = *in.DestinationLocationID
+	}
+	l.Status = LinePosted
+	if l.PassedQty.IsZero() {
+		l.Status = LineQCRejected
+	}
+	l.CheckedBy, l.CheckedByName, l.CheckedAt = &by, byName, &at
+	return in, nil
+}
+
+// QualityCheck adalah catatan QC (TG 5.7.2); satu baris QC bisa menghasilkan catatan lulus dan ditolak.
+type QualityCheck struct {
+	ID             uuid.UUID
+	DocumentType   string
+	DocumentID     uuid.UUID
+	DocumentLineID uuid.UUID
+	Result         string
+	Qty            decimal.Decimal
+	Checks         Checklist
+	Note           string
+	PhotoFileIDs   []uuid.UUID
+	CheckedBy      uuid.UUID
+	CheckedByName  string
+	CheckedAt      time.Time
+}
+
+// Hasil QC.
+const (
+	QCPassed   = "passed"
+	QCRejected = "rejected"
+)
+
+// QualityChecks menyusun catatan QC dari hasil satu baris Inbound.
+func QualityChecks(ib Inbound, l InboundLine, in QCInput) []QualityCheck {
+	base := QualityCheck{
+		DocumentType: "inbound", DocumentID: ib.ID, DocumentLineID: l.ID, Checks: in.Checks, Note: in.Note,
+		PhotoFileIDs: in.PhotoFileIDs, CheckedByName: l.CheckedByName,
+	}
+	if l.CheckedBy != nil {
+		base.CheckedBy = *l.CheckedBy
+	}
+	if l.CheckedAt != nil {
+		base.CheckedAt = *l.CheckedAt
+	}
+	var out []QualityCheck
+	if l.PassedQty.IsPositive() {
+		q := base
+		q.Result, q.Qty = QCPassed, l.PassedQty
+		out = append(out, q)
+	}
+	if l.RejectedQty.IsPositive() {
+		q := base
+		q.Result, q.Qty, q.Note = QCRejected, l.RejectedQty, joinNote(l.RejectReason, in.Note)
+		out = append(out, q)
+	}
+	return out
+}
+
+func joinNote(a, b string) string {
+	switch {
+	case a == "":
+		return b
+	case b == "":
+		return a
+	}
+	return a + " — " + b
+}
+
+// DefaultDestinationType adalah lokasi tujuan standar barang lulus QC menurut jenis produk catalog:
+// Produk Jadi → FG Non-Ecommerce, Packaging → RM, bahan reprocess → GM.
+func DefaultDestinationType(productType string) LocationType {
+	switch productType {
+	case "packaging":
+		return LocationRawMaterial
+	case "reprocess_material":
+		return LocationGoodsMaterial
+	}
+	return LocationFinishedGoods
+}
+
+// Complete menutup Inbound bila semua baris sudah QC.
+func (ib *Inbound) Complete(at time.Time) bool {
+	if ib.Status != StatusInProgress || !ib.AllChecked() {
+		return false
+	}
+	ib.Status, ib.CompletedAt = StatusCompleted, &at
+	return true
+}
diff --git a/backend/internal/warehouse/domain/schedule.go b/backend/internal/warehouse/domain/schedule.go
new file mode 100644
index 0000000..eda4e37
--- /dev/null
+++ b/backend/internal/warehouse/domain/schedule.go
@@ -0,0 +1,164 @@
+package domain
+
+import (
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// Frequency adalah frekuensi jadwal stock count (WMS-11).
+type Frequency string
+
+const (
+	FrequencyWeekly  Frequency = "weekly"
+	FrequencyMonthly Frequency = "monthly"
+	FrequencyYearly  Frequency = "yearly"
+)
+
+// CountSchedule adalah jadwal stock count: cycle count berkala, konsinyasi/vending bulanan, penuh akhir tahun.
+type CountSchedule struct {
+	ID             uuid.UUID
+	Name           string
+	CountType      CountType
+	Frequency      Frequency
+	DayOfWeek      *int
+	DayOfMonth     *int
+	MonthOfYear    *int
+	WarehouseID    *uuid.UUID
+	LocationIDs    []uuid.UUID
+	AssigneeUserID *uuid.UUID
+	AssigneeName   string
+	NextRunDate    clock.BusinessDate
+	LastRunDate    *clock.BusinessDate
+	IsActive       bool
+	CreatedAt      time.Time
+	UpdatedAt      time.Time
+	Version        int
+}
+
+// ScheduleInput adalah isian jadwal.
+type ScheduleInput struct {
+	Name           string
+	CountType      CountType
+	Frequency      Frequency
+	DayOfWeek      *int
+	DayOfMonth     *int
+	MonthOfYear    *int
+	WarehouseID    *uuid.UUID
+	LocationIDs    []uuid.UUID
+	AssigneeUserID *uuid.UUID
+	AssigneeName   string
+	IsActive       bool
+}
+
+// NewSchedule memvalidasi jadwal dan menghitung tanggal jalan pertama (hari ini atau sesudahnya).
+func NewSchedule(in ScheduleInput, today clock.BusinessDate) (CountSchedule, error) {
+	s := CountSchedule{}
+	if err := s.apply(in, today); err != nil {
+		return CountSchedule{}, err
+	}
+	return s, nil
+}
+
+// Update mengganti isian jadwal; tanggal jalan berikutnya dihitung ulang dari hari ini.
+func (s *CountSchedule) Update(in ScheduleInput, today clock.BusinessDate) error { return s.apply(in, today) }
+
+func (s *CountSchedule) apply(in ScheduleInput, today clock.BusinessDate) error {
+	fields := map[string]string{}
+	name := strings.TrimSpace(in.Name)
+	if name == "" || len([]rune(name)) > MaxNameLength {
+		fields["name"] = "Nama jadwal wajib diisi (maks. 120 karakter)"
+	}
+	if !in.CountType.Valid() {
+		fields["countType"] = "Jenis stock count tidak dikenal"
+	}
+	n := CountSchedule{
+		Name: name, CountType: in.CountType, Frequency: in.Frequency, WarehouseID: in.WarehouseID,
+		LocationIDs: in.LocationIDs, AssigneeUserID: in.AssigneeUserID, AssigneeName: in.AssigneeName, IsActive: in.IsActive,
+	}
+	inRange := func(v *int, lo, hi int) bool { return v != nil && *v >= lo && *v <= hi }
+	switch in.Frequency {
+	case FrequencyWeekly:
+		if !inRange(in.DayOfWeek, 1, 7) {
+			fields["dayOfWeek"] = "Hari wajib dipilih (Senin – Minggu)"
+		}
+		n.DayOfWeek = in.DayOfWeek
+	case FrequencyMonthly:
+		if !inRange(in.DayOfMonth, 1, 31) {
+			fields["dayOfMonth"] = "Tanggal 1 – 31 (31 = akhir bulan)"
+		}
+		n.DayOfMonth = in.DayOfMonth
+	case FrequencyYearly:
+		if !inRange(in.DayOfMonth, 1, 31) {
+			fields["dayOfMonth"] = "Tanggal 1 – 31 (31 = akhir bulan)"
+		}
+		if !inRange(in.MonthOfYear, 1, 12) {
+			fields["monthOfYear"] = "Bulan wajib dipilih"
+		}
+		n.DayOfMonth, n.MonthOfYear = in.DayOfMonth, in.MonthOfYear
+	default:
+		fields["frequency"] = "Frekuensi tidak dikenal"
+	}
+	if in.CountType.Adjusts() && in.WarehouseID == nil && len(in.LocationIDs) == 0 {
+		fields["warehouseId"] = "Pilih gudang atau lokasi yang dihitung"
+	}
+	if len(in.LocationIDs) > 100 {
+		fields["locationIds"] = "Maksimal 100 lokasi"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	n.ID, n.CreatedAt, n.UpdatedAt, n.Version, n.LastRunDate = s.ID, s.CreatedAt, s.UpdatedAt, s.Version, s.LastRunDate
+	n.NextRunDate = n.Occurrence(today)
+	*s = n
+	return nil
+}
+
+// Occurrence mengembalikan tanggal jalan pertama yang sama dengan atau sesudah from.
+func (s CountSchedule) Occurrence(from clock.BusinessDate) clock.BusinessDate {
+	switch s.Frequency {
+	case FrequencyWeekly:
+		// time.Weekday: Minggu = 0; jadwal: Senin = 1 … Minggu = 7.
+		want := *s.DayOfWeek % 7
+		d := from
+		for int(d.Time().Weekday()) != want {
+			d = d.AddDays(1)
+		}
+		return d
+	case FrequencyMonthly:
+		d := dayInMonth(from.Year(), from.Month(), *s.DayOfMonth)
+		if d.Before(from) {
+			next := from.Time().AddDate(0, 1, 1-from.Day())
+			d = dayInMonth(next.Year(), next.Month(), *s.DayOfMonth)
+		}
+		return d
+	case FrequencyYearly:
+		m := time.Month(*s.MonthOfYear)
+		d := dayInMonth(from.Year(), m, *s.DayOfMonth)
+		if d.Before(from) {
+			d = dayInMonth(from.Year()+1, m, *s.DayOfMonth)
+		}
+		return d
+	}
+	return from
+}
+
+// Advance mencatat jalan pada tanggal run dan menghitung tanggal berikutnya (sesudah run).
+func (s *CountSchedule) Advance(run clock.BusinessDate) {
+	r := run
+	s.LastRunDate = &r
+	s.NextRunDate = s.Occurrence(run.AddDays(1))
+}
+
+// dayInMonth memotong tanggal ke hari terakhir bulan (mis. 31 → 30 November, 28/29 Februari).
+func dayInMonth(year int, month time.Month, day int) clock.BusinessDate {
+	last := time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	if day > last {
+		day = last
+	}
+	return clock.NewBusinessDate(year, month, day)
+}
diff --git a/backend/internal/warehouse/domain/stockcount.go b/backend/internal/warehouse/domain/stockcount.go
new file mode 100644
index 0000000..1de68cb
--- /dev/null
+++ b/backend/internal/warehouse/domain/stockcount.go
@@ -0,0 +1,407 @@
+package domain
+
+import (
+	"strconv"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// CountType adalah jenis Stock Count.
+type CountType string
+
+const (
+	CountFull        CountType = "full"
+	CountCycle       CountType = "cycle"
+	CountConsignment CountType = "consignment"
+	CountVending     CountType = "vending"
+)
+
+// Valid memeriksa jenis stock count.
+func (t CountType) Valid() bool {
+	switch t {
+	case CountFull, CountCycle, CountConsignment, CountVending:
+		return true
+	}
+	return false
+}
+
+// Adjusts: stock count gudang membentuk penyesuaian stok (A-14); konsinyasi/vending hanya dipakai rekonsiliasi.
+func (t CountType) Adjusts() bool { return t == CountFull || t == CountCycle }
+
+// LocationTypes adalah jenis lokasi yang boleh dihitung dengan jenis stock count ini.
+func (t CountType) LocationTypes() []LocationType {
+	switch t {
+	case CountConsignment:
+		return []LocationType{LocationConsignment}
+	case CountVending:
+		return []LocationType{LocationVendingBuffer, LocationVendingMachine}
+	}
+	return []LocationType{
+		LocationInbound, LocationFinishedGoods, LocationEcommerce, LocationPettyStock, LocationRawMaterial,
+		LocationGoodsMaterial, LocationReturns, LocationEvent, LocationTollManufacturer,
+	}
+}
+
+// stockCountTransitions: Desain Status Dokumen 3.3. approved → posted dijalankan langsung oleh handler approval
+// di transaksi keputusan, sehingga status akhir dokumen yang disetujui adalah posted.
+var stockCountTransitions = transitionTable{
+	{StatusDraft, ActionStart, StatusInProgress},
+	{StatusInProgress, ActionCount, StatusInProgress},
+	{StatusInProgress, ActionSubmit, StatusPendingApproval},
+	{StatusPendingApproval, ActionApprove, StatusPosted},
+	{StatusPendingApproval, ActionReject, StatusRejected},
+	{StatusRejected, ActionRecount, StatusInProgress},
+	{StatusDraft, ActionCancel, StatusCancelled},
+	{StatusInProgress, ActionCancel, StatusCancelled},
+}
+
+// StockCount adalah dokumen Stock Count (SC) satu lokasi.
+type StockCount struct {
+	ID              uuid.UUID
+	Number          string
+	CountType       CountType
+	LocationID      uuid.UUID
+	ScheduleID      *uuid.UUID
+	BusinessDate    clock.BusinessDate
+	Status          Status
+	AssignedTo      *uuid.UUID
+	AssignedToName  string
+	Note            string
+	PhotoFileIDs    []uuid.UUID
+	SnapshotAt      *time.Time
+	StartedBy       *uuid.UUID
+	StartedByName   string
+	SubmittedBy     *uuid.UUID
+	SubmittedByName string
+	SubmittedAt     *time.Time
+	VarianceAmount  decimal.Decimal
+	NetVariance     decimal.Decimal
+	DecidedAt       *time.Time
+	DecisionNote    string
+	PostedAt        *time.Time
+	JournalEntryID  *uuid.UUID
+	CreatedAt       time.Time
+	CreatedBy       uuid.UUID
+	UpdatedAt       time.Time
+	Version         int
+	Lines           []CountLine
+}
+
+// CountLine adalah satu baris hitung per produk × batch.
+type CountLine struct {
+	ID             uuid.UUID
+	LineNo         int
+	ProductID      uuid.UUID
+	BatchID        *uuid.UUID
+	SystemQty      decimal.Decimal
+	UnitCost       decimal.Decimal
+	CountedQty     *decimal.Decimal
+	VarianceQty    decimal.Decimal
+	VarianceAmount decimal.Decimal
+	IsExtra        bool
+	PhotoFileID    *uuid.UUID
+	Note           string
+	CountedBy      *uuid.UUID
+	CountedAt      *time.Time
+}
+
+// StockCountInput adalah isian stock count baru.
+type StockCountInput struct {
+	CountType      CountType
+	LocationID     uuid.UUID
+	BusinessDate   clock.BusinessDate
+	ScheduleID     *uuid.UUID
+	AssignedTo     *uuid.UUID
+	AssignedToName string
+	Note           string
+}
+
+// NewStockCount memvalidasi stock count draft. Kecocokan jenis lokasi diperiksa service (CountType.LocationTypes).
+func NewStockCount(in StockCountInput) (StockCount, error) {
+	fields := map[string]string{}
+	if !in.CountType.Valid() {
+		fields["countType"] = "Jenis stock count tidak dikenal"
+	}
+	if in.LocationID == uuid.Nil {
+		fields["locationIds"] = "Lokasi wajib dipilih"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	note := checkNote(in.Note, "note", fields)
+	if len(fields) > 0 {
+		return StockCount{}, apperr.Validation(fields)
+	}
+	return StockCount{
+		CountType: in.CountType, LocationID: in.LocationID, BusinessDate: in.BusinessDate, ScheduleID: in.ScheduleID,
+		AssignedTo: in.AssignedTo, AssignedToName: in.AssignedToName, Note: note, Status: StatusDraft,
+		VarianceAmount: decimal.Zero, NetVariance: decimal.Zero,
+	}, nil
+}
+
+// Transition menjalankan aksi status.
+func (c *StockCount) Transition(action string) error {
+	to, err := stockCountTransitions.next("stock_count", c.Status, action)
+	if err != nil {
+		return err
+	}
+	c.Status = to
+	return nil
+}
+
+// Can memeriksa apakah aksi status diizinkan.
+func (c StockCount) Can(action string) bool { return stockCountTransitions.allows(c.Status, action) }
+
+// RevealsSystemQty: hitung buta — qty sistem dan selisih hanya terlihat setelah hasil dikirim.
+func (c StockCount) RevealsSystemQty() bool {
+	switch c.Status {
+	case StatusPendingApproval, StatusPosted, StatusCompleted:
+		return true
+	}
+	return false
+}
+
+// SnapshotRow adalah saldo sistem satu produk × batch di lokasi saat mulai.
+type SnapshotRow struct {
+	ProductID uuid.UUID
+	BatchID   *uuid.UUID
+	Qty       decimal.Decimal
+	UnitCost  decimal.Decimal
+}
+
+// Start mencatat snapshot saldo sistem dan mengubah status menjadi in_progress.
+func (c *StockCount) Start(rows []SnapshotRow, by uuid.UUID, byName string, at time.Time) error {
+	if err := c.Transition(ActionStart); err != nil {
+		return err
+	}
+	c.Lines = c.Lines[:0]
+	for i, r := range rows {
+		c.Lines = append(c.Lines, CountLine{
+			LineNo: i + 1, ProductID: r.ProductID, BatchID: r.BatchID, SystemQty: r.Qty, UnitCost: r.UnitCost,
+			VarianceQty: decimal.Zero, VarianceAmount: decimal.Zero,
+		})
+	}
+	c.SnapshotAt, c.StartedBy, c.StartedByName = &at, &by, byName
+	return nil
+}
+
+// CountEntry adalah isian hitung satu baris yang sudah ada.
+type CountEntry struct {
+	LineID      uuid.UUID
+	CountedQty  *decimal.Decimal
+	Note        *string
+	PhotoFileID *uuid.UUID
+}
+
+// ExtraEntry adalah barang yang ditemukan tetapi tidak ada di snapshot.
+type ExtraEntry struct {
+	ProductID  uuid.UUID
+	BatchID    *uuid.UUID
+	CountedQty decimal.Decimal
+	UnitCost   decimal.Decimal
+	Note       string
+}
+
+// MaxCountPhotos membatasi foto per stock count.
+const MaxCountPhotos = 10
+
+// RecordCounts mencatat isian hitung (autosave form HP). Baris ekstra untuk produk × batch yang sudah ada
+// digabung ke baris itu. Mengembalikan indeks baris yang berubah.
+func (c *StockCount) RecordCounts(entries []CountEntry, extras []ExtraEntry, by uuid.UUID, at time.Time) ([]int, error) {
+	if !c.Can(ActionCount) {
+		return nil, apperr.InvalidStateTransition("stock_count", string(c.Status), ActionCount)
+	}
+	fields := map[string]string{}
+	changed := map[int]bool{}
+	for i, e := range entries {
+		idx := c.lineIndex(e.LineID)
+		if idx < 0 {
+			fields[lineField(i, "lineId")] = "Baris tidak ditemukan"
+			continue
+		}
+		l := &c.Lines[idx]
+		if e.CountedQty != nil {
+			if !validQtyOrZero(*e.CountedQty) {
+				fields[lineField(i, "countedQty")] = "Qty hitung tidak valid"
+				continue
+			}
+			q := *e.CountedQty
+			l.CountedQty = &q
+		}
+		if e.Note != nil {
+			l.Note = checkNote(*e.Note, lineField(i, "note"), fields)
+		}
+		if e.PhotoFileID != nil {
+			id := *e.PhotoFileID
+			l.PhotoFileID = &id
+			if id == uuid.Nil {
+				l.PhotoFileID = nil
+			}
+		}
+		l.CountedBy, l.CountedAt = &by, &at
+		changed[idx] = true
+	}
+	for i, x := range extras {
+		f := func(name string) string { return "extraLines[" + strconv.Itoa(i) + "]." + name }
+		if x.ProductID == uuid.Nil {
+			fields[f("productId")] = "Produk wajib diisi"
+			continue
+		}
+		if !validQtyOrZero(x.CountedQty) {
+			fields[f("countedQty")] = "Qty hitung tidak valid"
+			continue
+		}
+		q := x.CountedQty
+		note := checkNote(x.Note, f("note"), fields)
+		if idx := c.lineFor(x.ProductID, x.BatchID); idx >= 0 {
+			c.Lines[idx].CountedQty, c.Lines[idx].CountedBy, c.Lines[idx].CountedAt = &q, &by, &at
+			changed[idx] = true
+			continue
+		}
+		if len(c.Lines) >= MaxDocumentLines*5 {
+			fields[f("productId")] = "Terlalu banyak baris"
+			continue
+		}
+		c.Lines = append(c.Lines, CountLine{
+			LineNo: len(c.Lines) + 1, ProductID: x.ProductID, BatchID: x.BatchID, SystemQty: decimal.Zero,
+			UnitCost: x.UnitCost, CountedQty: &q, IsExtra: true, Note: note, CountedBy: &by, CountedAt: &at,
+			VarianceQty: decimal.Zero, VarianceAmount: decimal.Zero,
+		})
+		changed[len(c.Lines)-1] = true
+	}
+	if len(fields) > 0 {
+		return nil, apperr.Validation(fields)
+	}
+	out := make([]int, 0, len(changed))
+	for i := range c.Lines {
+		if changed[i] {
+			out = append(out, i)
+		}
+	}
+	return out, nil
+}
+
+// SetPhotos mengganti foto stock count (mis. foto rak).
+func (c *StockCount) SetPhotos(ids []uuid.UUID) error {
+	if !c.Can(ActionCount) {
+		return apperr.InvalidStateTransition("stock_count", string(c.Status), ActionCount)
+	}
+	if len(ids) > MaxCountPhotos {
+		return apperr.Validation(map[string]string{"photoFileIds": "Maksimal 10 foto"})
+	}
+	c.PhotoFileIDs = ids
+	return nil
+}
+
+func (c StockCount) lineIndex(id uuid.UUID) int {
+	for i, l := range c.Lines {
+		if l.ID == id && id != uuid.Nil {
+			return i
+		}
+	}
+	return -1
+}
+
+func (c StockCount) lineFor(productID uuid.UUID, batchID *uuid.UUID) int {
+	for i, l := range c.Lines {
+		if l.ProductID == productID && sameBatch(l.BatchID, batchID) {
+			return i
+		}
+	}
+	return -1
+}
+
+func sameBatch(a, b *uuid.UUID) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+// Submit memeriksa semua baris sudah dihitung, menghitung selisih (qty dan nilai HPP snapshot), lalu
+// menentukan status: ada selisih pada stock count gudang → pending_approval; selain itu completed. Stock count
+// lokasi mitra/mesin wajib foto.
+func (c *StockCount) Submit(by uuid.UUID, byName string, at time.Time) error {
+	if !c.Can(ActionSubmit) {
+		return apperr.InvalidStateTransition("stock_count", string(c.Status), ActionSubmit)
+	}
+	fields := map[string]string{}
+	for i, l := range c.Lines {
+		if l.CountedQty == nil {
+			fields[lineField(i, "countedQty")] = "Qty hitung belum diisi"
+		}
+	}
+	if len(c.Lines) == 0 {
+		fields["lines"] = "Belum ada baris yang dihitung"
+	}
+	if !c.CountType.Adjusts() && len(c.PhotoFileIDs) == 0 {
+		fields["photoFileIds"] = "Foto lokasi wajib dilampirkan untuk stock count mitra/mesin"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	abs, net := decimal.Zero, decimal.Zero
+	hasVariance := false
+	for i := range c.Lines {
+		l := &c.Lines[i]
+		l.VarianceQty = l.CountedQty.Sub(l.SystemQty)
+		l.VarianceAmount = l.VarianceQty.Mul(l.UnitCost).Round(2)
+		if !l.VarianceQty.IsZero() {
+			hasVariance = true
+		}
+		abs = abs.Add(l.VarianceAmount.Abs())
+		net = net.Add(l.VarianceAmount)
+	}
+	c.VarianceAmount, c.NetVariance = abs, net
+	c.SubmittedBy, c.SubmittedByName, c.SubmittedAt = &by, byName, &at
+	if hasVariance && c.CountType.Adjusts() {
+		c.Status = StatusPendingApproval
+		return nil
+	}
+	c.Status = StatusCompleted
+	return nil
+}
+
+// HasVariance memeriksa apakah ada baris dengan selisih qty.
+func (c StockCount) HasVariance() bool {
+	for _, l := range c.Lines {
+		if !l.VarianceQty.IsZero() {
+			return true
+		}
+	}
+	return false
+}
+
+// Decide mencatat keputusan approval.
+func (c *StockCount) Decide(approved bool, note string, at time.Time) error {
+	action := ActionReject
+	if approved {
+		action = ActionApprove
+	}
+	if err := c.Transition(action); err != nil {
+		return err
+	}
+	c.DecidedAt, c.DecisionNote = &at, note
+	if approved {
+		c.PostedAt = &at
+	}
+	return nil
+}
+
+// Recount membuka kembali stock count yang ditolak untuk dihitung ulang (snapshot tetap).
+func (c *StockCount) Recount() error {
+	if err := c.Transition(ActionRecount); err != nil {
+		return err
+	}
+	c.SubmittedBy, c.SubmittedByName, c.SubmittedAt = nil, "", nil
+	c.VarianceAmount, c.NetVariance = decimal.Zero, decimal.Zero
+	for i := range c.Lines {
+		c.Lines[i].VarianceQty, c.Lines[i].VarianceAmount = decimal.Zero, decimal.Zero
+	}
+	return nil
+}
diff --git a/backend/internal/warehouse/domain/transfer.go b/backend/internal/warehouse/domain/transfer.go
new file mode 100644
index 0000000..c5a6813
--- /dev/null
+++ b/backend/internal/warehouse/domain/transfer.go
@@ -0,0 +1,368 @@
+package domain
+
+import (
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// TransferType adalah jenis Transfer Stok.
+type TransferType string
+
+const (
+	// TransferDirect adalah transfer oleh Logistik antar lokasi/gudang/eksternal.
+	TransferDirect TransferType = "direct"
+	// TransferRequest adalah Permintaan Petty Stock oleh Fulfillment Leader (FG Non-Ecommerce → Petty Stock).
+	TransferRequest TransferType = "request"
+)
+
+// Valid memeriksa jenis transfer.
+func (t TransferType) Valid() bool { return t == TransferDirect || t == TransferRequest }
+
+// directTransitions: Desain Status Dokumen 3.2 (transfer langsung).
+var directTransitions = transitionTable{
+	{StatusDraft, ActionEdit, StatusDraft},
+	{StatusDraft, ActionPost, StatusCompleted},
+	{StatusDraft, ActionShip, StatusInTransit},
+	{StatusInTransit, ActionReceive, StatusReceived},
+	{StatusPartiallyReceived, ActionReceive, StatusReceived},
+	{StatusPartiallyReceived, ActionComplete, StatusCompleted},
+	{StatusReceived, ActionComplete, StatusCompleted},
+	{StatusDraft, ActionCancel, StatusCancelled},
+}
+
+// requestTransitions: Permintaan Petty Stock (Desain Status Dokumen 3.2).
+var requestTransitions = transitionTable{
+	{StatusDraft, ActionEdit, StatusDraft},
+	{StatusDraft, ActionSubmit, StatusSubmitted},
+	{StatusSubmitted, ActionRelease, StatusInProgress},
+	{StatusInProgress, ActionPrepare, StatusInProgress},
+	{StatusInProgress, ActionReceive, StatusCompleted},
+	{StatusDraft, ActionCancel, StatusCancelled},
+	{StatusSubmitted, ActionCancel, StatusCancelled},
+}
+
+// StockTransfer adalah dokumen Transfer Stok (TRF) atau Permintaan Petty Stock.
+type StockTransfer struct {
+	ID               uuid.UUID
+	Number           string
+	Type             TransferType
+	FromLocationID   uuid.UUID
+	ToLocationID     uuid.UUID
+	RequiresShipping bool
+	BusinessDate     clock.BusinessDate
+	Status           Status
+	SourceType       string
+	SourceID         *uuid.UUID
+	Note             string
+	RequestedBy      uuid.UUID
+	RequestedByName  string
+	SubmittedAt      *time.Time
+	ReleasedBy       *uuid.UUID
+	ReleasedByName   string
+	ReleasedAt       *time.Time
+	PreparedBy       *uuid.UUID
+	PreparedByName   string
+	PreparedAt       *time.Time
+	ShippedBy        *uuid.UUID
+	ShippedByName    string
+	ShippedAt        *time.Time
+	ReceivedBy       *uuid.UUID
+	ReceivedByName   string
+	ReceivedAt       *time.Time
+	CompletedAt      *time.Time
+	CancelledAt      *time.Time
+	CancelReason     string
+	CreatedAt        time.Time
+	CreatedBy        uuid.UUID
+	UpdatedAt        time.Time
+	Version          int
+	Lines            []TransferLine
+}
+
+// TransferLine adalah satu baris transfer. Setelah dikirim, satu baris = satu batch.
+type TransferLine struct {
+	ID          uuid.UUID
+	LineNo      int
+	ProductID   uuid.UUID
+	BatchID     *uuid.UUID
+	Qty         decimal.Decimal
+	ReceivedQty decimal.Decimal
+	ShortageQty decimal.Decimal
+	// CostAmount adalah nilai FIFO barang yang dipindah (untuk jurnal A-07/A-24 oleh modul pemanggil).
+	CostAmount  decimal.Decimal
+	BatchReason string
+	Note        string
+}
+
+// Outstanding adalah qty yang belum diterima dan belum dicatat sebagai kekurangan.
+func (l TransferLine) Outstanding() decimal.Decimal {
+	return l.Qty.Sub(l.ReceivedQty).Sub(l.ShortageQty)
+}
+
+// TransferLineInput adalah isian baris.
+type TransferLineInput struct {
+	ProductID uuid.UUID
+	// BatchID nil = dialokasikan FEFO saat posting/kirim/release.
+	BatchID     *uuid.UUID
+	Qty         decimal.Decimal
+	BatchReason string
+	Note        string
+}
+
+// TransferInput adalah isian transfer.
+type TransferInput struct {
+	Type           TransferType
+	FromLocationID uuid.UUID
+	ToLocationID   uuid.UUID
+	BusinessDate   clock.BusinessDate
+	Note           string
+	SourceType     string
+	SourceID       *uuid.UUID
+	Lines          []TransferLineInput
+}
+
+func (in TransferInput) validate() (StockTransfer, error) {
+	fields := map[string]string{}
+	if !in.Type.Valid() {
+		fields["transferType"] = "Jenis transfer tidak dikenal"
+	}
+	if in.FromLocationID == uuid.Nil {
+		fields["fromLocationId"] = "Lokasi asal wajib diisi"
+	}
+	if in.ToLocationID == uuid.Nil {
+		fields["toLocationId"] = "Lokasi tujuan wajib diisi"
+	}
+	if in.FromLocationID != uuid.Nil && in.FromLocationID == in.ToLocationID {
+		fields["toLocationId"] = "Lokasi tujuan harus berbeda dari lokasi asal"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	if in.SourceType != "" && (!ValidSourceType(in.SourceType) || in.SourceID == nil || *in.SourceID == uuid.Nil) {
+		fields["source"] = "Dokumen sumber tidak valid"
+	}
+	note := checkNote(in.Note, "note", fields)
+	switch {
+	case len(in.Lines) == 0:
+		fields["lines"] = "Minimal satu baris"
+	case len(in.Lines) > MaxDocumentLines:
+		fields["lines"] = "Terlalu banyak baris"
+	}
+	t := StockTransfer{
+		Type: in.Type, FromLocationID: in.FromLocationID, ToLocationID: in.ToLocationID, BusinessDate: in.BusinessDate,
+		Note: note, SourceType: in.SourceType, SourceID: in.SourceID,
+	}
+	for i, l := range in.Lines {
+		if l.ProductID == uuid.Nil {
+			fields[lineField(i, "productId")] = "Produk wajib diisi"
+		}
+		if !validQty(l.Qty) {
+			fields[lineField(i, "qty")] = "Qty harus lebih dari 0 (maks. 3 desimal)"
+		}
+		reason := checkNote(l.BatchReason, lineField(i, "batchReason"), fields)
+		lnote := checkNote(l.Note, lineField(i, "note"), fields)
+		t.Lines = append(t.Lines, TransferLine{
+			LineNo: i + 1, ProductID: l.ProductID, BatchID: l.BatchID, Qty: l.Qty, BatchReason: reason, Note: lnote,
+			ReceivedQty: decimal.Zero, ShortageQty: decimal.Zero, CostAmount: decimal.Zero,
+		})
+	}
+	if len(fields) > 0 {
+		return StockTransfer{}, apperr.Validation(fields)
+	}
+	return t, nil
+}
+
+// NewTransfer memvalidasi transfer baru berstatus draft. Jenis lokasi (Petty Stock, aktif) diperiksa service.
+func NewTransfer(in TransferInput, by uuid.UUID, byName string) (StockTransfer, error) {
+	t, err := in.validate()
+	if err != nil {
+		return StockTransfer{}, err
+	}
+	t.Status, t.RequestedBy, t.RequestedByName = StatusDraft, by, byName
+	return t, nil
+}
+
+// UpdateDraft mengganti isian transfer draft. Jenis dan dokumen sumber tidak berubah.
+func (t *StockTransfer) UpdateDraft(in TransferInput) error {
+	if _, err := t.next(ActionEdit); err != nil {
+		return err
+	}
+	in.Type, in.SourceType, in.SourceID = t.Type, t.SourceType, t.SourceID
+	n, err := in.validate()
+	if err != nil {
+		return err
+	}
+	t.FromLocationID, t.ToLocationID, t.BusinessDate, t.Note, t.Lines = n.FromLocationID, n.ToLocationID, n.BusinessDate, n.Note, n.Lines
+	return nil
+}
+
+func (t StockTransfer) table() transitionTable {
+	if t.Type == TransferRequest {
+		return requestTransitions
+	}
+	return directTransitions
+}
+
+func (t StockTransfer) next(action string) (Status, error) {
+	return t.table().next("stock_transfer", t.Status, action)
+}
+
+// Transition menjalankan aksi status (tanpa efek stok). Aksi post/ship disesuaikan dengan RequiresShipping.
+func (t *StockTransfer) Transition(action string) error {
+	if t.Type == TransferDirect {
+		if action == ActionPost && t.RequiresShipping {
+			return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+				"Transfer antar gudang atau ke lokasi eksternal harus dikirim (Dalam Pengiriman), bukan langsung diposting")
+		}
+		if action == ActionShip && !t.RequiresShipping {
+			return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+				"Transfer dalam satu gudang langsung diposting tanpa status Dalam Pengiriman")
+		}
+	}
+	if t.Type == TransferRequest && action == ActionReceive && t.PreparedAt == nil {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Barang belum disiapkan Staf Gudang")
+	}
+	to, err := t.next(action)
+	if err != nil {
+		return err
+	}
+	t.Status = to
+	return nil
+}
+
+// Can memeriksa apakah aksi status diizinkan (tanpa cek permission).
+func (t StockTransfer) Can(action string) bool {
+	probe := t
+	probe.Lines = nil
+	return probe.Transition(action) == nil
+}
+
+// ReceiveLine adalah qty yang diterima untuk satu baris.
+type ReceiveLine struct {
+	LineID uuid.UUID
+	Qty    decimal.Decimal
+}
+
+// ApplyReceive mencatat qty diterima (transfer langsung yang Dalam Pengiriman). Qty tidak boleh melebihi
+// sisa; baris yang tidak disebut dianggap 0. Status menjadi received bila semua baris lengkap, selain itu
+// partially_received. Mengembalikan qty per baris yang dipindah ke Tersedia.
+func (t *StockTransfer) ApplyReceive(lines []ReceiveLine) (map[uuid.UUID]decimal.Decimal, error) {
+	if t.Type != TransferDirect || (t.Status != StatusInTransit && t.Status != StatusPartiallyReceived) {
+		return nil, apperr.InvalidStateTransition("stock_transfer", string(t.Status), ActionReceive)
+	}
+	fields := map[string]string{}
+	got := map[uuid.UUID]decimal.Decimal{}
+	for i, r := range lines {
+		idx := t.lineIndex(r.LineID)
+		switch {
+		case idx < 0:
+			fields[lineField(i, "lineId")] = "Baris tidak ditemukan"
+		case !validQtyOrZero(r.Qty):
+			fields[lineField(i, "qty")] = "Qty tidak valid"
+		case r.Qty.Add(got[r.LineID]).GreaterThan(t.Lines[idx].Outstanding()):
+			fields[lineField(i, "qty")] = "Qty diterima melebihi sisa kiriman (" + t.Lines[idx].Outstanding().String() + ")"
+		default:
+			got[r.LineID] = got[r.LineID].Add(r.Qty)
+		}
+	}
+	total := decimal.Zero
+	for _, q := range got {
+		total = total.Add(q)
+	}
+	if len(fields) == 0 && !total.IsPositive() {
+		fields["lines"] = "Isi qty diterima minimal satu baris"
+	}
+	if len(fields) > 0 {
+		return nil, apperr.Validation(fields)
+	}
+	complete := true
+	for i := range t.Lines {
+		t.Lines[i].ReceivedQty = t.Lines[i].ReceivedQty.Add(got[t.Lines[i].ID])
+		if t.Lines[i].Outstanding().IsPositive() {
+			complete = false
+		}
+	}
+	t.Status = StatusReceived
+	if !complete {
+		t.Status = StatusPartiallyReceived
+	}
+	return got, nil
+}
+
+// CloseShortage menyelesaikan transfer yang diterima sebagian: sisa yang tidak datang dicatat sebagai
+// kekurangan per baris (diproses lewat Stock Count lokasi tujuan). Mengembalikan kekurangan per baris.
+func (t *StockTransfer) CloseShortage() (map[uuid.UUID]decimal.Decimal, error) {
+	if err := t.Transition(ActionComplete); err != nil {
+		return nil, err
+	}
+	out := map[uuid.UUID]decimal.Decimal{}
+	for i := range t.Lines {
+		if o := t.Lines[i].Outstanding(); o.IsPositive() {
+			t.Lines[i].ShortageQty = t.Lines[i].ShortageQty.Add(o)
+			out[t.Lines[i].ID] = o
+		}
+	}
+	return out, nil
+}
+
+// ConfirmRequest mencatat qty yang diterima Fulfillment Leader untuk Permintaan Petty Stock. Qty tidak boleh
+// melebihi qty permintaan; selisih tetap di lokasi asal (reservasinya dilepas).
+func (t *StockTransfer) ConfirmRequest(lines []ReceiveLine) (map[uuid.UUID]decimal.Decimal, error) {
+	if t.Type != TransferRequest {
+		return nil, apperr.InvalidStateTransition("stock_transfer", string(t.Status), ActionReceive)
+	}
+	if err := t.Transition(ActionReceive); err != nil {
+		return nil, err
+	}
+	fields := map[string]string{}
+	got := map[uuid.UUID]decimal.Decimal{}
+	for i, r := range lines {
+		idx := t.lineIndex(r.LineID)
+		switch {
+		case idx < 0:
+			fields[lineField(i, "lineId")] = "Baris tidak ditemukan"
+		case !validQtyOrZero(r.Qty):
+			fields[lineField(i, "qty")] = "Qty tidak valid"
+		case r.Qty.Add(got[r.LineID]).GreaterThan(t.Lines[idx].Qty):
+			fields[lineField(i, "qty")] = "Qty diterima melebihi qty permintaan (" + t.Lines[idx].Qty.String() + ")"
+		default:
+			got[r.LineID] = got[r.LineID].Add(r.Qty)
+		}
+	}
+	if len(fields) > 0 {
+		return nil, apperr.Validation(fields)
+	}
+	for i := range t.Lines {
+		t.Lines[i].ReceivedQty = got[t.Lines[i].ID]
+		t.Lines[i].ShortageQty = t.Lines[i].Qty.Sub(t.Lines[i].ReceivedQty)
+	}
+	return got, nil
+}
+
+func (t StockTransfer) lineIndex(id uuid.UUID) int {
+	for i, l := range t.Lines {
+		if l.ID == id {
+			return i
+		}
+	}
+	return -1
+}
+
+// Cancel membatalkan transfer draft atau permintaan yang belum di-release.
+func (t *StockTransfer) Cancel(reason string, at time.Time) error {
+	fields := map[string]string{}
+	reason = checkNote(reason, "reason", fields)
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	if err := t.Transition(ActionCancel); err != nil {
+		return err
+	}
+	t.CancelReason, t.CancelledAt = reason, &at
+	return nil
+}
diff --git a/backend/internal/warehouse/postgres/queries/inbounds.sql b/backend/internal/warehouse/postgres/queries/inbounds.sql
new file mode 100644
index 0000000..d706e29
--- /dev/null
+++ b/backend/internal/warehouse/postgres/queries/inbounds.sql
@@ -0,0 +1,75 @@
+-- name: InsertInbound :one
+INSERT INTO inbounds (number, source_type, source_id, source_label, warehouse_id, location_id, business_date,
+                      reject_action, status, note, created_by, updated_by)
+VALUES (sqlc.arg('number'), sqlc.arg('source_type'), sqlc.arg('source_id'), sqlc.arg('source_label'),
+        sqlc.arg('warehouse_id'), sqlc.arg('location_id'), sqlc.arg('business_date'), sqlc.arg('reject_action'),
+        sqlc.arg('status'), sqlc.arg('note'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING *;
+
+-- name: InsertInboundLine :one
+INSERT INTO inbound_lines (inbound_id, line_no, source_line_id, product_id, batch_id, qty, destination_location_id)
+VALUES (sqlc.arg('inbound_id'), sqlc.arg('line_no'), sqlc.narg('source_line_id'), sqlc.arg('product_id'),
+        sqlc.narg('batch_id'), sqlc.arg('qty'), sqlc.arg('destination_location_id'))
+RETURNING id;
+
+-- name: GetInbound :one
+SELECT * FROM inbounds WHERE id = $1;
+
+-- name: GetInboundForUpdate :one
+SELECT * FROM inbounds WHERE id = $1 FOR UPDATE;
+
+-- name: GetInboundBySource :one
+SELECT * FROM inbounds WHERE source_type = sqlc.arg('source_type') AND source_id = sqlc.arg('source_id');
+
+-- name: ListInboundLines :many
+SELECT * FROM inbound_lines WHERE inbound_id = $1 ORDER BY line_no;
+
+-- name: UpdateInbound :one
+UPDATE inbounds
+SET status = sqlc.arg('status'), completed_at = sqlc.narg('completed_at'), updated_at = now(),
+    updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+RETURNING *;
+
+-- name: UpdateInboundLineQC :exec
+UPDATE inbound_lines
+SET passed_qty = sqlc.arg('passed_qty'), rejected_qty = sqlc.arg('rejected_qty'),
+    destination_location_id = sqlc.arg('destination_location_id'), status = sqlc.arg('status'),
+    reject_reason = sqlc.arg('reject_reason'), reject_location_id = sqlc.narg('reject_location_id'),
+    checked_by = sqlc.arg('checked_by'), checked_by_name = sqlc.arg('checked_by_name'), checked_at = sqlc.arg('checked_at')
+WHERE id = sqlc.arg('id');
+
+-- name: InsertQualityCheck :exec
+INSERT INTO quality_checks (document_type, document_id, document_line_id, result, qty, checks, note, photo_file_ids,
+                            checked_by, checked_by_name, checked_at)
+VALUES (sqlc.arg('document_type'), sqlc.arg('document_id'), sqlc.arg('document_line_id'), sqlc.arg('result'),
+        sqlc.arg('qty'), sqlc.arg('checks'), sqlc.arg('note'), sqlc.arg('photo_file_ids')::uuid[],
+        sqlc.arg('checked_by'), sqlc.arg('checked_by_name'), sqlc.arg('checked_at'));
+
+-- name: ListQualityChecks :many
+SELECT * FROM quality_checks
+WHERE document_type = sqlc.arg('document_type') AND document_id = sqlc.arg('document_id')
+ORDER BY checked_at, id;
+
+-- name: ListInbounds :many
+SELECT i.*,
+       (SELECT count(*) FROM inbound_lines l WHERE l.inbound_id = i.id)::bigint AS line_count,
+       (SELECT count(*) FROM inbound_lines l WHERE l.inbound_id = i.id AND l.status = 'quarantine')::bigint AS pending_count
+FROM inbounds i
+WHERE (sqlc.narg('status')::text IS NULL OR i.status = sqlc.narg('status')::text)
+  AND (sqlc.narg('source_type')::text IS NULL OR i.source_type = sqlc.narg('source_type')::text)
+  AND (sqlc.narg('warehouse_id')::uuid IS NULL OR i.warehouse_id = sqlc.narg('warehouse_id')::uuid)
+  AND (sqlc.narg('search')::text IS NULL
+       OR i.number ILIKE '%' || sqlc.narg('search')::text || '%'
+       OR i.source_label ILIKE '%' || sqlc.narg('search')::text || '%')
+ORDER BY i.created_at DESC, i.id DESC
+LIMIT sqlc.arg('row_limit') OFFSET sqlc.arg('row_offset');
+
+-- name: CountInbounds :one
+SELECT count(*) FROM inbounds i
+WHERE (sqlc.narg('status')::text IS NULL OR i.status = sqlc.narg('status')::text)
+  AND (sqlc.narg('source_type')::text IS NULL OR i.source_type = sqlc.narg('source_type')::text)
+  AND (sqlc.narg('warehouse_id')::uuid IS NULL OR i.warehouse_id = sqlc.narg('warehouse_id')::uuid)
+  AND (sqlc.narg('search')::text IS NULL
+       OR i.number ILIKE '%' || sqlc.narg('search')::text || '%'
+       OR i.source_label ILIKE '%' || sqlc.narg('search')::text || '%');
diff --git a/backend/internal/warehouse/postgres/queries/stock_counts.sql b/backend/internal/warehouse/postgres/queries/stock_counts.sql
new file mode 100644
index 0000000..c793992
--- /dev/null
+++ b/backend/internal/warehouse/postgres/queries/stock_counts.sql
@@ -0,0 +1,103 @@
+-- name: InsertStockCount :one
+INSERT INTO stock_counts (count_type, location_id, schedule_id, business_date, status, assigned_to,
+                          assigned_to_name, note, created_by, updated_by)
+VALUES (sqlc.arg('count_type'), sqlc.arg('location_id'), sqlc.narg('schedule_id'),
+        sqlc.arg('business_date'), sqlc.arg('status'), sqlc.narg('assigned_to'), sqlc.arg('assigned_to_name'),
+        sqlc.arg('note'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+ON CONFLICT (schedule_id, location_id, business_date) WHERE schedule_id IS NOT NULL DO NOTHING
+RETURNING *;
+
+-- name: GetStockCount :one
+SELECT * FROM stock_counts WHERE id = $1;
+
+-- name: GetStockCountForUpdate :one
+SELECT * FROM stock_counts WHERE id = $1 FOR UPDATE;
+
+-- name: UpdateStockCount :one
+UPDATE stock_counts
+SET number = sqlc.narg('number'), status = sqlc.arg('status'), note = sqlc.arg('note'), photo_file_ids = sqlc.arg('photo_file_ids')::uuid[],
+    snapshot_at = sqlc.narg('snapshot_at'), started_by = sqlc.narg('started_by'), started_by_name = sqlc.arg('started_by_name'),
+    submitted_by = sqlc.narg('submitted_by'), submitted_by_name = sqlc.arg('submitted_by_name'),
+    submitted_at = sqlc.narg('submitted_at'), variance_amount = sqlc.arg('variance_amount'),
+    net_variance = sqlc.arg('net_variance'), decided_at = sqlc.narg('decided_at'), decision_note = sqlc.arg('decision_note'),
+    posted_at = sqlc.narg('posted_at'), journal_entry_id = sqlc.narg('journal_entry_id'),
+    updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+RETURNING *;
+
+-- name: InsertStockCountLine :one
+INSERT INTO stock_count_lines (stock_count_id, line_no, product_id, batch_id, system_qty, unit_cost, counted_qty,
+                               variance_qty, variance_amount, is_extra, photo_file_id, note, counted_by, counted_at)
+VALUES (sqlc.arg('stock_count_id'), sqlc.arg('line_no'), sqlc.arg('product_id'), sqlc.narg('batch_id'),
+        sqlc.arg('system_qty'), sqlc.arg('unit_cost'), sqlc.narg('counted_qty'), sqlc.arg('variance_qty'),
+        sqlc.arg('variance_amount'), sqlc.arg('is_extra'), sqlc.narg('photo_file_id'), sqlc.arg('note'),
+        sqlc.narg('counted_by'), sqlc.narg('counted_at'))
+RETURNING id;
+
+-- name: UpdateStockCountLine :exec
+UPDATE stock_count_lines
+SET counted_qty = sqlc.narg('counted_qty'), variance_qty = sqlc.arg('variance_qty'),
+    variance_amount = sqlc.arg('variance_amount'), photo_file_id = sqlc.narg('photo_file_id'), note = sqlc.arg('note'),
+    counted_by = sqlc.narg('counted_by'), counted_at = sqlc.narg('counted_at')
+WHERE id = sqlc.arg('id');
+
+-- name: DeleteStockCountLines :exec
+DELETE FROM stock_count_lines WHERE stock_count_id = $1;
+
+-- name: ListStockCountLines :many
+SELECT * FROM stock_count_lines WHERE stock_count_id = $1 ORDER BY line_no;
+
+-- name: ListStockCounts :many
+SELECT c.*,
+       (SELECT count(*) FROM stock_count_lines l WHERE l.stock_count_id = c.id)::bigint AS line_count,
+       (SELECT count(*) FROM stock_count_lines l WHERE l.stock_count_id = c.id AND l.counted_qty IS NOT NULL)::bigint AS counted_count
+FROM stock_counts c
+WHERE (cardinality(sqlc.arg('statuses')::text[]) = 0 OR c.status = ANY (sqlc.arg('statuses')::text[]))
+  AND (sqlc.narg('count_type')::text IS NULL OR c.count_type = sqlc.narg('count_type')::text)
+  AND (sqlc.narg('location_id')::uuid IS NULL OR c.location_id = sqlc.narg('location_id')::uuid)
+  AND (NOT sqlc.arg('scoped')::boolean OR c.location_id = ANY (sqlc.arg('allowed_location_ids')::uuid[]))
+  AND (sqlc.narg('search')::text IS NULL OR c.number ILIKE '%' || sqlc.narg('search')::text || '%')
+ORDER BY c.business_date DESC, c.created_at DESC, c.id DESC
+LIMIT sqlc.arg('row_limit') OFFSET sqlc.arg('row_offset');
+
+-- name: CountStockCounts :one
+SELECT count(*) FROM stock_counts c
+WHERE (cardinality(sqlc.arg('statuses')::text[]) = 0 OR c.status = ANY (sqlc.arg('statuses')::text[]))
+  AND (sqlc.narg('count_type')::text IS NULL OR c.count_type = sqlc.narg('count_type')::text)
+  AND (sqlc.narg('location_id')::uuid IS NULL OR c.location_id = sqlc.narg('location_id')::uuid)
+  AND (NOT sqlc.arg('scoped')::boolean OR c.location_id = ANY (sqlc.arg('allowed_location_ids')::uuid[]))
+  AND (sqlc.narg('search')::text IS NULL OR c.number ILIKE '%' || sqlc.narg('search')::text || '%');
+
+-- name: InsertCountSchedule :one
+INSERT INTO stock_count_schedules (name, count_type, frequency, day_of_week, day_of_month, month_of_year, warehouse_id,
+                                   location_ids, assignee_user_id, assignee_name, next_run_date, is_active,
+                                   created_by, updated_by)
+VALUES (sqlc.arg('name'), sqlc.arg('count_type'), sqlc.arg('frequency'), sqlc.narg('day_of_week'),
+        sqlc.narg('day_of_month'), sqlc.narg('month_of_year'), sqlc.narg('warehouse_id'),
+        sqlc.arg('location_ids')::uuid[], sqlc.narg('assignee_user_id'), sqlc.arg('assignee_name'),
+        sqlc.arg('next_run_date'), sqlc.arg('is_active'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING *;
+
+-- name: UpdateCountSchedule :one
+UPDATE stock_count_schedules
+SET name = sqlc.arg('name'), count_type = sqlc.arg('count_type'), frequency = sqlc.arg('frequency'),
+    day_of_week = sqlc.narg('day_of_week'), day_of_month = sqlc.narg('day_of_month'),
+    month_of_year = sqlc.narg('month_of_year'), warehouse_id = sqlc.narg('warehouse_id'),
+    location_ids = sqlc.arg('location_ids')::uuid[], assignee_user_id = sqlc.narg('assignee_user_id'),
+    assignee_name = sqlc.arg('assignee_name'), next_run_date = sqlc.arg('next_run_date'),
+    last_run_date = sqlc.narg('last_run_date'), is_active = sqlc.arg('is_active'),
+    updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version')
+RETURNING *;
+
+-- name: GetCountSchedule :one
+SELECT * FROM stock_count_schedules WHERE id = $1;
+
+-- name: ListCountSchedules :many
+SELECT * FROM stock_count_schedules ORDER BY is_active DESC, next_run_date, name;
+
+-- name: DueCountSchedules :many
+SELECT * FROM stock_count_schedules
+WHERE is_active AND next_run_date <= sqlc.arg('today')
+ORDER BY next_run_date, id
+FOR UPDATE SKIP LOCKED;
diff --git a/backend/internal/warehouse/postgres/queries/transfers.sql b/backend/internal/warehouse/postgres/queries/transfers.sql
new file mode 100644
index 0000000..1aec7e3
--- /dev/null
+++ b/backend/internal/warehouse/postgres/queries/transfers.sql
@@ -0,0 +1,90 @@
+-- name: InsertTransfer :one
+INSERT INTO stock_transfers (transfer_type, from_location_id, to_location_id, requires_shipping, business_date, status,
+                             source_type, source_id, note, requested_by, requested_by_name, created_by, updated_by)
+VALUES (sqlc.arg('transfer_type'), sqlc.arg('from_location_id'), sqlc.arg('to_location_id'),
+        sqlc.arg('requires_shipping'), sqlc.arg('business_date'), sqlc.arg('status'), sqlc.arg('source_type'),
+        sqlc.narg('source_id'), sqlc.arg('note'), sqlc.arg('requested_by'), sqlc.arg('requested_by_name'),
+        sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING *;
