-func sumQty(cands []domain.Candidate) decimal.Decimal {
-	total := decimal.Zero
-	for _, c := range cands {
-		if c.Qty.IsPositive() {
-			total = total.Add(c.Qty)
-		}
-	}
-	return total
-}
