+				f.src.tiers = []domain.TieredPrice{{ID: uuid.New(), MinQty: decimal.NewFromInt(1), Price: amount(1), Period: domain.Period{ValidFrom: today.AddDays(-9), ValidTo: &end}}}
+			},
+			want: want{domain.RuleBasePrice, 50000},
