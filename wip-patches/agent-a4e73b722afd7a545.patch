diff --git a/backend/internal/dataexchange/postgres/store.go b/backend/internal/dataexchange/postgres/store.go
new file mode 100644
index 0000000..bee557b
--- /dev/null
+++ b/backend/internal/dataexchange/postgres/store.go
@@ -0,0 +1,326 @@
+// Package postgres adalah repository job impor/ekspor.
+package postgres
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"balans/internal/dataexchange/domain"
+	"balans/internal/dataexchange/postgres/sqlcgen"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/db"
+	"balans/internal/platform/paging"
+)
+
+// Store menyimpan import_jobs, import_job_rows, dan export_jobs.
+type Store struct {
+	pool *pgxpool.Pool
+}
+
+// NewStore membuat Store.
+func NewStore(pool *pgxpool.Pool) *Store { return &Store{pool: pool} }
+
+func (s *Store) q(ctx context.Context) *sqlcgen.Queries {
+	if tx, ok := db.Tx(ctx); ok {
+		return sqlcgen.New(tx)
+	}
+	return sqlcgen.New(s.pool)
+}
+
+func notFound(err error, what string) error {
+	if errors.Is(err, pgx.ErrNoRows) {
+		return apperr.Wrap(apperr.CodeNotFound, fmt.Errorf("%s: %w", what, err))
+	}
+	return fmt.Errorf("%s: %w", what, err)
+}
+
+func nullUUID(id *uuid.UUID) uuid.NullUUID {
+	if id == nil {
+		return uuid.NullUUID{}
+	}
+	return uuid.NullUUID{UUID: *id, Valid: true}
+}
+
+func ptrUUID(n uuid.NullUUID) *uuid.UUID {
+	if !n.Valid {
+		return nil
+	}
+	id := n.UUID
+	return &id
+}
+
+func text(s *string) pgtype.Text {
+	if s == nil {
+		return pgtype.Text{}
+	}
+	return pgtype.Text{String: *s, Valid: true}
+}
+
+func toImportJob(r sqlcgen.ImportJob) domain.ImportJob {
+	return domain.ImportJob{
+		ID: r.ID, Kind: r.Kind, FileID: r.FileID, FileName: r.FileName, FileSHA256: r.FileSha256,
+		Status: domain.ImportStatus(r.Status), TotalRows: int(r.TotalRows), ProcessedRows: int(r.ProcessedRows),
+		ValidRows: int(r.ValidRows), ErrorRows: int(r.ErrorRows), CommittedRows: int(r.CommittedRows),
+		ErrorFileID: ptrUUID(r.ErrorFileID), Message: r.Message, ValidatedAt: r.ValidatedAt, CompletedAt: r.CompletedAt,
+		CreatedBy: r.CreatedBy, CreatedAt: r.CreatedAt, UpdatedAt: r.UpdatedAt, Version: int(r.Version),
+	}
+}
+
+func toExportJob(r sqlcgen.ExportJob) domain.ExportJob {
+	return domain.ExportJob{
+		ID: r.ID, Kind: r.Kind, Status: domain.ExportStatus(r.Status), TotalRows: int(r.TotalRows),
+		FileID: ptrUUID(r.FileID), FileName: r.FileName, Message: r.Message, CompletedAt: r.CompletedAt,
+		CreatedBy: r.CreatedBy, CreatedAt: r.CreatedAt, UpdatedAt: r.UpdatedAt, Version: int(r.Version),
+	}
+}
+
+func i32(n int) int32 { return int32(min(n, 1<<31-1)) } //nolint:gosec // dibatasi
+
+// InsertImportJob mencatat job impor. File yang sama (per jenis data) atau file yang sudah dipakai job lain
+// ditolak IMPORT_ALREADY_PROCESSED.
+func (s *Store) InsertImportJob(ctx context.Context, j domain.ImportJob, actorID uuid.UUID) (domain.ImportJob, error) {
+	r, err := s.q(ctx).InsertImportJob(ctx, sqlcgen.InsertImportJobParams{
+		Kind: j.Kind, FileID: j.FileID, FileName: j.FileName, FileSha256: j.FileSHA256, ActorID: actorID,
+	})
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "23505" {
+		return domain.ImportJob{}, apperr.Wrap(apperr.CodeImportAlreadyProcessed, err)
+	}
+	if err != nil {
+		return domain.ImportJob{}, fmt.Errorf("insert import job: %w", err)
+	}
+	return toImportJob(r), nil
+}
+
+// GetImportJob membaca job; forUpdate mengunci baris.
+func (s *Store) GetImportJob(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.ImportJob, error) {
+	var (
+		r   sqlcgen.ImportJob
+		err error
+	)
+	if forUpdate {
+		r, err = s.q(ctx).GetImportJobForUpdate(ctx, id)
+	} else {
+		r, err = s.q(ctx).GetImportJob(ctx, id)
+	}
+	if err != nil {
+		return domain.ImportJob{}, notFound(err, "get import job")
+	}
+	return toImportJob(r), nil
+}
+
+// ListImportJobs mengembalikan riwayat impor untuk jenis data yang boleh dilihat actor.
+func (s *Store) ListImportJobs(ctx context.Context, kinds []string, kind *string, page paging.Page) (paging.Result[domain.ImportJob], error) {
+	rows, err := s.q(ctx).ListImportJobs(ctx, sqlcgen.ListImportJobsParams{
+		Kinds: kinds, Kind: text(kind), Off: page.Offset(), Lim: page.Limit(),
+	})
+	if err != nil {
+		return paging.Result[domain.ImportJob]{}, fmt.Errorf("list import jobs: %w", err)
+	}
+	total, err := s.q(ctx).CountImportJobs(ctx, sqlcgen.CountImportJobsParams{Kinds: kinds, Kind: text(kind)})
+	if err != nil {
+		return paging.Result[domain.ImportJob]{}, fmt.Errorf("count import jobs: %w", err)
+	}
+	out := make([]domain.ImportJob, len(rows))
+	for i, r := range rows {
+		out[i] = toImportJob(r)
+	}
+	return paging.Result[domain.ImportJob]{Items: out, Page: page, Total: total}, nil
+}
+
+// SaveImportJob menyimpan status dan hitungan job dengan optimistic locking.
+func (s *Store) SaveImportJob(ctx context.Context, j domain.ImportJob, now time.Time, actorID uuid.UUID) (domain.ImportJob, error) {
+	n, err := s.q(ctx).UpdateImportJob(ctx, sqlcgen.UpdateImportJobParams{
+		Status: string(j.Status), TotalRows: i32(j.TotalRows), ProcessedRows: i32(j.ProcessedRows),
+		ValidRows: i32(j.ValidRows), ErrorRows: i32(j.ErrorRows), CommittedRows: i32(j.CommittedRows),
+		ErrorFileID: nullUUID(j.ErrorFileID), Message: j.Message, ValidatedAt: j.ValidatedAt, CompletedAt: j.CompletedAt,
+		Now: now, ActorID: actorID, ID: j.ID, Version: i32(j.Version),
+	})
+	if err != nil {
+		return domain.ImportJob{}, fmt.Errorf("update import job: %w", err)
+	}
+	if n == 0 {
+		return domain.ImportJob{}, apperr.New(apperr.CodeVersionConflict)
+	}
+	j.Version++
+	j.UpdatedAt = now
+	return j, nil
+}
+
+// SetImportProgress menulis progress tanpa menaikkan versi (dipanggil di luar transaksi dry-run).
+func (s *Store) SetImportProgress(ctx context.Context, id uuid.UUID, processed, committed int, now time.Time) error {
+	if err := s.q(ctx).SetImportProgress(ctx, sqlcgen.SetImportProgressParams{
+		ProcessedRows: i32(processed), CommittedRows: i32(committed), Now: now, ID: id,
+	}); err != nil {
+		return fmt.Errorf("set import progress: %w", err)
+	}
+	return nil
+}
+
+// ReplaceImportRows mengganti hasil pemeriksaan baris job.
+func (s *Store) ReplaceImportRows(ctx context.Context, jobID uuid.UUID, rows []domain.RowResult) error {
+	q := s.q(ctx)
+	if err := q.DeleteImportRows(ctx, jobID); err != nil {
+		return fmt.Errorf("delete import rows: %w", err)
+	}
+	params := make([]sqlcgen.InsertImportRowsParams, len(rows))
+	for i, r := range rows {
+		values, err := json.Marshal(r.Values)
+		if err != nil {
+			return err
+		}
+		errs := r.Errors
+		if errs == nil {
+			errs = []domain.RowError{}
+		}
+		encoded, err := json.Marshal(errs)
+		if err != nil {
+			return err
+		}
+		params[i] = sqlcgen.InsertImportRowsParams{
+			JobID: jobID, RowNumber: i32(r.Number), IsValid: r.Valid(), CellValues: values, Errors: encoded,
+		}
+	}
+	if len(params) == 0 {
+		return nil
+	}
+	if _, err := q.InsertImportRows(ctx, params); err != nil {
+		return fmt.Errorf("insert import rows: %w", err)
+	}
+	return nil
+}
+
+func toRowResult(r sqlcgen.ImportJobRow) (domain.RowResult, error) {
+	out := domain.RowResult{Number: int(r.RowNumber)}
+	if err := json.Unmarshal(r.CellValues, &out.Values); err != nil {
+		return out, fmt.Errorf("decode import row values: %w", err)
+	}
+	if err := json.Unmarshal(r.Errors, &out.Errors); err != nil {
+		return out, fmt.Errorf("decode import row errors: %w", err)
+	}
+	if len(out.Errors) == 0 {
+		out.Errors = nil
+	}
+	return out, nil
+}
+
+// ListImportRows mengembalikan baris preview; valid nil = semua.
+func (s *Store) ListImportRows(ctx context.Context, jobID uuid.UUID, valid *bool, page paging.Page) (paging.Result[domain.RowResult], error) {
+	isValid := pgtype.Bool{}
+	if valid != nil {
+		isValid = pgtype.Bool{Bool: *valid, Valid: true}
+	}
+	rows, err := s.q(ctx).ListImportRows(ctx, sqlcgen.ListImportRowsParams{
+		JobID: jobID, IsValid: isValid, Off: page.Offset(), Lim: page.Limit(),
+	})
+	if err != nil {
+		return paging.Result[domain.RowResult]{}, fmt.Errorf("list import rows: %w", err)
+	}
+	total, err := s.q(ctx).CountImportRows(ctx, sqlcgen.CountImportRowsParams{JobID: jobID, IsValid: isValid})
+	if err != nil {
+		return paging.Result[domain.RowResult]{}, fmt.Errorf("count import rows: %w", err)
+	}
+	out := make([]domain.RowResult, len(rows))
+	for i, r := range rows {
+		if out[i], err = toRowResult(r); err != nil {
+			return paging.Result[domain.RowResult]{}, err
+		}
+	}
+	return paging.Result[domain.RowResult]{Items: out, Page: page, Total: total}, nil
+}
+
+// ValidRowNumbers mengembalikan nomor baris valid hasil pemeriksaan.
+func (s *Store) ValidRowNumbers(ctx context.Context, jobID uuid.UUID) (map[int]bool, error) {
+	nums, err := s.q(ctx).ValidImportRowNumbers(ctx, jobID)
+	if err != nil {
+		return nil, fmt.Errorf("valid import rows: %w", err)
+	}
+	out := make(map[int]bool, len(nums))
+	for _, n := range nums {
+		out[int(n)] = true
+	}
+	return out, nil
+}
+
+// SetRowErrors menandai baris gagal saat penyimpanan.
+func (s *Store) SetRowErrors(ctx context.Context, jobID uuid.UUID, row int, errs []domain.RowError) error {
+	encoded, err := json.Marshal(errs)
+	if err != nil {
+		return err
+	}
+	if err := s.q(ctx).SetImportRowError(ctx, sqlcgen.SetImportRowErrorParams{Errors: encoded, JobID: jobID, RowNumber: i32(row)}); err != nil {
+		return fmt.Errorf("set import row error: %w", err)
+	}
+	return nil
+}
+
+// InsertExportJob mencatat permintaan ekspor.
+func (s *Store) InsertExportJob(ctx context.Context, kind string, actorID uuid.UUID) (domain.ExportJob, error) {
+	r, err := s.q(ctx).InsertExportJob(ctx, sqlcgen.InsertExportJobParams{Kind: kind, ActorID: actorID})
+	if err != nil {
+		return domain.ExportJob{}, fmt.Errorf("insert export job: %w", err)
+	}
+	return toExportJob(r), nil
+}
+
+// GetExportJob membaca job ekspor.
+func (s *Store) GetExportJob(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.ExportJob, error) {
+	var (
+		r   sqlcgen.ExportJob
+		err error
+	)
+	if forUpdate {
+		r, err = s.q(ctx).GetExportJobForUpdate(ctx, id)
+	} else {
+		r, err = s.q(ctx).GetExportJob(ctx, id)
+	}
+	if err != nil {
+		return domain.ExportJob{}, notFound(err, "get export job")
+	}
+	return toExportJob(r), nil
+}
+
+// ListExportJobs mengembalikan riwayat ekspor.
+func (s *Store) ListExportJobs(ctx context.Context, kinds []string, kind *string, page paging.Page) (paging.Result[domain.ExportJob], error) {
+	rows, err := s.q(ctx).ListExportJobs(ctx, sqlcgen.ListExportJobsParams{
+		Kinds: kinds, Kind: text(kind), Off: page.Offset(), Lim: page.Limit(),
+	})
+	if err != nil {
+		return paging.Result[domain.ExportJob]{}, fmt.Errorf("list export jobs: %w", err)
+	}
+	total, err := s.q(ctx).CountExportJobs(ctx, sqlcgen.CountExportJobsParams{Kinds: kinds, Kind: text(kind)})
+	if err != nil {
+		return paging.Result[domain.ExportJob]{}, fmt.Errorf("count export jobs: %w", err)
+	}
+	out := make([]domain.ExportJob, len(rows))
+	for i, r := range rows {
+		out[i] = toExportJob(r)
+	}
+	return paging.Result[domain.ExportJob]{Items: out, Page: page, Total: total}, nil
+}
+
+// SaveExportJob menyimpan status job ekspor.
+func (s *Store) SaveExportJob(ctx context.Context, j domain.ExportJob, now time.Time, actorID uuid.UUID) (domain.ExportJob, error) {
+	n, err := s.q(ctx).UpdateExportJob(ctx, sqlcgen.UpdateExportJobParams{
+		Status: string(j.Status), TotalRows: i32(j.TotalRows), FileID: nullUUID(j.FileID), FileName: j.FileName,
+		Message: j.Message, CompletedAt: j.CompletedAt, Now: now, ActorID: actorID, ID: j.ID, Version: i32(j.Version),
+	})
+	if err != nil {
+		return domain.ExportJob{}, fmt.Errorf("update export job: %w", err)
+	}
+	if n == 0 {
+		return domain.ExportJob{}, apperr.New(apperr.CodeVersionConflict)
+	}
+	j.Version++
+	j.UpdatedAt = now
+	return j, nil
+}
diff --git a/backend/internal/dataexchange/service/exports.go b/backend/internal/dataexchange/service/exports.go
new file mode 100644
index 0000000..c3f175a
--- /dev/null
+++ b/backend/internal/dataexchange/service/exports.go
@@ -0,0 +1,153 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+
+	"balans/internal/dataexchange/domain"
+	"balans/internal/dataexchange/workbook"
+	"balans/internal/platform/actor"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/paging"
+	"balans/internal/platform/tabular"
+)
+
+const (
+	notifyExportReady  = "dataexchange.export_ready"
+	notifyExportFailed = "dataexchange.export_failed"
+)
+
+func exportLink(j domain.ExportJob) string {
+	return "/integrations/data-exchange?tab=export&kind=" + j.Kind
+}
+
+// CreateExport menjadwalkan ekspor jenis data; file xlsx dibuat job dataexchange.export di antrean bulk.
+func (s *Service) CreateExport(ctx context.Context, kind string) (domain.ExportJob, error) {
+	_, a, err := s.requireExporter(ctx, kind)
+	if err != nil {
+		return domain.ExportJob{}, err
+	}
+	var job domain.ExportJob
+	err = s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		if job, err = s.Store.InsertExportJob(ctx, kind, a.UserID); err != nil {
+			return err
+		}
+		return s.Jobs.Enqueue(ctx, ExportArgs{JobID: job.ID}, nil)
+	})
+	return job, err
+}
+
+// GetExport mengembalikan job ekspor.
+func (s *Service) GetExport(ctx context.Context, id uuid.UUID) (domain.ExportJob, error) {
+	j, err := s.Store.GetExportJob(ctx, id, false)
+	if err != nil {
+		return domain.ExportJob{}, err
+	}
+	if _, _, err := s.requireExporter(ctx, j.Kind); err != nil {
+		return domain.ExportJob{}, err
+	}
+	return j, nil
+}
+
+// ListExports mengembalikan riwayat ekspor jenis data yang boleh diekspor actor.
+func (s *Service) ListExports(ctx context.Context, kind *string, page paging.Page) (paging.Result[domain.ExportJob], error) {
+	a, ok := actor.From(ctx)
+	if !ok {
+		return paging.Result[domain.ExportJob]{}, apperr.New(apperr.CodeAuthSessionExpired)
+	}
+	kinds := s.exportKinds(a)
+	if len(kinds) == 0 {
+		return paging.Result[domain.ExportJob]{}, apperr.New(apperr.CodeForbidden)
+	}
+	return s.Store.ListExportJobs(ctx, kinds, kind, page)
+}
+
+// ExportDownloadURL membuat URL unduhan file ekspor.
+func (s *Service) ExportDownloadURL(ctx context.Context, id uuid.UUID) (string, time.Time, error) {
+	j, err := s.GetExport(ctx, id)
+	if err != nil {
+		return "", time.Time{}, err
+	}
+	if j.FileID == nil {
+		return "", time.Time{}, apperr.WithMessage(apperr.CodeInvalidStateTransition, "File ekspor belum selesai dibuat.")
+	}
+	return s.Files.DownloadURL(ctx, *j.FileID)
+}
+
+// RunExport dijalankan worker dataexchange.export. Job yang sudah selesai atau gagal tidak diproses ulang.
+func (s *Service) RunExport(ctx context.Context, id uuid.UUID) error {
+	j, err := s.Store.GetExportJob(ctx, id, false)
+	if err != nil {
+		return err
+	}
+	if j.Status == domain.ExportCompleted || j.Status == domain.ExportFailed {
+		return nil
+	}
+	exp, ok := s.exporter(j.Kind)
+	if !ok {
+		return s.failExport(ctx, j, "Jenis data "+j.Kind+" tidak aktif.")
+	}
+	a, err := s.Actors.ActorFor(ctx, j.CreatedBy)
+	if err != nil {
+		if apperr.As(err).Code != apperr.CodeInternal {
+			return s.failExport(ctx, j, "Pengguna pembuat ekspor tidak aktif.")
+		}
+		return err
+	}
+	spec := exp.Spec()
+	if !a.Has(spec.ExportPermission()) {
+		return s.failExport(ctx, j, "Pengguna tidak lagi memiliki akses ekspor "+spec.Label+".")
+	}
+	ctx = actor.With(ctx, a)
+	j.Status = domain.ExportRunning
+	if j, err = s.Store.SaveExportJob(ctx, j, s.now(), j.CreatedBy); err != nil {
+		return err
+	}
+	w, err := workbook.NewWriter(spec, false)
+	if err != nil {
+		return err
+	}
+	err = exp.Export(ctx, func(r tabular.Row) error { return w.Write(r, "") })
+	if err != nil {
+		err = errors.Join(err, w.Discard())
+		if appErr := apperr.As(err); appErr.Code != apperr.CodeInternal {
+			return s.failExport(ctx, j, appErr.Message)
+		}
+		return err
+	}
+	rows := w.Rows()
+	var buf bytes.Buffer
+	if err := w.Close(&buf); err != nil {
+		return err
+	}
+	name := fmt.Sprintf("Ekspor %s %s.xlsx", spec.Label, clock.Today(s.Clock))
+	fileID, err := s.Files.Save(ctx, ownerExport+j.Kind, j.ID, name, workbook.ContentType, buf.Bytes())
+	if err != nil {
+		return err
+	}
+	now := s.now()
+	j.Status, j.TotalRows, j.FileID, j.FileName, j.CompletedAt = domain.ExportCompleted, rows, &fileID, name, &now
+	if j, err = s.Store.SaveExportJob(ctx, j, now, j.CreatedBy); err != nil {
+		return err
+	}
+	s.notify(ctx, j.CreatedBy, notifyExportReady, "Ekspor siap diunduh: "+spec.Label,
+		fmt.Sprintf("%d baris %s.", rows, spec.Label), exportLink(j))
+	return nil
+}
+
+func (s *Service) failExport(ctx context.Context, j domain.ExportJob, msg string) error {
+	now := s.now()
+	j.Status, j.Message, j.CompletedAt = domain.ExportFailed, msg, &now
+	saved, err := s.Store.SaveExportJob(ctx, j, now, j.CreatedBy)
+	if err != nil {
+		return err
+	}
+	s.notify(ctx, j.CreatedBy, notifyExportFailed, "Ekspor gagal", msg, exportLink(saved))
+	return nil
+}
diff --git a/backend/internal/dataexchange/service/imports.go b/backend/internal/dataexchange/service/imports.go
new file mode 100644
index 0000000..3b06421
--- /dev/null
+++ b/backend/internal/dataexchange/service/imports.go
@@ -0,0 +1,465 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgconn"
+
+	"balans/internal/dataexchange/domain"
+	"balans/internal/dataexchange/workbook"
+	"balans/internal/platform/actor"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/db"
+	"balans/internal/platform/paging"
+	"balans/internal/platform/tabular"
+)
+
+// Jenis notifikasi in-app.
+const (
+	notifyImportValidated = "dataexchange.import_validated"
+	notifyImportCompleted = "dataexchange.import_completed"
+	notifyImportFailed    = "dataexchange.import_failed"
+)
+
+// progressEvery menentukan seberapa sering progress ditulis.
+const progressEvery = 50
+
+func importLink(j domain.ImportJob) string {
+	return "/integrations/data-exchange?tab=import&kind=" + j.Kind + "&job=" + j.ID.String()
+}
+
+// WriteTemplate menulis template impor jenis data ke w.
+func (s *Service) WriteTemplate(ctx context.Context, kind string, w io.Writer) (domain.Spec, error) {
+	imp, _, err := s.requireImporter(ctx, kind)
+	if err != nil {
+		return domain.Spec{}, err
+	}
+	return imp.Spec(), workbook.WriteTemplate(w, imp.Spec())
+}
+
+// CreateImport mencatat file yang sudah diunggah sebagai job impor lalu menjadwalkan pemeriksaan di antrean
+// bulk. File yang sama (SHA-256) untuk jenis data yang sama ditolak IMPORT_ALREADY_PROCESSED.
+func (s *Service) CreateImport(ctx context.Context, kind string, fileID uuid.UUID) (domain.ImportJob, error) {
+	_, a, err := s.requireImporter(ctx, kind)
+	if err != nil {
+		return domain.ImportJob{}, err
+	}
+	invalid := func(msg string) error { return apperr.Validation(map[string]string{"fileId": msg}) }
+	f, err := s.Files.Info(ctx, fileID)
+	switch {
+	case apperr.HasCode(err, apperr.CodeNotFound):
+		return domain.ImportJob{}, invalid("File tidak ditemukan")
+	case err != nil:
+		return domain.ImportJob{}, err
+	case f.OwnerType != UploadOwnerType(kind):
+		return domain.ImportJob{}, invalid("File tidak diunggah untuk jenis data ini")
+	case !f.Uploaded:
+		return domain.ImportJob{}, invalid("File belum selesai diunggah")
+	case f.CreatedBy != a.UserID:
+		return domain.ImportJob{}, invalid("File diunggah pengguna lain")
+	}
+	var job domain.ImportJob
+	err = s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		job, err = s.Store.InsertImportJob(ctx, domain.ImportJob{
+			Kind: kind, FileID: fileID, FileName: f.Name, FileSHA256: f.SHA256,
+		}, a.UserID)
+		if err != nil {
+			return err
+		}
+		if err := s.Files.Attach(ctx, fileID, UploadOwnerType(kind), job.ID); err != nil {
+			return err
+		}
+		return s.Jobs.Enqueue(ctx, ImportArgs{JobID: job.ID}, nil)
+	})
+	if apperr.HasCode(err, apperr.CodeImportAlreadyProcessed) {
+		return domain.ImportJob{}, apperr.WithMessage(apperr.CodeImportAlreadyProcessed,
+			"File ini sudah pernah diimpor atau sedang diproses. Buka riwayat impor untuk melihat hasilnya.")
+	}
+	return job, err
+}
+
+// GetImport mengembalikan job impor.
+func (s *Service) GetImport(ctx context.Context, id uuid.UUID) (domain.ImportJob, error) {
+	j, err := s.Store.GetImportJob(ctx, id, false)
+	if err != nil {
+		return domain.ImportJob{}, err
+	}
+	if _, _, err := s.requireImporter(ctx, j.Kind); err != nil {
+		return domain.ImportJob{}, err
+	}
+	return j, nil
+}
+
+// ListImports mengembalikan riwayat impor jenis data yang boleh diimpor actor.
+func (s *Service) ListImports(ctx context.Context, kind *string, page paging.Page) (paging.Result[domain.ImportJob], error) {
+	a, ok := actor.From(ctx)
+	if !ok {
+		return paging.Result[domain.ImportJob]{}, apperr.New(apperr.CodeAuthSessionExpired)
+	}
+	kinds := s.importKinds(a)
+	if len(kinds) == 0 {
+		return paging.Result[domain.ImportJob]{}, apperr.New(apperr.CodeForbidden)
+	}
+	return s.Store.ListImportJobs(ctx, kinds, kind, page)
+}
+
+// ImportRows mengembalikan baris hasil pemeriksaan; valid nil = semua baris.
+func (s *Service) ImportRows(ctx context.Context, id uuid.UUID, valid *bool, page paging.Page) (paging.Result[domain.RowResult], error) {
+	if _, err := s.GetImport(ctx, id); err != nil {
+		return paging.Result[domain.RowResult]{}, err
+	}
+	return s.Store.ListImportRows(ctx, id, valid, page)
+}
+
+// CommitImport mengonfirmasi penyimpanan baris valid; penyimpanan berjalan sebagai job.
+func (s *Service) CommitImport(ctx context.Context, id uuid.UUID) (domain.ImportJob, error) {
+	return s.transition(ctx, id, func(j *domain.ImportJob) error { return j.Commit() }, true)
+}
+
+// CancelImport membatalkan job yang menunggu konfirmasi; file yang sama boleh diunggah ulang.
+func (s *Service) CancelImport(ctx context.Context, id uuid.UUID) (domain.ImportJob, error) {
+	return s.transition(ctx, id, func(j *domain.ImportJob) error {
+		if err := j.Cancel(); err != nil {
+			return err
+		}
+		now := s.now()
+		j.CompletedAt = &now
+		return nil
+	}, false)
+}
+
+func (s *Service) transition(ctx context.Context, id uuid.UUID, apply func(*domain.ImportJob) error, enqueue bool) (domain.ImportJob, error) {
+	var out domain.ImportJob
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		j, err := s.Store.GetImportJob(ctx, id, true)
+		if err != nil {
+			return err
+		}
+		_, a, err := s.requireImporter(ctx, j.Kind)
+		if err != nil {
+			return err
+		}
+		if err := apply(&j); err != nil {
+			return err
+		}
+		if out, err = s.Store.SaveImportJob(ctx, j, s.now(), a.UserID); err != nil {
+			return err
+		}
+		if enqueue {
+			return s.Jobs.Enqueue(ctx, ImportArgs{JobID: id}, nil)
+		}
+		return nil
+	})
+	return out, err
+}
+
+// ImportErrorFileURL membuat URL unduhan file baris error.
+func (s *Service) ImportErrorFileURL(ctx context.Context, id uuid.UUID) (string, time.Time, error) {
+	j, err := s.GetImport(ctx, id)
+	if err != nil {
+		return "", time.Time{}, err
+	}
+	if j.ErrorFileID == nil {
+		return "", time.Time{}, apperr.WithMessage(apperr.CodeNotFound, "Tidak ada baris error.")
+	}
+	return s.Files.DownloadURL(ctx, *j.ErrorFileID)
+}
+
+// RunImport dijalankan worker dataexchange.import: memeriksa file (status uploaded/validating) atau menyimpan
+// baris valid (status committing). Status lain tidak diproses ulang (idempotent).
+func (s *Service) RunImport(ctx context.Context, id uuid.UUID) error {
+	j, err := s.Store.GetImportJob(ctx, id, false)
+	if err != nil {
+		return err
+	}
+	if !j.Status.Running() {
+		return nil
+	}
+	imp, ok := s.importer(j.Kind)
+	if !ok {
+		return s.failImport(ctx, j, "Jenis data "+j.Kind+" tidak aktif.")
+	}
+	a, err := s.Actors.ActorFor(ctx, j.CreatedBy)
+	if err != nil {
+		if apperr.As(err).Code != apperr.CodeInternal {
+			return s.failImport(ctx, j, "Pengguna pembuat impor tidak aktif.")
+		}
+		return err
+	}
+	if !a.Has(imp.Spec().ImportPermission()) {
+		return s.failImport(ctx, j, "Pengguna tidak lagi memiliki akses impor "+imp.Spec().Label+".")
+	}
+	ctx = actor.With(ctx, a)
+	if j.Status == domain.ImportCommitting {
+		return s.commit(ctx, j, imp)
+	}
+	return s.validate(ctx, j, imp)
+}
+
+func (s *Service) failImport(ctx context.Context, j domain.ImportJob, msg string) error {
+	now := s.now()
+	j.Status, j.Message, j.CompletedAt = domain.ImportFailed, msg, &now
+	saved, err := s.Store.SaveImportJob(db.WithoutTx(ctx), j, now, j.CreatedBy)
+	if err != nil {
+		return err
+	}
+	s.notify(ctx, j.CreatedBy, notifyImportFailed, "Impor gagal: "+j.FileName, msg, importLink(saved))
+	return nil
+}
+
+func (s *Service) readFile(ctx context.Context, j domain.ImportJob, spec domain.Spec) (workbook.Sheet, error) {
+	r, err := s.Files.Open(ctx, j.FileID)
+	if err != nil {
+		return workbook.Sheet{}, err
+	}
+	defer r.Close() //nolint:errcheck // hanya membaca
+	return workbook.Read(r, spec)
+}
+
+// rowErrors memetakan error ApplyRow ke error baris. Pelanggaran constraint database (kelas 23) dianggap error
+// data; error lain dikembalikan sebagai gangguan sistem.
+func rowErrors(err error, spec domain.Spec) ([]domain.RowError, error) {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && len(pgErr.Code) == 5 && pgErr.Code[:2] == "23" {
+		return []domain.RowError{{Message: "Data tidak memenuhi aturan penyimpanan (" + pgErr.ConstraintName + ")"}}, nil
+	}
+	return domain.ErrorsFrom(err, spec.Columns)
+}
+
+var errDryRun = errors.New("dry-run selesai")
+
+func withRowKey(ctx context.Context, jobID uuid.UUID, row int) context.Context {
+	return context.WithValue(ctx, rowKeyCtx{}, jobID.String()+":"+strconv.Itoa(row))
+}
+
+// checkRows menjalankan pemeriksaan semua baris di satu transaksi yang selalu dibatalkan. Tiap baris berjalan
+// di savepoint sehingga baris berikutnya melihat hasil baris sebelumnya (mis. komponen bundel dari SKU baru di
+// file yang sama), tetapi tidak ada data yang tersimpan.
+func (s *Service) checkRows(ctx context.Context, j domain.ImportJob, imp Importer, rows []tabular.Row) (map[int][]domain.RowError, error) {
+	spec := imp.Spec()
+	errs := domain.CheckRows(spec.Columns, rows)
+	validator, hasValidator := imp.(RowValidator)
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		for i, row := range rows {
+			if len(errs[row.Number]) == 0 {
+				rctx := withRowKey(ctx, j.ID, row.Number)
+				err := db.Savepoint(rctx, func(ctx context.Context) error {
+					if hasValidator {
+						return validator.ValidateRow(ctx, row)
+					}
+					return imp.ApplyRow(ctx, row)
+				})
+				if err != nil {
+					rowErrs, sysErr := rowErrors(err, spec)
+					if sysErr != nil {
+						return fmt.Errorf("baris %d: %w", row.Number, sysErr)
+					}
+					errs[row.Number] = rowErrs
+				}
+			}
+			if (i+1)%progressEvery == 0 {
+				if err := s.Store.SetImportProgress(db.WithoutTx(ctx), j.ID, i+1, 0, s.now()); err != nil {
+					return err
+				}
+			}
+		}
+		return errDryRun
+	})
+	if !errors.Is(err, errDryRun) {
+		return nil, err
+	}
+	return errs, nil
+}
+
+func (s *Service) validate(ctx context.Context, j domain.ImportJob, imp Importer) error {
+	spec := imp.Spec()
+	j.Status, j.ProcessedRows, j.Message = domain.ImportValidating, 0, ""
+	j, err := s.Store.SaveImportJob(ctx, j, s.now(), j.CreatedBy)
+	if err != nil {
+		return err
+	}
+	sheet, err := s.readFile(ctx, j, spec)
+	if err != nil {
+		if appErr := apperr.As(err); appErr.Code != apperr.CodeInternal {
+			return s.failImport(ctx, j, appErr.Message)
+		}
+		return err
+	}
+	if len(sheet.Rows) == 0 {
+		return s.failImport(ctx, j, "File tidak berisi data. Isi data mulai baris 2 template.")
+	}
+	j.TotalRows = len(sheet.Rows)
+	if err := s.Store.SetImportProgress(ctx, j.ID, 0, 0, s.now()); err != nil {
+		return err
+	}
+	if j, err = s.Store.SaveImportJob(ctx, j, s.now(), j.CreatedBy); err != nil {
+		return err
+	}
+	errs, err := s.checkRows(ctx, j, imp, sheet.Rows)
+	if err != nil {
+		return err
+	}
+	results := make([]domain.RowResult, len(sheet.Rows))
+	valid := 0
+	for i, r := range sheet.Rows {
+		results[i] = domain.RowResult{Number: r.Number, Values: domain.PreviewValues(spec.Columns, r), Errors: errs[r.Number]}
+		if results[i].Valid() {
+			valid++
+		}
+	}
+	var errorFile *uuid.UUID
+	if valid < len(results) {
+		id, err := s.saveErrorFile(ctx, j, spec, sheet.Rows, errs)
+		if err != nil {
+			return err
+		}
+		errorFile = &id
+	}
+	now := s.now()
+	j.Status, j.ProcessedRows, j.ValidRows, j.ErrorRows = domain.ImportValidated, len(results), valid, len(results)-valid
+	j.ErrorFileID, j.ValidatedAt = errorFile, &now
+	err = s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		if err := s.Store.ReplaceImportRows(ctx, j.ID, results); err != nil {
+			return err
+		}
+		j, err = s.Store.SaveImportJob(ctx, j, now, j.CreatedBy)
+		return err
+	})
+	if err != nil {
+		return err
+	}
+	s.notify(ctx, j.CreatedBy, notifyImportValidated, "Pemeriksaan impor selesai: "+j.FileName,
+		fmt.Sprintf("%d baris valid, %d baris error. Periksa hasilnya lalu simpan.", j.ValidRows, j.ErrorRows), importLink(j))
+	return nil
+}
+
+func (s *Service) saveErrorFile(ctx context.Context, j domain.ImportJob, spec domain.Spec, rows []tabular.Row, errs map[int][]domain.RowError) (uuid.UUID, error) {
+	w, err := workbook.NewWriter(spec, true)
+	if err != nil {
+		return uuid.Nil, err
+	}
+	for _, r := range rows {
+		if e := errs[r.Number]; len(e) > 0 {
+			if err := w.Write(r, fmt.Sprintf("Baris %d: %s", r.Number, domain.FormatErrors(spec.Columns, e))); err != nil {
+				return uuid.Nil, errors.Join(err, w.Discard())
+			}
+		}
+	}
+	var buf bytes.Buffer
+	if err := w.Close(&buf); err != nil {
+		return uuid.Nil, err
+	}
+	return s.Files.Save(ctx, ownerErrors+j.Kind, j.ID, "Baris Error "+spec.Label+".xlsx", workbook.ContentType, buf.Bytes())
+}
+
+// rowFailure adalah baris yang ditolak saat simpan (data berubah setelah pemeriksaan).
+type rowFailure struct {
+	row  int
+	errs []domain.RowError
+}
+
+func (e *rowFailure) Error() string { return fmt.Sprintf("baris %d ditolak saat simpan", e.row) }
+
+func batchSize(imp Importer) int {
+	if b, ok := imp.(BatchImporter); ok && b.BatchSize() > 0 {
+		return b.BatchSize()
+	}
+	return 0
+}
+
+func (s *Service) commit(ctx context.Context, j domain.ImportJob, imp Importer) error {
+	spec := imp.Spec()
+	validRows, err := s.Store.ValidRowNumbers(ctx, j.ID)
+	if err != nil {
+		return err
+	}
+	sheet, err := s.readFile(ctx, j, spec)
+	if err != nil {
+		if appErr := apperr.As(err); appErr.Code != apperr.CodeInternal {
+			return s.failImport(ctx, j, appErr.Message)
+		}
+		return err
+	}
+	rows := make([]tabular.Row, 0, len(validRows))
+	for _, r := range sheet.Rows {
+		if validRows[r.Number] {
+			rows = append(rows, r)
+		}
+	}
+	size := batchSize(imp)
+	if size == 0 {
+		size = len(rows)
+	}
+	// Mode batch melanjutkan dari batch terakhir yang sudah tersimpan saat job diulang.
+	done := j.CommittedRows
+	if batchSize(imp) == 0 {
+		done = 0
+	}
+	for start := done; start < len(rows); start += size {
+		batch := rows[start:min(start+size, len(rows))]
+		err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+			for i, row := range batch {
+				if err := imp.ApplyRow(withRowKey(ctx, j.ID, row.Number), row); err != nil {
+					rowErrs, sysErr := rowErrors(err, spec)
+					if sysErr != nil {
+						return fmt.Errorf("baris %d: %w", row.Number, sysErr)
+					}
+					return &rowFailure{row: row.Number, errs: rowErrs}
+				}
+				if n := start + i + 1; n%progressEvery == 0 {
+					if err := s.Store.SetImportProgress(db.WithoutTx(ctx), j.ID, j.ProcessedRows, n, s.now()); err != nil {
+						return err
+					}
+				}
+			}
+			if batchSize(imp) > 0 {
+				return s.Store.SetImportProgress(ctx, j.ID, j.ProcessedRows, start+len(batch), s.now())
+			}
+			return nil
+		})
+		var rf *rowFailure
+		if errors.As(err, &rf) {
+			return s.failCommit(ctx, j, rf, start, spec)
+		}
+		if err != nil {
+			return err
+		}
+	}
+	now := s.now()
+	cur, err := s.Store.GetImportJob(ctx, j.ID, false)
+	if err != nil {
+		return err
+	}
+	cur.Status, cur.CommittedRows, cur.CompletedAt = domain.ImportCompleted, len(rows), &now
+	if cur, err = s.Store.SaveImportJob(ctx, cur, now, j.CreatedBy); err != nil {
+		return err
+	}
+	s.notify(ctx, j.CreatedBy, notifyImportCompleted, "Impor selesai: "+j.FileName,
+		fmt.Sprintf("%d baris %s tersimpan.", cur.CommittedRows, spec.Label), importLink(cur))
+	return nil
+}
+
+func (s *Service) failCommit(ctx context.Context, j domain.ImportJob, rf *rowFailure, committed int, spec domain.Spec) error {
+	if err := s.Store.SetRowErrors(ctx, j.ID, rf.row, rf.errs); err != nil {
+		return err
+	}
+	cur, err := s.Store.GetImportJob(ctx, j.ID, false)
+	if err != nil {
+		return err
+	}
+	cur.CommittedRows = committed
+	msg := fmt.Sprintf("Baris %d: %s. ", rf.row, domain.FormatErrors(spec.Columns, rf.errs))
+	if committed == 0 {
+		msg += "Tidak ada data yang disimpan. Perbaiki file lalu impor ulang."
+	} else {
+		msg += fmt.Sprintf("%d baris sebelumnya sudah tersimpan.", committed)
+	}
+	return s.failImport(ctx, cur, msg)
+}
diff --git a/backend/internal/dataexchange/service/service.go b/backend/internal/dataexchange/service/service.go
new file mode 100644
index 0000000..40d3fc4
--- /dev/null
+++ b/backend/internal/dataexchange/service/service.go
@@ -0,0 +1,297 @@
+// Package service berisi use case impor/ekspor Excel generik (BRD MD-10, INT-02, Technical Guideline 5.15).
+// Modul bisnis tidak diimpor: jenis data didaftarkan lewat Importer/Exporter yang diisi adapter di internal/app,
+// sehingga validasi bisnis tetap di modul pemilik data.
+package service
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"slices"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/riverqueue/river"
+
+	"balans/internal/dataexchange/domain"
+	"balans/internal/platform/actor"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/paging"
+	"balans/internal/platform/tabular"
+)
+
+// Importer adalah satu jenis data yang bisa diimpor. ApplyRow membuat atau memperbarui data satu baris di
+// transaksi aktif dengan aturan bisnis modul pemilik (termasuk cek permission tulis actor). ApplyRow dipanggil
+// dua kali: saat pemeriksaan (di savepoint yang selalu dibatalkan, sehingga hasilnya sama dengan simpan
+// sebenarnya) dan saat simpan. Error apperr (VALIDATION_FAILED dengan field = Key kolom, DUPLICATE_CODE, dst.)
+// menjadi error baris; error lain dianggap gangguan sistem dan job diulang.
+type Importer interface {
+	Spec() domain.Spec
+	ApplyRow(ctx context.Context, row tabular.Row) error
+}
+
+// RowValidator opsional: importer yang tidak boleh menulis saat pemeriksaan (mis. kode dari sequence yang
+// tidak ikut dibatalkan) memeriksa baris tanpa menyimpan. Kolom Identity tetap dicek ganda oleh framework.
+type RowValidator interface {
+	ValidateRow(ctx context.Context, row tabular.Row) error
+}
+
+// BatchImporter opsional: BatchSize > 0 menyimpan per batch dengan transaksi terpisah (impor transaksi besar,
+// TG 5.15 butir 4). ApplyRow wajib idempotent per baris; gunakan RowKey sebagai kunci idempotensi. Default
+// (tanpa interface ini): satu impor = satu transaksi (master data).
+type BatchImporter interface {
+	BatchSize() int
+}
+
+// Exporter adalah satu jenis data yang bisa diekspor. Export memanggil emit per baris secara berurutan (stream)
+// dengan Key kolom yang sama dengan template impor, sehingga file ekspor bisa diimpor ulang.
+type Exporter interface {
+	Spec() domain.Spec
+	Export(ctx context.Context, emit func(tabular.Row) error) error
+}
+
+type rowKeyCtx struct{}
+
+// RowKey adalah kunci idempotensi baris: ID job + nomor baris. Kosong di luar job impor.
+func RowKey(ctx context.Context) string {
+	s, _ := ctx.Value(rowKeyCtx{}).(string)
+	return s
+}
+
+// FileInfo adalah metadata file dari modul filestore.
+type FileInfo struct {
+	ID        uuid.UUID
+	Name      string
+	OwnerType string
+	SHA256    []byte
+	Uploaded  bool
+	CreatedBy uuid.UUID
+}
+
+// Files adalah akses ke modul filestore.
+type Files interface {
+	Info(ctx context.Context, id uuid.UUID) (FileInfo, error)
+	Attach(ctx context.Context, id uuid.UUID, ownerType string, ownerID uuid.UUID) error
+	Open(ctx context.Context, id uuid.UUID) (io.ReadCloser, error)
+	// Save menyimpan file buatan server (hasil ekspor, baris error) yang langsung tertaut ke pemiliknya.
+	Save(ctx context.Context, ownerType string, ownerID uuid.UUID, name, contentType string, data []byte) (uuid.UUID, error)
+	// DownloadURL membuat URL unduhan bertanda tangan tanpa cek permission; dataexchange sudah memeriksanya.
+	DownloadURL(ctx context.Context, id uuid.UUID) (string, time.Time, error)
+}
+
+// Actors menyusun actor pembuat job saat worker berjalan (permission terbaru, untuk cek hak dan audit trail).
+type Actors interface {
+	ActorFor(ctx context.Context, userID uuid.UUID) (actor.Actor, error)
+}
+
+// Notifier mengirim notifikasi in-app (opsional).
+type Notifier interface {
+	Notify(ctx context.Context, userIDs []uuid.UUID, kind, title, body, link string) error
+}
+
+// Enqueuer memasukkan job river di transaksi aktif.
+type Enqueuer interface {
+	Enqueue(ctx context.Context, args river.JobArgs, opts *river.InsertOpts) error
+}
+
+type txRunner interface {
+	WithTx(ctx context.Context, fn func(ctx context.Context) error) error
+}
+
+type store interface {
+	InsertImportJob(ctx context.Context, j domain.ImportJob, actorID uuid.UUID) (domain.ImportJob, error)
+	GetImportJob(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.ImportJob, error)
+	ListImportJobs(ctx context.Context, kinds []string, kind *string, page paging.Page) (paging.Result[domain.ImportJob], error)
+	SaveImportJob(ctx context.Context, j domain.ImportJob, now time.Time, actorID uuid.UUID) (domain.ImportJob, error)
+	SetImportProgress(ctx context.Context, id uuid.UUID, processed, committed int, now time.Time) error
+	ReplaceImportRows(ctx context.Context, jobID uuid.UUID, rows []domain.RowResult) error
+	ListImportRows(ctx context.Context, jobID uuid.UUID, valid *bool, page paging.Page) (paging.Result[domain.RowResult], error)
+	ValidRowNumbers(ctx context.Context, jobID uuid.UUID) (map[int]bool, error)
+	SetRowErrors(ctx context.Context, jobID uuid.UUID, row int, errs []domain.RowError) error
+
+	InsertExportJob(ctx context.Context, kind string, actorID uuid.UUID) (domain.ExportJob, error)
+	GetExportJob(ctx context.Context, id uuid.UUID, forUpdate bool) (domain.ExportJob, error)
+	ListExportJobs(ctx context.Context, kinds []string, kind *string, page paging.Page) (paging.Result[domain.ExportJob], error)
+	SaveExportJob(ctx context.Context, j domain.ExportJob, now time.Time, actorID uuid.UUID) (domain.ExportJob, error)
+}
+
+// Deps adalah dependensi Service.
+type Deps struct {
+	Store    store
+	Tx       txRunner
+	Jobs     Enqueuer
+	Files    Files
+	Actors   Actors
+	Notifier Notifier
+	Clock    clock.Clock
+	Log      *slog.Logger
+}
+
+// Service adalah use case dataexchange.
+type Service struct {
+	Deps
+
+	mu        sync.RWMutex
+	importers map[string]Importer
+	exporters map[string]Exporter
+}
+
+// New membuat Service.
+func New(d Deps) *Service {
+	return &Service{Deps: d, importers: map[string]Importer{}, exporters: map[string]Exporter{}}
+}
+
+// Jenis pemilik file di filestore per jenis data.
+const (
+	ownerUpload = "import."
+	ownerErrors = "import_errors."
+	ownerExport = "export."
+)
+
+// UploadOwnerType adalah jenis pemilik file upload impor, mis. `import.catalog.product`.
+func UploadOwnerType(kind string) string { return ownerUpload + kind }
+
+// RegisterImporter didaftarkan saat wiring; pendaftaran terakhir untuk kind yang sama menang.
+func (s *Service) RegisterImporter(imp Importer) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.importers[imp.Spec().Kind] = imp
+}
+
+// RegisterExporter didaftarkan saat wiring.
+func (s *Service) RegisterExporter(exp Exporter) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.exporters[exp.Spec().Kind] = exp
+}
+
+func (s *Service) importer(kind string) (Importer, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	imp, ok := s.importers[kind]
+	return imp, ok
+}
+
+func (s *Service) exporter(kind string) (Exporter, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	exp, ok := s.exporters[kind]
+	return exp, ok
+}
+
+// KindInfo adalah jenis data yang tersedia untuk actor.
+type KindInfo struct {
+	Spec      domain.Spec
+	CanImport bool
+	CanExport bool
+}
+
+// Kinds mengembalikan jenis data yang boleh diimpor atau diekspor actor, urut label.
+func (s *Service) Kinds(ctx context.Context) ([]KindInfo, error) {
+	a, ok := actor.From(ctx)
+	if !ok {
+		return nil, apperr.New(apperr.CodeAuthSessionExpired)
+	}
+	s.mu.RLock()
+	byKind := map[string]*KindInfo{}
+	for k, imp := range s.importers {
+		if a.Has(imp.Spec().ImportPermission()) {
+			byKind[k] = &KindInfo{Spec: imp.Spec(), CanImport: true}
+		}
+	}
+	for k, exp := range s.exporters {
+		if !a.Has(exp.Spec().ExportPermission()) {
+			continue
+		}
+		if info, ok := byKind[k]; ok {
+			info.CanExport = true
+		} else {
+			byKind[k] = &KindInfo{Spec: exp.Spec(), CanExport: true}
+		}
+	}
+	s.mu.RUnlock()
+	out := make([]KindInfo, 0, len(byKind))
+	for _, info := range byKind {
+		out = append(out, *info)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Spec.Label < out[j].Spec.Label })
+	return out, nil
+}
+
+// importKinds mengembalikan jenis data yang boleh diimpor actor (filter riwayat).
+func (s *Service) importKinds(a actor.Actor) []string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	var out []string
+	for k, imp := range s.importers {
+		if a.Has(imp.Spec().ImportPermission()) {
+			out = append(out, k)
+		}
+	}
+	slices.Sort(out)
+	return out
+}
+
+func (s *Service) exportKinds(a actor.Actor) []string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	var out []string
+	for k, exp := range s.exporters {
+		if a.Has(exp.Spec().ExportPermission()) {
+			out = append(out, k)
+		}
+	}
+	slices.Sort(out)
+	return out
+}
+
+// KindLabel mengembalikan label jenis data untuk tampilan; jenis yang tidak terdaftar memakai kind-nya.
+func (s *Service) KindLabel(kind string) string {
+	if imp, ok := s.importer(kind); ok {
+		return imp.Spec().Label
+	}
+	if exp, ok := s.exporter(kind); ok {
+		return exp.Spec().Label
+	}
+	return kind
+}
+
+func unknownKind() error {
+	return apperr.Validation(map[string]string{"kind": "Jenis data tidak dikenal"})
+}
+
+// requireImporter memeriksa jenis data dan permission `<kind>.import`.
+func (s *Service) requireImporter(ctx context.Context, kind string) (Importer, actor.Actor, error) {
+	imp, ok := s.importer(kind)
+	if !ok {
+		return nil, actor.Actor{}, unknownKind()
+	}
+	a, err := actor.Require(ctx, imp.Spec().ImportPermission())
+	return imp, a, err
+}
+
+func (s *Service) requireExporter(ctx context.Context, kind string) (Exporter, actor.Actor, error) {
+	exp, ok := s.exporter(kind)
+	if !ok {
+		return nil, actor.Actor{}, unknownKind()
+	}
+	a, err := actor.Require(ctx, exp.Spec().ExportPermission())
+	return exp, a, err
+}
+
+func (s *Service) notify(ctx context.Context, userID uuid.UUID, kind, title, body, link string) {
+	if s.Notifier == nil || userID == uuid.Nil {
+		return
+	}
+	err := s.Tx.WithTx(ctx, func(ctx context.Context) error {
+		return s.Notifier.Notify(ctx, []uuid.UUID{userID}, kind, title, body, link)
+	})
+	if err != nil && s.Log != nil {
+		s.Log.WarnContext(ctx, "dataexchange notify failed", "kind", kind, "error", err)
+	}
+}
+
+func (s *Service) now() time.Time { return s.Clock.Now() }
