-			continue
-		}
-		if r.ExpiredAt != nil && (o.ExpiresAt == nil || o.ExpiresAt.After(*r.ExpiredAt)) {
-			continue
-		}
-		id := o.ID
-		lines = append(lines, domain.Line{
