-// --- Reservasi --------------------------------------------------------------------------------
-
-// ReserveLine adalah satu baris reservasi stok available → reserved di lokasi yang sama.
-type ReserveLine struct {
-	SourceLineID *uuid.UUID
-	ProductID    uuid.UUID
-	LocationID   uuid.UUID
