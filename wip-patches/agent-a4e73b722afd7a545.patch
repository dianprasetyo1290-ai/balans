+	require.Error(t, err)
+
+	link := h.json(http.MethodGet, "/api/v1/import-jobs/"+id+"/error-file", nil, http.StatusOK)
+	errFile, err := excelize.OpenReader(bytes.NewReader(h.fetch(link["url"].(string))))
