+func supplierField(k string) string {
+	if strings.HasPrefix(k, "bankAccounts.") {
+		parts := strings.Split(k, ".")
+		if f := parts[len(parts)-1]; f == "bankName" || f == "accountName" || f == "accountNumber" {
+			return f
+		}
+		return "accountNumber"
+	}
+	if k == "bankAccounts" {
+		return "accountNumber"
+	}
+	return k
+}
