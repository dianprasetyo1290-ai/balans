diff --git a/backend/internal/platform/tabular/tabular.go b/backend/internal/platform/tabular/tabular.go
new file mode 100644
index 0000000..754736a
--- /dev/null
+++ b/backend/internal/platform/tabular/tabular.go
@@ -0,0 +1,267 @@
+// Package tabular adalah format baris tabel netral untuk impor/ekspor Excel (Technical Guideline 5.15). Modul
+// bisnis mendefinisikan kolom dan membaca/menulis baris dengan tipe di sini tanpa bergantung pada modul
+// dataexchange maupun library Excel; dataexchange yang membaca dan menulis file xlsx-nya.
+package tabular
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+)
+
+// Kind menentukan format sel di template dan petunjuk pengisian.
+type Kind string
+
+const (
+	KindText    Kind = "text"
+	KindInteger Kind = "integer"
+	KindDecimal Kind = "decimal"
+	KindDate    Kind = "date"
+	// KindChoice memakai daftar Options (dropdown di template).
+	KindChoice Kind = "choice"
+	// KindBool adalah pilihan Ya/Tidak.
+	KindBool Kind = "bool"
+)
+
+// Label Ya/Tidak untuk kolom KindBool.
+const (
+	Yes = "Ya"
+	No  = "Tidak"
+)
+
+// Option adalah satu pilihan kolom KindChoice: Value disimpan sistem, Label ditulis di Excel.
+type Option struct {
+	Value string
+	Label string
+}
+
+// Column adalah definisi satu kolom template. Key sama dengan nama field API (mis. `sku`) agar error validasi
+// modul (apperr.Validation) bisa dipetakan ke kolom.
+type Column struct {
+	Key    string
+	Header string
+	Kind   Kind
+	// Required: sel kosong ditolak sebelum baris diteruskan ke modul.
+	Required bool
+	// Identity: kolom kunci bisnis baris (mis. SKU); kombinasi nilainya harus unik di satu file.
+	Identity bool
+	// Sensitive: data pribadi (NPWP, nomor rekening) disamarkan di preview dan tidak disimpan di tabel impor.
+	Sensitive bool
+	Options   []Option
+	Example   string
+	// Note adalah aturan tambahan di sheet Petunjuk.
+	Note string
+}
+
+// OptionLabels mengembalikan label pilihan kolom (untuk dropdown); KindBool = Ya/Tidak.
+func (c Column) OptionLabels() []string {
+	if c.Kind == KindBool {
+		return []string{Yes, No}
+	}
+	out := make([]string, len(c.Options))
+	for i, o := range c.Options {
+		out[i] = o.Label
+	}
+	return out
+}
+
+// FormatHint menjelaskan format isian untuk sheet Petunjuk.
+func (c Column) FormatHint() string {
+	switch c.Kind {
+	case KindInteger:
+		return "Angka bulat tanpa titik ribuan"
+	case KindDecimal:
+		return "Angka; desimal memakai titik, tanpa titik ribuan"
+	case KindDate:
+		return "Tanggal YYYY-MM-DD"
+	case KindChoice, KindBool:
+		return "Pilih: " + strings.Join(c.OptionLabels(), ", ")
+	}
+	return "Teks"
+}
+
+// Row adalah satu baris data. Number adalah nomor baris di sheet (header = baris 1). Values berisi teks sel
+// yang sudah dirapikan per Key kolom; kolom kosong boleh tidak ada.
+type Row struct {
+	Number int
+	Values map[string]string
+}
+
+// NewRow membuat baris kosong.
+func NewRow(number int) Row { return Row{Number: number, Values: map[string]string{}} }
+
+// Get membaca nilai kolom.
+func (r Row) Get(key string) string { return r.Values[key] }
+
+// Set mengisi nilai kolom (dipakai exporter).
+func (r Row) Set(key, value string) Row {
+	r.Values[key] = value
+	return r
+}
+
+// Label mengembalikan label pilihan dari nilai sistem; nilai tak dikenal dikembalikan apa adanya.
+func Label(options []Option, value string) string {
+	for _, o := range options {
+		if o.Value == value {
+			return o.Label
+		}
+	}
+	return value
+}
+
+// BoolLabel menulis Ya/Tidak.
+func BoolLabel(b bool) string {
+	if b {
+		return Yes
+	}
+	return No
+}
+
+// FormatInt menulis angka bulat opsional.
+func FormatInt(v *int) string {
+	if v == nil {
+		return ""
+	}
+	return strconv.Itoa(*v)
+}
+
+// FormatDecimal menulis angka desimal opsional.
+func FormatDecimal(v *decimal.Decimal) string {
+	if v == nil {
+		return ""
+	}
+	return v.String()
+}
+
+// FormatDate menulis tanggal bisnis opsional.
+func FormatDate(v *clock.BusinessDate) string {
+	if v == nil || v.IsZero() {
+		return ""
+	}
+	return v.String()
+}
+
+// Parser membaca nilai bertipe dari baris dan mengumpulkan error per kolom.
+type Parser struct {
+	row    Row
+	fields map[string]string
+}
+
+// Parse membuat Parser untuk satu baris.
+func Parse(r Row) *Parser { return &Parser{row: r, fields: map[string]string{}} }
+
+// Fail mencatat error kolom (error pertama per kolom yang dipakai).
+func (p *Parser) Fail(key, msg string) {
+	if _, ok := p.fields[key]; !ok {
+		p.fields[key] = msg
+	}
+}
+
+// Err mengembalikan VALIDATION_FAILED berisi error per kolom, atau nil.
+func (p *Parser) Err() error {
+	if len(p.fields) == 0 {
+		return nil
+	}
+	return apperr.Validation(p.fields)
+}
+
+// Text membaca teks apa adanya (sudah dirapikan).
+func (p *Parser) Text(key string) string { return p.row.Get(key) }
+
+// OptionalText membaca teks; kosong = nil.
+func (p *Parser) OptionalText(key string) *string {
+	v := p.row.Get(key)
+	if v == "" {
+		return nil
+	}
+	return &v
+}
+
+// Bool membaca Ya/Tidak (juga menerima Y/N, true/false, 1/0); kosong = def.
+func (p *Parser) Bool(key string, def bool) bool {
+	switch strings.ToLower(p.row.Get(key)) {
+	case "":
+		return def
+	case "ya", "y", "true", "1":
+		return true
+	case "tidak", "t", "n", "false", "0":
+		return false
+	}
+	p.Fail(key, "Isi Ya atau Tidak")
+	return def
+}
+
+// Int membaca angka bulat; kosong = nil.
+func (p *Parser) Int(key string) *int {
+	v := p.row.Get(key)
+	if v == "" {
+		return nil
+	}
+	d, err := decimal.NewFromString(v)
+	if err != nil || !d.IsInteger() || d.Abs().GreaterThan(decimal.NewFromInt(1_000_000_000)) {
+		p.Fail(key, "Harus angka bulat")
+		return nil
+	}
+	n := int(d.IntPart())
+	return &n
+}
+
+// Decimal membaca angka desimal (titik sebagai pemisah desimal); kosong = nil.
+func (p *Parser) Decimal(key string) *decimal.Decimal {
+	v := p.row.Get(key)
+	if v == "" {
+		return nil
+	}
+	d, err := decimal.NewFromString(v)
+	if err != nil {
+		p.Fail(key, "Harus angka; desimal memakai titik tanpa titik ribuan")
+		return nil
+	}
+	return &d
+}
+
+// excelEpoch adalah tanggal 0 sistem tanggal Excel 1900 (dengan koreksi tahun kabisat 1900).
+var excelEpoch = time.Date(1899, 12, 30, 0, 0, 0, 0, time.UTC)
+
+// Date membaca tanggal YYYY-MM-DD atau nomor seri tanggal Excel; kosong = nil.
+func (p *Parser) Date(key string) *clock.BusinessDate {
+	v := p.row.Get(key)
+	if v == "" {
+		return nil
+	}
+	if d, err := clock.ParseBusinessDate(v); err == nil {
+		return &d
+	}
+	if serial, err := strconv.ParseFloat(v, 64); err == nil && serial > 0 && serial < 2_958_466 {
+		t := excelEpoch.AddDate(0, 0, int(serial))
+		d := clock.NewBusinessDate(t.Year(), t.Month(), t.Day())
+		return &d
+	}
+	p.Fail(key, "Format tanggal YYYY-MM-DD")
+	return nil
+}
+
+// Choice mencocokkan label (tanpa membedakan huruf besar/kecil) atau nilai sistem; kosong = "".
+func (p *Parser) Choice(key string, options []Option) string {
+	v := p.row.Get(key)
+	if v == "" {
+		return ""
+	}
+	for _, o := range options {
+		if strings.EqualFold(o.Label, v) || strings.EqualFold(o.Value, v) {
+			return o.Value
+		}
+	}
+	labels := make([]string, len(options))
+	for i, o := range options {
+		labels[i] = o.Label
+	}
+	p.Fail(key, fmt.Sprintf("Pilihan tidak dikenal. Gunakan: %s", strings.Join(labels, ", ")))
+	return ""
+}
diff --git a/backend/internal/platform/tabular/tabular_test.go b/backend/internal/platform/tabular/tabular_test.go
new file mode 100644
index 0000000..8ee0b08
--- /dev/null
+++ b/backend/internal/platform/tabular/tabular_test.go
@@ -0,0 +1,101 @@
+package tabular_test
+
+import (
+	"testing"
+
+	"github.com/shopspring/decimal"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/tabular"
+)
+
+var opts = []tabular.Option{{Value: "finished_good", Label: "Produk Jadi"}, {Value: "packaging", Label: "Packaging"}}
+
+func TestParser(t *testing.T) {
+	r := tabular.NewRow(2).Set("name", "Meal").Set("yes", "ya").Set("no", "Tidak").Set("badBool", "mungkin").
+		Set("int", "24").Set("intFloat", "24.0").Set("badInt", "2,5").Set("dec", "1.250").Set("badDec", "1.000,5").
+		Set("date", "2026-10-17").Set("serial", "46312").Set("badDate", "17/10/2026").
+		Set("choice", "produk jadi").Set("value", "packaging").Set("badChoice", "Lain")
+	p := tabular.Parse(r)
+	assert.Equal(t, "Meal", p.Text("name"))
+	assert.Nil(t, p.OptionalText("missing"))
+	assert.Equal(t, "Meal", *p.OptionalText("name"))
+	assert.True(t, p.Bool("yes", false))
+	assert.False(t, p.Bool("no", true))
+	assert.True(t, p.Bool("missing", true))
+	assert.False(t, p.Bool("badBool", false))
+	assert.Equal(t, 24, *p.Int("int"))
+	assert.Equal(t, 24, *p.Int("intFloat"))
+	assert.Nil(t, p.Int("missing"))
+	assert.Nil(t, p.Int("badInt"))
+	assert.True(t, decimal.RequireFromString("1.25").Equal(*p.Decimal("dec")))
+	assert.Nil(t, p.Decimal("missing"))
+	assert.Nil(t, p.Decimal("badDec"))
+	assert.Equal(t, clock.NewBusinessDate(2026, 10, 17), *p.Date("date"))
+	assert.Equal(t, clock.NewBusinessDate(2026, 10, 17), *p.Date("serial"), "nomor seri tanggal Excel")
+	assert.Nil(t, p.Date("missing"))
+	assert.Nil(t, p.Date("badDate"))
+	assert.Equal(t, "finished_good", p.Choice("choice", opts))
+	assert.Equal(t, "packaging", p.Choice("value", opts))
+	assert.Empty(t, p.Choice("missing", opts))
+	assert.Empty(t, p.Choice("badChoice", opts))
+	p.Fail("badChoice", "pesan kedua tidak menimpa")
+
+	err := p.Err()
+	require.Error(t, err)
+	fields := apperr.As(err).Fields
+	assert.Equal(t, []string{"badBool", "badChoice", "badDate", "badDec", "badInt"}, keys(fields))
+	assert.Contains(t, fields["badChoice"], "Produk Jadi, Packaging")
+
+	assert.NoError(t, tabular.Parse(tabular.NewRow(3)).Err())
+}
+
+func keys(m map[string]string) []string {
+	out := make([]string, 0, len(m))
+	for _, k := range []string{"badBool", "badChoice", "badDate", "badDec", "badInt"} {
+		if _, ok := m[k]; ok {
+			out = append(out, k)
+		}
+	}
+	if len(out) != len(m) {
+		return nil
+	}
+	return out
+}
+
+func TestFormatting(t *testing.T) {
+	n := 5
+	d := decimal.RequireFromString("2.5")
+	date := clock.NewBusinessDate(2026, 1, 2)
+	assert.Equal(t, "5", tabular.FormatInt(&n))
+	assert.Empty(t, tabular.FormatInt(nil))
+	assert.Equal(t, "2.5", tabular.FormatDecimal(&d))
+	assert.Empty(t, tabular.FormatDecimal(nil))
+	assert.Equal(t, "2026-01-02", tabular.FormatDate(&date))
+	assert.Empty(t, tabular.FormatDate(nil))
+	assert.Equal(t, tabular.Yes, tabular.BoolLabel(true))
+	assert.Equal(t, tabular.No, tabular.BoolLabel(false))
+	assert.Equal(t, "Packaging", tabular.Label(opts, "packaging"))
+	assert.Equal(t, "lain", tabular.Label(opts, "lain"))
+}
+
+func TestColumnHints(t *testing.T) {
+	tests := []struct {
+		col  tabular.Column
+		want string
+	}{
+		{tabular.Column{Kind: tabular.KindText}, "Teks"},
+		{tabular.Column{Kind: tabular.KindInteger}, "Angka bulat tanpa titik ribuan"},
+		{tabular.Column{Kind: tabular.KindDecimal}, "Angka; desimal memakai titik, tanpa titik ribuan"},
+		{tabular.Column{Kind: tabular.KindDate}, "Tanggal YYYY-MM-DD"},
+		{tabular.Column{Kind: tabular.KindBool}, "Pilih: Ya, Tidak"},
+		{tabular.Column{Kind: tabular.KindChoice, Options: opts}, "Pilih: Produk Jadi, Packaging"},
+	}
+	for _, tt := range tests {
+		assert.Equal(t, tt.want, tt.col.FormatHint())
+	}
+	assert.Empty(t, tabular.Column{Kind: tabular.KindText}.OptionLabels())
+}
