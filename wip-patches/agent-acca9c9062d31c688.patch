+-+  vending: "Vending",
+-+  reseller: "Level Reseller (Fase 2)",
+-+}
+-+
+-+export const CREATABLE_PRICE_LIST_TYPES: Partial<Record<PriceListType, string>> =
+-+  {
+-+    channel: "Channel / sub-channel",
+-+    partner: "Mitra (MT / konsinyasi)",
+-+    employee: "Karyawan",
+-+    vending: "Vending",
