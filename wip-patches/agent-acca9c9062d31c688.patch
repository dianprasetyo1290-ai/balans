+-+	assert.Equal(t, &ref, e.ReferenceID)
+-+	assert.Equal(t, "Karyawan", domain.TypeEmployee.Label())
+-+
+-+	e.ID = ref
+-+	err = e.Update(domain.PriceListInput{Name: "Karyawan", Basis: domain.BasisPercent, ReferenceID: &ref, IsActive: true})
