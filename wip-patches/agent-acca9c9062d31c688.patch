+      {open ? (
+        <ReasonForm
+          title={title}
+          description={description}
+          confirmLabel={confirmLabel}
+          loading={loading}
+          error={error}
+          onCancel={() => onOpenChange(false)}
+          onConfirm={onConfirm}
+        />
+      ) : null}
+    </Dialog>
+  )
+}
+
+function ReasonForm({
+  title,
+  description,
+  confirmLabel,
+  loading,
+  error,
+  onCancel,
+  onConfirm,
+}: {
+  title: string
+  description: string
+  confirmLabel: string
+  loading: boolean
+  error?: string
+  onCancel: () => void
+  onConfirm: (reason: string) => void
+}) {
+  const [reason, setReason] = useState("")
+  const [local, setLocal] = useState<string>()
+  const message = local ?? error
+  return (
+    <DialogContent className="sm:max-w-md">
+      <DialogHeader>
+        <DialogTitle>{title}</DialogTitle>
+        <DialogDescription>{description}</DialogDescription>
+      </DialogHeader>
+      <form
+        noValidate
+        className="flex flex-col gap-4"
+        onSubmit={(e) => {
+          e.preventDefault()
+          if (!reason.trim()) {
+            setLocal("Alasan wajib diisi")
+            return
+          }
+          setLocal(undefined)
+          onConfirm(reason.trim())
+        }}
+      >
+        <Field data-invalid={!!message}>
+          <FieldLabel htmlFor="reason">Alasan</FieldLabel>
+          <Textarea
+            id="reason"
+            value={reason}
+            maxLength={400}
+            onChange={(e) => setReason(e.target.value)}
+            aria-invalid={!!message}
+          />
+          <FieldError errors={fieldErrors(message)} />
+        </Field>
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={onCancel}>
+            Kembali
+          </Button>
+          <LoadingButton
+            type="submit"
+            variant="destructive"
+            loading={loading}
+            loadingText="Memproses…"
+          >
+            {confirmLabel}
+          </LoadingButton>
+        </DialogFooter>
+      </form>
+    </DialogContent>
+  )
+}
+
+const LOCAL_STATUS: Record<string, { label: string; className: string }> = {
+  unmatched: { label: "Belum Cocok", className: "bg-muted text-muted-foreground" },
+  suggested: { label: "Ada Usulan", className: "bg-sky-500/10 text-sky-700 dark:text-sky-300" },
+  matched: { label: "Cocok", className: "bg-emerald-500/15 text-emerald-800 dark:text-emerald-300" },
+  recorded: { label: "Belum Disetor", className: "bg-amber-500/15 text-amber-800 dark:text-amber-300" },
+  deposited: { label: "Disetor", className: "bg-emerald-500/15 text-emerald-800 dark:text-emerald-300" },
+}
+
+/** Badge status khusus rekonsiliasi bank dan bukti potong; status dokumen umum memakai StatusBadge. */
+export function FinanceStatusBadge({ status }: { status: string }) {
+  const spec = LOCAL_STATUS[status]
+  if (!spec) {
+    return <StatusBadge status={status} />
+  }
+  return (
+    <Badge variant="outline" className={`border-transparent ${spec.className}`} data-status={status}>
+      {spec.label}
+    </Badge>
+  )
+}
+
+/** Tahun pilihan filter pajak (tahun berjalan dan 3 tahun sebelumnya). */
+export function yearOptions(current: number): SelectOption[] {
+  return [0, 1, 2, 3].map((d) => ({ value: String(current - d), label: String(current - d) }))
+}
