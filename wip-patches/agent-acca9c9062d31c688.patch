-func amountOn(lines []journalLine, account string) (debit, credit decimal.Decimal) {
-	debit, credit = decimal.Zero, decimal.Zero
-	for _, l := range lines {
-		if l.account == account {
-			debit, credit = debit.Add(l.debit), credit.Add(l.credit)
-		}
-	}
-	return debit, credit
-}
