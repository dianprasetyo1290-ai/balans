+-+// Deps adalah dependensi modul.
+-+type Deps struct {
+-+	Pool      *pgxpool.Pool
+-+	Tx        *db.TxManager
+-+	Clock     clock.Clock
+-+	Log       *slog.Logger
+-+	Responder *httpx.Responder
