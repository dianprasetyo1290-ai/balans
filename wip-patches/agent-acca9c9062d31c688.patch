++	}
++	for k, i := range idx {
++		l := &d.Lines[i]
++		l.CostAmount = res.Lines[k].CostAmount
++		if l.Disposition == domain.DispositionRestock {
++			amounts.Restock = amounts.Restock.Add(l.CostAmount)
++		} else {
++			amounts.Reprocess = amounts.Reprocess.Add(l.CostAmount)
++		}
++	}
++	return amounts, nil
++}
