+func day(d int) clock.BusinessDate { return clock.NewBusinessDate(2026, time.October, d) }
+
+func TestParseStatementRowsDebitCredit(t *testing.T) {
+	rows := [][]string{
+		{"Laporan Mutasi Rekening"},
+		{"No. Rekening", "1234567890"},
+		{},
+		{"Tanggal", "Keterangan", "No. Referensi", "Mutasi Debet", "Mutasi Kredit", "Saldo"},
+		{"", "SALDO AWAL", "", "", "", "10.000.000,00"},
+		{"01/10/2026", "TRSF E-BANKING CR INV/2026/10/00031", "FT26274001", "", "1.500.000,00", "11.500.000,00"},
+		{"02/10/2026", "BIAYA ADM", "", "15.000,00", "", "11.485.000,00"},
+		{"3 Okt 2026", "TRF KE VENDOR", "FT26276002", "(2.000.000)", "", ""},
+		{"2026-10-04", "BUNGA", "", "", "1,234.56", ""},
+		{"45934", "SERI EXCEL", "", "", "100", ""},
+		{"05/10/2026", "NOL", "", "", "0", ""},
+		{"Total", "", "", "2.015.000,00", "1.501.334,56", ""},
+	}
+	got, err := domain.ParseStatementRows(rows)
+	require.NoError(t, err)
+	require.Len(t, got.Rows, 5)
+	assert.Equal(t, 3, got.Skipped)
+
+	assert.Equal(t, "2026-10-01", got.Rows[0].Date.String())
+	assert.Equal(t, "1500000.00", got.Rows[0].Amount.String())
+	assert.Equal(t, "FT26274001", got.Rows[0].Reference)
+	require.NotNil(t, got.Rows[0].Balance)
+	assert.Equal(t, "11500000.00", got.Rows[0].Balance.String())
+	assert.Equal(t, 6, got.Rows[0].Row)
+
+	assert.Equal(t, "-15000.00", got.Rows[1].Amount.String())
+	assert.Equal(t, "2026-10-03", got.Rows[2].Date.String())
+	assert.Equal(t, "-2000000.00", got.Rows[2].Amount.String(), "debit dalam kurung tetap keluar")
+	assert.Equal(t, "1234.56", got.Rows[3].Amount.String())
+	assert.Equal(t, "2025-10-04", got.Rows[4].Date.String(), "seri tanggal Excel")
+
+	sum := domain.NewStatementSummary(got.Rows)
+	assert.Equal(t, "2025-10-04", sum.PeriodFrom.String())
+	assert.Equal(t, "2026-10-04", sum.PeriodTo.String())
+	assert.Equal(t, 5, sum.LineCount)
+	assert.Equal(t, "1501334.56", sum.TotalIn.String())
+	assert.Equal(t, "2015000.00", sum.TotalOut.String())
+}
+
+func TestParseStatementRowsAmountWithIndicator(t *testing.T) {
+	rows := [][]string{
+		{"Date", "Description", "Amount", "DB/CR", "Balance"},
+		{"19/10/2026", "TRANSFER IN", "Rp 2.500.000", "CR", "5,000,000.00"},
+		{"19/10/2026", "TRANSFER OUT", "750,000.00", "DB", ""},
+		{"20/10/2026", "NO INDICATOR", "-125.000", "", ""},
+		{"21/10/2026", "SUFFIX", "1,000.00 CR", "", ""},
+		{"22/10/2026", "SUFFIX NOSPACE", "300.00DB", "", ""},
+		{"23/10/2026", "PLUS", "+5000", "K", ""},
+	}
+	got, err := domain.ParseStatementRows(rows)
+	require.NoError(t, err)
+	require.Len(t, got.Rows, 6)
+	want := []string{"2500000.00", "-750000.00", "-125000.00", "1000.00", "-300.00", "5000.00"}
+	for i, w := range want {
+		assert.Equal(t, w, got.Rows[i].Amount.String(), got.Rows[i].Description)
+	}
+	assert.Empty(t, got.Rows[0].Reference)
+}
+
+func TestParseStatementRowsErrors(t *testing.T) {
+	_, err := domain.ParseStatementRows([][]string{{"a", "b"}, {"1", "2"}})
+	assert.Contains(t, fieldsOf(t, err), "fileId")
+
+	_, err = domain.ParseStatementRows([][]string{{"Tanggal", "Debit", "Kredit"}, {"01/10/2026", "abc", ""}})
+	var ae *apperr.Error
+	require.ErrorAs(t, err, &ae)
+	assert.Contains(t, ae.Fields["fileId"], "Baris 2")
+
+	_, err = domain.ParseStatementRows([][]string{{"Tanggal", "Debit", "Kredit"}, {"01/10/2026", "", "1.234,567"}})
+	assert.Error(t, err)
+
+	_, err = domain.ParseStatementRows([][]string{{"Tanggal", "Debit", "Kredit"}, {"bukan tanggal", "1", ""}})
+	assert.Contains(t, fieldsOf(t, err), "fileId", "tanpa baris transaksi")
+
+	_, err = domain.ParseStatementRows([][]string{{"Tanggal", "Nominal"}, {"01/10/2026", "Rp"}})
+	assert.Error(t, err)
+
+	big := [][]string{{"Tanggal", "Nominal"}}
+	for i := 0; i <= domain.MaxStatementLines; i++ {
+		big = append(big, []string{"01/10/2026", "1"})
+	}
+	_, err = domain.ParseStatementRows(big)
+	assert.Error(t, err)
+
+	// Tanggal di luar 2000–2099 dan seri Excel di luar rentang dilewati.
+	got, err := domain.ParseStatementRows([][]string{{"Tanggal", "Nominal"}, {"01/10/1999", "1"}, {"12", "1"}, {"'01/10/2026", "2"}})
+	require.NoError(t, err)
+	assert.Len(t, got.Rows, 1)
+	assert.Equal(t, 2, got.Skipped)
+}
+
+func stLine(n, d int, amount int64, ref, desc string) domain.StatementLine {
+	return domain.StatementLine{
+		ID: uuid.New(), LineNo: n, TransactionDate: day(d), Amount: rp(amount), Reference: ref, Description: desc,
+		Status: domain.LineUnmatched,
+	}
+}
+
+func jCand(d int, amount int64, refs ...string) domain.MatchCandidate {
+	return domain.MatchCandidate{
+		Kind: domain.MatchJournalLine, JournalLineID: uuid.New(), JournalEntryID: uuid.New(), Date: day(d), Amount: rp(amount),
+		References: refs, Label: "JV",
+	}
+}
+
+func dCand(d int, amount int64, refs ...string) domain.MatchCandidate {
+	return domain.MatchCandidate{
+		Kind: domain.MatchDocument, Source: "sales.invoice", DocumentID: uuid.New(), Date: day(d), Amount: rp(amount),
+		References: refs, Label: "INV",
+	}
+}
+
+func TestSuggestMatches(t *testing.T) {
+	byRef := stLine(1, 5, 1_500_000, "", "TRSF CR INV/2026/10/00031 PT ABC")
+	byRefExact := stLine(2, 6, -250_000, "BYR/2026/10/00007", "")
+	byAmount := stLine(3, 7, -15_000, "", "BIAYA ADM")
+	tie := stLine(4, 8, 99_000, "", "")
+	none := stLine(5, 9, 77_000, "", "")
+	preferJournal := stLine(6, 10, 500_000, "", "")
+
+	invoice := dCand(1, 1_500_000, "INV/2026/10/00031")
+	otherSame := jCand(5, 1_500_000) // nominal sama tapi tanpa referensi: kalah dari referensi
+	payment := jCand(2, -250_000, "BYR/2026/10/00007")
+	fee := jCand(8, -15_000) // selisih 1 hari
+	feeFar := jCand(20, -15_000)
+	tieA, tieB := jCand(7, 99_000), jCand(9, 99_000)
+	docNear := dCand(10, 500_000)
+	jNear := jCand(10, 500_000)
+	shortRef := dCand(25, 77_000, "AB") // referensi pendek tidak dicari di keterangan
+
+	got := domain.SuggestMatches(
+		[]domain.StatementLine{none, tie, byAmount, byRefExact, byRef, preferJournal},
+		[]domain.MatchCandidate{otherSame, invoice, payment, feeFar, fee, tieA, tieB, docNear, jNear, shortRef},
+		domain.DefaultMatchToleranceDays,
+	)
+	byLine := map[uuid.UUID]domain.Suggestion{}
+	for _, s := range got {
+		byLine[s.LineID] = s
+	}
+	require.Contains(t, byLine, byRef.ID)
+	assert.Equal(t, domain.RuleReference, byLine[byRef.ID].Rule)
+	assert.Equal(t, invoice.DocumentID, byLine[byRef.ID].Candidate.DocumentID)
+
+	require.Contains(t, byLine, byRefExact.ID)
+	assert.Equal(t, domain.RuleReference, byLine[byRefExact.ID].Rule)
+	assert.Equal(t, payment.JournalLineID, byLine[byRefExact.ID].Candidate.JournalLineID)
+
+	require.Contains(t, byLine, byAmount.ID)
+	assert.Equal(t, domain.RuleAmountDate, byLine[byAmount.ID].Rule)
+	assert.Equal(t, fee.JournalLineID, byLine[byAmount.ID].Candidate.JournalLineID)
+
+	assert.NotContains(t, byLine, tie.ID, "dua kandidat sama kuat → manual")
+	assert.NotContains(t, byLine, none.ID)
+
+	require.Contains(t, byLine, preferJournal.ID)
+	assert.Equal(t, domain.MatchJournalLine, byLine[preferJournal.ID].Candidate.Kind)
+}
+
+func TestSuggestMatchesUsesCandidateOnce(t *testing.T) {
+	a, b := stLine(1, 5, 100, "", ""), stLine(2, 5, 100, "", "")
+	c := jCand(5, 100)
+	got := domain.SuggestMatches([]domain.StatementLine{a, b}, []domain.MatchCandidate{c}, 3)
+	require.Len(t, got, 1)
+	assert.Equal(t, a.ID, got[0].LineID, "baris lebih awal (nomor baris) didahulukan")
+}
+
+func TestStatementLineTransitions(t *testing.T) {
+	l := stLine(1, 5, 100, "", "")
+	c := jCand(5, 100)
+	require.NoError(t, l.Suggest(c, domain.RuleAmountDate))
+	assert.Equal(t, domain.LineSuggested, l.Status)
+	assert.Equal(t, c.JournalLineID, *l.JournalLineID)
+
+	l.ClearSuggestion()
+	assert.Equal(t, domain.LineUnmatched, l.Status)
+	assert.Nil(t, l.JournalLineID)
+	l.ClearSuggestion() // tidak berubah bila tidak ada usulan
+
+	d := dCand(5, 100)
+	require.NoError(t, l.Suggest(d, domain.RuleReference))
+	assert.Equal(t, d.Source, l.CandidateSource)
+	assert.Equal(t, d.DocumentID, *l.CandidateDocID)
+
+	jl, je, pay := uuid.New(), uuid.New(), uuid.New()
+	require.NoError(t, l.Confirm(domain.MatchDocument, domain.RuleReference, jl, je, &pay, "INV · BYR", time.Now(), uuid.New()))
+	assert.Equal(t, domain.LineMatched, l.Status)
+	assert.Equal(t, "INV · BYR", l.CandidateLabel)
+	assert.True(t, apperr.HasCode(l.Suggest(c, domain.RuleManual), apperr.CodeInvalidStateTransition))
+	assert.Error(t, l.Confirm(domain.MatchJournalLine, domain.RuleManual, jl, je, nil, "", time.Now(), uuid.New()))
+
+	require.NoError(t, l.Unmatch())
+	assert.Equal(t, domain.LineUnmatched, l.Status)
+	assert.Nil(t, l.PaymentID)
+	assert.Error(t, l.Unmatch())
+
+	require.NoError(t, l.Confirm(domain.MatchNewEntry, domain.RuleManual, jl, je, &pay, "", time.Now(), uuid.New()))
+	assert.Empty(t, l.CandidateSource)
+}
diff --git a/backend/internal/accounting/domain/tax.go b/backend/internal/accounting/domain/tax.go
new file mode 100644
index 0000000..74bd771
--- /dev/null
+++ b/backend/internal/accounting/domain/tax.go
@@ -0,0 +1,358 @@
+package domain
+
+import (
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+	"balans/internal/tax"
+)
+
+// --- PPh potong, bukti potong, penyetoran, PPh Final (S-406, S-407) ---------------------------
+
+// Rule dan nilai bernama jurnal pajak (posting_rule_accounts A-29, A-30).
+const (
+	RuleTaxDeposit    = "A-29"
+	RuleFinalTax      = "A-30"
+	AmountTax         = "tax_value"
+	SourceTaxDeposit  = "tax_deposit"
+	SourceFinalTaxRun = "final_tax_run"
+)
+
+// TaxPayableCode mengembalikan akun utang pajak per jenis pajak (2301 – 2304).
+func TaxPayableCode(t tax.Type) string {
+	if t == tax.FinalUMKM {
+		return FinalTaxPayableCode
+	}
+	return WithholdingAccountCode(WithholdingType(t))
+}
+
+// TaxTypeOf memetakan jenis PPh jenis biaya/pemasok ke jenis pajak kalkulator ("" untuk none).
+func TaxTypeOf(w WithholdingType) tax.Type {
+	switch w {
+	case WithholdingPPh21:
+		return tax.PPh21
+	case WithholdingPPh23:
+		return tax.PPh23
+	case WithholdingPPh42:
+		return tax.PPh42
+	}
+	return ""
+}
+
+// RateVersion adalah satu baris withholding_tax_rates.
+type RateVersion struct {
+	ID uuid.UUID
+	tax.Rate
+	IsDefault bool
+	Note      string
+	UpdatedAt time.Time
+	Version   int
+}
+
+// NewRateVersion memvalidasi versi tarif baru.
+func NewRateVersion(r tax.Rate, isDefault bool, note string) (RateVersion, error) {
+	r.ObjectCode, r.Name = strings.TrimSpace(r.ObjectCode), strings.TrimSpace(r.Name)
+	if err := r.Validate(); err != nil {
+		return RateVersion{}, err
+	}
+	note = strings.TrimSpace(note)
+	if len(note) > 300 {
+		return RateVersion{}, apperr.Validation(map[string]string{"note": "Catatan maks. 300 karakter"})
+	}
+	return RateVersion{Rate: r, IsDefault: isDefault, Note: note}, nil
+}
+
+// SupersededBy mengembalikan tanggal akhir versi lama saat versi baru berlaku mulai from (sehari sebelumnya),
+// atau error bila versi baru tidak setelah versi lama dimulai.
+func (v RateVersion) SupersededBy(from clock.BusinessDate) (clock.BusinessDate, error) {
+	if !from.After(v.ValidFrom) {
+		return clock.BusinessDate{}, apperr.Validation(map[string]string{
+			"validFrom": "Tanggal berlaku harus setelah " + v.ValidFrom.String() + " (versi tarif sebelumnya)",
+		})
+	}
+	return from.AddDays(-1), nil
+}
+
+// DefaultObject memilih kode objek default jenis pajak yang berlaku pada tanggal tertentu.
+func DefaultObject(rates []RateVersion, t tax.Type, on clock.BusinessDate) (string, bool) {
+	fallback := ""
+	for _, r := range rates {
+		if r.Type != t || !r.EffectiveOn(on) {
+			continue
+		}
+		if r.IsDefault {
+			return r.ObjectCode, true
+		}
+		if fallback == "" {
+			fallback = r.ObjectCode
+		}
+	}
+	return fallback, fallback != ""
+}
+
+// FindRate mencari versi tarif yang berlaku beserta ID-nya (tax.SelectRate).
+func FindRate(rates []RateVersion, t tax.Type, objectCode string, on clock.BusinessDate) (RateVersion, error) {
+	plain := make([]tax.Rate, len(rates))
+	for i, r := range rates {
+		plain[i] = r.Rate
+	}
+	sel, err := tax.SelectRate(plain, t, objectCode, on)
+	if err != nil {
+		return RateVersion{}, err
+	}
+	for _, r := range rates {
+		if r.Type == sel.Type && r.ObjectCode == sel.ObjectCode && r.ValidFrom == sel.ValidFrom {
+			return r, nil
+		}
+	}
+	return RateVersion{}, apperr.New(apperr.CodeNotFound)
+}
+
+// WithholdingStatus adalah status data bukti potong.
+type WithholdingStatus string
+
+const (
+	WithholdingRecorded  WithholdingStatus = "recorded"
+	WithholdingDeposited WithholdingStatus = "deposited"
+	WithholdingCancelled WithholdingStatus = "cancelled"
+)
+
+// WithholdingRecord adalah data bukti potong satu dokumen sumber per jenis + objek pajak.
+type WithholdingRecord struct {
+	ID            uuid.UUID
+	SourceType    string
+	SourceID      uuid.UUID
+	SourceLabel   string
+	BusinessDate  clock.BusinessDate
+	Period        tax.Period
+	TaxType       tax.Type
+	ObjectCode    string
+	ObjectName    string
+	RateID        uuid.UUID
+	TaxpayerType  string
+	TaxpayerID    *uuid.UUID
+	TaxpayerName  string
+	TaxpayerTaxID string
+	HasTaxID      bool
+	Gross         money.Amount
+	TaxableBase   money.Amount
+	RatePercent   decimal.Decimal
+	TaxAmount     money.Amount
+	Status        WithholdingStatus
+	DepositID     *uuid.UUID
+	DepositNumber string
+	SlipNumber    string
+	CreatedAt     time.Time
+	UpdatedAt     time.Time
+	Version       int
+}
+
+// WithholdingSubject adalah dokumen dan penerima penghasilan yang dipotong.
+type WithholdingSubject struct {
+	SourceType    string
+	SourceID      uuid.UUID
+	SourceLabel   string
+	BusinessDate  clock.BusinessDate
+	TaxpayerType  string
+	TaxpayerID    *uuid.UUID
+	TaxpayerName  string
+	TaxpayerTaxID string
+}
+
+// Validate memeriksa dokumen dan penerima.
+func (s WithholdingSubject) Validate() error {
+	fields := map[string]string{}
+	if strings.TrimSpace(s.SourceType) == "" || s.SourceID == uuid.Nil {
+		fields["sourceId"] = "Dokumen sumber wajib diisi"
+	}
+	if s.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal dokumen wajib diisi"
+	}
+	if strings.TrimSpace(s.TaxpayerName) == "" {
+		fields["taxpayerName"] = "Nama penerima penghasilan wajib diisi"
+	}
+	if id := digitsOnly(s.TaxpayerTaxID); s.TaxpayerTaxID != "" && len(id) != 15 && len(id) != 16 {
+		fields["taxpayerTaxId"] = "NPWP/NIK 15 atau 16 angka"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+// NewWithholdingRecord menyusun data bukti potong dari hasil kalkulator.
+func NewWithholdingRecord(s WithholdingSubject, rate RateVersion, w tax.Withholding) WithholdingRecord {
+	taxID := digitsOnly(s.TaxpayerTaxID)
+	return WithholdingRecord{
+		SourceType: s.SourceType, SourceID: s.SourceID, SourceLabel: s.SourceLabel, BusinessDate: s.BusinessDate,
+		Period: tax.PeriodOf(s.BusinessDate), TaxType: w.Type, ObjectCode: w.ObjectCode, ObjectName: rate.Name,
+		RateID: rate.ID, TaxpayerType: s.TaxpayerType, TaxpayerID: s.TaxpayerID, TaxpayerName: strings.TrimSpace(s.TaxpayerName),
+		TaxpayerTaxID: taxID, HasTaxID: taxID != "", Gross: w.Gross, TaxableBase: w.TaxableBase,
+		RatePercent: w.RatePercent, TaxAmount: w.Amount, Status: WithholdingRecorded,
+	}
+}
+
+// Cancel membatalkan data bukti potong yang belum disetor (dokumen sumber dibatalkan).
+func (w *WithholdingRecord) Cancel() error {
+	if w.Status == WithholdingDeposited {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+			"PPh "+w.SourceLabel+" sudah disetor; batalkan lewat pembetulan SPT, bukan dari dokumen.")
+	}
+	w.Status = WithholdingCancelled
+	return nil
+}
+
+// SetSlipNumber mencatat nomor bukti potong dari Coretax.
+func (w *WithholdingRecord) SetSlipNumber(n string) error {
+	n = strings.TrimSpace(n)
+	if len(n) > 50 {
+		return apperr.Validation(map[string]string{"slipNumber": "Nomor bukti potong maks. 50 karakter"})
+	}
+	if w.Status == WithholdingCancelled {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Bukti potong sudah dibatalkan.")
+	}
+	w.SlipNumber = n
+	return nil
+}
+
+// TaxDeposit adalah penyetoran pajak satu jenis satu masa (A-29).
+type TaxDeposit struct {
+	ID              uuid.UUID
+	Number          string
+	TaxType         tax.Type
+	Period          tax.Period
+	BankAccountID   uuid.UUID
+	BankAccountName string
+	DepositDate     clock.BusinessDate
+	Amount          money.Amount
+	BillingCode     string
+	NTPN            string
+	JournalEntryID  uuid.UUID
+	JournalNumber   string
+	CreatedAt       time.Time
+	CreatedBy       uuid.UUID
+}
+
+// TaxDepositInput adalah isian Setor Pajak.
+type TaxDepositInput struct {
+	TaxType       tax.Type
+	Period        tax.Period
+	BankAccountID uuid.UUID
+	DepositDate   clock.BusinessDate
+	BillingCode   string
+	NTPN          string
+}
+
+// Validate memeriksa isian penyetoran. Masa pajak tidak boleh setelah bulan tanggal setor.
+func (in TaxDepositInput) Validate() error {
+	fields := map[string]string{}
+	if !in.TaxType.Valid() {
+		fields["taxType"] = "Jenis pajak tidak dikenal"
+	}
+	if err := in.Period.Validate(); err != nil {
+		fields["period"] = "Masa pajak tidak valid"
+	}
+	if in.BankAccountID == uuid.Nil {
+		fields["bankAccountId"] = "Rekening wajib dipilih"
+	}
+	if in.DepositDate.IsZero() {
+		fields["depositDate"] = "Tanggal setor wajib diisi"
+	} else if tax.PeriodOf(in.DepositDate).Before(in.Period) {
+		fields["depositDate"] = "Tanggal setor tidak boleh sebelum masa pajak"
+	}
+	if len(strings.TrimSpace(in.BillingCode)) > 30 {
+		fields["billingCode"] = "Kode billing maks. 30 karakter"
+	}
+	if len(strings.TrimSpace(in.NTPN)) > 30 {
+		fields["ntpn"] = "NTPN maks. 30 karakter"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+// FinalTaxSetting adalah status PPh Final UMKM yang berlaku mulai ValidFrom.
+type FinalTaxSetting struct {
+	ID              uuid.UUID
+	ValidFrom       clock.BusinessDate
+	IsEnabled       bool
+	OpeningYear     *int
+	OpeningTurnover money.Amount
+	Note            string
+	CreatedAt       time.Time
+	CreatedBy       uuid.UUID
+}
+
+// Validate memeriksa isian status PPh Final.
+func (s FinalTaxSetting) Validate() error {
+	fields := map[string]string{}
+	if s.ValidFrom.IsZero() {
+		fields["validFrom"] = "Tanggal berlaku wajib diisi"
+	}
+	if s.OpeningTurnover.IsNegative() || !s.OpeningTurnover.Equal(s.OpeningTurnover.Round()) {
+		fields["openingTurnover"] = "Omzet awal tidak boleh negatif (maks. 2 desimal)"
+	}
+	if s.OpeningYear != nil && (*s.OpeningYear < 2000 || *s.OpeningYear > 9999) {
+		fields["openingYear"] = "Tahun omzet awal tidak valid"
+	}
+	if len(strings.TrimSpace(s.Note)) > 300 {
+		fields["note"] = "Catatan maks. 300 karakter"
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+// OpeningFor mengembalikan omzet awal (cut-over) bila berlaku untuk tahun tersebut.
+func (s FinalTaxSetting) OpeningFor(year int) money.Amount {
+	if s.OpeningYear != nil && *s.OpeningYear == year {
+		return s.OpeningTurnover
+	}
+	return money.Zero
+}
+
+// FinalTaxRun adalah perhitungan PPh Final UMKM satu masa.
+type FinalTaxRun struct {
+	ID             uuid.UUID
+	Period         tax.Period
+	GrossRevenue   money.Amount
+	RateID         uuid.UUID
+	RatePercent    decimal.Decimal
+	TaxAmount      money.Amount
+	JournalEntryID *uuid.UUID
+	JournalNumber  string
+	DepositID      *uuid.UUID
+	CreatedAt      time.Time
+	CreatedBy      uuid.UUID
+}
+
+// FinalTaxMonth adalah ringkasan satu bulan di pemantauan PPh Final.
+type FinalTaxMonth struct {
+	Period       tax.Period
+	GrossRevenue money.Amount
+	Cumulative   money.Amount
+	Run          *FinalTaxRun
+}
+
+// CheckFinalTaxRun memeriksa masa yang akan dihitung: PPh Final aktif dan masa sudah berakhir.
+func CheckFinalTaxRun(setting *FinalTaxSetting, p tax.Period, today clock.BusinessDate) error {
+	if err := p.Validate(); err != nil {
+		return err
+	}
+	if setting == nil || !setting.IsEnabled {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition,
+			"PPh Final UMKM tidak aktif untuk masa "+p.String()+"; aktifkan di pengaturan PPh Final.")
+	}
+	if !p.Before(tax.PeriodOf(today)) {
+		return apperr.Validation(map[string]string{"period": "Masa " + p.String() + " belum berakhir"})
+	}
+	return nil
+}
diff --git a/backend/internal/accounting/domain/tax_test.go b/backend/internal/accounting/domain/tax_test.go
new file mode 100644
index 0000000..018e3f3
--- /dev/null
+++ b/backend/internal/accounting/domain/tax_test.go
@@ -0,0 +1,146 @@
+package domain_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"balans/internal/accounting/domain"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+	"balans/internal/tax"
+)
+
+var jan1 = clock.NewBusinessDate(2026, time.January, 1)
+
+func rateVersion(t tax.Type, object string, rate string, from clock.BusinessDate, isDefault bool) domain.RateVersion {
+	return domain.RateVersion{
+		ID: uuid.New(), IsDefault: isDefault,
+		Rate: tax.Rate{Type: t, ObjectCode: object, Name: object, RatePercent: decimal.RequireFromString(rate), ValidFrom: from},
+	}
+}
+
+func TestTaxMapping(t *testing.T) {
+	assert.Equal(t, "2301", domain.TaxPayableCode(tax.PPh21))
+	assert.Equal(t, "2302", domain.TaxPayableCode(tax.PPh23))
+	assert.Equal(t, "2303", domain.TaxPayableCode(tax.PPh42))
+	assert.Equal(t, "2304", domain.TaxPayableCode(tax.FinalUMKM))
+	assert.Equal(t, tax.PPh21, domain.TaxTypeOf(domain.WithholdingPPh21))
+	assert.Equal(t, tax.PPh23, domain.TaxTypeOf(domain.WithholdingPPh23))
+	assert.Equal(t, tax.PPh42, domain.TaxTypeOf(domain.WithholdingPPh42))
+	assert.Equal(t, tax.Type(""), domain.TaxTypeOf(domain.WithholdingNone))
+}
+
+func TestRateVersions(t *testing.T) {
+	v, err := domain.NewRateVersion(tax.Rate{
+		Type: tax.PPh23, ObjectCode: " 24-104-14 ", Name: " Jasa ", RatePercent: decimal.NewFromInt(2), ValidFrom: jan1,
+	}, true, " catatan ")
+	require.NoError(t, err)
+	assert.Equal(t, "24-104-14", v.ObjectCode)
+	assert.Equal(t, "catatan", v.Note)
+	_, err = domain.NewRateVersion(tax.Rate{Type: tax.PPh23}, false, "")
+	assert.Error(t, err)
+	_, err = domain.NewRateVersion(v.Rate, false, string(make([]byte, 301)))
+	assert.Contains(t, fieldsOf(t, err), "note")
+
+	end, err := v.SupersededBy(clock.NewBusinessDate(2026, time.July, 1))
+	require.NoError(t, err)
+	assert.Equal(t, "2026-06-30", end.String())
+	_, err = v.SupersededBy(jan1)
+	assert.Contains(t, fieldsOf(t, err), "validFrom")
+
+	rates := []domain.RateVersion{
+		rateVersion(tax.PPh23, "A", "2", jan1, false),
+		rateVersion(tax.PPh23, "B", "3", jan1, true),
+		rateVersion(tax.PPh42, "C", "10", jan1, false),
+	}
+	code, ok := domain.DefaultObject(rates, tax.PPh23, oct20)
+	assert.True(t, ok)
+	assert.Equal(t, "B", code)
+	code, ok = domain.DefaultObject(rates, tax.PPh42, oct20)
+	assert.True(t, ok)
+	assert.Equal(t, "C", code, "tanpa default → objek pertama")
+	_, ok = domain.DefaultObject(rates, tax.PPh21, oct20)
+	assert.False(t, ok)
+
+	found, err := domain.FindRate(rates, tax.PPh23, "A", oct20)
+	require.NoError(t, err)
+	assert.Equal(t, rates[0].ID, found.ID)
+	_, err = domain.FindRate(rates, tax.PPh23, "Z", oct20)
+	assert.Error(t, err)
+}
+
+func TestWithholdingRecord(t *testing.T) {
+	subject := domain.WithholdingSubject{
+		SourceType: "expense_claim", SourceID: uuid.New(), SourceLabel: "EXP/1", BusinessDate: oct20,
+		TaxpayerType: "other", TaxpayerName: " Agensi ", TaxpayerTaxID: "01.234.567.8-901.000",
+	}
+	require.NoError(t, subject.Validate())
+	rate := rateVersion(tax.PPh23, "24-104-14", "2", jan1, true)
+	w, err := rate.Withhold(tax.WithholdingInput{Gross: rp(1_000_000), HasTaxID: true})
+	require.NoError(t, err)
+	rec := domain.NewWithholdingRecord(subject, rate, w)
+	assert.Equal(t, "Agensi", rec.TaxpayerName)
+	assert.Equal(t, "012345678901000", rec.TaxpayerTaxID)
+	assert.True(t, rec.HasTaxID)
+	assert.Equal(t, tax.Period{Year: 2026, Month: time.October}, rec.Period)
+	assert.Equal(t, "20000.00", rec.TaxAmount.String())
+	assert.Equal(t, rate.ID, rec.RateID)
+	assert.Equal(t, domain.WithholdingRecorded, rec.Status)
+
+	require.NoError(t, rec.SetSlipNumber(" BP-001 "))
+	assert.Equal(t, "BP-001", rec.SlipNumber)
+	assert.Contains(t, fieldsOf(t, rec.SetSlipNumber(string(make([]byte, 51)))), "slipNumber")
+	rec.Status = domain.WithholdingDeposited
+	assert.True(t, apperr.HasCode(rec.Cancel(), apperr.CodeInvalidStateTransition))
+	rec.Status = domain.WithholdingRecorded
+	require.NoError(t, rec.Cancel())
+	assert.Equal(t, domain.WithholdingCancelled, rec.Status)
+	assert.Error(t, rec.SetSlipNumber("x"))
+
+	bad := domain.WithholdingSubject{TaxpayerTaxID: "123"}
+	assert.ElementsMatch(t, []string{"sourceId", "businessDate", "taxpayerName", "taxpayerTaxId"}, fieldsOf(t, bad.Validate()))
+}
+
+func TestTaxDepositInput(t *testing.T) {
+	in := domain.TaxDepositInput{
+		TaxType: tax.PPh23, Period: tax.Period{Year: 2026, Month: time.September}, BankAccountID: uuid.New(), DepositDate: oct20,
+	}
+	require.NoError(t, in.Validate())
+	bad := domain.TaxDepositInput{
+		TaxType: "ppn", Period: tax.Period{Year: 2026, Month: 13}, DepositDate: clock.NewBusinessDate(2026, time.August, 1),
+		BillingCode: string(make([]byte, 31)), NTPN: string(make([]byte, 31)),
+	}
+	assert.ElementsMatch(t, []string{"taxType", "period", "bankAccountId", "depositDate", "billingCode", "ntpn"}, fieldsOf(t, bad.Validate()))
+	early := in
+	early.DepositDate = clock.NewBusinessDate(2026, time.August, 31)
+	assert.Contains(t, fieldsOf(t, early.Validate()), "depositDate")
+	early.DepositDate = clock.BusinessDate{}
+	assert.Contains(t, fieldsOf(t, early.Validate()), "depositDate")
+}
+
+func TestFinalTaxSetting(t *testing.T) {
+	year := 2026
+	s := domain.FinalTaxSetting{ValidFrom: jan1, IsEnabled: true, OpeningYear: &year, OpeningTurnover: rp(1_000_000_000)}
+	require.NoError(t, s.Validate())
+	assert.Equal(t, rp(1_000_000_000), s.OpeningFor(2026))
+	assert.True(t, s.OpeningFor(2027).IsZero())
+
+	badYear := 1999
+	bad := domain.FinalTaxSetting{OpeningYear: &badYear, OpeningTurnover: money.MustParse("-1"), Note: string(make([]byte, 301))}
+	assert.ElementsMatch(t, []string{"validFrom", "openingTurnover", "openingYear", "note"}, fieldsOf(t, bad.Validate()))
+
+	sep := tax.Period{Year: 2026, Month: time.September}
+	require.NoError(t, domain.CheckFinalTaxRun(&s, sep, oct20))
+	assert.Contains(t, fieldsOf(t, domain.CheckFinalTaxRun(&s, tax.Period{Year: 2026, Month: time.October}, oct20)), "period")
+	assert.True(t, apperr.HasCode(domain.CheckFinalTaxRun(nil, sep, oct20), apperr.CodeInvalidStateTransition))
+	off := s
+	off.IsEnabled = false
+	assert.True(t, apperr.HasCode(domain.CheckFinalTaxRun(&off, sep, oct20), apperr.CodeInvalidStateTransition))
+	assert.Error(t, domain.CheckFinalTaxRun(&s, tax.Period{Year: 2026, Month: 0}, oct20))
+}
diff --git a/backend/internal/accounting/finance.go b/backend/internal/accounting/finance.go
new file mode 100644
index 0000000..6527870
--- /dev/null
+++ b/backend/internal/accounting/finance.go
@@ -0,0 +1,155 @@
+package accounting
+
+import (
+	"context"
+
+	"github.com/google/uuid"
+
+	"balans/internal/accounting/domain"
+	"balans/internal/accounting/service"
+)
+
+// --- API publik Kas & Bank, rekonsiliasi, biaya, kas kecil, dan pajak (R1.4) -----------------
+
+type (
+	// BankAccount adalah rekening kas/bank Balans (terhubung ke akun 11xx).
+	BankAccount = domain.BankAccount
+	// Payment adalah pembayaran masuk/keluar (BYR, jurnal A-PB).
+	Payment = domain.Payment
+	// PaymentDirection adalah arah pembayaran.
+	PaymentDirection = domain.PaymentDirection
+	// PaymentRequest adalah pembayaran dokumen modul lain yang dicatat lewat RecordPayment.
+	PaymentRequest = service.PaymentRequest
+
+	// PaymentCandidate adalah dokumen terbuka yang bisa dilunasi baris mutasi bank.
+	PaymentCandidate = service.PaymentCandidate
+	// CandidateQuery adalah kriteria pencarian kandidat pembayaran.
+	CandidateQuery = service.CandidateQuery
+	// PaymentCandidateProvider adalah titik sambung piutang/utang ke rekonsiliasi bank (S-402).
+	PaymentCandidateProvider = service.PaymentCandidateProvider
+
+	// WithholdingRequest adalah permintaan pemotongan PPh satu dokumen sumber.
+	WithholdingRequest = service.WithholdingRequest
+	// WithholdingResult adalah data bukti potong dan akun utang PPh hasil pemotongan.
+	WithholdingResult = service.WithholdingResult
+	// WithholdingSubject adalah dokumen sumber dan penerima penghasilan yang dipotong.
+	WithholdingSubject = domain.WithholdingSubject
+	// WithholdingRecord adalah data bukti potong.
+	WithholdingRecord = domain.WithholdingRecord
+
+	// ApprovalSubject, Approvals, DocNumberer, Files, FileContent, DownloadLink, Users, Notifier, Suppliers diisi
+	// adapter saat wiring (ConnectFinance).
+	ApprovalSubject = service.ApprovalSubject
+	Approvals       = service.Approvals
+	DocNumberer     = service.DocNumberer
+	Files           = service.Files
+	FileContent     = service.FileContent
+	DownloadLink    = service.DownloadLink
+	Users           = service.Users
+	Notifier        = service.Notifier
+	Suppliers       = service.Suppliers
+)
+
+// Arah pembayaran, sumber kandidat bawaan, jenis pemilik file, dan permission yang dipakai wiring.
+const (
+	PaymentIncoming = domain.PaymentIncoming
+	PaymentOutgoing = domain.PaymentOutgoing
+
+	SourceClaimCandidates = service.SourceClaimCandidates
+
+	FileOwnerBankStatement   = service.FileOwnerBankStatement
+	FileOwnerExpenseClaim    = service.FileOwnerExpenseClaim
+	FileOwnerPettyCash       = service.FileOwnerPettyCash
+	FileOwnerPaymentProof    = service.FileOwnerPaymentProof
+	FileOwnerWithholdingSlip = service.FileOwnerWithholdingSlip
+
+	PermPaymentRead        = service.PermPaymentRead
+	PermPaymentWrite       = service.PermPaymentWrite
+	PermBankReconRead      = service.PermBankReconRead
+	PermBankReconImport    = service.PermBankReconImport
+	PermExpenseClaimRead   = service.PermExpenseClaimRead
+	PermExpenseClaimWrite  = service.PermExpenseClaimWrite
+	PermPettyCashRead      = service.PermPettyCashRead
+	PermPettyCashWrite     = service.PermPettyCashWrite
+	PermWithholdingRead    = service.PermWithholdingRead
+	PermWithholdingExport  = service.PermWithholdingExport
+	ContentTypeBankCSV     = service.ContentTypeCSV
+	ContentTypeBankXLSX    = service.ContentTypeXLSX
+	ExpensePayableAccount  = domain.ExpensePayableCode
+	TradePayableAccount    = "2101"
+	TradeReceivableAccount = "1201"
+)
+
+// FinanceConnections adalah dependensi R1.4 dari modul lain yang disusun setelah accounting.
+type FinanceConnections struct {
+	Files      Files
+	Approvals  Approvals
+	DocNumbers DocNumberer
+	Users      Users
+	Notifier   Notifier
+	Suppliers  Suppliers
+	BaseURL    string
+}
+
+// ConnectFinance memasang dependensi Kas & Bank, rekonsiliasi, biaya, kas kecil, dan pajak (saat wiring).
+func (m *Module) ConnectFinance(c FinanceConnections) {
+	d := &m.svc.FinanceDeps
+	d.Files, d.Approvals, d.DocNumbers, d.Users, d.Notifier, d.Suppliers, d.BaseURL =
+		c.Files, c.Approvals, c.DocNumbers, c.Users, c.Notifier, c.Suppliers, c.BaseURL
+}
+
+// RegisterPaymentCandidates mendaftarkan penyedia kandidat pembayaran untuk rekonsiliasi bank, mis. invoice
+// terbuka (sales) atau tagihan pemasok (procurement). Registrasi terakhir per Source menang.
+func (m *Module) RegisterPaymentCandidates(p PaymentCandidateProvider) {
+	m.svc.RegisterPaymentCandidates(p)
+}
+
+// RecordPayment membuat dan memposting pembayaran dokumen modul lain (nomor BYR, jurnal A-PB) di transaksi aktif.
+// Pembayaran keluar butuh re-autentikasi `accounting.payment.post` (★).
+func (m *Module) RecordPayment(ctx context.Context, req PaymentRequest) (Payment, error) {
+	return m.svc.RecordPayment(ctx, req)
+}
+
+// BankAccounts mengembalikan rekening kas/bank aktif untuk pilihan rekening dokumen modul lain (tanpa cek
+// permission).
+func (m *Module) BankAccounts(ctx context.Context) ([]BankAccount, error) {
+	return m.svc.Finance.ListBankAccounts(ctx, false, false)
+}
+
+// QuoteWithholding menghitung PPh potong (PPh 21/23/4(2)) dengan tarif effective-dated pada tanggal dokumen
+// tanpa menyimpan, mis. pratinjau tagihan pemasok.
+func (m *Module) QuoteWithholding(ctx context.Context, req WithholdingRequest) (WithholdingResult, error) {
+	return m.svc.QuoteWithholding(ctx, req)
+}
+
+// Withhold menghitung dan mencatat data bukti potong di transaksi aktif. Dokumen sumber memposting jurnalnya
+// sendiri, mis. tagihan pemasok A-18 `withholding_value` ke WithholdingResult.AccountCode (2302 PPh 23).
+func (m *Module) Withhold(ctx context.Context, req WithholdingRequest) (WithholdingResult, error) {
+	return m.svc.Withhold(ctx, req)
+}
+
+// CancelWithholdings membatalkan data bukti potong dokumen sumber yang dibatalkan (ditolak bila sudah disetor).
+func (m *Module) CancelWithholdings(ctx context.Context, sourceType string, sourceID uuid.UUID) error {
+	return m.svc.CancelWithholdings(ctx, sourceType, sourceID)
+}
+
+// OnExpenseClaimDecided dipanggil handler approval `expense_claim`.
+func (m *Module) OnExpenseClaimDecided(ctx context.Context, id uuid.UUID, approved bool, note string) error {
+	return m.svc.OnExpenseClaimDecided(ctx, id, approved, note)
+}
+
+// OnPettyCashDecided dipanggil handler approval `petty_cash_replenishment`.
+func (m *Module) OnPettyCashDecided(ctx context.Context, id uuid.UUID, approved bool, note string) error {
+	return m.svc.OnPettyCashDecided(ctx, id, approved, note)
+}
+
+// AuditEntities memetakan entitas audit R1.4 ke permission baca untuk tab Riwayat.
+func AuditEntities() map[string]string {
+	return map[string]string{
