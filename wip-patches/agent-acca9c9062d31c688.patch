+	ClaimDate         clock.BusinessDate
+	Description       string
+	TotalAmount       decimal.Decimal
+	WithholdingAmount decimal.Decimal
+	PayableAmount     decimal.Decimal
+	Status            string
+	SubmittedAt       *time.Time
+	DecidedAt         *time.Time
+	DecisionNote      string
+	VerifiedAt        *time.Time
+	VerifiedBy        uuid.NullUUID
+	VerifyDate        pgtype.Date
+	JournalEntryID    uuid.NullUUID
+	PaymentID         uuid.NullUUID
+	PaidAt            *time.Time
+	CancelReason      string
+	ActorID           uuid.UUID
+	ID                uuid.UUID
+	Version           int32
+}
+
+func (q *Queries) SaveExpenseClaim(ctx context.Context, arg SaveExpenseClaimParams) (int64, error) {
+	result, err := q.db.Exec(ctx, saveExpenseClaim,
+		arg.Number,
+		arg.ClaimType,
+		arg.DivisionID,
+		arg.CampaignID,
+		arg.PayeeType,
+		arg.PayeeID,
+		arg.PayeeName,
+		arg.PayeeTaxIDEnc,
+		arg.ClaimDate,
+		arg.Description,
+		arg.TotalAmount,
+		arg.WithholdingAmount,
+		arg.PayableAmount,
+		arg.Status,
+		arg.SubmittedAt,
+		arg.DecidedAt,
+		arg.DecisionNote,
+		arg.VerifiedAt,
+		arg.VerifiedBy,
+		arg.VerifyDate,
+		arg.JournalEntryID,
+		arg.PaymentID,
+		arg.PaidAt,
+		arg.CancelReason,
+		arg.ActorID,
+		arg.ID,
+		arg.Version,
+	)
+	if err != nil {
+		return 0, err
+	}
+	return result.RowsAffected(), nil
+}
+
+const updateExpenseClaimLineTax = `-- name: UpdateExpenseClaimLineTax :exec
+UPDATE expense_claim_lines
+SET withholding_type = $1, object_code = $2,
+    withholding_rate = $3, withholding_amount = $4
+WHERE id = $5
+`
+
+type UpdateExpenseClaimLineTaxParams struct {
+	WithholdingType   string
+	ObjectCode        string
+	WithholdingRate   decimal.Decimal
+	WithholdingAmount decimal.Decimal
+	ID                uuid.UUID
+}
+
+func (q *Queries) UpdateExpenseClaimLineTax(ctx context.Context, arg UpdateExpenseClaimLineTaxParams) error {
+	_, err := q.db.Exec(ctx, updateExpenseClaimLineTax,
+		arg.WithholdingType,
+		arg.ObjectCode,
+		arg.WithholdingRate,
+		arg.WithholdingAmount,
+		arg.ID,
+	)
+	return err
+}
