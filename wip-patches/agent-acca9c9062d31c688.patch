-func parseMoney(s string, field string, fields map[string]string) money.Amount {
-	if strings.TrimSpace(s) == "" {
-		return money.Zero
-	}
-	a, err := money.Parse(strings.TrimSpace(s))
-	if err != nil {
-		fields[field] = "Nominal tidak valid"
-	}
-	return a
-}
