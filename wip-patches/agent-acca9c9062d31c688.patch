+-+func (s *Service) products(ctx context.Context, ids []uuid.UUID) (map[uuid.UUID]ProductRef, error) {
+-+	if s.Products == nil || len(ids) == 0 {
+-+		return map[uuid.UUID]ProductRef{}, nil
+-+	}
+-+	return s.Products.Products(ctx, uniqueIDs(ids))
+-+}
