+            placeholder="Pilih rekening"
+          />
+        </Field>
+        <Field className="w-44">
+          <FieldLabel htmlFor="mut-from">Dari</FieldLabel>
+          <DateInput id="mut-from" value={dateFrom} onValueChange={(v) => void navigate({ search: (s) => ({ ...s, dateFrom: v, page: 1 }) })} />
+        </Field>
+        <Field className="w-44">
+          <FieldLabel htmlFor="mut-to">Sampai</FieldLabel>
+          <DateInput id="mut-to" value={dateTo} onValueChange={(v) => void navigate({ search: (s) => ({ ...s, dateTo: v, page: 1 }) })} />
+        </Field>
+      </div>
+      {mutations.data ? (
+        <p className="text-sm text-muted-foreground">
+          Saldo awal {formatDate(dateFrom)}: <span className="font-medium text-foreground">{formatRupiah(mutations.data.openingBalance)}</span>
+        </p>
+      ) : null}
+      <DataTable
+        columns={columns}
+        rows={accountId ? mutations.data?.items : []}
+        getRowId={(m) => m.journalLineId}
+        loading={!!accountId && mutations.isPending}
+        fetching={mutations.isFetching}
+        page={search.page}
+        totalPages={mutations.data?.totalPages ?? 0}
+        totalItems={mutations.data?.totalItems ?? 0}
+        onSortChange={() => undefined}
+        onPageChange={(page) => void navigate({ search: (s) => ({ ...s, page }) })}
