+
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex flex-wrap gap-3">
+          <form
+            onSubmit={(e) => {
+              e.preventDefault()
+              const q = new FormData(e.currentTarget).get("q")
+              void navigate({ search: (s) => ({ ...s, q: String(q ?? "") || undefined, page: 1 }) })
+            }}
+          >
+            <Input name="q" aria-label="Cari pembayaran" placeholder="Cari nomor, pihak, referensi" defaultValue={search.q} className="w-64" />
+          </form>
+          <SimpleSelect
+            className="w-40"
+            aria-label="Filter arah"
+            value={search.direction ?? "all"}
