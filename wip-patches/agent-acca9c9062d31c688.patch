++		Number: text(d.Number), LocationID: d.LocationID, InboundID: nullUUID(d.InboundID), BusinessDate: d.BusinessDate,
++		Note: d.Note, Status: string(d.Status), DisposalValue: d.DisposalValue, CostAmount: d.CostAmount,
