+-+	ListPurchaseAdvances(ctx context.Context, request ListPurchaseAdvancesRequestObject) (ListPurchaseAdvancesResponseObject, error)
+-+	// CreatePurchaseAdvance Menyimpan draft uang muka untuk PO yang disetujui
+-+	// (POST /api/v1/purchase-advances)
+-+	CreatePurchaseAdvance(ctx context.Context, request CreatePurchaseAdvanceRequestObject) (CreatePurchaseAdvanceResponseObject, error)
