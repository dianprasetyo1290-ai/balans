++	}
++	res, err := s.Post(ctx, domain.Posting{
++		Source: domain.Source{Type: SourceReturnDisposition, ID: d.ID, Action: stockExecute, Label: d.Number, BusinessDate: s.today()},
++		Lines:  lines,
