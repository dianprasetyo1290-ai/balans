+-+    queryFn: () =>
+-+      unwrap(
+-+        api.GET("/api/v1/price-lists", {
+-+          params: {
+-+            query: {
+-+              q: s.q || undefined,
+-+              priceListType: s.priceListType,
+-+              includeInactive: s.includeInactive,
+-+              deleted: s.deleted,
+-+            },
+-+          },
+-+        })
+-+      ),
+-+    placeholderData: keepPreviousData,
+-+  })
+-+
+-+export const priceListOptionsQuery = () =>
+-+  queryOptions({
