+  const [entry, setEntry] = useState<BankStatementLine | null>(null)
+  const canPost = statement.lines.some((l) => l.allowedActions.length > 0)
+
+  const bulk = useIdempotentMutation({
+    mutationFn: (kind: "auto" | "confirm", key) =>
+      kind === "auto" ? autoMatchStatement(statement.id, key) : confirmStatementSuggestions(statement.id, key),
+    onSuccess: async (res, kind) => {
+      toast.success(
