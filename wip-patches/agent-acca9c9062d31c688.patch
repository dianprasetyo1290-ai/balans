+		TotalAmount: s.TotalAmount, WithholdingAmount: s.WithholdingAmount, PayableAmount: s.PayableAmount, Status: s.Status,
+		CreatedAt: s.CreatedAt, UpdatedAt: s.UpdatedAt, Version: s.Version,
