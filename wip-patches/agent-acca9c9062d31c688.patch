+-+	UpdatePurchaseAdvance(ctx context.Context, request UpdatePurchaseAdvanceRequestObject) (UpdatePurchaseAdvanceResponseObject, error)
+-+	// CancelPurchaseAdvance Batalkan uang muka
+-+	// (POST /api/v1/purchase-advances/{id}/cancel)
+-+	CancelPurchaseAdvance(ctx context.Context, request CancelPurchaseAdvanceRequestObject) (CancelPurchaseAdvanceResponseObject, error)
