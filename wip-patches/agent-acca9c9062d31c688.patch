-	}
-	return clock.NewBusinessDate(d.Year(), d.Month(), d.Day())
-}
-
-func optFromDate(d *BusinessDate) *clock.BusinessDate {
-	if d == nil || d.IsZero() {
-		return nil
-	}
-	out := fromDate(*d)
-	return &out
-}
