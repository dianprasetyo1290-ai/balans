+}
+
+function ImportForm({ onClose }: { onClose: () => void }) {
+  const navigate = useNavigate()
+  const refresh = useFinanceRefresh()
+  const banks = useQuery(cashBankAccountsQuery())
+  const [bankAccountId, setBankAccountId] = useState("")
+  const [fileId, setFileId] = useState<string>()
+  const [errors, setErrors] = useState<Record<string, string>>({})
+  const save = useIdempotentMutation({
+    mutationFn: (_: void, key) => importBankStatement({ bankAccountId, fileId: fileId ?? "" }, key),
+    onSuccess: async (d) => {
+      toast.success(`${d.lineCount} baris diimpor, ${d.suggestedCount} usulan pencocokan`)
+      onClose()
+      await refresh()
+      void navigate({ to: "/finance/bank-reconciliation/$id", params: { id: d.id } })
+    },
+    onError: (err) => {
+      const p = parseProblem(err)
+      if (p.fields) {
+        setErrors(p.fields)
+        return
+      }
+      showErrorDialog(p)
+    },
+  })
+  return (
+    <DialogContent className="sm:max-w-lg">
+      <DialogHeader>
+        <DialogTitle>Impor Mutasi Bank</DialogTitle>
+        <DialogDescription>
+          File CSV atau Excel (.xlsx) dengan kolom Tanggal, Keterangan, Referensi, Debit/Kredit (atau Nominal + D/K),
+          dan Saldo. Satu file hanya bisa diimpor sekali.
+        </DialogDescription>
+      </DialogHeader>
+      <form
+        noValidate
+        className="flex flex-col gap-4"
+        onSubmit={(e) => {
+          e.preventDefault()
+          const next: Record<string, string> = {}
+          if (!bankAccountId) next.bankAccountId = "Rekening wajib dipilih"
+          if (!fileId) next.fileId = "File mutasi wajib diunggah"
+          setErrors(next)
+          if (Object.keys(next).length === 0) save.mutate()
+        }}
+      >
+        <Field data-invalid={!!errors.bankAccountId}>
+          <FieldLabel htmlFor="st-bank">Rekening</FieldLabel>
+          <SimpleSelect
+            id="st-bank"
+            value={bankAccountId}
+            onValueChange={setBankAccountId}
+            options={bankOptions(banks.data, true)}
+            placeholder="Pilih rekening bank"
+            aria-invalid={!!errors.bankAccountId}
+          />
+          <FieldError errors={fieldErrors(errors.bankAccountId)} />
+        </Field>
+        <Field data-invalid={!!errors.fileId}>
+          <FieldLabel>File Mutasi</FieldLabel>
+          <FileUpload
+            label="Pilih File CSV/Excel"
+            accept=".csv,text/csv,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
+            maxSizeBytes={10 * 1024 * 1024}
+            requestUpload={requestStatementUpload}
+            onUploaded={(id) => setFileId(id)}
+            onRemoved={() => setFileId(undefined)}
+            onError={(m) => toast.error(m)}
