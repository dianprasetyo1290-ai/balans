-	type key struct{ amountKey, account string }
-	sums := map[key]money.Amount{}
-	order := []key{}
-	add := func(k key, v money.Amount) {
-		if v.IsZero() {
-			return
-		}
-		if _, ok := sums[k]; !ok {
-			order = append(order, k)
-		}
-		sums[k] = sums[k].Add(v)
