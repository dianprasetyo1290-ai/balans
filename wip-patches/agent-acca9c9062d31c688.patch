+        </Field>
+        <Field>
+          <FieldLabel>Bukti</FieldLabel>
+          <ReceiptUpload ownerType="payment" onUploaded={setProofFileId} onRemoved={() => setProofFileId(undefined)} />
+        </Field>
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={onClose}>
+            Batal
+          </Button>
+          <LoadingButton type="submit" loading={save.isPending} loadingText="Menyimpan…">
+            Simpan Draft
+          </LoadingButton>
+        </DialogFooter>
+      </form>
+    </DialogContent>
+  )
+}
+
+// --- Mutasi -----------------------------------------------------------------------------------
+
+function MutationsTab() {
+  const search = route.useSearch()
+  const navigate = route.useNavigate()
+  const banks = useQuery(cashBankAccountsQuery())
+  const today = todayBusinessDate()
+  const accountId = search.accountId ?? banks.data?.[0]?.id ?? ""
+  const dateFrom = search.dateFrom ?? `${today.slice(0, 8)}01`
+  const dateTo = search.dateTo ?? today
+  const mutations = useQuery({
+    ...bankMutationsQuery({ id: accountId, dateFrom, dateTo, page: search.page }),
+    enabled: !!accountId,
+  })
+  type Row = NonNullable<typeof mutations.data>["items"][number]
+  const columns: DataTableColumn<Row>[] = [
+    { id: "date", header: "Tanggal", cell: (m) => <span className="whitespace-nowrap">{formatDate(m.businessDate)}</span> },
+    { id: "number", header: "Jurnal", cell: (m) => <span className="whitespace-nowrap">{m.journalNumber}</span> },
+    {
+      id: "desc",
+      header: "Keterangan",
+      cell: (m) => (
