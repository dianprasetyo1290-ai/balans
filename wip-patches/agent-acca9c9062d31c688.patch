+		{Group: groups[1], ObjectCode: "28-403-01", RatePercent: decimal.NewFromInt(10), Amount: rp(400_000)},
+	}
+	require.NoError(t, c.Verify(results, oct20, time.Now(), uuid.New()))
+	assert.Equal(t, domain.StatusAwaitingPayment, c.Status)
+	assert.Equal(t, "460001.00", c.Withholding.String())
+	assert.Equal(t, "9539999.00", c.Payable.String())
+	assert.Equal(t, money.Sum(c.Lines[0].WithholdingAmount, c.Lines[1].WithholdingAmount).String(), "60001.00", "alokasi tanpa selisih")
+	assert.Equal(t, "24-104-14", c.Lines[0].ObjectCode)
+	assert.Equal(t, domain.WithholdingNone, c.Lines[2].WithholdingType)
+	assert.Equal(t, []domain.Action{domain.ActionPay}, c.Actions())
+
+	splits, amounts := c.PostingSplits()
+	assert.Equal(t, "9539999.00", amounts[domain.AmountPayable].String())
+	sum := map[string]string{}
+	for _, s := range splits {
+		sum[s.AmountKey+":"+s.AccountCode] = s.Amount.String()
+	}
+	assert.Equal(t, map[string]string{
+		"expense_value:6102": "3000000.00", "expense_value:6303": "3000000.00", "expense_value:6301": "4000000.00",
+		"withholding_value:2302": "60001.00", "withholding_value:2303": "400000.00",
+	}, sum)
+
+	assert.Error(t, c.Verify(results, oct20, time.Now(), uuid.New()), "verifikasi hanya dari Disetujui")
+	require.NoError(t, c.MarkPaid(uuid.New(), "BYR/1", time.Now()))
+	assert.Equal(t, domain.StatusPaid, c.Status)
+	assert.Error(t, c.MarkPaid(uuid.New(), "BYR/2", time.Now()))
+}
+
+func TestExpenseClaimVerifyRejects(t *testing.T) {
+	typ := uuid.New()
+	c := approvedClaim(t, typ)
+	g := domain.TaxGroup{Type: domain.WithholdingPPh23, LineIDs: []uuid.UUID{c.Lines[0].ID}, Gross: c.Total}
+	assert.Error(t, c.Verify([]domain.TaxResult{{Group: g, Amount: c.Total}}, oct20, time.Now(), uuid.New()), "potongan ≥ total")
+	bad := domain.TaxGroup{Type: domain.WithholdingPPh23, LineIDs: []uuid.UUID{uuid.New()}}
+	assert.Error(t, c.Verify([]domain.TaxResult{{Group: bad, Amount: rp(1)}}, oct20, time.Now(), uuid.New()))
+	zero := domain.TaxGroup{Type: domain.WithholdingPPh23}
+	assert.Error(t, c.Verify([]domain.TaxResult{{Group: zero, Amount: rp(1)}}, oct20, time.Now(), uuid.New()), "kelompok tanpa baris")
+}
+
+func TestWithholdingAccountCode(t *testing.T) {
+	assert.Equal(t, "2301", domain.WithholdingAccountCode(domain.WithholdingPPh21))
+	assert.Equal(t, "2302", domain.WithholdingAccountCode(domain.WithholdingPPh23))
+	assert.Equal(t, "2303", domain.WithholdingAccountCode(domain.WithholdingPPh42))
+	assert.Empty(t, domain.WithholdingAccountCode(domain.WithholdingNone))
+}
diff --git a/backend/internal/accounting/domain/petty_cash.go b/backend/internal/accounting/domain/petty_cash.go
new file mode 100644
index 0000000..ce90641
--- /dev/null
+++ b/backend/internal/accounting/domain/petty_cash.go
@@ -0,0 +1,389 @@
+package domain
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+// --- Kas kecil imprest (S-405, ACC-12, Desain Status Dokumen 6.2) -----------------------------
+
+// Batas kas kecil. TODO(setting): pindahkan ke settings `petty_cash.max_per_transaction` dan
+// `petty_cash.default_ceiling` (effective-dated) saat modul setting dibangun.
+var (
+	PettyCashMaxPerTransaction = money.FromInt(1_000_000)
+	PettyCashDefaultCeiling    = money.FromInt(5_000_000)
+)
+
+// Rule dan nilai bernama kas kecil (posting_rule_accounts A-16, A-17).
+const (
+	RulePettyCashReplenish = "A-16"
+	RulePettyCashExpense   = "A-17"
+	AmountReplenish        = "replenish_value"
+	SourcePettyCash        = "petty_cash_transaction"
+)
+
+var fundCodePattern = regexp.MustCompile(`^[A-Z0-9][A-Z0-9_-]{1,29}$`)
+
+// PettyCashFund adalah dana kas kecil dengan plafon (imprest) dan saldo berjalan.
+type PettyCashFund struct {
+	ID           uuid.UUID
+	Code         string
+	Name         string
+	HolderUserID uuid.UUID
+	HolderName   string
+	DivisionID   uuid.UUID
+	DivisionName string
+	Ceiling      money.Amount
+	Balance      money.Amount
+	IsActive     bool
+	Description  string
+	UpdatedAt    time.Time
+	Version      int
+}
+
+// FundInput adalah isian Tambah/Ubah Dana Kas Kecil. Code hanya dipakai saat membuat.
+type FundInput struct {
+	Code         string
+	Name         string
+	HolderUserID uuid.UUID
+	DivisionID   uuid.UUID
+	Ceiling      money.Amount
+	IsActive     bool
+	Description  string
+}
+
+func (in *FundInput) normalize() {
+	in.Code, in.Name = strings.ToUpper(strings.TrimSpace(in.Code)), strings.TrimSpace(in.Name)
+	in.Description = strings.TrimSpace(in.Description)
+	if in.Ceiling.IsZero() {
+		in.Ceiling = PettyCashDefaultCeiling
+	}
+}
+
+func (in FundInput) validate(withCode bool) map[string]string {
+	fields := map[string]string{}
+	if withCode && !fundCodePattern.MatchString(in.Code) {
+		fields["code"] = "Kode huruf kapital/angka/garis bawah/strip (2–30 karakter), mis. KK-HO"
+	}
+	if in.Name == "" || len(in.Name) > 150 {
+		fields["name"] = "Nama wajib diisi (maks. 150 karakter)"
+	}
+	if in.HolderUserID == uuid.Nil {
+		fields["holderUserId"] = "Pemegang kas kecil wajib dipilih"
+	}
+	if in.DivisionID == uuid.Nil {
+		fields["divisionId"] = "Divisi wajib dipilih"
+	}
+	if msg := validMoney(in.Ceiling); msg != "" {
+		fields["ceilingAmount"] = msg
+	}
+	if len(in.Description) > 500 {
+		fields["description"] = "Keterangan maks. 500 karakter"
+	}
+	return fields
+}
+
+// NewFund membuat dana kas kecil bersaldo nol (diisi lewat pengisian kembali).
+func NewFund(in FundInput) (PettyCashFund, error) {
+	in.normalize()
+	if fields := in.validate(true); len(fields) > 0 {
+		return PettyCashFund{}, apperr.Validation(fields)
+	}
+	f := PettyCashFund{Code: in.Code, Balance: money.Zero}
+	f.apply(in)
+	return f, nil
+}
+
+// Update mengubah dana. Plafon tidak boleh di bawah saldo saat ini.
+func (f *PettyCashFund) Update(in FundInput) error {
+	in.normalize()
+	fields := in.validate(false)
+	if _, bad := fields["ceilingAmount"]; !bad && in.Ceiling.Cmp(f.Balance) < 0 {
+		fields["ceilingAmount"] = "Plafon tidak boleh lebih kecil dari saldo " + f.Balance.Rupiah()
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	f.apply(in)
+	return nil
+}
+
+func (f *PettyCashFund) apply(in FundInput) {
+	f.Name, f.HolderUserID, f.DivisionID, f.Ceiling = in.Name, in.HolderUserID, in.DivisionID, in.Ceiling
+	f.IsActive, f.Description = in.IsActive, in.Description
+}
+
+// Shortfall adalah nilai pengisian kembali agar saldo kembali ke plafon.
+func (f PettyCashFund) Shortfall() money.Amount { return f.Ceiling.Sub(f.Balance) }
+
+// PettyCashType adalah jenis transaksi kas kecil.
+type PettyCashType string
+
+const (
+	PettyCashExpense       PettyCashType = "expense"
+	PettyCashReplenishment PettyCashType = "replenishment"
+)
+
+// PettyCashTxn adalah transaksi kas kecil (KK).
+type PettyCashTxn struct {
+	ID                 uuid.UUID
+	Number             string
+	FundID             uuid.UUID
+	FundCode           string
+	FundName           string
+	Type               PettyCashType
+	BusinessDate       clock.BusinessDate
+	ExpenseTypeID      *uuid.UUID
+	ExpenseTypeCode    string
+	ExpenseTypeName    string
+	ExpenseAccountCode string
+	DivisionID         uuid.UUID
+	DivisionName       string
+	CampaignID         *uuid.UUID
+	CampaignName       string
+	Description        string
+	Amount             money.Amount
+	ReceiptFileID      *uuid.UUID
+	ReceiptFileName    string
+	BankAccountID      *uuid.UUID
+	BankAccountName    string
+	Status             DocStatus
+	DecisionNote       string
+	JournalEntryID     *uuid.UUID
+	JournalNumber      string
+	PostedAt           *time.Time
+	PostedBy           *uuid.UUID
+	CancelReason       string
+	CreatedAt          time.Time
+	CreatedBy          uuid.UUID
+	UpdatedAt          time.Time
+	Version            int
+}
+
+// PettyCashInput adalah isian transaksi kas kecil.
+type PettyCashInput struct {
+	Type          PettyCashType
+	FundID        uuid.UUID
+	BusinessDate  clock.BusinessDate
+	ExpenseTypeID *uuid.UUID
+	DivisionID    uuid.UUID
+	CampaignID    *uuid.UUID
+	Description   string
+	Amount        money.Amount
+	ReceiptFileID *uuid.UUID
+}
+
+func (in *PettyCashInput) normalize() {
+	in.Description = strings.TrimSpace(in.Description)
+	if in.Type == PettyCashReplenishment {
+		in.ExpenseTypeID, in.CampaignID, in.ReceiptFileID = nil, nil, nil
+	}
+}
+
+func (in PettyCashInput) validate() map[string]string {
+	fields := map[string]string{}
+	if in.Type != PettyCashExpense && in.Type != PettyCashReplenishment {
+		fields["type"] = "Jenis transaksi tidak dikenal"
+	}
+	if in.FundID == uuid.Nil {
+		fields["fundId"] = "Dana kas kecil wajib dipilih"
+	}
+	if in.BusinessDate.IsZero() {
+		fields["businessDate"] = "Tanggal wajib diisi"
+	}
+	if in.Type == PettyCashExpense && in.ExpenseTypeID == nil {
+		fields["expenseTypeId"] = "Jenis biaya wajib dipilih"
+	}
+	if in.DivisionID == uuid.Nil {
+		fields["divisionId"] = "Divisi wajib dipilih"
+	}
+	if msg := validMoney(in.Amount); msg != "" {
+		fields["amount"] = msg
+	}
+	if len(in.Description) > 300 {
+		fields["description"] = "Keterangan maks. 300 karakter"
+	}
+	return fields
+}
+
+// NewPettyCashTxn membuat draft transaksi kas kecil.
+func NewPettyCashTxn(in PettyCashInput) (PettyCashTxn, error) {
+	in.normalize()
+	if fields := in.validate(); len(fields) > 0 {
+		return PettyCashTxn{}, apperr.Validation(fields)
+	}
+	t := PettyCashTxn{Type: in.Type, FundID: in.FundID, Status: StatusDraft}
+	t.apply(in)
+	return t, nil
+}
+
+// Update mengubah draft. Jenis transaksi dan dana tidak berubah.
+func (t *PettyCashTxn) Update(in PettyCashInput) error {
+	if t.Status != StatusDraft {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Hanya transaksi Draft yang bisa diubah.")
+	}
+	in.Type, in.FundID = t.Type, t.FundID
+	in.normalize()
+	if fields := in.validate(); len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	t.apply(in)
+	return nil
+}
+
+func (t *PettyCashTxn) apply(in PettyCashInput) {
+	if !equalUUIDPtr(t.ExpenseTypeID, in.ExpenseTypeID) {
+		t.ExpenseTypeCode, t.ExpenseTypeName, t.ExpenseAccountCode = "", "", ""
+	}
+	t.BusinessDate, t.ExpenseTypeID, t.DivisionID, t.CampaignID = in.BusinessDate, in.ExpenseTypeID, in.DivisionID, in.CampaignID
+	t.Description, t.Amount, t.ReceiptFileID = in.Description, in.Amount, in.ReceiptFileID
+}
+
+func equalUUIDPtr(a, b *uuid.UUID) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return *a == *b
+}
+
+// CheckExpense memeriksa pengeluaran sebelum diposting: dana aktif, bukti wajib, maksimal per transaksi,
+// tidak melebihi saldo dana, jenis biaya aktif dan kampanye bila jenis biaya mewajibkan.
+func (t PettyCashTxn) CheckExpense(f PettyCashFund, et ExpenseType, maxPerTx money.Amount) error {
+	if t.Type != PettyCashExpense {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Bukan transaksi pengeluaran.")
+	}
+	fields := map[string]string{}
+	if !f.IsActive {
+		fields["fundId"] = "Dana kas kecil " + f.Code + " tidak aktif"
+	}
+	if t.ReceiptFileID == nil {
+		fields["receiptFileId"] = "Bukti pengeluaran wajib dilampirkan"
+	}
+	if t.Amount.Cmp(maxPerTx) > 0 {
+		fields["amount"] = "Maksimal " + maxPerTx.Rupiah() + " per transaksi kas kecil; gunakan Pengajuan Biaya"
+	} else if t.Amount.Cmp(f.Balance) > 0 {
+		fields["amount"] = "Saldo kas kecil tidak cukup (saldo " + f.Balance.Rupiah() + ")"
+	}
+	if msg := et.UsableError(); msg != "" {
+		fields["expenseTypeId"] = msg
+	}
+	if et.RequiresCampaign && t.CampaignID == nil {
+		fields["campaignId"] = "Kode kampanye wajib untuk " + et.Name
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+// CheckReplenishment memeriksa pengisian kembali: dana aktif dan saldo setelah diisi tidak melebihi plafon.
+func (t PettyCashTxn) CheckReplenishment(f PettyCashFund) error {
+	if t.Type != PettyCashReplenishment {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Bukan transaksi pengisian kembali.")
+	}
+	fields := map[string]string{}
+	if !f.IsActive {
+		fields["fundId"] = "Dana kas kecil " + f.Code + " tidak aktif"
+	}
+	if t.Amount.Cmp(f.Shortfall()) > 0 {
+		fields["amount"] = fmt.Sprintf("Pengisian maksimal %s agar saldo tidak melebihi plafon %s",
+			f.Shortfall().Rupiah(), f.Ceiling.Rupiah())
+	}
+	if len(fields) > 0 {
+		return apperr.Validation(fields)
+	}
+	return nil
+}
+
+func (t *PettyCashTxn) transition(to DocStatus, from ...DocStatus) error {
+	if !slices.Contains(from, t.Status) {
+		return invalidTransition("Transaksi kas kecil", t.Status, to)
+	}
+	t.Status = to
+	return nil
+}
+
+// Submit mengajukan pengisian kembali untuk approval Head F&A.
+func (t *PettyCashTxn) Submit() error {
+	if t.Type != PettyCashReplenishment {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Pengeluaran kas kecil langsung diposting tanpa approval.")
+	}
+	return t.transition(StatusPendingApproval, StatusDraft)
+}
+
+// Approve dipanggil handler approval.
+func (t *PettyCashTxn) Approve(note string) error {
+	t.DecisionNote = note
+	return t.transition(StatusApproved, StatusPendingApproval)
+}
+
+// Reject dipanggil handler approval.
+func (t *PettyCashTxn) Reject(note string) error {
+	t.DecisionNote = note
+	return t.transition(StatusRejected, StatusPendingApproval)
+}
+
+// Revise mengembalikan pengisian ditolak menjadi draft.
+func (t *PettyCashTxn) Revise() error { return t.transition(StatusDraft, StatusRejected) }
+
+// Post menandai transaksi diposting: pengeluaran dari draft, pengisian dari disetujui.
+func (t *PettyCashTxn) Post(number string, journalID uuid.UUID, at time.Time, by uuid.UUID) error {
+	from := StatusDraft
+	if t.Type == PettyCashReplenishment {
+		from = StatusApproved
+	}
+	if err := t.transition(StatusPosted, from); err != nil {
+		return err
+	}
+	t.Number, t.JournalEntryID, t.PostedAt, t.PostedBy = number, &journalID, &at, &by
+	return nil
+}
+
+// Cancel membatalkan transaksi yang belum diposting dan tidak sedang menunggu persetujuan.
+func (t *PettyCashTxn) Cancel(reason string) error {
+	r, err := requireReason(reason, "reason", "pembatalan")
+	if err != nil {
+		return err
+	}
+	if err := t.transition(StatusCancelled, StatusDraft, StatusRejected, StatusApproved); err != nil {
+		return err
+	}
+	t.CancelReason = r
+	return nil
+}
+
+// Label adalah nomor transaksi atau label draft.
+func (t PettyCashTxn) Label() string {
+	if t.Number != "" {
+		return t.Number
+	}
+	if t.Type == PettyCashReplenishment {
+		return "Draft pengisian kas kecil " + t.FundCode
+	}
+	return "Draft pengeluaran kas kecil " + t.FundCode
+}
+
+// Actions mengembalikan aksi transaksi kas kecil sesuai status.
+func (t PettyCashTxn) Actions() []Action {
+	switch t.Status {
+	case StatusDraft:
+		if t.Type == PettyCashReplenishment {
+			return []Action{ActionEdit, ActionSubmit, ActionCancel}
+		}
+		return []Action{ActionEdit, ActionPost, ActionCancel}
+	case StatusRejected:
+		return []Action{ActionRevise, ActionCancel}
+	case StatusApproved:
+		return []Action{ActionPost, ActionCancel}
+	}
+	return nil
+}
diff --git a/backend/internal/accounting/domain/petty_cash_test.go b/backend/internal/accounting/domain/petty_cash_test.go
new file mode 100644
index 0000000..a1e7471
--- /dev/null
+++ b/backend/internal/accounting/domain/petty_cash_test.go
@@ -0,0 +1,174 @@
+package domain_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"balans/internal/accounting/domain"
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+func fundInput() domain.FundInput {
+	return domain.FundInput{Code: " kk-ho ", Name: "Kas Kecil HO", HolderUserID: uuid.New(), DivisionID: uuid.New(), IsActive: true}
+}
+
+func TestPettyCashFund(t *testing.T) {
+	f, err := domain.NewFund(fundInput())
+	require.NoError(t, err)
+	assert.Equal(t, "KK-HO", f.Code)
+	assert.Equal(t, domain.PettyCashDefaultCeiling, f.Ceiling, "plafon kosong = default")
+	assert.True(t, f.Balance.IsZero())
+	assert.Equal(t, f.Ceiling, f.Shortfall())
+
+	tests := []struct {
+		name  string
+		mod   func(in *domain.FundInput)
+		field string
+	}{
+		{"kode", func(in *domain.FundInput) { in.Code = "!" }, "code"},
+		{"nama", func(in *domain.FundInput) { in.Name = "" }, "name"},
+		{"pemegang", func(in *domain.FundInput) { in.HolderUserID = uuid.Nil }, "holderUserId"},
+		{"divisi", func(in *domain.FundInput) { in.DivisionID = uuid.Nil }, "divisionId"},
+		{"plafon", func(in *domain.FundInput) { in.Ceiling = rp(-5) }, "ceilingAmount"},
+		{"keterangan", func(in *domain.FundInput) { in.Description = string(make([]byte, 501)) }, "description"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			in := fundInput()
+			tt.mod(&in)
+			_, err := domain.NewFund(in)
+			assert.Contains(t, fieldsOf(t, err), tt.field)
+		})
+	}
+
+	f.Balance = rp(3_000_000)
+	in := fundInput()
+	in.Ceiling = rp(2_000_000)
+	assert.Contains(t, fieldsOf(t, f.Update(in)), "ceilingAmount")
+	in.Ceiling = rp(4_000_000)
+	require.NoError(t, f.Update(in))
+	assert.Equal(t, "1000000.00", f.Shortfall().String())
+}
+
+func pettyInput(t domain.PettyCashType) domain.PettyCashInput {
+	et := uuid.New()
+	file := uuid.New()
+	return domain.PettyCashInput{
+		Type: t, FundID: uuid.New(), BusinessDate: oct20, ExpenseTypeID: &et, DivisionID: uuid.New(), Description: " ATK ",
+		Amount: rp(150_000), ReceiptFileID: &file,
+	}
+}
+
+func TestPettyCashExpense(t *testing.T) {
+	tx, err := domain.NewPettyCashTxn(pettyInput(domain.PettyCashExpense))
+	require.NoError(t, err)
+	assert.Equal(t, "ATK", tx.Description)
+	assert.Equal(t, []domain.Action{domain.ActionEdit, domain.ActionPost, domain.ActionCancel}, tx.Actions())
+	tx.FundCode = "KK-HO"
+	assert.Equal(t, "Draft pengeluaran kas kecil KK-HO", tx.Label())
+
+	fund := domain.PettyCashFund{Code: "KK-HO", IsActive: true, Ceiling: rp(5_000_000), Balance: rp(1_000_000)}
+	et := domain.ExpenseType{Name: "ATK", IsActive: true}
+	require.NoError(t, tx.CheckExpense(fund, et, domain.PettyCashMaxPerTransaction))
+
+	big := tx
+	big.Amount = rp(1_500_000)
+	assert.Contains(t, fieldsOf(t, big.CheckExpense(fund, et, domain.PettyCashMaxPerTransaction)), "amount")
+	low := tx
+	low.Amount = rp(900_000)
+	poor := fund
+	poor.Balance = rp(100_000)
+	assert.Contains(t, fieldsOf(t, low.CheckExpense(poor, et, domain.PettyCashMaxPerTransaction)), "amount")
+	noReceipt := tx
+	noReceipt.ReceiptFileID = nil
+	inactive := fund
+	inactive.IsActive = false
+	campaignType := domain.ExpenseType{Name: "Event", IsActive: false, RequiresCampaign: true}
+	assert.ElementsMatch(t, []string{"receiptFileId", "fundId", "expenseTypeId", "campaignId"},
+		fieldsOf(t, noReceipt.CheckExpense(inactive, campaignType, domain.PettyCashMaxPerTransaction)))
+	assert.True(t, apperr.HasCode(tx.CheckReplenishment(fund), apperr.CodeInvalidStateTransition))
+	assert.True(t, apperr.HasCode(tx.Submit(), apperr.CodeInvalidStateTransition))
+
+	upd := pettyInput(domain.PettyCashExpense)
+	upd.Amount = rp(200_000)
+	tx.ExpenseTypeCode = "OFFICE_SUPPLY"
+	require.NoError(t, tx.Update(upd))
+	assert.Equal(t, rp(200_000), tx.Amount)
+	assert.Empty(t, tx.ExpenseTypeCode, "jenis biaya berganti → kode tampilan dikosongkan")
+	upd.Amount = money.Zero
+	assert.Error(t, tx.Update(upd))
+
+	require.NoError(t, tx.Post("KK/2026/10/00001", uuid.New(), time.Now(), uuid.New()))
+	assert.Equal(t, domain.StatusPosted, tx.Status)
+	assert.Equal(t, "KK/2026/10/00001", tx.Label())
+	assert.Empty(t, tx.Actions())
+	assert.True(t, apperr.HasCode(tx.Update(upd), apperr.CodeInvalidStateTransition))
+	assert.Error(t, tx.Cancel("x"))
+}
+
+func TestPettyCashReplenishment(t *testing.T) {
+	in := pettyInput(domain.PettyCashReplenishment)
+	tx, err := domain.NewPettyCashTxn(in)
+	require.NoError(t, err)
+	assert.Nil(t, tx.ExpenseTypeID, "pengisian tanpa jenis biaya")
+	assert.Nil(t, tx.ReceiptFileID)
+	assert.Equal(t, []domain.Action{domain.ActionEdit, domain.ActionSubmit, domain.ActionCancel}, tx.Actions())
+	tx.FundCode = "KK-HO"
+	assert.Equal(t, "Draft pengisian kas kecil KK-HO", tx.Label())
+
+	fund := domain.PettyCashFund{IsActive: true, Ceiling: rp(5_000_000), Balance: rp(4_900_000)}
+	assert.Contains(t, fieldsOf(t, tx.CheckReplenishment(fund)), "amount")
+	fund.Balance = rp(1_000_000)
+	require.NoError(t, tx.CheckReplenishment(fund))
+	fund.IsActive = false
+	assert.Contains(t, fieldsOf(t, tx.CheckReplenishment(fund)), "fundId")
+	assert.True(t, apperr.HasCode(tx.CheckExpense(fund, domain.ExpenseType{}, rp(1)), apperr.CodeInvalidStateTransition))
+
+	assert.Error(t, tx.Post("KK/1", uuid.New(), time.Now(), uuid.New()), "pengisian harus disetujui dulu")
+	require.NoError(t, tx.Submit())
+	assert.Empty(t, tx.Actions())
+	require.NoError(t, tx.Reject("plafon terlalu besar"))
+	assert.Equal(t, []domain.Action{domain.ActionRevise, domain.ActionCancel}, tx.Actions())
+	require.NoError(t, tx.Revise())
+	require.NoError(t, tx.Submit())
+	require.NoError(t, tx.Approve("ok"))
+	assert.Equal(t, []domain.Action{domain.ActionPost, domain.ActionCancel}, tx.Actions())
+	require.NoError(t, tx.Post("KK/2", uuid.New(), time.Now(), uuid.New()))
+	assert.Error(t, tx.Approve(""))
+
+	other, err := domain.NewPettyCashTxn(in)
+	require.NoError(t, err)
+	assert.Contains(t, fieldsOf(t, other.Cancel(" ")), "reason")
+	require.NoError(t, other.Cancel("batal"))
+	assert.Equal(t, domain.StatusCancelled, other.Status)
+}
+
+func TestNewPettyCashValidation(t *testing.T) {
+	tests := []struct {
+		name  string
+		mod   func(in *domain.PettyCashInput)
+		field string
+	}{
+		{"jenis", func(in *domain.PettyCashInput) { in.Type = "x" }, "type"},
+		{"dana", func(in *domain.PettyCashInput) { in.FundID = uuid.Nil }, "fundId"},
+		{"tanggal", func(in *domain.PettyCashInput) { in.BusinessDate = clock.BusinessDate{} }, "businessDate"},
+		{"jenis biaya", func(in *domain.PettyCashInput) { in.ExpenseTypeID = nil }, "expenseTypeId"},
+		{"divisi", func(in *domain.PettyCashInput) { in.DivisionID = uuid.Nil }, "divisionId"},
+		{"nominal", func(in *domain.PettyCashInput) { in.Amount = money.Zero }, "amount"},
+		{"keterangan", func(in *domain.PettyCashInput) { in.Description = string(make([]byte, 301)) }, "description"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			in := pettyInput(domain.PettyCashExpense)
+			tt.mod(&in)
+			_, err := domain.NewPettyCashTxn(in)
+			assert.Contains(t, fieldsOf(t, err), tt.field)
+		})
+	}
+}
diff --git a/backend/internal/accounting/domain/statement.go b/backend/internal/accounting/domain/statement.go
new file mode 100644
index 0000000..ff0243e
--- /dev/null
+++ b/backend/internal/accounting/domain/statement.go
@@ -0,0 +1,651 @@
+package domain
+
+import (
+	"fmt"
+	"math"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/google/uuid"
+	"github.com/shopspring/decimal"
+
+	"balans/internal/platform/apperr"
+	"balans/internal/platform/clock"
+	"balans/internal/platform/money"
+)
+
+// --- Rekonsiliasi bank (S-402, Technical Guideline 5.8.5) -------------------------------------
+
+// LineStatus adalah status baris mutasi bank.
+type LineStatus string
+
+const (
+	LineUnmatched LineStatus = "unmatched"
+	LineSuggested LineStatus = "suggested"
+	LineMatched   LineStatus = "matched"
+)
+
+// MatchKind adalah jenis pasangan baris mutasi.
+type MatchKind string
+
+const (
+	// MatchJournalLine: transaksi yang sudah dijurnal di akun rekening.
+	MatchJournalLine MatchKind = "journal_line"
+	// MatchDocument: dokumen terbuka dari penyedia kandidat (piutang, utang, pengajuan biaya) yang dibayar saat
+	// usulan dikonfirmasi.
+	MatchDocument MatchKind = "document"
+	// MatchNewEntry: jurnal baru dibuat dari baris yang tidak cocok (biaya bank, bunga, dll.).
+	MatchNewEntry MatchKind = "new_entry"
+)
+
+// MatchRule adalah aturan pencocokan yang menghasilkan pasangan.
+type MatchRule string
+
+const (
+	RuleReference  MatchRule = "reference"
+	RuleAmountDate MatchRule = "amount_date"
+	RuleManual     MatchRule = "manual"
+)
+
+// DefaultMatchToleranceDays adalah selisih tanggal maksimal aturan nominal + tanggal.
+// TODO(setting): pindahkan ke settings `bank_reconciliation.tolerance_days`.
+const DefaultMatchToleranceDays = 3
+
+// MaxStatementLines membatasi jumlah baris satu file mutasi.
+const MaxStatementLines = 5000
+
+// StatementRow adalah satu baris hasil baca file mutasi.
+type StatementRow struct {
+	// Row adalah nomor baris di file (1 = baris pertama) untuk pesan error.
+	Row         int
+	Date        clock.BusinessDate
+	Description string
+	Reference   string
+	// Amount bertanda: positif = dana masuk (kredit rekening koran), negatif = keluar.
+	Amount  money.Amount
+	Balance *money.Amount
+}
+
+// ParsedStatement adalah hasil ParseStatementRows.
+type ParsedStatement struct {
+	Rows []StatementRow
+	// Skipped adalah jumlah baris non-transaksi yang dilewati (judul, saldo awal, total).
+	Skipped int
+}
+
+type columnRole int
+
+const (
+	colNone columnRole = iota
+	colDate
+	colDescription
+	colReference
+	colDebit
+	colCredit
+	colAmount
+	colDC
+	colBalance
+)
+
+var headerAliases = map[columnRole][]string{
+	colDate: {"tanggal", "tgl", "date", "tanggal transaksi", "tgl transaksi", "transaction date", "posting date",
+		"tanggal mutasi", "tgl mutasi", "trx date", "value date", "tanggal valuta"},
+	colDescription: {"keterangan", "deskripsi", "description", "uraian", "remark", "remarks", "uraian transaksi",
+		"keterangan transaksi", "transaction description", "berita"},
+	colReference: {"referensi", "reference", "no referensi", "no ref", "ref", "nomor referensi", "reference no",
+		"ref no", "kode referensi", "no transaksi", "nomor transaksi", "transaction id", "cheque no"},
+	colDebit:   {"debit", "debet", "mutasi debit", "mutasi debet", "keluar", "withdrawal", "withdrawals", "db", "dana keluar"},
+	colCredit:  {"kredit", "credit", "mutasi kredit", "masuk", "deposit", "deposits", "cr", "dana masuk"},
+	colAmount:  {"nominal", "jumlah", "amount", "mutasi", "nilai"},
+	colDC:      {"db cr", "d k", "dk", "dc", "d c", "cr db", "jenis", "jenis mutasi", "type"},
+	colBalance: {"saldo", "balance", "saldo akhir", "running balance"},
+}
+
+func normalizeHeader(s string) string {
+	var b strings.Builder
+	space := false
+	for _, r := range strings.ToLower(strings.TrimSpace(s)) {
+		if unicode.IsLetter(r) || unicode.IsDigit(r) {
+			b.WriteRune(r)
+			space = false
+		} else if !space && b.Len() > 0 {
+			b.WriteByte(' ')
+			space = true
+		}
+	}
+	return strings.TrimSpace(b.String())
+}
+
+func roleOf(header string) columnRole {
+	h := normalizeHeader(header)
+	if h == "" {
+		return colNone
+	}
+	for role := colDate; role <= colBalance; role++ {
+		if slices.Contains(headerAliases[role], h) {
+			return role
+		}
+	}
+	return colNone
+}
+
+// detectHeader mencari baris judul kolom pada 20 baris pertama: wajib ada tanggal dan nominal (debit/kredit
+// atau nominal).
+func detectHeader(rows [][]string) (int, map[columnRole]int, bool) {
+	for i := 0; i < len(rows) && i < 20; i++ {
+		cols := map[columnRole]int{}
+		for j, cell := range rows[i] {
+			if r := roleOf(cell); r != colNone {
+				if _, dup := cols[r]; !dup {
+					cols[r] = j
+				}
+			}
+		}
+		_, hasDate := cols[colDate]
+		_, hasDebit := cols[colDebit]
+		_, hasCredit := cols[colCredit]
+		_, hasAmount := cols[colAmount]
+		if hasDate && ((hasDebit && hasCredit) || hasAmount) {
+			return i, cols, true
+		}
+	}
+	return 0, nil, false
+}
+
+func cell(row []string, cols map[columnRole]int, role columnRole) string {
+	j, ok := cols[role]
+	if !ok || j >= len(row) {
+		return ""
+	}
+	return strings.TrimSpace(row[j])
+}
+
+// ParseStatementRows membaca baris file mutasi (CSV atau sel Excel mentah). Baris judul kolom dikenali dari
+// nama kolom umum bank Indonesia (Tanggal, Keterangan, Referensi, Debit/Mutasi Debit, Kredit/Mutasi Kredit,
+// atau Nominal + D/K, Saldo). Baris tanpa tanggal valid atau bernominal nol dilewati (judul, saldo awal, total);
+// baris bertanggal dengan nominal tidak valid ditolak dengan nomor barisnya.
+func ParseStatementRows(rows [][]string) (ParsedStatement, error) {
+	hdr, cols, ok := detectHeader(rows)
+	if !ok {
+		return ParsedStatement{}, apperr.Validation(map[string]string{
+			"fileId": "Kolom Tanggal dan Debit/Kredit (atau Nominal) tidak ditemukan di file mutasi",
+		})
+	}
+	var out ParsedStatement
+	for i := hdr + 1; i < len(rows); i++ {
+		row := rows[i]
+		if isBlank(row) {
+			continue
+		}
+		date, ok := parseStatementDate(cell(row, cols, colDate))
+		if !ok {
+			out.Skipped++
+			continue
+		}
+		amount, err := rowAmount(row, cols)
+		if err != nil {
+			return ParsedStatement{}, apperr.Validation(map[string]string{
+				"fileId": fmt.Sprintf("Baris %d: %s", i+1, err.Error()),
+			})
+		}
+		if amount.IsZero() {
+			out.Skipped++
+			continue
+		}
+		r := StatementRow{
+			Row: i + 1, Date: date, Amount: amount,
+			Description: truncate(cell(row, cols, colDescription), 500), Reference: truncate(cell(row, cols, colReference), 100),
+		}
+		if s := cell(row, cols, colBalance); s != "" {
+			if b, _, err := parseStatementAmount(s); err == nil {
+				r.Balance = &b
+			}
+		}
+		out.Rows = append(out.Rows, r)
+		if len(out.Rows) > MaxStatementLines {
+			return ParsedStatement{}, apperr.Validation(map[string]string{
+				"fileId": fmt.Sprintf("File mutasi maksimal %d baris transaksi", MaxStatementLines),
+			})
+		}
+	}
+	if len(out.Rows) == 0 {
+		return ParsedStatement{}, apperr.Validation(map[string]string{"fileId": "File mutasi tidak berisi transaksi"})
+	}
+	return out, nil
+}
+
+func absAmount(a money.Amount) money.Amount {
+	if a.IsNegative() {
+		return a.Neg()
+	}
+	return a
+}
+
+func truncate(s string, n int) string {
+	if r := []rune(s); len(r) > n {
+		return string(r[:n])
+	}
+	return s
+}
+
+func isBlank(row []string) bool {
+	for _, c := range row {
+		if strings.TrimSpace(c) != "" {
+			return false
+		}
+	}
+	return true
+}
+
+func rowAmount(row []string, cols map[columnRole]int) (money.Amount, error) {
+	debitS, creditS := cell(row, cols, colDebit), cell(row, cols, colCredit)
+	if _, ok := cols[colDebit]; ok && (debitS != "" || creditS != "") {
+		debit, credit := money.Zero, money.Zero
+		var err error
+		if debitS != "" {
+			if debit, _, err = parseStatementAmount(debitS); err != nil {
+				return money.Zero, err
+			}
+		}
+		if creditS != "" {
+			if credit, _, err = parseStatementAmount(creditS); err != nil {
+				return money.Zero, err
+			}
+		}
+		return absAmount(credit).Sub(absAmount(debit)), nil
+	}
+	s := cell(row, cols, colAmount)
+	if s == "" {
+		return money.Zero, nil
+	}
+	a, dc, err := parseStatementAmount(s)
+	if err != nil {
+		return money.Zero, err
+	}
+	if ind := strings.ToUpper(normalizeHeader(cell(row, cols, colDC))); ind != "" {
+		dc = ind
+	}
+	switch dc {
+	case "D", "DB", "DEBIT", "DEBET", "K-", "KELUAR":
+		return absAmount(a).Neg(), nil
+	case "K", "CR", "C", "KREDIT", "CREDIT", "MASUK":
+		return absAmount(a), nil
+	}
+	return a, nil
+}
+
+// parseStatementAmount membaca nominal dengan format Indonesia (1.234.567,89) atau internasional
+// (1,234,567.89), awalan Rp, tanda minus/kurung, dan akhiran CR/DB. Mengembalikan indikator D/K akhiran.
+func parseStatementAmount(s string) (money.Amount, string, error) {
+	s = strings.TrimSpace(s)
+	upper := strings.ToUpper(s)
+	dc := ""
+	if f := strings.Fields(upper); len(f) > 1 && slices.Contains([]string{"CR", "DB", "D", "K", "C"}, f[len(f)-1]) {
+		dc, upper = f[len(f)-1], strings.Join(f[:len(f)-1], " ")
+	} else if n := len(upper); n > 2 && (strings.HasSuffix(upper, "CR") || strings.HasSuffix(upper, "DB")) &&
+		upper[n-3] >= '0' && upper[n-3] <= '9' {
+		dc, upper = upper[n-2:], upper[:n-2]
+	}
+	neg := false
+	if strings.HasPrefix(upper, "(") && strings.HasSuffix(upper, ")") {
+		neg, upper = true, upper[1:len(upper)-1]
+	}
+	upper = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(upper), "RP"))
+	upper = strings.TrimPrefix(upper, ".")
+	upper = strings.ReplaceAll(upper, " ", "")
+	if strings.HasPrefix(upper, "-") {
+		neg, upper = !neg, upper[1:]
+	} else if strings.HasPrefix(upper, "+") {
+		upper = upper[1:]
+	}
+	if upper == "" {
+		return money.Zero, dc, fmt.Errorf("nominal %q tidak valid", s)
+	}
+	normalized := normalizeNumber(upper)
+	d, err := decimal.NewFromString(normalized)
+	if err != nil {
+		return money.Zero, dc, fmt.Errorf("nominal %q tidak valid", s)
+	}
+	if d.Exponent() < -2 && !d.Equal(d.Round(2)) {
+		return money.Zero, dc, fmt.Errorf("nominal %q lebih dari 2 angka di belakang koma", s)
+	}
+	a := money.FromDecimal(d.Round(2))
+	if neg {
+		a = a.Neg()
+	}
+	return a, dc, nil
+}
+
+// normalizeNumber mengubah pemisah ribuan/desimal menjadi format titik desimal.
+func normalizeNumber(s string) string {
+	dot, comma := strings.LastIndex(s, "."), strings.LastIndex(s, ",")
+	switch {
+	case dot >= 0 && comma >= 0:
+		if comma > dot {
+			return strings.ReplaceAll(strings.ReplaceAll(s, ".", ""), ",", ".")
+		}
+		return strings.ReplaceAll(s, ",", "")
+	case comma >= 0:
+		if strings.Count(s, ",") == 1 && len(s)-comma-1 <= 2 {
+			return strings.Replace(s, ",", ".", 1)
+		}
+		return strings.ReplaceAll(s, ",", "")
+	case dot >= 0:
+		if strings.Count(s, ".") == 1 && len(s)-dot-1 <= 2 {
+			return s
+		}
+		return strings.ReplaceAll(s, ".", "")
+	}
+	return s
+}
+
+var idMonths = strings.NewReplacer(
+	"Januari", "Jan", "Februari", "Feb", "Maret", "Mar", "April", "Apr", "Juni", "Jun", "Juli", "Jul",
+	"Agustus", "Aug", "September", "Sep", "Oktober", "Oct", "November", "Nov", "Desember", "Dec",
+	"Mei", "May", "Agu", "Aug", "Ags", "Aug", "Okt", "Oct", "Des", "Dec",
+)
+
+var statementDateLayouts = []string{
+	"2006-01-02", "02/01/2006", "2/1/2006", "02-01-2006", "2-1-2006", "02/01/06", "2/1/06", "02-01-06",
+	"2006/01/02", "02 Jan 2006", "2 Jan 2006", "02-Jan-2006", "2-Jan-2006", "02 Jan 06", "02-Jan-06",
+	"02.01.2006", "2006-01-02 15:04:05", "02/01/2006 15:04:05", "02/01/2006 15:04", "02/01",
+}
+
+// parseStatementDate membaca tanggal mutasi: format umum bank Indonesia (DD/MM/YYYY, nama bulan Indonesia)
+// atau nomor seri tanggal Excel.
+func parseStatementDate(s string) (clock.BusinessDate, bool) {
+	s = strings.TrimSpace(strings.Trim(s, "'"))
+	if s == "" {
+		return clock.BusinessDate{}, false
+	}
+	if f, err := strconv.ParseFloat(s, 64); err == nil {
+		// Seri tanggal Excel (1900 date system): 25569 = 1970-01-01. Batasi 2000–2099.
+		if f >= 36526 && f < 73051 {
+			days := int(math.Floor(f))
+			t := time.Date(1899, time.December, 30, 0, 0, 0, 0, time.UTC).AddDate(0, 0, days)
+			return clock.NewBusinessDate(t.Year(), t.Month(), t.Day()), true
+		}
+		return clock.BusinessDate{}, false
+	}
+	s = idMonths.Replace(s)
+	for _, layout := range statementDateLayouts {
+		if layout == "02/01" {
+			continue // tanpa tahun tidak didukung
+		}
+		if t, err := time.Parse(layout, s); err == nil {
+			if t.Year() < 2000 || t.Year() > 2099 {
+				return clock.BusinessDate{}, false
+			}
+			return clock.NewBusinessDate(t.Year(), t.Month(), t.Day()), true
+		}
+	}
+	return clock.BusinessDate{}, false
+}
+
+// StatementLine adalah baris mutasi bank tersimpan beserta usulan/hasil pencocokan.
+type StatementLine struct {
+	ID              uuid.UUID
+	StatementID     uuid.UUID
+	BankAccountID   uuid.UUID
+	LineNo          int
+	TransactionDate clock.BusinessDate
+	Description     string
+	Reference       string
+	Amount          money.Amount
+	Balance         *money.Amount
+	Status          LineStatus
+	MatchKind       MatchKind
+	MatchRule       MatchRule
+	JournalLineID   *uuid.UUID
+	JournalEntryID  *uuid.UUID
+	JournalNumber   string
+	CandidateSource string
+	CandidateDocID  *uuid.UUID
+	CandidateLabel  string
+	PaymentID       *uuid.UUID
+	MatchedAt       *time.Time
+	MatchedBy       *uuid.UUID
+	Version         int
+}
+
+// Suggest menyimpan usulan pasangan (belum dikonfirmasi).
+func (l *StatementLine) Suggest(c MatchCandidate, rule MatchRule) error {
+	if l.Status == LineMatched {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Baris mutasi sudah direkonsiliasi.")
+	}
+	l.Status, l.MatchKind, l.MatchRule = LineSuggested, c.Kind, rule
+	l.JournalLineID, l.JournalEntryID, l.JournalNumber = nil, nil, ""
+	l.CandidateSource, l.CandidateDocID, l.CandidateLabel = "", nil, c.Label
+	if c.Kind == MatchJournalLine {
+		l.JournalLineID, l.JournalEntryID = ptrUUID(c.JournalLineID), ptrUUID(c.JournalEntryID)
+	} else {
+		l.CandidateSource, l.CandidateDocID = c.Source, ptrUUID(c.DocumentID)
+	}
+	return nil
+}
+
+func ptrUUID(id uuid.UUID) *uuid.UUID {
+	if id == uuid.Nil {
+		return nil
+	}
+	return &id
+}
+
+// ClearSuggestion menghapus usulan baris yang belum dikonfirmasi.
+func (l *StatementLine) ClearSuggestion() {
+	if l.Status != LineSuggested {
+		return
+	}
+	l.Status, l.MatchKind, l.MatchRule = LineUnmatched, "", ""
+	l.JournalLineID, l.JournalEntryID, l.JournalNumber = nil, nil, ""
+	l.CandidateSource, l.CandidateDocID, l.CandidateLabel = "", nil, ""
+}
+
+// Confirm menandai baris direkonsiliasi dengan baris jurnal akun rekening.
+func (l *StatementLine) Confirm(kind MatchKind, rule MatchRule, journalLineID, journalEntryID uuid.UUID, paymentID *uuid.UUID,
+	label string, at time.Time, by uuid.UUID,
+) error {
+	if l.Status == LineMatched {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Baris mutasi sudah direkonsiliasi.")
+	}
+	if kind != MatchDocument {
+		l.CandidateSource, l.CandidateDocID = "", nil
+	}
+	l.Status, l.MatchKind, l.MatchRule = LineMatched, kind, rule
+	l.JournalLineID, l.JournalEntryID, l.PaymentID = &journalLineID, &journalEntryID, paymentID
+	if label != "" {
+		l.CandidateLabel = label
+	}
+	l.MatchedAt, l.MatchedBy = &at, &by
+	return nil
+}
+
+// Unmatch melepas pencocokan baris (jurnal yang sudah dibuat tetap ada).
+func (l *StatementLine) Unmatch() error {
+	if l.Status != LineMatched {
+		return apperr.WithMessage(apperr.CodeInvalidStateTransition, "Baris mutasi belum direkonsiliasi.")
+	}
+	l.Status, l.MatchKind, l.MatchRule = LineUnmatched, "", ""
+	l.JournalLineID, l.JournalEntryID, l.JournalNumber, l.PaymentID = nil, nil, "", nil
+	l.CandidateSource, l.CandidateDocID, l.CandidateLabel = "", nil, ""
+	l.MatchedAt, l.MatchedBy = nil, nil
+	return nil
+}
+
+// MatchCandidate adalah calon pasangan baris mutasi: baris jurnal akun rekening yang belum direkonsiliasi atau
+// dokumen terbuka dari penyedia kandidat pembayaran.
+type MatchCandidate struct {
+	Kind           MatchKind
+	JournalLineID  uuid.UUID
+	JournalEntryID uuid.UUID
+	Source         string
+	DocumentID     uuid.UUID
+	Label          string
+	Date           clock.BusinessDate
+	// Amount bertanda dari sisi rekening: masuk positif, keluar negatif.
+	Amount money.Amount
+	// References adalah teks yang dicari di referensi/keterangan mutasi (nomor BYR, nomor invoice, referensi
+	// transfer).
+	References []string
+}
+
+// Suggestion adalah usulan pasangan satu baris mutasi.
+type Suggestion struct {
+	LineID    uuid.UUID
+	Candidate MatchCandidate
+	Rule      MatchRule
+}
+
+// normalizeRef menyisakan huruf kapital dan angka agar "INV/2027/01/00031" cocok dengan "INV2027010031".
+func normalizeRef(s string) string {
+	var b strings.Builder
+	for _, r := range strings.ToUpper(s) {
+		if (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// minRefLength adalah panjang minimal referensi kandidat yang dicari di keterangan mutasi.
+const minRefLength = 6
+
+func refMatches(line StatementLine, c MatchCandidate) bool {
+	ref, desc := normalizeRef(line.Reference), normalizeRef(line.Description)
+	for _, r := range c.References {
+		n := normalizeRef(r)
+		if n == "" {
+			continue
+		}
+		if ref != "" && ref == n {
+			return true
+		}
+		if len(n) >= minRefLength && (strings.Contains(desc, n) || (len(ref) >= minRefLength && strings.Contains(ref, n))) {
+			return true
+		}
+	}
+	return false
+}
+
+func dayDiff(a, b clock.BusinessDate) int {
+	d := int(math.Round(a.Time().Sub(b.Time()).Hours() / 24))
+	if d < 0 {
+		return -d
+	}
+	return d
+}
+
+func candidateKey(c MatchCandidate) string {
+	if c.Kind == MatchJournalLine {
+		return "j:" + c.JournalLineID.String()
+	}
+	return "d:" + c.Source + ":" + c.DocumentID.String()
+}
+
+// SuggestMatches menjalankan aturan pencocokan berurutan (Technical Guideline 5.8.5): (1) referensi sama dan
+// nominal sama, (2) nominal sama dengan selisih tanggal ≤ toleranceDays (tanggal terdekat; baris jurnal
+// didahulukan dari dokumen). Kandidat dipakai paling banyak sekali. Bila ada beberapa kandidat sama kuat,
+// baris dibiarkan untuk pencocokan manual. Fungsi murni dan deterministik.
+func SuggestMatches(lines []StatementLine, cands []MatchCandidate, toleranceDays int) []Suggestion {
+	ordered := slices.Clone(lines)
+	slices.SortStableFunc(ordered, func(a, b StatementLine) int {
+		if c := a.TransactionDate.Time().Compare(b.TransactionDate.Time()); c != 0 {
+			return c
+		}
+		return a.LineNo - b.LineNo
+	})
+	used := map[string]bool{}
+	done := map[uuid.UUID]bool{}
+	var out []Suggestion
+
+	for _, l := range ordered {
+		var hits []MatchCandidate
+		for _, c := range cands {
+			if !used[candidateKey(c)] && c.Amount.Equal(l.Amount) && refMatches(l, c) {
+				hits = append(hits, c)
+			}
+		}
+		if best, ok := pickClosest(l, hits); ok {
+			used[candidateKey(best)], done[l.ID] = true, true
+			out = append(out, Suggestion{LineID: l.ID, Candidate: best, Rule: RuleReference})
+		}
+	}
+	for _, l := range ordered {
+		if done[l.ID] {
+			continue
+		}
+		var hits []MatchCandidate
+		for _, c := range cands {
+			if !used[candidateKey(c)] && c.Amount.Equal(l.Amount) && dayDiff(l.TransactionDate, c.Date) <= toleranceDays {
+				hits = append(hits, c)
+			}
+		}
+		if best, ok := pickClosest(l, hits); ok {
+			used[candidateKey(best)] = true
+			out = append(out, Suggestion{LineID: l.ID, Candidate: best, Rule: RuleAmountDate})
+		}
+	}
+	return out
+}
+
+// pickClosest memilih kandidat dengan tanggal terdekat (baris jurnal didahulukan). Seri → tidak ada usulan.
+func pickClosest(l StatementLine, hits []MatchCandidate) (MatchCandidate, bool) {
+	if len(hits) == 0 {
+		return MatchCandidate{}, false
+	}
+	rank := func(c MatchCandidate) int {
+		r := dayDiff(l.TransactionDate, c.Date) * 2
+		if c.Kind != MatchJournalLine {
+			r++
+		}
+		return r
+	}
+	slices.SortStableFunc(hits, func(a, b MatchCandidate) int { return rank(a) - rank(b) })
+	if len(hits) > 1 && rank(hits[0]) == rank(hits[1]) {
+		return MatchCandidate{}, false
+	}
+	return hits[0], true
+}
+
+// StatementSummary adalah ringkasan satu file mutasi.
+type StatementSummary struct {
+	ID              uuid.UUID
+	BankAccountID   uuid.UUID
+	BankAccountCode string
+	BankAccountName string
+	FileID          uuid.UUID
+	FileName        string
+	PeriodFrom      clock.BusinessDate
+	PeriodTo        clock.BusinessDate
+	LineCount       int
+	TotalIn         money.Amount
+	TotalOut        money.Amount
+	MatchedCount    int
+	SuggestedCount  int
+	CreatedAt       time.Time
+	CreatedBy       uuid.UUID
+}
+
+// NewStatementSummary menghitung periode dan total dari baris hasil baca.
+func NewStatementSummary(rows []StatementRow) StatementSummary {
+	var s StatementSummary
+	s.TotalIn, s.TotalOut = money.Zero, money.Zero
+	for i, r := range rows {
+		if i == 0 || r.Date.Before(s.PeriodFrom) {
+			s.PeriodFrom = r.Date
+		}
+		if i == 0 || r.Date.After(s.PeriodTo) {
+			s.PeriodTo = r.Date
+		}
+		if r.Amount.IsPositive() {
+			s.TotalIn = s.TotalIn.Add(r.Amount)
+		} else {
+			s.TotalOut = s.TotalOut.Add(r.Amount.Neg())
+		}
+	}
+	s.LineCount = len(rows)
+	return s
+}
