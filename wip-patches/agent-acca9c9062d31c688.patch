+	require.NoError(t, err, "pengeluaran kas kecil tanpa re-autentikasi")
+	assert.Equal(t, map[string]string{"Dr 6303": "150000.00", "Cr 1102": "150000.00"}, h.journalLines(t, *exp.JournalEntryID))
