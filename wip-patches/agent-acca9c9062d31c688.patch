+-+	assert.Nil(t, p.PartnerID, "cakupan channel tidak menyimpan mitra")
+-+	assert.Equal(t, domain.BasisFixed, p.Basis)
+-+	assert.True(t, p.Usable())
+-+	assert.Empty(t, p.DeleteError())
+-+
+-+	e, err := domain.NewPriceList(domain.PriceListInput{
