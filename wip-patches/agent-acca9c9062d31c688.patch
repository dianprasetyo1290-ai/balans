+
+function PaymentForm({ value, onClose }: { value?: CashPayment; onClose: () => void }) {
+  const refresh = useFinanceRefresh()
+  const banks = useQuery(cashBankAccountsQuery())
+  const gls = useQuery(accountsQuery(false))
+  const [direction, setDirection] = useState<PaymentDirection>(value?.direction ?? "outgoing")
+  const [bankAccountId, setBankAccountId] = useState(value?.bankAccountId ?? "")
+  const [paymentDate, setPaymentDate] = useState(value?.paymentDate ?? todayBusinessDate())
+  const [amount, setAmount] = useState(value?.amount ?? "")
+  const [counterAccountId, setCounterAccountId] = useState(value?.counterAccountId ?? "")
+  const [partyName, setPartyName] = useState(value?.partyName ?? "")
+  const [reference, setReference] = useState(value?.reference ?? "")
+  const [description, setDescription] = useState(value?.description ?? "")
+  const [proofFileId, setProofFileId] = useState<string | undefined>(value?.proofFileId)
+  const [errors, setErrors] = useState<Record<string, string>>({})
+  const bankGLs = new Set((banks.data ?? []).map((b) => b.accountId))
+  const counterOptions = (gls.data ?? [])
+    .filter((a) => a.isPostable && a.allowManualPosting && !bankGLs.has(a.id))
+    .map((a) => ({ value: a.id, label: `${a.code} ${a.name}` }))
+
+  const save = useIdempotentMutation({
+    mutationFn: (_: void, key) => {
+      const body = { direction, bankAccountId, paymentDate, amount, counterAccountId, partyName, reference, description, proofFileId }
+      return value ? updateCashPayment(value.id, { ...body, version: value.version }, key) : createCashPayment(body, key)
+    },
+    onSuccess: async () => {
+      toast.success("Draft pembayaran disimpan")
+      onClose()
+      await refresh()
+    },
+    onError: (err) => {
+      const p = parseProblem(err)
+      if (p.fields) {
+        setErrors(p.fields)
+        return
+      }
+      showErrorDialog(p)
+    },
+  })
+
+  return (
+    <DialogContent className="sm:max-w-lg">
+      <DialogHeader>
+        <DialogTitle>{value ? "Ubah Pembayaran" : "Catat Pembayaran"}</DialogTitle>
+        <DialogDescription>
+          Penerimaan atau pengeluaran di luar piutang/utang (mis. setoran modal, biaya bank). Pelunasan invoice,
