+-+func options(list []service.Option) []PurchaseOption {
+-+	out := make([]PurchaseOption, len(list))
+-+	for i, o := range list {
+-+		out[i] = PurchaseOption{Id: o.ID, Code: o.Code, Name: o.Name}
+-+	}
+-+	return out
+-+}
