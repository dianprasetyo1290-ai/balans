-		}
-	}
-	slices.Sort(accounts)
-	out := make([]accounting.PostingSplit, len(accounts))
-	for i, a := range accounts {
-		out[i] = accounting.PostingSplit{AmountKey: key, AccountCode: a, Amount: money.FromDecimal(byAccount[a]).Round()}
-	}
-	return out
-}
