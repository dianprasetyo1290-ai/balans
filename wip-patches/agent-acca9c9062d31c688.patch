+          <span className="truncate">{m.description}</span>
+          {m.sourceLabel ? <span className="text-xs text-muted-foreground">{m.sourceLabel}</span> : null}
+        </div>
+      ),
+    },
+    {
+      id: "in",
+      header: "Masuk",
+      align: "right",
+      cell: (m) => (m.amount.startsWith("-") ? "" : formatRupiah(m.amount)),
+    },
+    {
+      id: "out",
+      header: "Keluar",
+      align: "right",
+      cell: (m) => (m.amount.startsWith("-") ? formatRupiah(m.amount.slice(1)) : ""),
+    },
+    { id: "balance", header: "Saldo", align: "right", cell: (m) => formatRupiah(m.balance) },
+    {
+      id: "rec",
+      header: "Rekonsiliasi",
+      cell: (m) => (m.reconciled ? <Badge variant="secondary">Cocok</Badge> : <span className="text-muted-foreground">—</span>),
