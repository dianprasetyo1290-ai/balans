+-+  return message ? (
+-+    <p className="mt-1 text-xs text-destructive">{message}</p>
+-+  ) : null
+-+}
+-+
+-+/** Error field di bawah input. */
+-+export function fieldErrors(message?: string) {
+-+  return message ? [{ message }] : []
+-+}
+-+
+-+type OptionSelectProps = {
+-+  id?: string
+-+  value: string
+-+  onValueChange: (value: string) => void
+-+  options: PurchaseOption[]
+-+  placeholder: string
+-+  showCode?: boolean
+-+  "aria-invalid"?: boolean
+-+  "aria-label"?: string
+-+}
+-+
+-+/** Pilihan divisi atau akun dari daftar kode–nama. */
+-+export function OptionSelect({
+-+  id,
+-+  value,
+-+  onValueChange,
+-+  options,
+-+  placeholder,
+-+  showCode = false,
+-+  ...aria
+-+}: OptionSelectProps) {
+-+  const text = (o: PurchaseOption) => (showCode ? `${o.code} ${o.name}` : o.name)
+-+  return (
+-+    <Select value={value} onValueChange={(v) => onValueChange(String(v ?? ""))}>
+-+      <SelectTrigger
+-+        id={id}
+-+        className="w-full"
+-+        aria-invalid={aria["aria-invalid"]}
+-+        aria-label={aria["aria-label"]}
+-+      >
+-+        <SelectValue>
+-+          {(v: string) => {
+-+            const o = options.find((x) => x.id === v || x.code === v)
+-+            return o ? text(o) : placeholder
+-+          }}
+-+        </SelectValue>
+-+      </SelectTrigger>
+-+      <SelectContent>
+-+        {options.map((o) => (
+-+          <SelectItem key={o.id} value={showCode ? o.code : o.id}>
+-+            {text(o)}
+-+          </SelectItem>
+-+        ))}
+-+      </SelectContent>
+-+    </Select>
+-+  )
