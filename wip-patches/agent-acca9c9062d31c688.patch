+-+// --- Uang muka ----------------------------------------------------------------------------------
+-+
+-+// AdvanceFilter adalah kriteria daftar uang muka.
+-+type AdvanceFilter struct {
+-+	Status          domain.Status
+-+	PurchaseOrderID *uuid.UUID
+-+	SupplierID      *uuid.UUID
+-+	DateFrom        *clock.BusinessDate
+-+	DateTo          *clock.BusinessDate
+-+	Search          string
