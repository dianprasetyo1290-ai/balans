+-+    api.DELETE("/api/v1/price-lists/{id}", {
+-+      params: { path: { id }, query: { version }, ...idem(key) },
+-+    })
+-+  )
+-+}
+-+
+-+export function restorePriceList(id: string, version: number, key: string) {
+-+  return unwrap(
+-+    api.POST("/api/v1/price-lists/{id}/restore", {
+-+      params: { path: { id }, ...idem(key) },
+-+      body: { version },
