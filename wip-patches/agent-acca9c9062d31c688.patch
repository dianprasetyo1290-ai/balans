-	for _, l := range r.Lines {
-		add(key{"unbilled_return_value", l.InventoryAccount}, l.UnbilledAmount)
-		add(key{"return_value", l.InventoryAccount}, l.BilledAmount())
-	}
-	for _, k := range order {
