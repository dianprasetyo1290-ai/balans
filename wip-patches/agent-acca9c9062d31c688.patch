+    CONSTRAINT uq_bank_accounts_code UNIQUE (code),
+    CONSTRAINT fk_bank_accounts_account_id FOREIGN KEY (account_id) REFERENCES accounts (id),
+    CONSTRAINT ck_bank_accounts_code CHECK (code ~ '^[A-Z0-9][A-Z0-9_-]{1,29}$'),
+    CONSTRAINT ck_bank_accounts_name CHECK (btrim(name) <> ''),
+    CONSTRAINT ck_bank_accounts_kind CHECK (kind IN ('bank', 'cash')),
+    CONSTRAINT ck_bank_accounts_bank CHECK (kind = 'cash' OR (bank_name <> '' AND account_number_enc <> ''))
+);
+-- Satu akun GL hanya untuk satu rekening aktif (belum dihapus) agar mutasi rekening = Buku Besar akun.
+CREATE UNIQUE INDEX uq_bank_accounts_account_id ON bank_accounts (account_id) WHERE deleted_at IS NULL;
+
+-- Pembayaran masuk/keluar (BYR). Jurnal A-PB: masuk Dr akun rekening / Cr akun lawan; keluar Dr akun lawan /
+-- Cr akun rekening. source_* menautkan dokumen yang dibayar (pengajuan biaya, tagihan pemasok, invoice).
+CREATE TABLE payments (
+    id                 uuid          NOT NULL DEFAULT uuidv7(),
+    number             text,
+    direction          text          NOT NULL,
+    bank_account_id    uuid          NOT NULL,
+    payment_date       date          NOT NULL,
+    amount             numeric(18,2) NOT NULL,
+    counter_account_id uuid          NOT NULL,
+    party_type         text          NOT NULL DEFAULT '',
+    party_id           uuid,
+    party_name         text          NOT NULL DEFAULT '',
+    reference          text          NOT NULL DEFAULT '',
+    description        text          NOT NULL DEFAULT '',
+    proof_file_id      uuid,
+    source_type        text          NOT NULL DEFAULT '',
+    source_id          uuid,
+    source_label       text          NOT NULL DEFAULT '',
+    status             text          NOT NULL DEFAULT 'draft',
+    journal_entry_id   uuid,
+    posted_at          timestamptz,
+    posted_by          uuid,
+    cancelled_at       timestamptz,
+    cancelled_by       uuid,
+    cancel_reason      text          NOT NULL DEFAULT '',
+    created_at         timestamptz   NOT NULL DEFAULT now(),
+    created_by         uuid          NOT NULL,
+    updated_at         timestamptz   NOT NULL DEFAULT now(),
+    updated_by         uuid          NOT NULL,
+    version            integer       NOT NULL DEFAULT 1,
+    deleted_at         timestamptz,
+    deleted_by         uuid,
+    CONSTRAINT pk_payments PRIMARY KEY (id),
+    CONSTRAINT uq_payments_number UNIQUE (number),
+    CONSTRAINT fk_payments_bank_account_id FOREIGN KEY (bank_account_id) REFERENCES bank_accounts (id),
+    CONSTRAINT fk_payments_counter_account_id FOREIGN KEY (counter_account_id) REFERENCES accounts (id),
+    CONSTRAINT fk_payments_journal_entry_id FOREIGN KEY (journal_entry_id) REFERENCES journal_entries (id),
+    CONSTRAINT ck_payments_direction CHECK (direction IN ('incoming', 'outgoing')),
+    CONSTRAINT ck_payments_amount CHECK (amount > 0),
+    CONSTRAINT ck_payments_status CHECK (status IN ('draft', 'posted', 'cancelled')),
+    CONSTRAINT ck_payments_party CHECK ((party_type = '') = (party_id IS NULL)),
+    CONSTRAINT ck_payments_posted CHECK (status = 'draft' OR (number IS NOT NULL AND journal_entry_id IS NOT NULL)
+        OR (status = 'cancelled' AND number IS NULL)),
+    CONSTRAINT ck_payments_deleted CHECK (deleted_at IS NULL OR status = 'draft')
+);
+CREATE INDEX idx_payments_bank_account_id ON payments (bank_account_id, payment_date DESC);
+CREATE INDEX idx_payments_counter_account_id ON payments (counter_account_id);
+CREATE INDEX idx_payments_journal_entry_id ON payments (journal_entry_id);
+CREATE INDEX idx_payments_source ON payments (source_type, source_id) WHERE source_id IS NOT NULL;
+CREATE INDEX idx_payments_status ON payments (status, payment_date DESC) WHERE deleted_at IS NULL;
+
+-- File mutasi rekening yang diimpor (CSV/Excel). Satu file hanya sekali diimpor.
+CREATE TABLE bank_statements (
+    id              uuid          NOT NULL DEFAULT uuidv7(),
+    bank_account_id uuid          NOT NULL,
+    file_id         uuid          NOT NULL,
+    file_name       text          NOT NULL DEFAULT '',
+    period_from     date          NOT NULL,
+    period_to       date          NOT NULL,
+    line_count      integer       NOT NULL DEFAULT 0,
+    total_in        numeric(18,2) NOT NULL DEFAULT 0,
+    total_out       numeric(18,2) NOT NULL DEFAULT 0,
+    created_at      timestamptz   NOT NULL DEFAULT now(),
+    created_by      uuid          NOT NULL,
+    updated_at      timestamptz   NOT NULL DEFAULT now(),
+    updated_by      uuid          NOT NULL,
+    version         integer       NOT NULL DEFAULT 1,
+    CONSTRAINT pk_bank_statements PRIMARY KEY (id),
+    CONSTRAINT uq_bank_statements_file_id UNIQUE (file_id),
+    CONSTRAINT fk_bank_statements_bank_account_id FOREIGN KEY (bank_account_id) REFERENCES bank_accounts (id),
+    CONSTRAINT ck_bank_statements_period CHECK (period_to >= period_from)
+);
+CREATE INDEX idx_bank_statements_bank_account_id ON bank_statements (bank_account_id, period_to DESC);
+
+-- Baris mutasi bank. amount bertanda: positif = dana masuk (kredit di rekening koran), negatif = keluar.
+-- Usulan dan hasil pencocokan disimpan di baris (1 baris mutasi ↔ 1 baris jurnal akun rekening):
+--   match_kind `journal_line` = transaksi yang sudah dijurnal, `document` = dokumen terbuka dari penyedia kandidat
+--   (piutang/utang/pengajuan biaya) yang dibayar saat konfirmasi, `new_entry` = jurnal baru dari baris tak cocok.
+CREATE TABLE bank_statement_lines (
+    id                    uuid          NOT NULL DEFAULT uuidv7(),
+    statement_id          uuid          NOT NULL,
+    line_no               integer       NOT NULL,
+    transaction_date      date          NOT NULL,
+    description           text          NOT NULL DEFAULT '',
+    reference             text          NOT NULL DEFAULT '',
+    amount                numeric(18,2) NOT NULL,
+    balance               numeric(18,2),
+    status                text          NOT NULL DEFAULT 'unmatched',
+    match_kind            text          NOT NULL DEFAULT '',
+    match_rule            text          NOT NULL DEFAULT '',
+    journal_line_id       uuid,
+    journal_entry_id      uuid,
+    candidate_source      text          NOT NULL DEFAULT '',
+    candidate_document_id uuid,
+    candidate_label       text          NOT NULL DEFAULT '',
+    payment_id            uuid,
+    matched_at            timestamptz,
+    matched_by            uuid,
+    updated_at            timestamptz   NOT NULL DEFAULT now(),
+    version               integer       NOT NULL DEFAULT 1,
+    CONSTRAINT pk_bank_statement_lines PRIMARY KEY (id),
+    CONSTRAINT uq_bank_statement_lines_line_no UNIQUE (statement_id, line_no),
+    CONSTRAINT fk_bank_statement_lines_statement_id FOREIGN KEY (statement_id) REFERENCES bank_statements (id),
+    CONSTRAINT fk_bank_statement_lines_journal_line_id FOREIGN KEY (journal_line_id) REFERENCES journal_lines (id),
+    CONSTRAINT fk_bank_statement_lines_journal_entry_id FOREIGN KEY (journal_entry_id) REFERENCES journal_entries (id),
+    CONSTRAINT fk_bank_statement_lines_payment_id FOREIGN KEY (payment_id) REFERENCES payments (id),
+    CONSTRAINT ck_bank_statement_lines_amount CHECK (amount <> 0),
+    CONSTRAINT ck_bank_statement_lines_status CHECK (status IN ('unmatched', 'suggested', 'matched')),
+    CONSTRAINT ck_bank_statement_lines_kind CHECK (match_kind IN ('', 'journal_line', 'document', 'new_entry')),
+    CONSTRAINT ck_bank_statement_lines_rule CHECK (match_rule IN ('', 'reference', 'amount_date', 'manual')),
+    CONSTRAINT ck_bank_statement_lines_matched CHECK (status <> 'matched' OR journal_line_id IS NOT NULL),
+    CONSTRAINT ck_bank_statement_lines_unmatched CHECK (status <> 'unmatched' OR match_kind = '')
+);
+CREATE INDEX idx_bank_statement_lines_journal_line_id ON bank_statement_lines (journal_line_id);
+CREATE INDEX idx_bank_statement_lines_journal_entry_id ON bank_statement_lines (journal_entry_id);
+CREATE INDEX idx_bank_statement_lines_payment_id ON bank_statement_lines (payment_id);
+-- Satu baris jurnal hanya bisa direkonsiliasi dengan satu baris mutasi.
+CREATE UNIQUE INDEX uq_bank_statement_lines_reconciled ON bank_statement_lines (journal_line_id) WHERE status = 'matched';
+
+-- Kas Besar (1101) disemai sebagai rekening kas. Rekening bank dibuat Finance & Accounting karena nomor
+-- rekening wajib terenkripsi.
+INSERT INTO bank_accounts (code, name, kind, account_id, created_by, updated_by)
+SELECT 'KAS-BESAR', a.name, 'cash', a.id, '00000000-0000-0000-0000-000000000000', '00000000-0000-0000-0000-000000000000'
+FROM accounts a WHERE a.code = '1101';
+
+-- +goose Down
+DROP TABLE bank_statement_lines;
+DROP TABLE bank_statements;
+DROP TABLE payments;
+DROP TABLE bank_accounts;
diff --git a/backend/migrations/20261030000200_create_expense_claims_petty_cash.sql b/backend/migrations/20261030000200_create_expense_claims_petty_cash.sql
new file mode 100644
index 0000000..271da82
--- /dev/null
+++ b/backend/migrations/20261030000200_create_expense_claims_petty_cash.sql
@@ -0,0 +1,167 @@
+-- +goose Up
+-- Pengajuan biaya/reimbursement (S-404, ACC-11, A-15) dan kas kecil imprest (S-405, ACC-12, A-16, A-17).
+-- Desain Status Dokumen 6.1 – 6.2.
+
+CREATE TABLE expense_claims (
+    id                 uuid          NOT NULL DEFAULT uuidv7(),
+    number             text,
+    claim_type         text          NOT NULL DEFAULT 'expense',
+    requester_id       uuid          NOT NULL,
+    division_id        uuid          NOT NULL,
+    campaign_id        uuid,
+    payee_type         text          NOT NULL DEFAULT 'other',
+    payee_id           uuid,
+    payee_name         text          NOT NULL,
+    payee_tax_id_enc   text          NOT NULL DEFAULT '',
+    claim_date         date          NOT NULL,
+    description        text          NOT NULL DEFAULT '',
+    total_amount       numeric(18,2) NOT NULL DEFAULT 0,
+    withholding_amount numeric(18,2) NOT NULL DEFAULT 0,
+    payable_amount     numeric(18,2) NOT NULL DEFAULT 0,
+    status             text          NOT NULL DEFAULT 'draft',
+    submitted_at       timestamptz,
+    decided_at         timestamptz,
+    decision_note      text          NOT NULL DEFAULT '',
+    verified_at        timestamptz,
+    verified_by        uuid,
+    verify_date        date,
+    journal_entry_id   uuid,
+    payment_id         uuid,
+    paid_at            timestamptz,
+    cancel_reason      text          NOT NULL DEFAULT '',
+    created_at         timestamptz   NOT NULL DEFAULT now(),
+    created_by         uuid          NOT NULL,
+    updated_at         timestamptz   NOT NULL DEFAULT now(),
+    updated_by         uuid          NOT NULL,
+    version            integer       NOT NULL DEFAULT 1,
+    deleted_at         timestamptz,
+    deleted_by         uuid,
+    CONSTRAINT pk_expense_claims PRIMARY KEY (id),
+    CONSTRAINT uq_expense_claims_number UNIQUE (number),
+    CONSTRAINT fk_expense_claims_division_id FOREIGN KEY (division_id) REFERENCES divisions (id),
+    CONSTRAINT fk_expense_claims_campaign_id FOREIGN KEY (campaign_id) REFERENCES campaigns (id),
+    CONSTRAINT fk_expense_claims_journal_entry_id FOREIGN KEY (journal_entry_id) REFERENCES journal_entries (id),
+    CONSTRAINT fk_expense_claims_payment_id FOREIGN KEY (payment_id) REFERENCES payments (id),
+    CONSTRAINT ck_expense_claims_type CHECK (claim_type IN ('expense', 'reimbursement')),
+    CONSTRAINT ck_expense_claims_payee_type CHECK (payee_type IN ('employee', 'supplier', 'other')),
+    CONSTRAINT ck_expense_claims_payee_name CHECK (btrim(payee_name) <> ''),
+    CONSTRAINT ck_expense_claims_status CHECK (status IN (
+        'draft', 'pending_approval', 'approved', 'rejected', 'awaiting_payment', 'paid', 'cancelled')),
+    CONSTRAINT ck_expense_claims_amounts CHECK (total_amount >= 0 AND withholding_amount >= 0
+        AND payable_amount = total_amount - withholding_amount),
+    CONSTRAINT ck_expense_claims_number CHECK (status IN ('draft', 'cancelled') OR number IS NOT NULL),
+    CONSTRAINT ck_expense_claims_verified CHECK (status NOT IN ('awaiting_payment', 'paid') OR journal_entry_id IS NOT NULL),
+    CONSTRAINT ck_expense_claims_deleted CHECK (deleted_at IS NULL OR status = 'draft')
+);
+CREATE INDEX idx_expense_claims_division_id ON expense_claims (division_id);
+CREATE INDEX idx_expense_claims_campaign_id ON expense_claims (campaign_id);
+CREATE INDEX idx_expense_claims_journal_entry_id ON expense_claims (journal_entry_id);
+CREATE INDEX idx_expense_claims_payment_id ON expense_claims (payment_id);
+CREATE INDEX idx_expense_claims_requester ON expense_claims (requester_id, created_at DESC) WHERE deleted_at IS NULL;
+CREATE INDEX idx_expense_claims_status ON expense_claims (status, created_at DESC) WHERE deleted_at IS NULL;
+
+-- Baris biaya. Kolom withholding_* diisi saat verifikasi F&A (PPh per baris dari kalkulator tax).
+CREATE TABLE expense_claim_lines (
+    id                 uuid          NOT NULL DEFAULT uuidv7(),
+    claim_id           uuid          NOT NULL,
+    line_no            integer       NOT NULL,
+    expense_type_id    uuid          NOT NULL,
+    description        text          NOT NULL DEFAULT '',
+    amount             numeric(18,2) NOT NULL,
+    receipt_file_id    uuid,
+    withholding_type   text          NOT NULL DEFAULT 'none',
+    object_code        text          NOT NULL DEFAULT '',
+    withholding_rate   numeric(9,4)  NOT NULL DEFAULT 0,
+    withholding_amount numeric(18,2) NOT NULL DEFAULT 0,
+    created_at         timestamptz   NOT NULL DEFAULT now(),
+    created_by         uuid          NOT NULL,
+    CONSTRAINT pk_expense_claim_lines PRIMARY KEY (id),
+    CONSTRAINT uq_expense_claim_lines_line_no UNIQUE (claim_id, line_no),
+    CONSTRAINT fk_expense_claim_lines_claim_id FOREIGN KEY (claim_id) REFERENCES expense_claims (id) ON DELETE CASCADE,
+    CONSTRAINT fk_expense_claim_lines_expense_type_id FOREIGN KEY (expense_type_id) REFERENCES expense_types (id),
+    CONSTRAINT ck_expense_claim_lines_amount CHECK (amount > 0),
+    CONSTRAINT ck_expense_claim_lines_withholding CHECK (withholding_type IN ('none', 'pph21', 'pph23', 'pph4_2')),
+    CONSTRAINT ck_expense_claim_lines_withholding_amount CHECK (withholding_amount >= 0 AND withholding_amount <= amount)
+);
+CREATE INDEX idx_expense_claim_lines_expense_type_id ON expense_claim_lines (expense_type_id);
+
+-- Dana kas kecil (imprest): plafon per dana, saldo diperbarui setiap pengeluaran/pengisian diposting.
+-- Akun GL selalu 1102 Kas Kecil (rule A-16/A-17 fixed).
+CREATE TABLE petty_cash_funds (
+    id             uuid          NOT NULL DEFAULT uuidv7(),
+    code           text          NOT NULL,
+    name           text          NOT NULL,
+    holder_user_id uuid          NOT NULL,
+    division_id    uuid          NOT NULL,
+    ceiling_amount numeric(18,2) NOT NULL,
+    balance_amount numeric(18,2) NOT NULL DEFAULT 0,
+    is_active      boolean       NOT NULL DEFAULT true,
+    description    text          NOT NULL DEFAULT '',
+    created_at     timestamptz   NOT NULL DEFAULT now(),
+    created_by     uuid          NOT NULL,
+    updated_at     timestamptz   NOT NULL DEFAULT now(),
+    updated_by     uuid          NOT NULL,
+    version        integer       NOT NULL DEFAULT 1,
+    CONSTRAINT pk_petty_cash_funds PRIMARY KEY (id),
+    CONSTRAINT uq_petty_cash_funds_code UNIQUE (code),
+    CONSTRAINT fk_petty_cash_funds_division_id FOREIGN KEY (division_id) REFERENCES divisions (id),
+    CONSTRAINT ck_petty_cash_funds_code CHECK (code ~ '^[A-Z0-9][A-Z0-9_-]{1,29}$'),
+    CONSTRAINT ck_petty_cash_funds_name CHECK (btrim(name) <> ''),
+    CONSTRAINT ck_petty_cash_funds_ceiling CHECK (ceiling_amount > 0),
+    CONSTRAINT ck_petty_cash_funds_balance CHECK (balance_amount >= 0 AND balance_amount <= ceiling_amount)
+);
+CREATE INDEX idx_petty_cash_funds_division_id ON petty_cash_funds (division_id);
+
+-- Transaksi kas kecil (KK): pengeluaran `draft → posted` (A-17), pengisian kembali
+-- `draft → pending_approval → approved → posted` (A-16).
+CREATE TABLE petty_cash_transactions (
+    id               uuid          NOT NULL DEFAULT uuidv7(),
+    number           text,
+    fund_id          uuid          NOT NULL,
+    transaction_type text          NOT NULL,
+    business_date    date          NOT NULL,
+    expense_type_id  uuid,
+    division_id      uuid          NOT NULL,
+    campaign_id      uuid,
+    description      text          NOT NULL DEFAULT '',
+    amount           numeric(18,2) NOT NULL,
+    receipt_file_id  uuid,
+    bank_account_id  uuid,
+    status           text          NOT NULL DEFAULT 'draft',
+    decision_note    text          NOT NULL DEFAULT '',
+    journal_entry_id uuid,
+    posted_at        timestamptz,
+    posted_by        uuid,
+    cancel_reason    text          NOT NULL DEFAULT '',
+    created_at       timestamptz   NOT NULL DEFAULT now(),
+    created_by       uuid          NOT NULL,
+    updated_at       timestamptz   NOT NULL DEFAULT now(),
+    updated_by       uuid          NOT NULL,
+    version          integer       NOT NULL DEFAULT 1,
+    CONSTRAINT pk_petty_cash_transactions PRIMARY KEY (id),
+    CONSTRAINT uq_petty_cash_transactions_number UNIQUE (number),
+    CONSTRAINT fk_petty_cash_transactions_fund_id FOREIGN KEY (fund_id) REFERENCES petty_cash_funds (id),
+    CONSTRAINT fk_petty_cash_transactions_expense_type_id FOREIGN KEY (expense_type_id) REFERENCES expense_types (id),
+    CONSTRAINT fk_petty_cash_transactions_division_id FOREIGN KEY (division_id) REFERENCES divisions (id),
+    CONSTRAINT fk_petty_cash_transactions_campaign_id FOREIGN KEY (campaign_id) REFERENCES campaigns (id),
+    CONSTRAINT fk_petty_cash_transactions_bank_account_id FOREIGN KEY (bank_account_id) REFERENCES bank_accounts (id),
+    CONSTRAINT fk_petty_cash_transactions_journal_entry_id FOREIGN KEY (journal_entry_id) REFERENCES journal_entries (id),
+    CONSTRAINT ck_petty_cash_transactions_type CHECK (transaction_type IN ('expense', 'replenishment')),
+    CONSTRAINT ck_petty_cash_transactions_amount CHECK (amount > 0),
+    CONSTRAINT ck_petty_cash_transactions_status CHECK (status IN (
+        'draft', 'pending_approval', 'approved', 'rejected', 'posted', 'cancelled')),
+    CONSTRAINT ck_petty_cash_transactions_expense CHECK (transaction_type <> 'expense' OR expense_type_id IS NOT NULL),
+    CONSTRAINT ck_petty_cash_transactions_posted CHECK (status <> 'posted' OR (number IS NOT NULL AND journal_entry_id IS NOT NULL))
+);
+CREATE INDEX idx_petty_cash_transactions_fund_id ON petty_cash_transactions (fund_id, business_date DESC);
+CREATE INDEX idx_petty_cash_transactions_expense_type_id ON petty_cash_transactions (expense_type_id);
+CREATE INDEX idx_petty_cash_transactions_division_id ON petty_cash_transactions (division_id);
+CREATE INDEX idx_petty_cash_transactions_campaign_id ON petty_cash_transactions (campaign_id);
+CREATE INDEX idx_petty_cash_transactions_bank_account_id ON petty_cash_transactions (bank_account_id);
+CREATE INDEX idx_petty_cash_transactions_journal_entry_id ON petty_cash_transactions (journal_entry_id);
+
+-- +goose Down
+DROP TABLE petty_cash_transactions;
+DROP TABLE petty_cash_funds;
+DROP TABLE expense_claim_lines;
+DROP TABLE expense_claims;
diff --git a/backend/migrations/20261030000300_create_tax.sql b/backend/migrations/20261030000300_create_tax.sql
new file mode 100644
index 0000000..6993b0e
--- /dev/null
+++ b/backend/migrations/20261030000300_create_tax.sql
@@ -0,0 +1,174 @@
+-- +goose Up
+-- PPh potong 21/23/4(2), bukti potong, penyetoran (A-29), dan PPh Final UMKM (A-30) — S-406, S-407; BRD ACC-19,
+-- ACC-20; Technical Guideline 5.9, 5.14. Kalkulator di package tax; tarif effective-dated di sini.
+
+-- Tarif per jenis pajak dan kode objek pajak (Coretax). brackets = lapisan tarif progresif Pasal 17
+-- [{"upTo": "60000000.00", "ratePercent": "5"}, ...] (upTo kosong = tanpa batas); base_percent = DPP % bruto.
+CREATE TABLE withholding_tax_rates (
+    id                          uuid         NOT NULL DEFAULT uuidv7(),
+    tax_type                    text         NOT NULL,
+    object_code                 text         NOT NULL,
+    name                        text         NOT NULL,
+    rate_percent                numeric(9,4) NOT NULL DEFAULT 0,
+    brackets                    jsonb        NOT NULL DEFAULT '[]',
+    base_percent                numeric(9,4) NOT NULL DEFAULT 100,
+    no_tax_id_surcharge_percent numeric(9,4) NOT NULL DEFAULT 0,
+    is_default                  boolean      NOT NULL DEFAULT false,
+    valid_from                  date         NOT NULL,
+    valid_to                    date,
+    note                        text         NOT NULL DEFAULT '',
+    created_at                  timestamptz  NOT NULL DEFAULT now(),
+    created_by                  uuid         NOT NULL,
+    updated_at                  timestamptz  NOT NULL DEFAULT now(),
+    updated_by                  uuid         NOT NULL,
+    version                     integer      NOT NULL DEFAULT 1,
+    CONSTRAINT pk_withholding_tax_rates PRIMARY KEY (id),
+    CONSTRAINT ck_withholding_tax_rates_type CHECK (tax_type IN ('pph21', 'pph23', 'pph4_2', 'final_umkm')),
+    CONSTRAINT ck_withholding_tax_rates_object CHECK (btrim(object_code) <> ''),
+    CONSTRAINT ck_withholding_tax_rates_rate CHECK (rate_percent >= 0 AND rate_percent <= 100),
+    CONSTRAINT ck_withholding_tax_rates_base CHECK (base_percent > 0 AND base_percent <= 100),
+    CONSTRAINT ck_withholding_tax_rates_valid CHECK (valid_to IS NULL OR valid_to >= valid_from),
+    CONSTRAINT ex_withholding_tax_rates_period EXCLUDE USING gist (
+        tax_type WITH =, object_code WITH =, daterange(valid_from, valid_to, '[]') WITH &&)
+);
+
+-- Penyetoran pajak per jenis dan masa (A-29: Dr utang PPh / Cr bank). Satu penyetoran per jenis per masa.
+CREATE TABLE tax_deposits (
+    id               uuid          NOT NULL DEFAULT uuidv7(),
+    number           text          NOT NULL,
+    tax_type         text          NOT NULL,
+    tax_year         integer       NOT NULL,
+    tax_month        integer       NOT NULL,
+    bank_account_id  uuid          NOT NULL,
+    deposit_date     date          NOT NULL,
+    amount           numeric(18,2) NOT NULL,
+    billing_code     text          NOT NULL DEFAULT '',
+    ntpn             text          NOT NULL DEFAULT '',
+    journal_entry_id uuid          NOT NULL,
+    created_at       timestamptz   NOT NULL DEFAULT now(),
+    created_by       uuid          NOT NULL,
+    CONSTRAINT pk_tax_deposits PRIMARY KEY (id),
+    CONSTRAINT uq_tax_deposits_number UNIQUE (number),
+    CONSTRAINT uq_tax_deposits_period UNIQUE (tax_type, tax_year, tax_month),
+    CONSTRAINT fk_tax_deposits_bank_account_id FOREIGN KEY (bank_account_id) REFERENCES bank_accounts (id),
+    CONSTRAINT fk_tax_deposits_journal_entry_id FOREIGN KEY (journal_entry_id) REFERENCES journal_entries (id),
+    CONSTRAINT ck_tax_deposits_type CHECK (tax_type IN ('pph21', 'pph23', 'pph4_2', 'final_umkm')),
+    CONSTRAINT ck_tax_deposits_month CHECK (tax_month BETWEEN 1 AND 12),
+    CONSTRAINT ck_tax_deposits_amount CHECK (amount > 0)
+);
+CREATE INDEX idx_tax_deposits_bank_account_id ON tax_deposits (bank_account_id);
+CREATE INDEX idx_tax_deposits_journal_entry_id ON tax_deposits (journal_entry_id);
+
+-- Data bukti potong per dokumen sumber (pengajuan biaya, tagihan pemasok) per jenis + objek pajak. NPWP/NIK
+-- penerima terenkripsi; slip_number = nomor bukti potong dari Coretax setelah diinput.
+CREATE TABLE withholdings (
+    id                  uuid          NOT NULL DEFAULT uuidv7(),
+    source_type         text          NOT NULL,
+    source_id           uuid          NOT NULL,
+    source_label        text          NOT NULL DEFAULT '',
+    business_date       date          NOT NULL,
+    tax_year            integer       NOT NULL,
+    tax_month           integer       NOT NULL,
+    tax_type            text          NOT NULL,
+    object_code         text          NOT NULL,
+    object_name         text          NOT NULL DEFAULT '',
+    rate_id             uuid          NOT NULL,
+    taxpayer_type       text          NOT NULL DEFAULT '',
+    taxpayer_id         uuid,
+    taxpayer_name       text          NOT NULL,
+    taxpayer_tax_id_enc text          NOT NULL DEFAULT '',
+    has_tax_id          boolean       NOT NULL DEFAULT false,
+    gross_amount        numeric(18,2) NOT NULL,
+    taxable_base        numeric(18,2) NOT NULL,
+    rate_percent        numeric(9,4)  NOT NULL,
