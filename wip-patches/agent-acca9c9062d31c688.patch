+-+  return unwrap(
+-+    api.PUT("/api/v1/price-list-versions/{id}", {
+-+      params: { path: { id }, ...idem(key) },
+-+      body,
+-+    })
+-+  )
+-+}
+-+
+-+export type VersionAction = "submit" | "withdraw" | "cancel"
+-+
+-+export function transitionPriceListVersion(
+-+  id: string,
+-+  action: VersionAction,
+-+  version: number,
+-+  key: string
