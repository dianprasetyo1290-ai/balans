+            <li key={`${c.kind}-${c.journalLineId ?? c.documentId}`} className="flex items-center justify-between gap-3 p-3 text-sm">
+              <div className="flex min-w-0 flex-col">
+                <span className="truncate font-medium">{c.label}</span>
+                <span className="text-xs text-muted-foreground">
+                  {KIND_LABELS[c.kind]} · {formatDate(c.date)}
+                </span>
+              </div>
+              <div className="flex items-center gap-3">
+                <span className="whitespace-nowrap tabular-nums">{formatRupiah(c.amount)}</span>
+                <Button size="sm" disabled={save.isPending} onClick={() => save.mutate(c)}>
+                  Pilih
+                </Button>
+              </div>
+            </li>
+          ))}
+          {candidates.data?.length === 0 ? (
+            <li className="p-3 text-sm text-muted-foreground">Tidak ada kandidat searah. Gunakan Buat Jurnal.</li>
+          ) : null}
+        </ul>
+      </LoadingArea>
+      <DialogFooter>
+        <Button variant="outline" onClick={onClose}>
+          Tutup
+        </Button>
+      </DialogFooter>
+    </DialogContent>
+  )
+}
+
+function EntryForm({ line, onClose }: { line: BankStatementLine; onClose: () => void }) {
+  const refresh = useFinanceRefresh()
+  const gls = useQuery(accountsQuery(false))
+  const banks = useQuery(cashBankAccountsQuery())
+  const [counterAccountId, setCounterAccountId] = useState("")
+  const [description, setDescription] = useState(line.description)
+  const [errors, setErrors] = useState<Record<string, string>>({})
+  const bankGLs = new Set((banks.data ?? []).map((b) => b.accountId))
+  const options = (gls.data ?? [])
+    .filter((a) => a.isPostable && a.allowManualPosting && !bankGLs.has(a.id))
+    .map((a) => ({ value: a.id, label: `${a.code} ${a.name}` }))
+  const save = useIdempotentMutation({
+    mutationFn: (_: void, key) =>
+      createStatementLineEntry(line.id, { version: line.version, counterAccountId, description }, key),
+    onSuccess: async () => {
+      toast.success("Jurnal dibuat dan baris direkonsiliasi")
+      onClose()
+      await refresh()
+    },
+    onError: (err) => {
+      const p = parseProblem(err)
+      if (p.fields) {
+        setErrors(p.fields)
+        return
+      }
+      showErrorDialog(p)
+    },
+  })
+  return (
+    <DialogContent className="sm:max-w-lg">
+      <DialogHeader>
+        <DialogTitle>Buat Jurnal dari Mutasi</DialogTitle>
+        <DialogDescription>
+          Untuk mutasi tanpa pasangan seperti biaya administrasi, bunga, atau pajak bunga. Sistem membuat pembayaran{" "}
+          {line.amount.startsWith("-") ? "keluar" : "masuk"} {formatRupiah(line.amount.replace("-", ""))} yang langsung
+          diposting.
+        </DialogDescription>
+      </DialogHeader>
+      <form
+        noValidate
+        className="flex flex-col gap-4"
+        onSubmit={(e) => {
+          e.preventDefault()
+          if (!counterAccountId) {
+            setErrors({ counterAccountId: "Akun lawan wajib dipilih" })
+            return
+          }
+          save.mutate()
+        }}
+      >
+        <Field data-invalid={!!errors.counterAccountId}>
+          <FieldLabel htmlFor="en-account">Akun Lawan</FieldLabel>
+          <SimpleSelect
+            id="en-account"
+            value={counterAccountId}
+            onValueChange={setCounterAccountId}
+            options={options}
+            placeholder="Mis. 7202 Beban Bank"
+            aria-invalid={!!errors.counterAccountId}
+          />
+          <FieldError errors={fieldErrors(errors.counterAccountId)} />
+        </Field>
+        <Field>
+          <FieldLabel htmlFor="en-desc">Keterangan</FieldLabel>
+          <Input id="en-desc" value={description} maxLength={500} onChange={(e) => setDescription(e.target.value)} />
+        </Field>
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={onClose}>
+            Batal
+          </Button>
+          <LoadingButton type="submit" loading={save.isPending} loadingText="Menyimpan…">
+            Buat Jurnal
+          </LoadingButton>
+        </DialogFooter>
+      </form>
+    </DialogContent>
+  )
+}
