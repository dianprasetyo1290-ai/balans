+-+	PreparedBy       uuid.NullUUID
+-+	PreparedByName   string
+-+	PreparedAt       *time.Time
+-+	ShippedBy        uuid.NullUUID
+-+	ShippedByName    string
+-+	ShippedAt        *time.Time
+-+	ReceivedBy       uuid.NullUUID
+-+	ReceivedByName   string
+-+	ReceivedAt       *time.Time
+-+	CompletedAt      *time.Time
+-+	CancelledAt      *time.Time
+-+	CancelReason     string
+-+	ActorID          uuid.UUID
+-+	ID               uuid.UUID
+-+	Version          int32
+-+}
+-+
+-+func (q *Queries) UpdateTransfer(ctx context.Context, arg UpdateTransferParams) (StockTransfer, error) {
+-+	row := q.db.QueryRow(ctx, updateTransfer,
+-+		arg.Number,
+-+		arg.FromLocationID,
+-+		arg.ToLocationID,
+-+		arg.RequiresShipping,
+-+		arg.BusinessDate,
+-+		arg.Status,
+-+		arg.Note,
+-+		arg.SubmittedAt,
+-+		arg.ReleasedBy,
+-+		arg.ReleasedByName,
+-+		arg.ReleasedAt,
+-+		arg.PreparedBy,
+-+		arg.PreparedByName,
+-+		arg.PreparedAt,
+-+		arg.ShippedBy,
+-+		arg.ShippedByName,
+-+		arg.ShippedAt,
+-+		arg.ReceivedBy,
+-+		arg.ReceivedByName,
+-+		arg.ReceivedAt,
+-+		arg.CompletedAt,
+-+		arg.CancelledAt,
+-+		arg.CancelReason,
+-+		arg.ActorID,
+-+		arg.ID,
+-+		arg.Version,
+-+	)
+-+	var i StockTransfer
+-+	err := row.Scan(
+-+		&i.ID,
+-+		&i.Number,
+-+		&i.TransferType,
+-+		&i.FromLocationID,
+-+		&i.ToLocationID,
+-+		&i.RequiresShipping,
+-+		&i.BusinessDate,
+-+		&i.Status,
+-+		&i.SourceType,
+-+		&i.SourceID,
+-+		&i.Note,
+-+		&i.RequestedBy,
+-+		&i.RequestedByName,
+-+		&i.SubmittedAt,
+-+		&i.ReleasedBy,
+-+		&i.ReleasedByName,
+-+		&i.ReleasedAt,
+-+		&i.PreparedBy,
+-+		&i.PreparedByName,
+-+		&i.PreparedAt,
+-+		&i.ShippedBy,
+-+		&i.ShippedByName,
+-+		&i.ShippedAt,
+-+		&i.ReceivedBy,
+-+		&i.ReceivedByName,
+-+		&i.ReceivedAt,
+-+		&i.CompletedAt,
+-+		&i.CancelledAt,
+-+		&i.CancelReason,
+-+		&i.CreatedAt,
+-+		&i.CreatedBy,
+-+		&i.UpdatedAt,
+-+		&i.UpdatedBy,
+-+		&i.Version,
+-+	)
+-+	return i, err
+-+}
+-+
+-+const updateTransferLine = `-- name: UpdateTransferLine :exec
+-+UPDATE stock_transfer_lines
+-+SET received_qty = $1, shortage_qty = $2, cost_amount = $3
+-+WHERE id = $4
+-+`
+-+
+-+type UpdateTransferLineParams struct {
+-+	ReceivedQty decimal.Decimal
+-+	ShortageQty decimal.Decimal
+-+	CostAmount  decimal.Decimal
+-+	ID          uuid.UUID
+-+}
+-+
+-+func (q *Queries) UpdateTransferLine(ctx context.Context, arg UpdateTransferLineParams) error {
+-+	_, err := q.db.Exec(ctx, updateTransferLine,
+-+		arg.ReceivedQty,
+-+		arg.ShortageQty,
+-+		arg.CostAmount,
+-+		arg.ID,
+-+	)
+-+	return err
+-+}
