+		ID: d.ID, Number: d.Number, TaxType: string(d.TaxType), TaxYear: int32(d.Period.Year), //nolint:gosec // tahun valid
+		TaxMonth: int32(d.Period.Month), BankAccountID: d.BankAccountID, DepositDate: d.DepositDate, //nolint:gosec // bulan valid
+		Amount: d.Amount.Decimal(), BillingCode: d.BillingCode, Ntpn: d.NTPN, JournalEntryID: d.JournalEntryID, ActorID: actorID,
+	})
+	if err != nil {
+		return uuid.Nil, time.Time{}, mapFinanceError(err, "insert tax deposit")
+	}
+	return r.ID, r.CreatedAt, nil
+}
+
+// DepositExists: pajak jenis + masa sudah disetor.
+func (s *FinanceStore) DepositExists(ctx context.Context, t tax.Type, p tax.Period) (bool, error) {
+	_, err := s.q(ctx).TaxDepositByPeriod(ctx, sqlcgen.TaxDepositByPeriodParams{
+		TaxType: string(t), TaxYear: int32(p.Year), TaxMonth: int32(p.Month), //nolint:gosec // tahun/bulan valid
+	})
+	if errors.Is(err, pgx.ErrNoRows) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("tax deposit by period: %w", err)
+	}
+	return true, nil
+}
+
+// ListDeposits mengembalikan penyetoran setahun.
+func (s *FinanceStore) ListDeposits(ctx context.Context, year int) ([]domain.TaxDeposit, error) {
+	rows, err := s.q(ctx).ListTaxDeposits(ctx, int32(year)) //nolint:gosec // tahun valid
+	if err != nil {
+		return nil, fmt.Errorf("list tax deposits: %w", err)
+	}
+	out := make([]domain.TaxDeposit, len(rows))
+	for i, r := range rows {
+		out[i] = domain.TaxDeposit{
+			ID: r.ID, Number: r.Number, TaxType: tax.Type(r.TaxType), Period: tax.Period{Year: int(r.TaxYear), Month: time.Month(r.TaxMonth)},
+			BankAccountID: r.BankAccountID, BankAccountName: r.BankName, DepositDate: r.DepositDate,
+			Amount: money.FromDecimal(r.Amount), BillingCode: r.BillingCode, NTPN: r.Ntpn, JournalEntryID: r.JournalEntryID,
+			JournalNumber: strOf(r.JournalNumber), CreatedAt: r.CreatedAt, CreatedBy: r.CreatedBy,
+		}
+	}
+	return out, nil
+}
+
+// ListFinalTaxSettings mengembalikan riwayat status PPh Final (terbaru dulu).
+func (s *FinanceStore) ListFinalTaxSettings(ctx context.Context) ([]domain.FinalTaxSetting, error) {
+	rows, err := s.q(ctx).ListFinalTaxSettings(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("list final tax settings: %w", err)
+	}
+	out := make([]domain.FinalTaxSetting, len(rows))
+	for i, r := range rows {
+		out[i] = domain.FinalTaxSetting{
+			ID: r.ID, ValidFrom: r.ValidFrom, IsEnabled: r.IsEnabled, OpeningTurnover: money.FromDecimal(r.OpeningTurnover),
+			Note: r.Note, CreatedAt: r.CreatedAt, CreatedBy: r.CreatedBy,
+		}
+		if r.OpeningYear.Valid {
+			y := int(r.OpeningYear.Int32)
+			out[i].OpeningYear = &y
+		}
+	}
+	return out, nil
+}
+
+// InsertFinalTaxSetting menyimpan status PPh Final baru.
+func (s *FinanceStore) InsertFinalTaxSetting(ctx context.Context, st domain.FinalTaxSetting, actorID uuid.UUID) (uuid.UUID, error) {
+	var year pgtype.Int4
+	if st.OpeningYear != nil {
+		year = pgtype.Int4{Int32: int32(*st.OpeningYear), Valid: true} //nolint:gosec // tahun valid
+	}
+	r, err := s.q(ctx).InsertFinalTaxSetting(ctx, sqlcgen.InsertFinalTaxSettingParams{
+		ValidFrom: st.ValidFrom, IsEnabled: st.IsEnabled, OpeningYear: year, OpeningTurnover: st.OpeningTurnover.Decimal(),
+		Note: st.Note, ActorID: actorID,
+	})
+	if err != nil {
+		return uuid.Nil, mapFinanceError(err, "insert final tax setting")
+	}
+	return r.ID, nil
+}
+
+// MonthlyRevenue mengembalikan omzet bruto (kredit − debit akun 4xxx) per bulan setahun.
+func (s *FinanceStore) MonthlyRevenue(ctx context.Context, year int) (map[time.Month]money.Amount, error) {
+	rows, err := s.q(ctx).MonthlyRevenue(ctx, int32(year)) //nolint:gosec // tahun valid
+	if err != nil {
+		return nil, fmt.Errorf("monthly revenue: %w", err)
+	}
+	out := map[time.Month]money.Amount{}
+	for _, r := range rows {
+		out[time.Month(r.Month)] = money.FromDecimal(r.Revenue)
+	}
+	return out, nil
+}
+
+// ListFinalTaxRuns mengembalikan perhitungan PPh Final setahun.
+func (s *FinanceStore) ListFinalTaxRuns(ctx context.Context, year int) ([]domain.FinalTaxRun, error) {
+	rows, err := s.q(ctx).ListFinalTaxRuns(ctx, int32(year)) //nolint:gosec // tahun valid
+	if err != nil {
+		return nil, fmt.Errorf("list final tax runs: %w", err)
+	}
+	out := make([]domain.FinalTaxRun, len(rows))
+	for i, r := range rows {
+		out[i] = domain.FinalTaxRun{
+			ID: r.ID, Period: tax.Period{Year: int(r.TaxYear), Month: time.Month(r.TaxMonth)},
+			GrossRevenue: money.FromDecimal(r.GrossRevenueAmount), RateID: r.RateID, RatePercent: r.RatePercent,
+			TaxAmount: money.FromDecimal(r.TaxAmount), JournalEntryID: uuidPtr(r.JournalEntryID), JournalNumber: r.JournalNumber,
+			DepositID: uuidPtr(r.DepositID), CreatedAt: r.CreatedAt, CreatedBy: r.CreatedBy,
+		}
+	}
+	return out, nil
+}
+
+// InsertFinalTaxRun menyimpan perhitungan PPh Final satu masa.
+func (s *FinanceStore) InsertFinalTaxRun(ctx context.Context, r domain.FinalTaxRun, actorID uuid.UUID) (uuid.UUID, time.Time, error) {
+	row, err := s.q(ctx).InsertFinalTaxRun(ctx, sqlcgen.InsertFinalTaxRunParams{
+		ID: r.ID, TaxYear: int32(r.Period.Year), TaxMonth: int32(r.Period.Month), //nolint:gosec // tahun/bulan valid
+		GrossRevenueAmount: r.GrossRevenue.Decimal(), RateID: r.RateID, RatePercent: r.RatePercent,
+		TaxAmount: r.TaxAmount.Decimal(), JournalEntryID: nullUUID(r.JournalEntryID), ActorID: actorID,
+	})
+	if err != nil {
+		return uuid.Nil, time.Time{}, mapFinanceError(err, "insert final tax run")
+	}
+	return row.ID, row.CreatedAt, nil
+}
+
+// FinalTaxRunForDeposit mengunci perhitungan PPh Final satu masa; ok=false bila belum dihitung.
+func (s *FinanceStore) FinalTaxRunForDeposit(ctx context.Context, p tax.Period) (uuid.UUID, money.Amount, bool, bool, error) {
+	r, err := s.q(ctx).LockFinalTaxRunForDeposit(ctx, sqlcgen.LockFinalTaxRunForDepositParams{
+		TaxYear: int32(p.Year), TaxMonth: int32(p.Month), //nolint:gosec // tahun/bulan valid
+	})
+	if errors.Is(err, pgx.ErrNoRows) {
+		return uuid.Nil, money.Zero, false, false, nil
+	}
+	if err != nil {
+		return uuid.Nil, money.Zero, false, false, fmt.Errorf("lock final tax run: %w", err)
+	}
+	return r.ID, money.FromDecimal(r.TaxAmount), true, r.DepositID.Valid, nil
+}
+
+// MarkFinalTaxRunDeposited menautkan perhitungan PPh Final ke penyetorannya.
+func (s *FinanceStore) MarkFinalTaxRunDeposited(ctx context.Context, runID, depositID uuid.UUID) error {
+	if err := s.q(ctx).MarkFinalTaxRunDeposited(ctx, sqlcgen.MarkFinalTaxRunDepositedParams{
+		DepositID: uuid.NullUUID{UUID: depositID, Valid: true}, ID: runID,
+	}); err != nil {
+		return fmt.Errorf("mark final tax run deposited: %w", err)
+	}
+	return nil
+}
diff --git a/backend/internal/accounting/postgres/queries/cash.sql b/backend/internal/accounting/postgres/queries/cash.sql
new file mode 100644
index 0000000..b0a9635
--- /dev/null
+++ b/backend/internal/accounting/postgres/queries/cash.sql
@@ -0,0 +1,166 @@
+-- name: ListBankAccounts :many
+SELECT b.*, a.code AS gl_code, a.name AS gl_name
+FROM bank_accounts b
+JOIN accounts a ON a.id = b.account_id
+WHERE (b.deleted_at IS NOT NULL) = sqlc.arg('deleted')::boolean
+  AND (sqlc.arg('include_inactive')::boolean OR b.is_active)
+ORDER BY b.code;
+
+-- name: GetBankAccount :one
+SELECT b.*, a.code AS gl_code, a.name AS gl_name
+FROM bank_accounts b
+JOIN accounts a ON a.id = b.account_id
+WHERE b.id = $1;
+
+-- name: GetBankAccountForUpdate :one
+SELECT b.*, a.code AS gl_code, a.name AS gl_name
+FROM bank_accounts b
+JOIN accounts a ON a.id = b.account_id
+WHERE b.id = $1
+FOR UPDATE OF b;
+
+-- name: InsertBankAccount :one
+INSERT INTO bank_accounts (
+    code, name, kind, bank_name, account_number_enc, account_number_last4, account_holder, account_id, is_active,
+    description, created_by, updated_by)
+VALUES (
+    sqlc.arg('code'), sqlc.arg('name'), sqlc.arg('kind'), sqlc.arg('bank_name'), sqlc.arg('account_number_enc'),
+    sqlc.arg('account_number_last4'), sqlc.arg('account_holder'), sqlc.arg('account_id'), sqlc.arg('is_active'),
+    sqlc.arg('description'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING id;
+
+-- name: UpdateBankAccount :execrows
+UPDATE bank_accounts
+SET name = sqlc.arg('name'), kind = sqlc.arg('kind'), bank_name = sqlc.arg('bank_name'),
+    account_number_enc = sqlc.arg('account_number_enc'), account_number_last4 = sqlc.arg('account_number_last4'),
+    account_holder = sqlc.arg('account_holder'), account_id = sqlc.arg('account_id'), is_active = sqlc.arg('is_active'),
+    description = sqlc.arg('description'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version');
+
+-- name: SetBankAccountDeleted :execrows
+UPDATE bank_accounts
+SET deleted_at = sqlc.narg('deleted_at'), deleted_by = sqlc.narg('deleted_by'), updated_at = now(),
+    updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version');
+
+-- name: BankAccountUsage :one
+SELECT
+    (SELECT count(*) FROM payments p WHERE p.bank_account_id = $1 AND p.status <> 'cancelled')::bigint AS payments,
+    (SELECT count(*) FROM bank_statements s WHERE s.bank_account_id = $1)::bigint AS statements;
+
+-- name: ListPayments :many
+SELECT p.*, b.code AS bank_code, b.name AS bank_name, ba.code AS bank_gl_code, c.code AS counter_code,
+       c.name AS counter_name, j.number AS journal_number,
+       EXISTS (SELECT 1 FROM bank_statement_lines l
+               JOIN journal_lines jl ON jl.id = l.journal_line_id
+               WHERE l.status = 'matched' AND jl.journal_entry_id = p.journal_entry_id) AS reconciled,
+       count(*) OVER () AS total_count
+FROM payments p
+JOIN bank_accounts b ON b.id = p.bank_account_id
+JOIN accounts ba ON ba.id = b.account_id
+JOIN accounts c ON c.id = p.counter_account_id
+LEFT JOIN journal_entries j ON j.id = p.journal_entry_id
+WHERE p.deleted_at IS NULL
+  AND (sqlc.narg('bank_account_id')::uuid IS NULL OR p.bank_account_id = sqlc.narg('bank_account_id'))
+  AND (sqlc.narg('direction')::text IS NULL OR p.direction = sqlc.narg('direction'))
+  AND (sqlc.narg('status')::text IS NULL OR p.status = sqlc.narg('status'))
+  AND (sqlc.narg('date_from')::date IS NULL OR p.payment_date >= sqlc.narg('date_from'))
+  AND (sqlc.narg('date_to')::date IS NULL OR p.payment_date <= sqlc.narg('date_to'))
+  AND (sqlc.narg('q')::text IS NULL OR p.number ILIKE '%' || sqlc.narg('q') || '%'
+       OR p.party_name ILIKE '%' || sqlc.narg('q') || '%' OR p.reference ILIKE '%' || sqlc.narg('q') || '%'
+       OR p.description ILIKE '%' || sqlc.narg('q') || '%' OR p.source_label ILIKE '%' || sqlc.narg('q') || '%')
+ORDER BY p.payment_date DESC, p.created_at DESC
+LIMIT sqlc.arg('lim') OFFSET sqlc.arg('off');
+
+-- name: GetPayment :one
+SELECT p.*, b.code AS bank_code, b.name AS bank_name, ba.code AS bank_gl_code, c.code AS counter_code,
+       c.name AS counter_name, j.number AS journal_number,
+       EXISTS (SELECT 1 FROM bank_statement_lines l
+               JOIN journal_lines jl ON jl.id = l.journal_line_id
+               WHERE l.status = 'matched' AND jl.journal_entry_id = p.journal_entry_id) AS reconciled,
+       0::bigint AS total_count
+FROM payments p
+JOIN bank_accounts b ON b.id = p.bank_account_id
+JOIN accounts ba ON ba.id = b.account_id
+JOIN accounts c ON c.id = p.counter_account_id
+LEFT JOIN journal_entries j ON j.id = p.journal_entry_id
+WHERE p.id = $1 AND p.deleted_at IS NULL;
+
+-- name: LockPayment :one
+SELECT version FROM payments WHERE id = $1 AND deleted_at IS NULL FOR UPDATE;
+
+-- name: InsertPayment :one
+INSERT INTO payments (
+    direction, bank_account_id, payment_date, amount, counter_account_id, party_type, party_id, party_name,
+    reference, description, proof_file_id, source_type, source_id, source_label, created_by, updated_by)
+VALUES (
+    sqlc.arg('direction'), sqlc.arg('bank_account_id'), sqlc.arg('payment_date'), sqlc.arg('amount'),
+    sqlc.arg('counter_account_id'), sqlc.arg('party_type'), sqlc.narg('party_id'), sqlc.arg('party_name'),
+    sqlc.arg('reference'), sqlc.arg('description'), sqlc.narg('proof_file_id'), sqlc.arg('source_type'),
+    sqlc.narg('source_id'), sqlc.arg('source_label'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING id;
+
+-- name: SavePayment :execrows
+UPDATE payments
+SET number = sqlc.narg('number'), direction = sqlc.arg('direction'), bank_account_id = sqlc.arg('bank_account_id'),
+    payment_date = sqlc.arg('payment_date'), amount = sqlc.arg('amount'), counter_account_id = sqlc.arg('counter_account_id'),
+    party_type = sqlc.arg('party_type'), party_id = sqlc.narg('party_id'), party_name = sqlc.arg('party_name'),
+    reference = sqlc.arg('reference'), description = sqlc.arg('description'), proof_file_id = sqlc.narg('proof_file_id'),
+    status = sqlc.arg('status'), journal_entry_id = sqlc.narg('journal_entry_id'), posted_at = sqlc.narg('posted_at'),
+    posted_by = sqlc.narg('posted_by'), cancelled_at = sqlc.narg('cancelled_at'), cancelled_by = sqlc.narg('cancelled_by'),
+    cancel_reason = sqlc.arg('cancel_reason'), updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version');
+
+-- name: BankMutationOpening :one
+SELECT coalesce(sum(l.debit_amount - l.credit_amount), 0)::numeric AS opening
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+WHERE e.status = 'posted' AND l.account_id = sqlc.arg('account_id') AND e.business_date < sqlc.arg('date_from');
+
+-- name: BankMutationCount :one
+SELECT count(*)::bigint
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+WHERE e.status = 'posted' AND l.account_id = sqlc.arg('account_id')
+  AND e.business_date BETWEEN sqlc.arg('date_from') AND sqlc.arg('date_to');
+
+-- name: BankMutations :many
+SELECT l.id AS line_id, e.id AS entry_id, e.number, e.business_date, e.description, e.source_type, e.source_label,
+       l.memo, (l.debit_amount - l.credit_amount)::numeric AS amount,
+       sum(l.debit_amount - l.credit_amount) OVER (ORDER BY e.business_date, e.number, l.line_no)::numeric AS cumulative,
+       EXISTS (SELECT 1 FROM bank_statement_lines s WHERE s.journal_line_id = l.id AND s.status = 'matched') AS reconciled
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+WHERE e.status = 'posted' AND l.account_id = sqlc.arg('account_id')
+  AND e.business_date BETWEEN sqlc.arg('date_from') AND sqlc.arg('date_to')
+ORDER BY e.business_date, e.number, l.line_no
+LIMIT sqlc.arg('lim') OFFSET sqlc.arg('off');
+
+-- name: UnreconciledBankLines :many
+SELECT l.id AS line_id, e.id AS entry_id, e.number, e.business_date, e.description, e.source_type, e.source_label,
+       (l.debit_amount - l.credit_amount)::numeric AS amount,
+       coalesce(p.reference, '')::text AS payment_reference, coalesce(p.number, '')::text AS payment_number,
+       coalesce(p.party_name, '')::text AS party_name
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+LEFT JOIN payments p ON p.journal_entry_id = e.id
+WHERE e.status = 'posted' AND l.account_id = sqlc.arg('account_id')
+  AND e.business_date BETWEEN sqlc.arg('date_from') AND sqlc.arg('date_to')
+  AND NOT EXISTS (SELECT 1 FROM bank_statement_lines s WHERE s.journal_line_id = l.id AND s.status = 'matched')
+ORDER BY e.business_date, e.number, l.line_no
+LIMIT 2000;
+
+-- name: JournalLineOnAccount :one
+SELECT l.id AS line_id, e.id AS entry_id, e.number, e.business_date, (l.debit_amount - l.credit_amount)::numeric AS amount
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+WHERE e.status = 'posted' AND e.id = sqlc.arg('entry_id') AND l.account_id = sqlc.arg('account_id')
+ORDER BY l.line_no
+LIMIT 1;
+
+-- name: GetJournalLine :one
+SELECT l.id AS line_id, e.id AS entry_id, e.number, e.business_date, l.account_id,
+       (l.debit_amount - l.credit_amount)::numeric AS amount
+FROM journal_lines l
+JOIN journal_entries e ON e.id = l.journal_entry_id
+WHERE l.id = $1 AND e.status = 'posted';
diff --git a/backend/internal/accounting/postgres/queries/expense_claims.sql b/backend/internal/accounting/postgres/queries/expense_claims.sql
new file mode 100644
index 0000000..e82e19b
--- /dev/null
+++ b/backend/internal/accounting/postgres/queries/expense_claims.sql
@@ -0,0 +1,92 @@
+-- name: ListExpenseClaims :many
+SELECT c.*, d.name AS division_name, coalesce(k.name, '')::text AS campaign_name,
+       coalesce(j.number, '')::text AS journal_number, coalesce(p.number, '')::text AS payment_number,
+       count(*) OVER () AS total_count
+FROM expense_claims c
+JOIN divisions d ON d.id = c.division_id
+LEFT JOIN campaigns k ON k.id = c.campaign_id
+LEFT JOIN journal_entries j ON j.id = c.journal_entry_id
+LEFT JOIN payments p ON p.id = c.payment_id
+WHERE c.deleted_at IS NULL
+  AND (sqlc.narg('requester_id')::uuid IS NULL OR c.requester_id = sqlc.narg('requester_id'))
+  AND (sqlc.narg('status')::text IS NULL OR c.status = sqlc.narg('status'))
+  AND (sqlc.narg('division_id')::uuid IS NULL OR c.division_id = sqlc.narg('division_id'))
+  AND (sqlc.narg('date_from')::date IS NULL OR c.claim_date >= sqlc.narg('date_from'))
+  AND (sqlc.narg('date_to')::date IS NULL OR c.claim_date <= sqlc.narg('date_to'))
+  AND (sqlc.narg('q')::text IS NULL OR c.number ILIKE '%' || sqlc.narg('q') || '%'
+       OR c.payee_name ILIKE '%' || sqlc.narg('q') || '%' OR c.description ILIKE '%' || sqlc.narg('q') || '%')
+ORDER BY c.created_at DESC
+LIMIT sqlc.arg('lim') OFFSET sqlc.arg('off');
+
+-- name: GetExpenseClaim :one
+SELECT c.*, d.name AS division_name, coalesce(k.name, '')::text AS campaign_name,
+       coalesce(j.number, '')::text AS journal_number, coalesce(p.number, '')::text AS payment_number,
+       0::bigint AS total_count
+FROM expense_claims c
+JOIN divisions d ON d.id = c.division_id
+LEFT JOIN campaigns k ON k.id = c.campaign_id
+LEFT JOIN journal_entries j ON j.id = c.journal_entry_id
+LEFT JOIN payments p ON p.id = c.payment_id
+WHERE c.id = $1 AND c.deleted_at IS NULL;
+
+-- name: LockExpenseClaim :one
+SELECT version FROM expense_claims WHERE id = $1 AND deleted_at IS NULL FOR UPDATE;
+
+-- name: ExpenseClaimLines :many
+SELECT l.*, t.code AS type_code, t.name AS type_name, a.code AS account_code
+FROM expense_claim_lines l
+JOIN expense_types t ON t.id = l.expense_type_id
+JOIN accounts a ON a.id = t.expense_account_id
+WHERE l.claim_id = $1
+ORDER BY l.line_no;
+
+-- name: InsertExpenseClaim :one
+INSERT INTO expense_claims (
+    claim_type, requester_id, division_id, campaign_id, payee_type, payee_id, payee_name, payee_tax_id_enc, claim_date,
+    description, total_amount, withholding_amount, payable_amount, created_by, updated_by)
+VALUES (
+    sqlc.arg('claim_type'), sqlc.arg('requester_id'), sqlc.arg('division_id'), sqlc.narg('campaign_id'),
+    sqlc.arg('payee_type'), sqlc.narg('payee_id'), sqlc.arg('payee_name'), sqlc.arg('payee_tax_id_enc'),
+    sqlc.arg('claim_date'), sqlc.arg('description'), sqlc.arg('total_amount'), sqlc.arg('withholding_amount'),
+    sqlc.arg('payable_amount'), sqlc.arg('actor_id'), sqlc.arg('actor_id'))
+RETURNING id;
+
+-- name: SaveExpenseClaim :execrows
+UPDATE expense_claims
+SET number = sqlc.narg('number'), claim_type = sqlc.arg('claim_type'), division_id = sqlc.arg('division_id'),
+    campaign_id = sqlc.narg('campaign_id'), payee_type = sqlc.arg('payee_type'), payee_id = sqlc.narg('payee_id'),
+    payee_name = sqlc.arg('payee_name'), payee_tax_id_enc = sqlc.arg('payee_tax_id_enc'), claim_date = sqlc.arg('claim_date'),
+    description = sqlc.arg('description'), total_amount = sqlc.arg('total_amount'),
+    withholding_amount = sqlc.arg('withholding_amount'), payable_amount = sqlc.arg('payable_amount'),
+    status = sqlc.arg('status'), submitted_at = sqlc.narg('submitted_at'), decided_at = sqlc.narg('decided_at'),
+    decision_note = sqlc.arg('decision_note'), verified_at = sqlc.narg('verified_at'), verified_by = sqlc.narg('verified_by'),
+    verify_date = sqlc.narg('verify_date'), journal_entry_id = sqlc.narg('journal_entry_id'),
+    payment_id = sqlc.narg('payment_id'), paid_at = sqlc.narg('paid_at'), cancel_reason = sqlc.arg('cancel_reason'),
+    updated_at = now(), updated_by = sqlc.arg('actor_id'), version = version + 1
+WHERE id = sqlc.arg('id') AND version = sqlc.arg('version');
+
+-- name: DeleteExpenseClaimLines :exec
+DELETE FROM expense_claim_lines WHERE claim_id = $1;
+
+-- name: InsertExpenseClaimLine :exec
+INSERT INTO expense_claim_lines (
+    claim_id, line_no, expense_type_id, description, amount, receipt_file_id, withholding_type, object_code,
+    withholding_rate, withholding_amount, created_by)
+VALUES (
+    sqlc.arg('claim_id'), sqlc.arg('line_no'), sqlc.arg('expense_type_id'), sqlc.arg('description'), sqlc.arg('amount'),
