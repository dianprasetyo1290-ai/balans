+        key
+      ),
+    onSuccess: async () => {
+      toast.success("Baris mutasi dicocokkan")
+      onClose()
+      await refresh()
+    },
+    onError: (err) => showErrorDialog(parseProblem(err)),
+  })
+  return (
+    <DialogContent className="sm:max-w-2xl">
+      <DialogHeader>
+        <DialogTitle>Cocokkan Manual</DialogTitle>
+        <DialogDescription>
+          Mutasi {formatDate(line.transactionDate)} · {formatRupiah(line.amount)}. Pilih transaksi tercatat (nominal
+          harus sama) atau dokumen terbuka; dokumen dibayar otomatis dengan pembayaran BYR.
+        </DialogDescription>
+      </DialogHeader>
+      <LoadingArea loading={candidates.isPending}>
+        <ul className="flex max-h-96 flex-col divide-y overflow-y-auto rounded-md border">
