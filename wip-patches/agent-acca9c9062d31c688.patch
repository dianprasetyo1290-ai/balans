+const lockExpenseClaim = `-- name: LockExpenseClaim :one
+SELECT version FROM expense_claims WHERE id = $1 AND deleted_at IS NULL FOR UPDATE
+`
+
+func (q *Queries) LockExpenseClaim(ctx context.Context, id uuid.UUID) (int32, error) {
+	row := q.db.QueryRow(ctx, lockExpenseClaim, id)
+	var version int32
+	err := row.Scan(&version)
+	return version, err
+}
+
+const saveExpenseClaim = `-- name: SaveExpenseClaim :execrows
+UPDATE expense_claims
+SET number = $1, claim_type = $2, division_id = $3,
+    campaign_id = $4, payee_type = $5, payee_id = $6,
+    payee_name = $7, payee_tax_id_enc = $8, claim_date = $9,
+    description = $10, total_amount = $11,
+    withholding_amount = $12, payable_amount = $13,
+    status = $14, submitted_at = $15, decided_at = $16,
+    decision_note = $17, verified_at = $18, verified_by = $19,
+    verify_date = $20, journal_entry_id = $21,
+    payment_id = $22, paid_at = $23, cancel_reason = $24,
+    updated_at = now(), updated_by = $25, version = version + 1
+WHERE id = $26 AND version = $27
+`
+
+type SaveExpenseClaimParams struct {
+	Number            pgtype.Text
+	ClaimType         string
+	DivisionID        uuid.UUID
+	CampaignID        uuid.NullUUID
+	PayeeType         string
+	PayeeID           uuid.NullUUID
