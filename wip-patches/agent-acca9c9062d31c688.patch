+        <div className="grid gap-4 sm:grid-cols-2">
+          <Field>
+            <FieldLabel htmlFor="pay-dir">Arah</FieldLabel>
+            <SimpleSelect
+              id="pay-dir"
+              value={direction}
+              onValueChange={(v) => setDirection(v as PaymentDirection)}
+              placeholder="Pilih arah"
+              options={[
+                { value: "incoming", label: "Masuk (penerimaan)" },
