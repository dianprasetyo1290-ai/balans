# Env untuk Caddy edge. Salin ke /opt/balans/edge.env (permission 600).
# Dipakai compose.edge.yaml untuk env_file Caddy (menunjuk ke file ini sendiri).
ENV_FILE=/opt/balans/edge.env
ACME_EMAIL=it@findyourbalans.com
PRODUCTION_HOST=erp.findyourbalans.com
STAGING_HOST=erp-staging.findyourbalans.com
# Basic auth staging. Hash dibuat dengan:
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '<password>'
STAGING_BASIC_AUTH_USER=tim-balans
# Bungkus dengan kutip tunggal karena hash berisi $ yang akan diinterpolasi Compose.
STAGING_BASIC_AUTH_HASH='GANTI_DENGAN_HASH_BCRYPT'
