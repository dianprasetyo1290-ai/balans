# Contoh /opt/balans/monitoring.env (chmod 600) untuk host-check.sh, worker-check.sh, dan restore-test.sh
# (Runbook 7). Semua URL berasal dari layanan monitor di luar VPS (F0-EXT-03, mis. healthchecks.io atau
# Better Stack); kosong = fitur tersebut dilewati.

# Webhook chat tim IT (Slack incoming webhook / Discord webhook). Pesan dikirim sebagai {"text","content"}.
ALERT_WEBHOOK_URL=

# Heartbeat (ping URL; akhiran /fail = gagal, /start = mulai). Periode & grace di monitor: lihat Runbook 7.1.
HOST_HEARTBEAT_URL=
WORKER_HEARTBEAT_URL=
STAGING_WORKER_HEARTBEAT_URL=
RESTORE_HEARTBEAT_URL=

# Ambang host-check (opsional).
DISK_ALERT_PERCENT=80
MEM_ALERT_PERCENT=10
# Ambang worker-check (opsional): job available yang terlambat lebih dari N menit = worker macet.
WORKER_BACKLOG_MINUTES=10
