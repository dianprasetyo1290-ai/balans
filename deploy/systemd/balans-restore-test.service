# Uji restore bulanan (NFR-07, Runbook 5.2). Dipasang sekali di VPS:
#   sudo cp /opt/balans/deploy/systemd/balans-restore-test.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now balans-restore-test.timer
# Jalankan manual: sudo systemctl start balans-restore-test.service; log: journalctl -u balans-restore-test
[Unit]
Description=Balans - uji restore bulanan dari backup WAL-G
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=docker
Environment=BALANS_HOME=/opt/balans
ExecStart=/usr/bin/bash /opt/balans/deploy/scripts/restore-test.sh
# Restore database besar bisa lama; batas 3 jam agar unit yang macet tidak berjalan selamanya.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
