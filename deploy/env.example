# Contoh file env per lingkungan. Salin ke /opt/balans/production.env atau /opt/balans/staging.env
# di VPS dengan permission 600. Nilai rahasia DILARANG di-commit (Technical Guideline 9.4); nilai di
# bawah hanya placeholder.

# --- Aplikasi ---------------------------------------------------------------
APP_ENV=staging
LOG_LEVEL=info
HTTP_ADDR=:8080
# Modul yang dirilis (Technical Guideline 14.5). Production Fase 0: kosong.
# Staging Fase 0: notification,sales,logistics agar jalur mock teruji.
ENABLED_MODULES=identity,audit,notification,approval,document,accounting,catalog,warehouse,filestore,party,hris,dataexchange,sales,logistics
DATABASE_URL=postgres://balans:GANTI_PASSWORD@postgres:5432/balans?sslmode=disable
PUBLIC_BASE_URL=https://erp-staging.findyourbalans.com
INTERNAL_API_URL=http://api:8080
SENTRY_DSN=

# --- Identity (Runbook 3.1 – 3.2) ---------------------------------------------
JWT_SIGNING_KEY_ID=GANTI
JWT_SIGNING_KEY=GANTI_BASE64_PEM
JWT_VERIFY_KEYS=GANTI:GANTI_BASE64_PEM_PUBLIK
PII_ENCRYPTION_KEY_ID=GANTI
PII_ENCRYPTION_KEYS=GANTI:GANTI_BASE64_32_BYTE
PII_HASH_KEY=GANTI_BASE64_32_BYTE
# Diundang sebagai Admin Sistem pertama saat database belum punya user.
INITIAL_ADMIN_EMAIL=

# --- File (Technical Guideline 5.16) -------------------------------------------
# Folder file modul filestore di container api (volume filestore-data). Adapter object storage S3 menyusul.
FILESTORE_DIR=/var/lib/balans/files

# --- Adapter pihak ketiga (mock hanya untuk local dan staging, D-27) --------
EMAIL_PROVIDER=mock
SHIPMENT_PROVIDER=mock
PAYMENT_GATEWAY=mock
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Balans ERP <no-reply@findyourbalans.com>
MIDTRANS_SERVER_KEY=GANTI_DENGAN_STRING_ACAK
BITESHIP_WEBHOOK_SECRET=GANTI_DENGAN_STRING_ACAK

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=balans
POSTGRES_USER=balans
POSTGRES_PASSWORD=GANTI_PASSWORD
PGDATA=/var/lib/postgresql/18/docker

# --- Backup WAL-G ke object storage S3-compatible (bucket & kredensial khusus backup) ---
WALG_S3_PREFIX=s3://balans-backup/production
AWS_ACCESS_KEY_ID=GANTI
AWS_SECRET_ACCESS_KEY=GANTI
AWS_ENDPOINT=https://s3.provider.example
AWS_REGION=id-jkt-1
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=brotli
BACKUP_HOUR_WIB=01
# URL monitor heartbeat (mis. healthchecks.io / Better Stack). Kosong = tanpa heartbeat.
BACKUP_HEARTBEAT_URL=
